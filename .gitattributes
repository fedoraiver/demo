# 音频来源证据、配方和清单按原字节保存，避免自动换行破坏记录中的 SHA-256。
assets/audio/** -text whitespace=cr-at-eol
# 第三方许可证副本保留原有制表符和行尾空白，不对来源证据做格式清理。
assets/audio/sources/*-License.txt -whitespace
# 清单包含生成器自身的哈希，因此检出也不能改变其换行。
scripts/audio_pipeline.py -text
# 真实调度 DOT 保留原始字节与上游行尾空白，按普通文本展示差异。
docs/diagrams/generated/dot/*.dot -text diff whitespace=cr-at-eol,-blank-at-eol
# 原生调度回归夹具保留导出字节及空白行上的缩进。
docs/diagrams/tests/fixtures/native-postupdate.dot -text diff whitespace=cr-at-eol,-blank-at-eol
docs/diagrams/tests/fixtures/native-render.dot -text diff whitespace=cr-at-eol,-blank-at-eol
# 生成图与源码快照参与哈希或精确内容校验，检出时保留原始换行。
docs/diagrams/generated/svg/**/*.svg -text whitespace=cr-at-eol
docs/diagrams/generated/mermaid/*.mmd -text whitespace=cr-at-eol
docs/diagrams/generated/pages/*.html -text whitespace=cr-at-eol
docs/diagrams/generated/data/**/*.json -text
docs/diagrams/generated/data/*.json -text
docs/diagrams/generated/data/*.ndjson -text
# 分发运行库参与完整性校验，保留原始字节及第三方模板字符串中的行尾空白。
docs/diagrams/generated/runtime/*.mjs -text whitespace=cr-at-eol,-blank-at-eol
# 分发运行库的完整许可证保留来源格式。
docs/diagrams/licenses/SCHEDULE-RUNTIME-LICENSES.txt -text -whitespace
docs/diagrams/generated/data/model.calls.ndjson filter=lfs diff=lfs merge=lfs -text
