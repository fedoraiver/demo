# 音频来源证据、配方和清单按原字节保存，避免自动换行破坏记录中的 SHA-256。
assets/audio/** -text whitespace=cr-at-eol
# 第三方许可证副本保留原有制表符和行尾空白，不对来源证据做格式清理。
assets/audio/sources/*-License.txt -whitespace
# 清单包含生成器自身的哈希，因此检出也不能改变其换行。
scripts/audio_pipeline.py -text
# 真实调度 DOT 保留原始字节与上游行尾空白，按普通文本展示差异。
docs/diagrams/ecs-schedule-*.dot -text diff whitespace=cr-at-eol,-blank-at-eol
# 生成图与源码快照参与哈希或精确内容校验，检出时保留原始换行。
docs/diagrams/ecs-*.svg -text whitespace=cr-at-eol
docs/diagrams/ecs-*.mmd -text whitespace=cr-at-eol
docs/diagrams/ecs-*.html -text whitespace=cr-at-eol
# 分发运行库的完整许可证保留来源格式。
docs/diagrams/SCHEDULE-RUNTIME-LICENSES.txt -text -whitespace
