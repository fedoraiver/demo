---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 第一人称控制 · 数据与实体
  accDescr: 第一人称控制的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_note fill:#F7F7F5,stroke:#9A9B88,stroke-width:1.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n10@{ shape: rect, label: "**键盘控制者**        ​<br/>保存玩家身份、输入上下文与受控        ​<br/>角色及相机。        ​" }
  class n10 node_entity
  n11@{ shape: rect, label: "**第一人称相机实体**        ​<br/>提供跟随角色的第一人称视角与观        ​<br/>察输入状态。        ​" }
  class n11 node_entity
  subgraph n13[" "]
  direction TB
  eh4@{ shape: text, label: "**动作实体**        ​<br/>保存玩法或调试动作的评估结果与        ​<br/>触发状态。        ​" }
  n85@{ shape: rect, label: "**Name**<br/>来自Bevy 引擎 ↗：Action#lt;A#gt; 要求的动作<br/>名称，用于插件诊断。" }
  class n85 node_component
  class n85 external_node
  n86@{ shape: rect, label: "**Action#lt;A#gt;**<br/>来自Enhanced Input ↗：保存具体玩法动<br/>作的当前输出。" }
  class n86 node_component
  class n86 external_node
  n87@{ shape: rect, label: "**ActionSettings**<br/>来自Enhanced Input ↗：保存动作的输入<br/>消费与重新激活策略。" }
  class n87 node_component
  class n87 external_node
  n88@{ shape: rect, label: "**ActionOf#lt;GameplayContext#gt;**<br/>来自Enhanced Input ↗：将动作关联到所<br/>属控制上下文。" }
  class n88 node_component
  class n88 external_node
  n89@{ shape: rect, label: "**Bindings**<br/>来自Enhanced Input ↗：索引动作拥有的<br/>输入绑定。" }
  class n89 node_component
  class n89 external_node
  eh4 layout_0@~~~ n85
  n85 layout_1@~~~ n86
  n86 layout_2@~~~ n87
  n87 layout_3@~~~ n88
  n88 layout_4@~~~ n89
  n90@{ shape: rect, label: "**Press**<br/>来自Enhanced Input ↗：将按钮按下转换<br/>为一次触发。" }
  class n90 node_component
  class n90 external_node
  n91@{ shape: rect, label: "**ActionValue**<br/>来自Enhanced Input ↗：保存动作评估产<br/>生的通用输入值。" }
  class n91 node_component
  class n91 external_node
  n92@{ shape: rect, label: "**TriggerState**<br/>来自Enhanced Input ↗：保存本次动作评<br/>估的触发状态。" }
  class n92 node_component
  class n92 external_node
  n93@{ shape: rect, label: "**ActionEvents**<br/>来自Enhanced Input ↗：保存本次待派发<br/>的动作事件。" }
  class n93 node_component
  class n93 external_node
  eh4 layout_5@~~~ n90
  n90 layout_6@~~~ n91
  n91 layout_7@~~~ n92
  n92 layout_8@~~~ n93
  n94@{ shape: rect, label: "**ActionTime**<br/>来自Enhanced Input ↗：动作持续与触发<br/>计时，由插件评估更新。" }
  class n94 node_component
  class n94 external_node
  n95@{ shape: rect, label: "**ActionMock**<br/>来自Enhanced Input ↗：保存测试使用的<br/>模拟动作输入。" }
  class n95 node_component
  class n95 external_node
  n96@{ shape: rect, label: "**ActionFns**<br/>来自Enhanced Input ↗：将通用动作值适<br/>配为具体动作组件。" }
  class n96 node_component
  class n96 external_node
  n97@{ shape: rect, label: "**ConditionFns**<br/>来自Enhanced Input ↗：保存动作触发条<br/>件的执行适配。" }
  class n97 node_component
  class n97 external_node
  eh4 layout_9@~~~ n94
  n94 layout_10@~~~ n95
  n95 layout_11@~~~ n96
  n96 layout_12@~~~ n97
  end
  class n13 node_entity
  style n13 fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  n14@{ shape: rect, label: "**绑定实体**        ​<br/>将键盘或鼠标输入映射到玩法动        ​<br/>作。        ​" }
  class n14 node_entity
  n15@{ shape: hex, label: "**on_camera_look**<br/>将观察输入转为第一人称水平角与俯仰角。" }
  class n15 node_observer
  n16@{ shape: rounded, label: "**sync_character_facing**<br/>同步人物朝向并处理持物转向受阻。" }
  class n16 node_system
  n17@{ shape: rect, label: "**角色业务根实体**        ​<br/>来自场景装配 ↗：承载角色身        ​<br/>份、运动意图与动态物理身体。        ​" }
  class n17 node_entity
  class n17 external_node
  n15 e0@-->|"观察角度"| n11
  class e0 edge_write
  n11 e1@-->|"角度"| n16
  class e1 edge_read
  n10 e2@-->|"ControlsCharacter"| n17
  class e2 edge_reference
  n10 e3@-->|"ControlsCamera"| n11
  class e3 edge_reference
  n11 e4@-->|"FirstPersonCamera.target"| n17
  class e4 edge_reference
  n13 e5@-->|"ActionOf#lt;GameplayContext#gt;"| n10
  class e5 edge_relationship
  n14 e6@-->|"BindingOf"| n13
  class e6 edge_relationship
  end
  style relation_0 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: notch-rect, label: "**Local#lt;f64#gt;（next_log_at）**<br/>保存连续观察角度日志的下次采样时间。" }
  class n0 node_local
  n8@{ shape: doc, label: "**第一人称模型生命周期**<br/>保持受控角色自身模型隐藏并恢复失效关联。" }
  class n8 node_note
  n9@{ shape: rect, label: "**捕获与输入上下文**<br/>保存光标捕获与玩法输入启用状态。" }
  class n9 node_component
  n12@{ shape: rect, label: "**业务直属 GLB 视觉根实体**        ​<br/>承载业务实体的模型、骨骼与动画        ​<br/>子树。        ​" }
  class n12 node_entity
  n0 layout_13@~~~ n8
  n8 layout_14@~~~ n9
  n9 layout_15@~~~ n12
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
