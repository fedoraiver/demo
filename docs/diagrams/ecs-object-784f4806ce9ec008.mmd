---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-784f4806ce9ec008-e6{marker-start:url(#object-784f4806ce9ec008_flowchart-v2-pointStart)!important}\n#object-784f4806ce9ec008-e7{marker-start:url(#object-784f4806ce9ec008_flowchart-v2-pointStart)!important}\n#object-784f4806ce9ec008-e8{marker-start:url(#object-784f4806ce9ec008_flowchart-v2-pointStart)!important}\n#object-784f4806ce9ec008-e9{marker-start:url(#object-784f4806ce9ec008_flowchart-v2-pointStart)!important}\n#object-784f4806ce9ec008_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Pressed · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Pressed**<br/>标记原生按钮当前被按压。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**clear_cancelled_primary_presses**<br/>来自菜单与界面 ↗：清理被取消、失焦或离<br/>窗的菜单主键按压。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: hex, label: "**button_on_pointer_down**<br/>按压时插入原生Pressed；可<br/>选ActivateOnPress会发Activate。" }
  class n2 node_observer
  n3@{ shape: hex, label: "**button_on_pointer_up**<br/>释放时移除原生Pressed。" }
  class n3 node_observer
  n4@{ shape: hex, label: "**button_on_pointer_drag_end**<br/>拖动结束时移除原生Pressed。" }
  class n4 node_observer
  n5@{ shape: hex, label: "**button_on_pointer_cancel**<br/>收到取消事件时移除原生Pressed。" }
  class n5 node_observer
  n6@{ shape: rounded, label: "**可操作菜单按钮**<br/>来自菜单与界面 ↗：承载可操作菜单动作、<br/>设置调整与连续导航。" }
  class n6 node_entity
  class n6 external_node
  n7@{ shape: hex, label: "**button_on_pointer_click**<br/>满足条件时派发原生Activate。" }
  class n7 node_observer
  n8@{ shape: rounded, label: "**style_buttons**<br/>来自菜单与界面 ↗：按当前输入来源更新按<br/>钮背景与焦点边框。" }
  class n8 node_system
  class n8 external_node
  n1 e0@-->|"移除"| n0
  class e0 edge_write
  n2 e1@-->|"添加"| n0
  class e1 edge_write
  n3 e2@-->|"移除"| n0
  class e2 edge_write
  n4 e3@-->|"移除"| n0
  class e3 edge_write
  n5 e4@-->|"移除"| n0
  class e4 edge_write
  n0 e5@-->|"可能挂载于"| n6
  class e5 edge_reference
  n2 e6@---|"Has#lt;Pressed#gt;"| n0
  class e6 edge_reference
  n3 e7@---|"Has#lt;Pressed#gt;"| n0
  class e7 edge_reference
  n4 e8@---|"Has#lt;Pressed#gt;"| n0
  class e8 edge_reference
  n5 e9@---|"Has#lt;Pressed#gt;"| n0
  class e9 edge_reference
  n0 e10@-->|"Has#lt;Pressed#gt;"| n7
  class e10 edge_reference
  n0 e11@-->|"存在 / 变更过滤"| n8
  class e11 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
