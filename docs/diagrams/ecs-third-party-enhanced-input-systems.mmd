---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: Enhanced Input · 系统与调度
  accDescr: Enhanced Input的系统与调度；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_contract fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  subgraph sg0["PreUpdate"]
  direction TB
  n3@{ shape: lin-rect, label: "**ApplyDeferred（捕获 → 动作准备）**<br/>来自Bevy 引擎 ↗：使本帧玩法输入启停变<br/>更对动作评估可见。" }
  class n3 node_contract
  class n3 external_node
  n0@{ shape: lin-rect, label: "**EnhancedInputSystems::Prepare**<br/>准备动作评估并清理待释放的输入。" }
  class n0 node_contract
  n1@{ shape: lin-rect, label: "**EnhancedInputSystems::Update**<br/>评估绑定输入并更新动作值与触发状态。" }
  class n1 node_contract
  n2@{ shape: lin-rect, label: "**EnhancedInputSystems::Apply**<br/>提交动作值并派发对应事件。" }
  class n2 node_contract
  n4@{ shape: lin-rect, label: "**ApplyDeferred · 动作事件**<br/>来自菜单与界面 ↗：应用动作事件命令以触<br/>发匹配的观察系统。" }
  class n4 node_contract
  class n4 external_node
  n3 layout_0@~~~ n0
  n0 layout_1@~~~ n1
  n1 layout_2@~~~ n2
  n2 layout_3@~~~ n4
  end
  n3 e0@--> n0
  class e0 edge_order
  n0 e1@--> n1
  class e1 edge_order
  n1 e2@--> n2
  class e2 edge_order
  n2 e3@--> n4
  class e3 edge_order
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
