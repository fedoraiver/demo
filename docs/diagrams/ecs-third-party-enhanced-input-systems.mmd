---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: Enhanced Input · 系统与调度
  accDescr: Enhanced Input的系统与调度；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  subgraph sg0["PreUpdate"]
  direction TB
  n5@{ shape: rounded, label: "**ApplyDeferred（捕获 → 动作准备）**<br/>来自Bevy 引擎 ↗：使本帧玩法输入启停变<br/>更对动作评估可见。" }
  class n5 node_sync
  class n5 external_node
  n0@{ shape: lin-rect, label: "**EnhancedInputSystems::Prepare**<br/>准备动作评估并清理待释放的输入。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**EnhancedInputSystems::Update**<br/>评估绑定输入并更新动作值与触发状态。" }
  class n1 node_system_set
  n2@{ shape: lin-rect, label: "**EnhancedInputSystems::Apply**<br/>把评估结果写回强类型动作值。" }
  class n2 node_system_set
  n3@{ shape: lin-rect, label: "**EnhancedInputSystems::Trigger**<br/>按上下文顺序排入动作事件命令。" }
  class n3 node_system_set
  n6@{ shape: rounded, label: "**ApplyDeferred · 动作事件**<br/>来自菜单与界面 ↗：应用动作事件命令以触<br/>发匹配的观察系统。" }
  class n6 node_sync
  class n6 external_node
  n4@{ shape: hex, label: "**reset_action#lt;GameplayContext#gt;**<br/>动作移除时清零并派发条件性的结束事件。" }
  class n4 node_observer
  n7@{ shape: hex, label: "**record_movement**<br/>来自第一人称控制 ↗：保存控制角色的持续<br/>移动方向。" }
  class n7 node_observer
  class n7 external_node
  n8@{ shape: hex, label: "**clear_completed_movement**<br/>来自第一人称控制 ↗：清除已结束动作的角<br/>色移动方向。" }
  class n8 node_observer
  class n8 external_node
  n9@{ shape: hex, label: "**clear_cancelled_movement**<br/>来自第一人称控制 ↗：清除已取消动作的角<br/>色移动方向。" }
  class n9 node_observer
  class n9 external_node
  n10@{ shape: hex, label: "**request_jump**<br/>来自第一人称控制 ↗：记录目标角色的单次<br/>跳跃请求。" }
  class n10 node_observer
  class n10 external_node
  n11@{ shape: hex, label: "**request_interaction**<br/>来自第一人称控制 ↗：记录目标角色的单次<br/>交互请求。" }
  class n11 node_observer
  class n11 external_node
  n12@{ shape: hex, label: "**on_camera_look**<br/>来自第一人称控制 ↗：将观察输入转为第一<br/>人称水平角与俯仰角。" }
  class n12 node_observer
  class n12 external_node
  n13@{ shape: hex, label: "**release_pointer_for_inspector**<br/>来自第一人称控制 ↗：释放光标以允许操作<br/>世界检查器。" }
  class n13 node_observer
  class n13 external_node
  n14@{ shape: hex, label: "**previous**<br/>来自菜单与界面 ↗：循环选择上一个可操作<br/>菜单按钮。" }
  class n14 node_observer
  class n14 external_node
  n15@{ shape: hex, label: "**next**<br/>来自菜单与界面 ↗：循环选择下一个可操作<br/>菜单按钮。" }
  class n15 node_observer
  class n15 external_node
  n16@{ shape: hex, label: "**left**<br/>来自菜单与界面 ↗：向左调整当前聚焦的真<br/>实设置字段。" }
  class n16 node_observer
  class n16 external_node
  n17@{ shape: hex, label: "**right**<br/>来自菜单与界面 ↗：向右调整当前聚焦的真<br/>实设置字段。" }
  class n17 node_observer
  class n17 external_node
  n18@{ shape: hex, label: "**confirm**<br/>来自菜单与界面 ↗：执行当前聚焦按钮的菜<br/>单动作。" }
  class n18 node_observer
  class n18 external_node
  n19@{ shape: hex, label: "**back**<br/>来自菜单与界面 ↗：发出返回、暂停或恢复<br/>请求。" }
  class n19 node_observer
  class n19 external_node
  n20@{ shape: stadium, label: "**组件移除与实体销毁流程**<br/>来自Bevy 引擎 ↗：在实际移除或销毁时发<br/>出匹配的生命周期事件。" }
  class n20 node_engine_flow
  class n20 external_node
  n5 layout_0@~~~ n0
  n0 layout_1@~~~ n1
  n1 layout_2@~~~ n2
  n2 layout_3@~~~ n3
  n3 layout_4@~~~ n6
  n7 layout_5@~~~ n8
  n8 layout_6@~~~ n9
  n9 layout_7@~~~ n10
  n10 layout_8@~~~ n11
  n11 layout_9@~~~ n12
  n12 layout_10@~~~ n13
  n13 layout_11@~~~ n14
  n14 layout_12@~~~ n15
  n15 layout_13@~~~ n16
  n16 layout_14@~~~ n17
  n17 layout_15@~~~ n18
  n18 layout_16@~~~ n19
  end
  n5 e0@--> n0
  class e0 edge_order
  n0 e1@--> n1
  class e1 edge_order
  n1 e2@--> n2
  class e2 edge_order
  n3 e3@--> n6
  class e3 edge_order
  n2 e4@--> n3
  class e4 edge_order
  n3 e5@-->|"Fire#lt;MoveAction#gt;"| n7
  class e5 edge_observe
  n3 e6@-->|"Complete#lt;MoveAction#gt;"| n8
  class e6 edge_observe
  n4 e7@-->|"Complete#lt;MoveAction#gt;"| n8
  class e7 edge_observe
  n3 e8@-->|"Cancel#lt;MoveAction#gt;"| n9
  class e8 edge_observe
  n4 e9@-->|"Cancel#lt;MoveAction#gt;"| n9
  class e9 edge_observe
  n3 e10@-->|"Fire#lt;JumpAction#gt;"| n10
  class e10 edge_observe
  n3 e11@-->|"Fire#lt;InteractAction#gt;"| n11
  class e11 edge_observe
  n3 e12@-->|"Fire#lt;LookAction#gt;"| n12
  class e12 edge_observe
  n3 e13@-->|"Fire#lt;ReleasePointerAction#gt;"| n13
  class e13 edge_observe
  n3 e14@-->|"Fire#lt;PreviousAction#gt;"| n14
  class e14 edge_observe
  n3 e15@-->|"Fire#lt;NextAction#gt;"| n15
  class e15 edge_observe
  n3 e16@-->|"Fire#lt;LeftAction#gt;"| n16
  class e16 edge_observe
  n3 e17@-->|"Fire#lt;RightAction#gt;"| n17
  class e17 edge_observe
  n3 e18@-->|"Fire#lt;ConfirmAction#gt;"| n18
  class e18 edge_observe
  n3 e19@-->|"Fire#lt;BackAction#gt;"| n19
  class e19 edge_observe
  n20 e20@-->|"Remove#lt;ActionOf#lt;GameplayContext#gt;#gt;"| n4
  class e20 edge_observe
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
