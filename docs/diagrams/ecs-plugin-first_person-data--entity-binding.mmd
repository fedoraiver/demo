---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 第一人称控制 · 数据与实体
  accDescr: 第一人称控制的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_note fill:#F7F7F5,stroke:#9A9B88,stroke-width:1.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n10@{ shape: rect, label: "**键盘控制者**        ​<br/>保存玩家身份、输入上下文与受控        ​<br/>角色及相机。        ​" }
  class n10 node_entity
  n11@{ shape: rect, label: "**第一人称相机实体**        ​<br/>提供跟随角色的第一人称视角与观        ​<br/>察输入状态。        ​" }
  class n11 node_entity
  n13@{ shape: rect, label: "**动作实体**        ​<br/>保存玩法或调试动作的评估结果与        ​<br/>触发状态。        ​" }
  class n13 node_entity
  subgraph n14[" "]
  direction TB
  eh5@{ shape: text, label: "**绑定实体**        ​<br/>将键盘或鼠标输入映射到玩法动        ​<br/>作。        ​" }
  n98@{ shape: rect, label: "**Binding**<br/>来自Enhanced Input ↗：保存设备输入到<br/>动作的映射。" }
  class n98 node_component
  class n98 external_node
  n99@{ shape: rect, label: "**BindingOf**<br/>来自Enhanced Input ↗：将输入绑定关联<br/>到所属动作。" }
  class n99 node_component
  class n99 external_node
  n100@{ shape: rect, label: "**FirstActivation**<br/>来自Enhanced Input ↗：记录绑定重新启<br/>用时的首次激活状态。" }
  class n100 node_component
  class n100 external_node
  n101@{ shape: rect, label: "**Negate**<br/>来自Enhanced Input ↗：反转绑定输入的<br/>方向符号。" }
  class n101 node_component
  class n101 external_node
  n102@{ shape: rect, label: "**SwizzleAxis**<br/>来自Enhanced Input ↗：将输入标量映射<br/>到指定坐标轴。" }
  class n102 node_component
  class n102 external_node
  n103@{ shape: rect, label: "**ModifierFns**<br/>来自Enhanced Input ↗：保存输入修饰器<br/>的执行适配。" }
  class n103 node_component
  class n103 external_node
  eh5 layout_0@~~~ n98
  n98 layout_1@~~~ n99
  n99 layout_2@~~~ n100
  n100 layout_3@~~~ n101
  n101 layout_4@~~~ n102
  n102 layout_5@~~~ n103
  end
  class n14 node_entity
  style n14 fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  n15@{ shape: hex, label: "**on_camera_look**<br/>将观察输入转为第一人称水平角与俯仰角。" }
  class n15 node_observer
  n16@{ shape: rounded, label: "**sync_character_facing**<br/>同步人物朝向并处理持物转向受阻。" }
  class n16 node_system
  n17@{ shape: rect, label: "**角色业务根实体**        ​<br/>来自场景装配 ↗：承载角色身        ​<br/>份、运动意图与动态物理身体。        ​" }
  class n17 node_entity
  class n17 external_node
  n15 e0@-->|"观察角度"| n11
  class e0 edge_write
  n11 e1@-->|"角度"| n16
  class e1 edge_read
  n10 e2@-->|"ControlsCharacter"| n17
  class e2 edge_reference
  n10 e3@-->|"ControlsCamera"| n11
  class e3 edge_reference
  n11 e4@-->|"FirstPersonCamera.target"| n17
  class e4 edge_reference
  n13 e5@-->|"ActionOf#lt;GameplayContext#gt;"| n10
  class e5 edge_relationship
  n14 e6@-->|"BindingOf"| n13
  class e6 edge_relationship
  end
  style relation_0 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: notch-rect, label: "**Local#lt;f64#gt;（next_log_at）**<br/>保存连续观察角度日志的下次采样时间。" }
  class n0 node_local
  n8@{ shape: doc, label: "**第一人称模型生命周期**<br/>保持受控角色自身模型隐藏并恢复失效关联。" }
  class n8 node_note
  n9@{ shape: rect, label: "**捕获与输入上下文**<br/>保存光标捕获与玩法输入启用状态。" }
  class n9 node_component
  n12@{ shape: rect, label: "**业务直属 GLB 视觉根实体**        ​<br/>承载业务实体的模型、骨骼与动画        ​<br/>子树。        ​" }
  class n12 node_entity
  n0 layout_6@~~~ n8
  n8 layout_7@~~~ n9
  n9 layout_8@~~~ n12
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
