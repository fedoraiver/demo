---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 角色动画 · 数据与实体
  accDescr: 角色动画的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n4@{ shape: rect, label: "**业务直属 GLB 视觉根实体**        ​<br/>承载业务实体的模型、骨骼与动画        ​<br/>子树。        ​" }
  class n4 node_entity
  n5@{ shape: rect, label: "**主角 GLB 播放器节点**        ​<br/>承载主角模型的动画播放与混合状        ​<br/>态。        ​" }
  class n5 node_entity
  subgraph n6[" "]
  direction TB
  eh0@{ shape: text, label: "**角色业务根实体**        ​<br/>来自场景装配 ↗：承载角色身        ​<br/>份、运动意图与动态物理身体。        ​" }
  n8@{ shape: rect, label: "**Name**<br/>来自Bevy 引擎 ↗：角色根实体名称。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rect, label: "**Character**<br/>来自角色运动 ↗：标识具有角色运动能力的<br/>实体。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: rect, label: "**CharacterIntent**<br/>来自角色运动 ↗：保存持续移动方向与单次<br/>跳跃、交互请求。" }
  class n10 node_component
  class n10 external_node
  n11@{ shape: rect, label: "**CharacterMotion**<br/>来自角色运动 ↗：保存角色接地等运动观察<br/>结果。" }
  class n11 node_component
  class n11 external_node
  n12@{ shape: rect, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n12 node_component
  class n12 external_node
  n13@{ shape: rect, label: "**GlobalTransform**<br/>来自Bevy 引擎 ↗：保存层级传播后的世界<br/>姿态。" }
  class n13 node_component
  class n13 external_node
  n14@{ shape: rect, label: "**Visibility**<br/>来自Bevy 引擎 ↗：根实体的可见性，视觉<br/>子实体继承层级可见性。" }
  class n14 node_component
  class n14 external_node
  n15@{ shape: rect, label: "**Children**<br/>来自Bevy 引擎 ↗：索引当前实体的直接子<br/>实体。" }
  class n15 node_component
  class n15 external_node
  n16@{ shape: rect, label: "**HoldingItems**<br/>来自物品交互 ↗：索引角色当前持有的物<br/>品。" }
  class n16 node_component
  class n16 external_node
  n17@{ shape: rect, label: "**RigidBody**<br/>来自Avian ↗：定义实体参与物理模拟的刚<br/>体模式。" }
  class n17 node_component
  class n17 external_node
  eh0 layout_0@~~~ n8
  n8 layout_1@~~~ n9
  n9 layout_2@~~~ n10
  n10 layout_3@~~~ n11
  n11 layout_4@~~~ n12
  n12 layout_5@~~~ n13
  n13 layout_6@~~~ n14
  n14 layout_7@~~~ n15
  n15 layout_8@~~~ n16
  n16 layout_9@~~~ n17
  n18@{ shape: rect, label: "**Collider**<br/>来自Avian ↗：保存参与物理碰撞的实体形<br/>状。" }
  class n18 node_component
  class n18 external_node
  n19@{ shape: rect, label: "**Position**<br/>来自Avian ↗：保存物理模拟中的真实位<br/>置。" }
  class n19 node_component
  class n19 external_node
  n20@{ shape: rect, label: "**Rotation**<br/>来自Avian ↗：保存物理模拟中的真实旋<br/>转。" }
  class n20 node_component
  class n20 external_node
  n21@{ shape: rect, label: "**LinearVelocity**<br/>来自Avian ↗：实际线速度，由冲量、外<br/>力、重力与接触求解改变。" }
  class n21 node_component
  class n21 external_node
  n22@{ shape: rect, label: "**AngularVelocity**<br/>来自Avian ↗：保存物理模拟中的角速度。" }
  class n22 node_component
  class n22 external_node
  n23@{ shape: rect, label: "**Mass**<br/>来自Avian ↗：保存显式配置的质量。" }
  class n23 node_component
  class n23 external_node
  n24@{ shape: rect, label: "**ComputedMass**<br/>来自Avian ↗：保存物理求解使用的计算质<br/>量。" }
  class n24 node_component
  class n24 external_node
  n25@{ shape: rect, label: "**ComputedAngularInertia**<br/>来自Avian ↗：保存物理求解使用的计算角<br/>惯量。" }
  class n25 node_component
  class n25 external_node
  n26@{ shape: rect, label: "**ComputedCenterOfMass**<br/>来自Avian ↗：保存物理求解使用的计算质<br/>心。" }
  class n26 node_component
  class n26 external_node
  n27@{ shape: rect, label: "**CollisionLayers**<br/>来自Avian ↗：配置实体之间允许发生碰撞<br/>的层。" }
  class n27 node_component
  class n27 external_node
  eh0 layout_10@~~~ n18
  n18 layout_11@~~~ n19
  n19 layout_12@~~~ n20
  n20 layout_13@~~~ n21
  n21 layout_14@~~~ n22
  n22 layout_15@~~~ n23
  n23 layout_16@~~~ n24
  n24 layout_17@~~~ n25
  n25 layout_18@~~~ n26
  n26 layout_19@~~~ n27
  n28@{ shape: rect, label: "**CollisionEventsEnabled**<br/>来自Avian ↗：请求离散接触开始/结束消<br/>息，用于集中日志。" }
  class n28 node_component
  class n28 external_node
  n29@{ shape: rect, label: "**SweptCcd**<br/>来自Avian ↗：启用连续碰撞检测以减少高<br/>速穿透。" }
  class n29 node_component
  class n29 external_node
  n30@{ shape: rect, label: "**Friction**<br/>来自Avian ↗：保存接触表面的摩擦参数。" }
  class n30 node_component
  class n30 external_node
  n31@{ shape: rect, label: "**Restitution**<br/>来自Avian ↗：接触恢复系数。" }
  class n31 node_component
  class n31 external_node
  n32@{ shape: rect, label: "**VelocityIntegrationData**<br/>来自Avian ↗：累计本物理步的世界加速度<br/>与外力。" }
  class n32 node_component
  class n32 external_node
  n33@{ shape: rect, label: "**AccumulatedLocalAcceleration**<br/>来自Avian ↗：累计本物理步的局部加速<br/>度。" }
  class n33 node_component
  class n33 external_node
  n34@{ shape: rect, label: "**SleepTimer**<br/>来自Avian ↗：记录刚体休眠计时。" }
  class n34 node_component
  class n34 external_node
  n35@{ shape: rect, label: "**TranslationInterpolation**<br/>来自Avian ↗：启用平移显示插值。" }
  class n35 node_component
  class n35 external_node
  n36@{ shape: rect, label: "**TranslationEasingState**<br/>来自Avian ↗：保存固定步平移插值的起止<br/>端点。" }
  class n36 node_component
  class n36 external_node
  eh0 layout_20@~~~ n28
  n28 layout_21@~~~ n29
  n29 layout_22@~~~ n30
  n30 layout_23@~~~ n31
  n31 layout_24@~~~ n32
  n32 layout_25@~~~ n33
  n33 layout_26@~~~ n34
  n34 layout_27@~~~ n35
  n35 layout_28@~~~ n36
  n37@{ shape: rect, label: "**LockedAxes**<br/>来自Avian ↗：限制刚体可移动或旋转的<br/>轴。" }
  class n37 node_component
  class n37 external_node
  n38@{ shape: rect, label: "**ColliderAabb**<br/>来自Avian ↗：保存碰撞查询使用的轴对齐<br/>包围盒。" }
  class n38 node_component
  class n38 external_node
  n39@{ shape: rect, label: "**SpawnPoint**<br/>来自越界恢复 ↗：每个业务根独立保存出生<br/>姿态。" }
  class n39 node_component
  class n39 external_node
  n40@{ shape: rect, label: "**ResumeInterpolation**<br/>来自越界恢复 ↗：记录本次恢复临时添加的<br/>暂停项。" }
  class n40 node_component
  class n40 external_node
  n41@{ shape: rect, label: "**NoTranslationEasing**<br/>来自Avian ↗：暂停独立平移插值。" }
  class n41 node_component
  class n41 external_node
  n42@{ shape: rect, label: "**NoRotationEasing**<br/>来自Avian ↗：暂停独立旋转插值。" }
  class n42 node_component
  class n42 external_node
  n43@{ shape: rect, label: "**DespawnOnExit**<br/>来自Bevy 引擎 ↗：标记退出所属应用状态<br/>时销毁此实体。" }
  class n43 node_component
  class n43 external_node
  n44@{ shape: rect, label: "**CarryBaseMass**<br/>来自物品交互 ↗：挂接时保存，释放或箱体<br/>销毁时恢复原人物质量。" }
  class n44 node_component
  class n44 external_node
  n45@{ shape: rect, label: "**RigidBodyColliders**<br/>来自Avian ↗：索引属于同一刚体的全部碰<br/>撞体。" }
  class n45 node_component
  class n45 external_node
  eh0 layout_29@~~~ n37
  n37 layout_30@~~~ n38
  n38 layout_31@~~~ n39
  n39 layout_32@~~~ n40
  n40 layout_33@~~~ n41
  n41 layout_34@~~~ n42
  n42 layout_35@~~~ n43
  n43 layout_36@~~~ n44
  n44 layout_37@~~~ n45
  end
  class n6 node_entity
  class n6 external_node
  style n6 fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340,stroke-dasharray:6 4
  n7@{ shape: rect, label: "**GLB 网格与骨骼节点**        ​<br/>来自Bevy 引擎 ↗：承载导入模型        ​<br/>的网格、骨骼与局部动画姿态。        ​" }
  class n7 node_entity
  class n7 external_node
  n5 e0@-->|"CourierAnimation.character"| n6
  class e0 edge_reference
  n4 e1@-->|"CourierFootGrounding.character"| n6
  class e1 edge_reference
  n4 e2@-->|"CourierFootGrounding.animation_<br/>player"| n5
  class e2 edge_reference
  n4 e3@-->|"CourierFootGrounding.sole_markers"| n7
  class e3 edge_reference
  n7 e4@-->|"AnimatedBy"| n5
  class e4 edge_reference
  end
  style relation_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
