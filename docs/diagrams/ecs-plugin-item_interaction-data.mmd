---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 物品交互 · 数据与实体
  accDescr: 物品交互的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_contract fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n4@{ shape: rounded, label: "**角色业务根实体**<br/>承载角色身份、运动意图与动态物理身体。" }
  class n4 node_entity
  n5@{ shape: rounded, label: "**可搬物品业务根实体**<br/>承载可拾取物品身份及自由运动、共享持握状<br/>态。" }
  class n5 node_entity
  n6@{ shape: rounded, label: "**持物无视觉碰撞代理**<br/>为持物共享人物刚体提供无视觉碰撞形状。" }
  class n6 node_entity
  n7@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n7 node_system
  class n7 external_node
  n5 e0@-->|"HeldBy"| n4
  class e0 edge_relationship
  n5 e1@-->|"HeldAttachment.collider"| n6
  class e1 edge_reference
  n6 e2@-->|"HeldCollider.0"| n5
  class e2 edge_reference
  n6 e3@-->|"ColliderOf"| n4
  class e3 edge_relationship
  n5 e4@-->|"落水时解除持握"| n7
  class e4 edge_read
  end
  style relation_0 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: notch-rect, label: "**Local#lt;HashSet#lt;Entity#gt;#gt;（reserved）**<br/>预留同批次拾取目标以避免重复占用。" }
  class n0 node_local
  n1@{ shape: notch-rect, label: "**Local#lt;LandingContacts#gt;**<br/>记录物品支撑接触与单次落地反馈状态。" }
  class n1 node_local
  n2@{ shape: notch-rect, label: "**Local#lt;HashMap#lt;Entity, HoldStrain#gt;#gt;**<br/>记录持握偏差计时与失稳提示锁存。" }
  class n2 node_local
  n3@{ shape: lin-rect, label: "**CarryRotationQuery**<br/>提供持物转向与对齐的连续碰撞路径查询。" }
  class n3 node_contract
  n0 layout_0@~~~ n1
  n1 layout_1@~~~ n2
  n2 layout_2@~~~ n3
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
