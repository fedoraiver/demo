---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-34cb75204f84aca7-e1{marker-start:url(#component-34cb75204f84aca7_flowchart-v2-pointStart)!important}\n#component-34cb75204f84aca7-e2{marker-start:url(#component-34cb75204f84aca7_flowchart-v2-pointStart)!important}\n#component-34cb75204f84aca7-e3{marker-start:url(#component-34cb75204f84aca7_flowchart-v2-pointStart)!important}\n#component-34cb75204f84aca7-e4{marker-start:url(#component-34cb75204f84aca7_flowchart-v2-pointStart)!important}\n#component-34cb75204f84aca7-e5{marker-start:url(#component-34cb75204f84aca7_flowchart-v2-pointStart)!important}\n#component-34cb75204f84aca7-e6{marker-start:url(#component-34cb75204f84aca7_flowchart-v2-pointStart)!important}\n#component-34cb75204f84aca7-e7{marker-start:url(#component-34cb75204f84aca7_flowchart-v2-pointStart)!important}\n#component-34cb75204f84aca7-e8{marker-start:url(#component-34cb75204f84aca7_flowchart-v2-pointStart)!important}\n#component-34cb75204f84aca7-e9{marker-start:url(#component-34cb75204f84aca7_flowchart-v2-pointStart)!important}\n#component-34cb75204f84aca7_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: PrimaryWindow · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**主窗口实体**<br/>承载应用主窗口及原生尺寸策略。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**PrimaryWindow**<br/>标识鼠标捕获系统要求唯一的主窗口。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**sync_mouse_capture**<br/>来自第一人称控制 ↗：管理光标捕获及玩法<br/>输入启停。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**filter_captured_egui_input**<br/>来自第一人称控制 ↗：隔离游戏操作与检查<br/>器界面输入。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**sync_context**<br/>来自菜单与界面 ↗：跟随窗口焦点启停菜单<br/>输入。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**pointer_interaction**<br/>来自菜单与界面 ↗：将真实鼠标交互转换为<br/>共享菜单请求。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**rebuild_page**<br/>来自菜单与界面 ↗：按页面结构变化重建菜<br/>单界面。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: hex, label: "**release_pointer_for_inspector**<br/>来自第一人称控制 ↗：释放光标以允许操作<br/>世界检查器。" }
  class n7 node_observer
  class n7 external_node
  n8@{ shape: rounded, label: "**sample_slider_pointer**<br/>来自菜单与界面 ↗：从光标位置生成音量采<br/>样与释放请求。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**install_native_policy**<br/>来自窗口策略 ↗：安装并维护原生窗口比例<br/>与尺寸策略。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**clear_cancelled_primary_presses**<br/>来自菜单与界面 ↗：清理被取消、失焦或离<br/>窗的菜单主键按压。" }
  class n10 node_system
  class n10 external_node
  n1 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n1
  n4 layout_3@~~~ n1
  n5 layout_4@~~~ n1
  n6 layout_5@~~~ n1
  n7 layout_6@~~~ n1
  n8 layout_7@~~~ n1
  n9 layout_8@~~~ n1
  n10 layout_9@~~~ n1
  n1 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n2 e1@---|"存在 / 变更过滤"| n1
  class e1 edge_reference
  n3 e2@---|"存在 / 变更过滤"| n1
  class e2 edge_reference
  n4 e3@---|"存在 / 变更过滤"| n1
  class e3 edge_reference
  n5 e4@---|"存在 / 变更过滤"| n1
  class e4 edge_reference
  n6 e5@---|"存在 / 变更过滤"| n1
  class e5 edge_reference
  n7 e6@---|"存在 / 变更过滤"| n1
  class e6 edge_reference
  n8 e7@---|"存在 / 变更过滤"| n1
  class e7 edge_reference
  n9 e8@---|"存在 / 变更过滤"| n1
  class e8 edge_reference
  n10 e9@---|"存在 / 变更过滤"| n1
  class e9 edge_reference
