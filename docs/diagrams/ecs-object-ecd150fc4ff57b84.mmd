---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: EnhancedInputSystems::Trigger · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**EnhancedInputSystems::Trigger**<br/>按上下文顺序排入动作事件命令。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**ApplyDeferred · 动作事件**<br/>来自菜单与界面 ↗：应用动作事件命令以触<br/>发匹配的观察系统。" }
  class n1 node_sync
  class n1 external_node
  n2@{ shape: lin-rect, label: "**EnhancedInputSystems::Apply**<br/>把评估结果写回强类型动作值。" }
  class n2 node_system_set
  n3@{ shape: stadium, label: "**Fire#lt;MoveAction#gt;**<br/>来自第一人称控制 ↗：通知目标控制者的移<br/>动动作已触发。" }
  class n3 node_event
  class n3 external_node
  n4@{ shape: stadium, label: "**Complete#lt;MoveAction#gt;**<br/>来自第一人称控制 ↗：通知目标控制者的移<br/>动动作已正常结束。" }
  class n4 node_event
  class n4 external_node
  n5@{ shape: stadium, label: "**Cancel#lt;MoveAction#gt;**<br/>来自第一人称控制 ↗：通知目标控制者的移<br/>动动作已取消。" }
  class n5 node_event
  class n5 external_node
  n6@{ shape: stadium, label: "**Fire#lt;JumpAction#gt;**<br/>来自第一人称控制 ↗：通知目标控制者发起<br/>跳跃动作。" }
  class n6 node_event
  class n6 external_node
  n7@{ shape: stadium, label: "**Fire#lt;InteractAction#gt;**<br/>来自第一人称控制 ↗：通知目标控制者发起<br/>交互动作。" }
  class n7 node_event
  class n7 external_node
  n8@{ shape: stadium, label: "**Fire#lt;LookAction#gt;**<br/>来自第一人称控制 ↗：通知目标控制者更新<br/>观察输入。" }
  class n8 node_event
  class n8 external_node
  n9@{ shape: stadium, label: "**Fire#lt;ReleasePointerAction#gt;**<br/>来自第一人称控制 ↗：通知控制者释放光标<br/>以操作检查器。" }
  class n9 node_event
  class n9 external_node
  n10@{ shape: stadium, label: "**Fire#lt;PreviousAction#gt;**<br/>来自菜单与界面 ↗：向上循环选择可操作按<br/>钮。" }
  class n10 node_event
  class n10 external_node
  n11@{ shape: stadium, label: "**Fire#lt;NextAction#gt;**<br/>来自菜单与界面 ↗：向下循环选择可操作按<br/>钮。" }
  class n11 node_event
  class n11 external_node
  n12@{ shape: stadium, label: "**Fire#lt;LeftAction#gt;**<br/>来自菜单与界面 ↗：向左调整当前聚焦的真<br/>实设置字段。" }
  class n12 node_event
  class n12 external_node
  n13@{ shape: stadium, label: "**Fire#lt;RightAction#gt;**<br/>来自菜单与界面 ↗：向右调整当前聚焦的真<br/>实设置字段。" }
  class n13 node_event
  class n13 external_node
  n14@{ shape: stadium, label: "**Fire#lt;ConfirmAction#gt;**<br/>来自菜单与界面 ↗：通知执行当前聚焦按钮<br/>的菜单动作。" }
  class n14 node_event
  class n14 external_node
  n15@{ shape: stadium, label: "**Fire#lt;BackAction#gt;**<br/>来自菜单与界面 ↗：通知菜单执行返回、暂<br/>停或恢复操作。" }
  class n15 node_event
  class n15 external_node
  n16@{ shape: rounded, label: "**Actions#lt;GameplayContext#gt;**<br/>索引控制上下文拥有的动作实体。" }
  class n16 node_component
  n17@{ shape: rounded, label: "**ActionFns**<br/>将通用动作值适配为具体动作组件。" }
  class n17 node_component
  n18@{ shape: rounded, label: "**ActionValue**<br/>保存动作评估产生的通用输入值。" }
  class n18 node_component
  n19@{ shape: rounded, label: "**TriggerState**<br/>保存本次动作评估的触发状态。" }
  class n19 node_component
  n20@{ shape: rounded, label: "**ActionEvents**<br/>保存本次待派发的动作事件。" }
  class n20 node_component
  n21@{ shape: rounded, label: "**ActionTime**<br/>动作持续与触发计时，由插件评估更新。" }
  class n21 node_component
  n22@{ shape: cyl, label: "**ContextInstances#lt;PreUpdate#gt;**<br/>索引输入框架当前运行的动作上下文。" }
  class n22 node_resource
