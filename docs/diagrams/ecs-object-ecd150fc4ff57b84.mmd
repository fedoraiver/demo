---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: EnhancedInputSystems::Trigger · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**EnhancedInputSystems::Trigger**<br/>按上下文顺序排入动作事件命令。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**ApplyDeferred · 动作事件**<br/>来自菜单与界面 ↗：应用动作事件命令以触<br/>发匹配的观察系统。" }
  class n1 node_sync
  class n1 external_node
  n2@{ shape: lin-rect, label: "**EnhancedInputSystems::Apply**<br/>把评估结果写回强类型动作值。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**Actions#lt;GameplayContext#gt;**<br/>索引控制上下文拥有的动作实体。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**ActionFns**<br/>将通用动作值适配为具体动作组件。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**ActionValue**<br/>保存动作评估产生的通用输入值。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**TriggerState**<br/>保存本次动作评估的触发状态。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**ActionEvents**<br/>保存本次待派发的动作事件。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**ActionTime**<br/>动作持续与触发计时，由插件评估更新。" }
  class n8 node_component
  n9@{ shape: cyl, label: "**ContextInstances#lt;PreUpdate#gt;**<br/>索引输入框架当前运行的动作上下文。" }
  class n9 node_resource
  n0 e0@--> n1
  class e0 edge_order
  n2 e1@--> n0
  class e1 edge_order
  n3 e2@-->|"查询访问"| n0
  class e2 edge_read
  n4 e3@-->|"查询访问"| n0
  class e3 edge_read
  n5 e4@-->|"查询访问"| n0
  class e4 edge_read
  n6 e5@-->|"查询访问"| n0
  class e5 edge_read
  n7 e6@-->|"查询访问"| n0
  class e6 edge_read
  n8 e7@-->|"查询访问"| n0
  class e7 edge_read
  n9 e8@-->|"访问声明"| n0
  class e8 edge_read
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
