---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Time<Physics> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Time#lt;Physics#gt;**<br/>保存可随游戏暂停的物理模拟时间。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**enter_main_menu**<br/>来自应用流程 ↗：保留主菜单展示时间并冻<br/>结物理模拟。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**pause_simulation**<br/>来自应用流程 ↗：冻结游戏与物理时钟并清<br/>零当前增量。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**resume_simulation**<br/>来自应用流程 ↗：恢复游戏与物理时钟。" }
  class n3 node_system
  class n3 external_node
  n1 e0@-->|"访问声明"| n0
  class e0 edge_write
  n2 e1@-->|"访问声明"| n0
  class e1 edge_write
  n3 e2@-->|"访问声明"| n0
  class e2 edge_write
  e0@{ curve: basis }
  e2@{ curve: basis }
