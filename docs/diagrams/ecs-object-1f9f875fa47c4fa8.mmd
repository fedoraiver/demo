---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: 海岛静态碰撞实体 · 对象关系
  accDescr: 中心实体与直接关联的非组件对象；组件清单在右侧查看，保留原关系方向及身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**海岛静态碰撞实体**<br/>为海岛结构、入口坡道与展示人物提供静态碰<br/>撞。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**GLB 网格与骨骼节点**<br/>来自Bevy 引擎 ↗：承载导入模型的网格、<br/>骨骼与局部动画姿态。" }
  class n1 node_entity
  class n1 external_node
  n2@{ shape: rounded, label: "**地图展示 NPC**<br/>保留地图展示人物及其静态身体碰撞。" }
  class n2 node_entity
  n3@{ shape: fr-rect, label: "**SceneAssemblyPlugin**<br/>加载运行资源并装配海岛、碰撞与业务实体。" }
  class n3 node_plugin
  n0 e0@-->|"ChildOf（原地图美术实例）"| n1
  class e0 edge_relationship
  n0 e1@-->|"ChildOf（NPC 身体碰撞）"| n2
  class e1 edge_relationship
  n3 e2@-->|"装配归属"| n0
  class e2 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
