---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 角色动画 · 数据与实体
  accDescr: 角色动画的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n4@{ shape: rect, label: "**业务直属 GLB 视觉根实体**        ​<br/>承载业务实体的模型、骨骼与动画        ​<br/>子树。        ​" }
  class n4 node_entity
  n5@{ shape: rect, label: "**主角 GLB 播放器节点**        ​<br/>承载主角模型的动画播放与混合状        ​<br/>态。        ​" }
  class n5 node_entity
  n6@{ shape: rect, label: "**角色业务根实体**        ​<br/>来自场景装配 ↗：承载角色身        ​<br/>份、运动意图与动态物理身体。        ​" }
  class n6 node_entity
  class n6 external_node
  subgraph n7[" "]
  direction TB
  eh3@{ shape: text, label: "**GLB 网格与骨骼节点**        ​<br/>来自Bevy 引擎 ↗：承载导入模型        ​<br/>的网格、骨骼与局部动画姿态。        ​" }
  n57@{ shape: rect, label: "**Name**<br/>来自Bevy 引擎 ↗：保存用于绑定鞋底节点<br/>的模型名称。" }
  class n57 node_component
  class n57 external_node
  n58@{ shape: rect, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存骨骼或模型节点的<br/>局部动画姿态。" }
  class n58 node_component
  class n58 external_node
  n59@{ shape: rect, label: "**GlobalTransform**<br/>来自Bevy 引擎 ↗：保存层级传播后的世界<br/>姿态。" }
  class n59 node_component
  class n59 external_node
  n60@{ shape: rect, label: "**ChildOf**<br/>来自Bevy 引擎 ↗：关联父实体并跟随父级<br/>生命周期。" }
  class n60 node_component
  class n60 external_node
  n61@{ shape: rect, label: "**Mesh3d**<br/>来自Bevy 引擎 ↗：关联实体使用的三维网<br/>格资产。" }
  class n61 node_component
  class n61 external_node
  n62@{ shape: rect, label: "**MeshMaterial3d**<br/>来自Bevy 引擎 ↗：关联实体使用的三维网<br/>格材质。" }
  class n62 node_component
  class n62 external_node
  eh3 layout_0@~~~ n57
  n57 layout_1@~~~ n58
  n58 layout_2@~~~ n59
  n59 layout_3@~~~ n60
  n60 layout_4@~~~ n61
  n61 layout_5@~~~ n62
  n63@{ shape: rect, label: "**Visibility**<br/>来自Bevy 引擎 ↗：保存模型节点的显隐状<br/>态。" }
  class n63 node_component
  class n63 external_node
  n64@{ shape: rect, label: "**GltfExtras**<br/>来自Bevy 引擎 ↗：保存模型节点附带的美<br/>术元数据。" }
  class n64 node_component
  class n64 external_node
  n65@{ shape: rect, label: "**SkinnedMesh**<br/>来自Bevy 引擎 ↗：保存网格与骨骼的蒙皮<br/>关联。" }
  class n65 node_component
  class n65 external_node
  n66@{ shape: rect, label: "**AnimationTargetId**<br/>来自Bevy 引擎 ↗：标识需要接收动画曲线<br/>的模型节点。" }
  class n66 node_component
  class n66 external_node
  n67@{ shape: rect, label: "**AnimatedBy**<br/>来自Bevy 引擎 ↗：关联负责采样当前节点<br/>动画的播放器。" }
  class n67 node_component
  class n67 external_node
  eh3 layout_6@~~~ n63
  n63 layout_7@~~~ n64
  n64 layout_8@~~~ n65
  n65 layout_9@~~~ n66
  n66 layout_10@~~~ n67
  end
  class n7 node_entity
  class n7 external_node
  style n7 fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340,stroke-dasharray:6 4
  n5 e0@-->|"CourierAnimation.character"| n6
  class e0 edge_reference
  n4 e1@-->|"CourierFootGrounding.character"| n6
  class e1 edge_reference
  n4 e2@-->|"CourierFootGrounding.animation_<br/>player"| n5
  class e2 edge_reference
  n4 e3@-->|"CourierFootGrounding.sole_markers"| n7
  class e3 edge_reference
  n7 e4@-->|"AnimatedBy"| n5
  class e4 edge_reference
  end
  style relation_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: basis }
  e4@{ curve: basis }
