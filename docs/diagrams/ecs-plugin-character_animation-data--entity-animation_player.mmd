---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 角色动画 · 数据与实体
  accDescr: 角色动画的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  subgraph n5[" "]
  direction TB
  eh2@{ shape: text, label: "**主角 GLB 播放器节点**        ​<br/>承载主角模型的动画播放与混合状        ​<br/>态。        ​" }
  n3@{ shape: rect, label: "**CourierAnimation**<br/>保存角色动画混合权重、步相位与跳跃阶段。" }
  class n3 node_component
  n54@{ shape: rect, label: "**AnimationPlayer**<br/>来自Bevy 引擎 ↗：驱动模型的动画播放。" }
  class n54 node_component
  class n54 external_node
  n55@{ shape: rect, label: "**AnimationGraphHandle**<br/>来自Bevy 引擎 ↗：本次绑定生成的命名动<br/>作图。" }
  class n55 node_component
  class n55 external_node
  n56@{ shape: rect, label: "**ChildOf**<br/>来自Bevy 引擎 ↗：关联父实体并跟随父级<br/>生命周期。" }
  class n56 node_component
  class n56 external_node
  eh2 layout_0@~~~ n3
  n3 layout_1@~~~ n54
  n54 layout_2@~~~ n55
  n55 layout_3@~~~ n56
  end
  class n5 node_entity
  style n5 fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  n4@{ shape: rect, label: "**业务直属 GLB 视觉根实体**        ​<br/>承载业务实体的模型、骨骼与动画        ​<br/>子树。        ​" }
  class n4 node_entity
  n6@{ shape: rect, label: "**角色业务根实体**        ​<br/>来自场景装配 ↗：承载角色身        ​<br/>份、运动意图与动态物理身体。        ​" }
  class n6 node_entity
  class n6 external_node
  n7@{ shape: rect, label: "**GLB 网格与骨骼节点**        ​<br/>来自Bevy 引擎 ↗：承载导入模型        ​<br/>的网格、骨骼与局部动画姿态。        ​" }
  class n7 node_entity
  class n7 external_node
  n5 e0@-->|"CourierAnimation.character"| n6
  class e0 edge_reference
  n4 e1@-->|"CourierFootGrounding.character"| n6
  class e1 edge_reference
  n4 e2@-->|"CourierFootGrounding.animation_<br/>player"| n5
  class e2 edge_reference
  n4 e3@-->|"CourierFootGrounding.sole_markers"| n7
  class e3 edge_reference
  n7 e4@-->|"AnimatedBy"| n5
  class e4 edge_reference
  end
  style relation_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
