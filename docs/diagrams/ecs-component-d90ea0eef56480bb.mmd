---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-d90ea0eef56480bb-e2{marker-start:url(#component-d90ea0eef56480bb_flowchart-v2-pointStart)!important}\n#component-d90ea0eef56480bb-e3{marker-start:url(#component-d90ea0eef56480bb_flowchart-v2-pointStart)!important}\n#component-d90ea0eef56480bb-e4{marker-start:url(#component-d90ea0eef56480bb_flowchart-v2-pointStart)!important}\n#component-d90ea0eef56480bb-e5{marker-start:url(#component-d90ea0eef56480bb_flowchart-v2-pointStart)!important}\n#component-d90ea0eef56480bb-e6{marker-start:url(#component-d90ea0eef56480bb_flowchart-v2-pointStart)!important}\n#component-d90ea0eef56480bb_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: ComputedNode · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**可操作菜单按钮**<br/>来自菜单与界面 ↗：承载可操作菜单动作、<br/>设置调整与连续导航。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**设置面板内容视口**<br/>来自菜单与界面 ↗：为设置标题、字段、说<br/>明与提示提供滚动视口。" }
  class n1 node_entity
  class n1 external_node
  n2@{ shape: rounded, label: "**ComputedNode**<br/>原生布局后的按钮几何，用于焦点滚入。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**scroll_focused_button**<br/>来自菜单与界面 ↗：将当前聚焦设置按钮滚<br/>入可视范围。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: hex, label: "**scroll_menu**<br/>来自菜单与界面 ↗：滚动设置内容并限制在<br/>有效范围内。" }
  class n4 node_observer
  class n4 external_node
  n5@{ shape: rounded, label: "**sample_slider_pointer**<br/>来自菜单与界面 ↗：从光标位置生成音量采<br/>样与释放请求。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**sync_settings_scrollbars**<br/>来自菜单与界面 ↗：同步滚动条显隐、拾取<br/>范围与高亮。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: hex, label: "**scroll_over_settings_scrollbar**<br/>来自菜单与界面 ↗：通过滚动条上的滚轮操<br/>作滚动内容视口。" }
  class n7 node_observer
  class n7 external_node
  n2 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n2
  n4 layout_3@~~~ n2
  n5 layout_4@~~~ n2
  n6 layout_5@~~~ n2
  n7 layout_6@~~~ n2
  n2 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n2 e1@-->|"可能挂载于"| n1
  class e1 edge_reference
  n3 e2@---|"查询访问"| n2
  class e2 edge_read
  n4 e3@---|"查询访问"| n2
  class e3 edge_read
  n5 e4@---|"查询访问"| n2
  class e4 edge_read
  n6 e5@---|"查询访问"| n2
  class e5 edge_read
  n7 e6@---|"查询访问"| n2
  class e6 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
