  class n29 node_observer
  n31@{ shape: hex, label: "**scrollbar_pointer_source**<br/>将滚动条按下操作标为鼠标输入。" }
  class n31 node_observer
  n32@{ shape: rounded, label: "**handle_requests**<br/>处理菜单导航、设置应用与音量编辑请求。" }
