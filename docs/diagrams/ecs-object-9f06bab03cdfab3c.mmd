  class e9 edge_read
  n10 e10@-->|"访问声明"| n0
  class e10 edge_read
  n8 e11@---|"访问声明"| n0
  class e11 edge_write
  n9 e12@---|"访问声明"| n0
  class e12 edge_write
  n11 e13@--> n0
  class e13 edge_registration
  n12 e14@-->|"AudioSystems::Playback"| n0
  class e14 edge_set_membership
