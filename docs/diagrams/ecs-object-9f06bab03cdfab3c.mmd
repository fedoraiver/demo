---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-9f06bab03cdfab3c-e4{marker-start:url(#object-9f06bab03cdfab3c_flowchart-v2-pointStart)!important}\n#object-9f06bab03cdfab3c-e11{marker-start:url(#object-9f06bab03cdfab3c_flowchart-v2-pointStart)!important}\n#object-9f06bab03cdfab3c-e12{marker-start:url(#object-9f06bab03cdfab3c_flowchart-v2-pointStart)!important}\n#object-9f06bab03cdfab3c_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: play_requests · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**play_requests**<br/>按有效音量与播放策略处理短音请求。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**sync_voice_volumes**<br/>将有效混音与素材音量同步到播放实例。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**stop_on_exit**<br/>停止音频通道并记录退出。" }
  class n2 node_system
  n3@{ shape: cyl, label: "**Messages#lt;SoundRequest#gt;**<br/>缓冲菜单交互与物品反馈的短音请求。" }
  class n3 node_message_buffer
  n4@{ shape: cyl, label: "**SoundBank**<br/>保存短音资源、播放策略与实例生命周期。" }
  class n4 node_resource
  n5@{ shape: stadium, label: "**Kira UI / SFX 输出流程**<br/>来自Kira ↗：接收播放与停止命令并输出界<br/>面和物品短音。" }
  class n5 node_engine_flow
  class n5 external_node
  n6@{ shape: cyl, label: "**Time#lt;Real#gt;**<br/>来自Bevy 引擎 ↗：提供不随游戏暂停的真<br/>实时间。" }
  class n6 node_resource
  class n6 external_node
  n7@{ shape: cyl, label: "**Assets#lt;AudioSource#gt;**<br/>来自Kira ↗：保存已加载的短音资产。" }
  class n7 node_resource
  class n7 external_node
  n8@{ shape: cyl, label: "**AudioChannel#lt;UiTrack#gt;**<br/>承载界面短音的播放命令。" }
  class n8 node_resource
  n9@{ shape: cyl, label: "**AudioChannel#lt;SfxTrack#gt;**<br/>承载物品等音效短音的播放命令。" }
  class n9 node_resource
  n10@{ shape: cyl, label: "**AudioMix**<br/>保存界面与音效通道当前采用的有效音量。" }
  class n10 node_resource
  n11@{ shape: fr-rect, label: "**GameAudioPlugin**<br/>管理短音预加载、混音、播放与设备输出。" }
  class n11 node_plugin
  n12@{ shape: lin-rect, label: "**AudioSystems**<br/>公开音量混合与播放的调度阶段。" }
  class n12 node_system_set
  n1 e0@--> n0
  class e0 edge_order
  n0 e1@--> n2
  class e1 edge_order
  n3 e2@--> n0
  class e2 edge_consume
  n4 e3@-->|"策略"| n0
  class e3 edge_read
  n4 e4@---|"实例"| n0
  class e4 edge_write
  n0 e5@-->|"排队播放"| n5
  class e5 edge_write
  n6 e6@-->|"访问声明"| n0
  class e6 edge_read
  n7 e7@-->|"访问声明"| n0
  class e7 edge_read
  n8 e8@-->|"访问声明"| n0
  class e8 edge_read
