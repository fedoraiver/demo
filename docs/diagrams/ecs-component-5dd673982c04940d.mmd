---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-5dd673982c04940d-e3{marker-start:url(#component-5dd673982c04940d_flowchart-v2-pointStart)!important}\n#component-5dd673982c04940d-e4{marker-start:url(#component-5dd673982c04940d_flowchart-v2-pointStart)!important}\n#component-5dd673982c04940d_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: PrimaryEguiContext · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**第一人称相机实体**<br/>来自场景装配 ↗：提供跟随角色的第一人称<br/>视角与观察输入状态。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**主菜单展示相机**<br/>来自菜单与界面 ↗：为主菜单展示场景与界<br/>面提供相机。" }
  class n1 node_entity
  class n1 external_node
  n2@{ shape: rounded, label: "**PrimaryEguiContext**<br/>指定主检查器界面的相机上下文。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**spawn_lighting**<br/>来自场景装配 ↗：为游戏会话创建日光与加<br/>载相机。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**sync_mouse_capture**<br/>来自第一人称控制 ↗：管理光标捕获及玩法<br/>输入启停。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**filter_captured_egui_input**<br/>来自第一人称控制 ↗：隔离游戏操作与检查<br/>器界面输入。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**spawn_backdrop**<br/>来自菜单与界面 ↗：装配主菜单海岛展示舞<br/>台、相机与日光。" }
  class n6 node_system
  class n6 external_node
  n2 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n2
  n4 layout_3@~~~ n2
  n5 layout_4@~~~ n2
  n6 layout_5@~~~ n2
  n3 e2@-->|"添加"| n2
  class e2 edge_write
  n6 e5@-->|"添加"| n2
  class e5 edge_write
  n2 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n2 e1@-->|"可能挂载于"| n1
  class e1 edge_reference
  n4 e3@---|"存在 / 变更过滤"| n2
  class e3 edge_reference
  n5 e4@---|"存在 / 变更过滤"| n2
  class e4 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
