---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-22086d43382eb6a9-e6{marker-start:url(#component-22086d43382eb6a9_flowchart-v2-pointStart)!important}\n#component-22086d43382eb6a9_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: GlobalTransform · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_contract fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**可搬物品业务根实体**<br/>来自场景装配 ↗：承载可拾取物品身份及自<br/>由运动、共享持握状态。" }
  class n1 node_entity
  class n1 external_node
  n2@{ shape: rounded, label: "**第一人称相机实体**<br/>来自场景装配 ↗：提供跟随角色的第一人称<br/>视角与观察输入状态。" }
  class n2 node_entity
  class n2 external_node
  n3@{ shape: rounded, label: "**业务直属 GLB 视觉根实体**<br/>来自场景装配 ↗：承载业务实体的模型、骨<br/>骼与动画子树。" }
  class n3 node_entity
  class n3 external_node
  n4@{ shape: rounded, label: "**GLB 网格与骨骼节点**<br/>承载导入模型的网格、骨骼与局部动画姿态。" }
  class n4 node_entity
  n5@{ shape: rounded, label: "**GlobalTransform**<br/>保存层级传播后的世界姿态。" }
  class n5 node_component
  n6@{ shape: lin-rect, label: "**TransformSystems::Propagate**<br/>沿实体层级传播世界变换。" }
  class n6 node_contract
  n7@{ shape: lin-rect, label: "**RenderApp / 渲染流程**<br/>提取场景数据并执行本帧渲染。" }
  class n7 node_contract
  n5 layout_0@~~~ n0
  n5 layout_1@~~~ n1
  n5 layout_2@~~~ n2
  n5 layout_3@~~~ n3
  n5 layout_4@~~~ n4
  n6 layout_5@~~~ n5
  n7 layout_6@~~~ n5
  n6 e5@-->|"/ 结构变更（待核实）"| n5
  class e5 edge_write
  n5 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n5 e1@-->|"可能挂载于"| n1
  class e1 edge_reference
  n5 e2@-->|"可能挂载于"| n2
  class e2 edge_reference
  n5 e3@-->|"可能挂载于"| n3
  class e3 edge_reference
  n5 e4@-->|"可能挂载于"| n4
  class e4 edge_reference
  n7 e6@---|"查询访问"| n5
  class e6 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
