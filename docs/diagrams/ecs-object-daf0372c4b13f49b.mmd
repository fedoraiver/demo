  n2@{ shape: cyl, label: "**SettingsDraft**<br/>来自设置与参数 ↗：保存待应用的设置草稿<br/>与临时音量编辑。" }
  class n2 node_resource
  class n2 external_node
  n3@{ shape: rounded, label: "**Text**<br/>来自Bevy 引擎 ↗：保存界面实际显示的文<br/>字。" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: rounded, label: "**SettingValue**<br/>标识草稿值文字，原位更新。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**SettingsStatus**<br/>标识保存提示文字，原位更新。" }
