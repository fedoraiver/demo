---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-88c2bc5b9b83de97-e1{marker-start:url(#component-88c2bc5b9b83de97_flowchart-v2-pointStart)!important}\n#component-88c2bc5b9b83de97_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: MenuRoot · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**BSN 菜单页面根**<br/>承载当前菜单页面及其声明式控件层级。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**MenuRoot**<br/>标记菜单页面以统一清理其界面。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**rebuild_page**<br/>按页面结构变化重建菜单界面。" }
  class n2 node_system
  n1 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n2 e2@-->|"添加"| n1
  class e2 edge_write
  n1 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n2 e1@---|"存在 / 变更过滤"| n1
  class e1 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
