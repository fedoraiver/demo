---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: AnimationSystems · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**AnimationSystems**<br/>采样动画图并更新骨骼局部姿态。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**compensate_courier_sole_penetration**<br/>来自角色动画 ↗：补偿鞋底穿地并平滑恢复<br/>视觉高度。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**AnimationPlayer**<br/>驱动模型的动画播放。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**AnimationGraphHandle**<br/>本次绑定生成的命名动作图。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**AnimationTargetId**<br/>标识需要接收动画曲线的模型节点。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**AnimatedBy**<br/>关联负责采样当前节点动画的播放器。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Transform**<br/>保存骨骼或模型节点的局部动画姿态。" }
  class n6 node_component
  n7@{ shape: cyl, label: "**Assets#lt;AnimationGraph#gt;**<br/>保存模型使用的动画混合图。" }
  class n7 node_resource
  n8@{ shape: cyl, label: "**Assets#lt;AnimationClip#gt;**<br/>保存主角与展示模型使用的动画片段。" }
  class n8 node_resource
  n0 e0@-->|"AnimationSystems"| n1
  class e0 edge_order
  n2 e1@-->|"查询访问"| n0
  class e1 edge_read
  n3 e2@-->|"查询访问"| n0
  class e2 edge_read
  n4 e3@-->|"查询访问"| n0
  class e3 edge_read
  n5 e4@-->|"查询访问"| n0
  class e4 edge_read
  n0 e5@-->|"可变访问"| n6
  class e5 edge_write
  n7 e6@-->|"访问声明"| n0
  class e6 edge_read
  n8 e7@-->|"访问声明"| n0
  class e7 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
