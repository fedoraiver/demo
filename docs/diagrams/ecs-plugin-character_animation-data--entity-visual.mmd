---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 角色动画 · 数据与实体
  accDescr: 角色动画的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  subgraph n4[" "]
  direction TB
  eh1@{ shape: text, label: "**业务直属 GLB 视觉根实体**        ​<br/>承载业务实体的模型、骨骼与动画        ​<br/>子树。        ​" }
  n46@{ shape: rect, label: "**Name**<br/>来自Bevy 引擎 ↗：各视觉部分的调试名<br/>称。" }
  class n46 node_component
  class n46 external_node
  n47@{ shape: rect, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存模型相对业务根的<br/>局部显示姿态。" }
  class n47 node_component
  class n47 external_node
  n48@{ shape: rect, label: "**GlobalTransform**<br/>来自Bevy 引擎 ↗：保存层级传播后的世界<br/>姿态。" }
  class n48 node_component
  class n48 external_node
  n49@{ shape: rect, label: "**ChildOf**<br/>来自Bevy 引擎 ↗：关联父实体并跟随父级<br/>生命周期。" }
  class n49 node_component
  class n49 external_node
  n50@{ shape: rect, label: "**Visibility**<br/>来自Bevy 引擎 ↗：控制实体及视觉子树的<br/>显示状态。" }
  class n50 node_component
  class n50 external_node
  n51@{ shape: rect, label: "**CharacterVisual**<br/>来自第一人称控制 ↗：标记随第一人称视角<br/>隐藏的角色模型。" }
  class n51 node_component
  class n51 external_node
  eh1 layout_0@~~~ n46
  n46 layout_1@~~~ n47
  n47 layout_2@~~~ n48
  n48 layout_3@~~~ n49
  n49 layout_4@~~~ n50
  n50 layout_5@~~~ n51
  n0@{ shape: rect, label: "**CourierVisual**<br/>保存主角模型来源并作为动画绑定入口。" }
  class n0 node_component
  n1@{ shape: rect, label: "**CourierAnimationPending**<br/>实例就绪后等待命名动画绑定。" }
  class n1 node_component
  n2@{ shape: rect, label: "**CourierFootGrounding**<br/>保存鞋底高度补偿与骨链引用。" }
  class n2 node_component
  n52@{ shape: rect, label: "**WorldAssetRoot**<br/>来自Bevy 引擎 ↗：主角和物品模板的实例<br/>化入口。" }
  class n52 node_component
  class n52 external_node
  n53@{ shape: rect, label: "**Children**<br/>来自Bevy 引擎 ↗：索引当前实体的直接子<br/>实体。" }
  class n53 node_component
  class n53 external_node
  eh1 layout_6@~~~ n0
  n0 layout_7@~~~ n1
  n1 layout_8@~~~ n2
  n2 layout_9@~~~ n52
  n52 layout_10@~~~ n53
  end
  class n4 node_entity
  style n4 fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  n5@{ shape: rect, label: "**主角 GLB 播放器节点**        ​<br/>承载主角模型的动画播放与混合状        ​<br/>态。        ​" }
  class n5 node_entity
  n6@{ shape: rect, label: "**角色业务根实体**        ​<br/>来自场景装配 ↗：承载角色身        ​<br/>份、运动意图与动态物理身体。        ​" }
  class n6 node_entity
  class n6 external_node
  n7@{ shape: rect, label: "**GLB 网格与骨骼节点**        ​<br/>来自Bevy 引擎 ↗：承载导入模型        ​<br/>的网格、骨骼与局部动画姿态。        ​" }
  class n7 node_entity
  class n7 external_node
  n5 e0@-->|"CourierAnimation.character"| n6
  class e0 edge_reference
  n4 e1@-->|"CourierFootGrounding.character"| n6
  class e1 edge_reference
  n4 e2@-->|"CourierFootGrounding.animation_<br/>player"| n5
  class e2 edge_reference
  n4 e3@-->|"CourierFootGrounding.sole_markers"| n7
  class e3 edge_reference
  n7 e4@-->|"AnimatedBy"| n5
  class e4 edge_reference
  end
  style relation_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
