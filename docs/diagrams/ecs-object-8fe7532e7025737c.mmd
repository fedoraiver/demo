---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: SessionLogPlugin · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_app fill:#EFF4F5,stroke:#3A7B87,stroke-width:2.2px,color:#1F3340
  classDef node_external_io fill:#F1F3F4,stroke:#526A78,stroke-width:1.6px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: fr-rect, label: "**SessionLogPlugin**<br/>安装统一会话日志并管理后台输出与退出刷<br/>新。" }
  class n0 node_plugin
  n1@{ shape: fr-rect, label: "**main / App**<br/>来自Bevy 引擎 ↗：装配应用、设置与插件<br/>并管理主循环和退出。" }
  class n1 node_app
  class n1 external_node
  n2@{ shape: fr-rect, label: "**LogPlugin**<br/>来自Bevy 引擎 ↗：安装统一日志订阅与输<br/>出基础设施。" }
  class n2 node_plugin
  class n2 external_node
  n3@{ shape: lean-l, label: "**tracing producer**<br/>格式化日志并交给独立文件与控制台队列。" }
  class n3 node_external_io
  n4@{ shape: cyl, label: "**SessionWriter**<br/>把文件日志写入器暂存到 App，随后交给文<br/>件日志 layer。" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**ConsoleWriter**<br/>把控制台写入器暂存到 App，随后交给控制<br/>台日志 layer。" }
  class n5 node_resource
  n1 e0@-->|"日志"| n0
  class e0 edge_registration
  n0 e1@-->|"LogPlugin"| n2
  class e1 edge_registration
  n0 e2@-->|"格式层与后台输出"| n3
  class e2 edge_registration
  n0 e3@-->|"构建期暂存写入器"| n4
  class e3 edge_registration
  n0 e4@-->|"构建期暂存写入器"| n5
  class e4 edge_registration
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
