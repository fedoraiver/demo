---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: RemoveEvent · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**RemoveEvent**<br/>通知 GameplayContext 的动作关系正在移<br/>除。" }
  class n0 node_event
  n1@{ shape: stadium, label: "**组件移除与实体销毁流程**<br/>在实际移除或销毁时发出匹配的生命周期事<br/>件。" }
  class n1 node_engine_flow
  n2@{ shape: hex, label: "**reset_action#lt;GameplayContext#gt;**<br/>来自Enhanced Input ↗：动作移除时清零<br/>并派发条件性的结束事件。" }
  class n2 node_observer
  class n2 external_node
  n1 e0@-->|"Remove#lt;ActionOf#lt;GameplayContext#gt;#gt; 生<br/>命周期"| n0
  class e0 edge_emit
  n0 e1@-->|"Remove#lt;ActionOf#lt;GameplayContext#gt;#gt;"| n2
  class e1 edge_observe
