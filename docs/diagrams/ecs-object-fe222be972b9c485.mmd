---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: ItemInteractionPlugin · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_app fill:#EFF4F5,stroke:#3A7B87,stroke-width:2.2px,color:#1F3340
  classDef node_registration_helper fill:#F6F4F0,stroke:#8A7548,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: fr-rect, label: "**ItemInteractionPlugin**<br/>管理物品拾取、共享持握、安全释放与反馈。" }
  class n0 node_plugin
  n1@{ shape: tag-rect, label: "**物品反馈收集**<br/>收集持握失稳与物品落地的声音反馈。" }
  class n1 node_registration_helper
  n2@{ shape: fr-rect, label: "**main / App**<br/>来自Bevy 引擎 ↗：装配应用、设置与插件<br/>并管理主循环和退出。" }
  class n2 node_app
  class n2 external_node
  n3@{ shape: rounded, label: "**持物无视觉碰撞代理**<br/>为持物共享人物刚体提供无视觉碰撞形状。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**handle_interaction**<br/>处理物品拾取、共享持握与主动释放。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**sync_held_presentation**<br/>按人物呈现姿态同步持物模型与握持目标。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**sync_held_presentation**<br/>按人物呈现姿态同步持物模型与握持目标。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**release_orphaned_items**<br/>清理失效持握并恢复物品独立运动。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**ApplyDeferred（清理 / 装卸依赖）**<br/>来自Bevy 引擎 ↗：使持物清理与刚体装卸<br/>变更对后续同步可见。" }
  class n8 node_sync
  class n8 external_node
  n9@{ shape: rounded, label: "**warn_hold_strain**<br/>检查持续持握偏差并发出失稳提示音。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**emit_parcel_land**<br/>识别自由物品落地并发出声音请求。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**cleanup_orphaned_colliders**<br/>清理物品销毁后残留的碰撞代理。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**restore_empty_holder_mass**<br/>归还不再持物角色的原有质量。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**finish_attachments**<br/>为持物装配共享碰撞代理并累计质量。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**align_attachments**<br/>沿安全碰撞路径将物品对齐双手。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**sync_held_physics**<br/>按人物物理姿态同步持物位置与碰撞代理。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**sync_held_physics**<br/>按最新物理位姿同步持物与碰撞代理。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**sync_held_physics**<br/>同步本帧持物碰撞朝向与显示朝向。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**resume_carry_easing**<br/>恢复物品释放前未暂停的插值通道。" }
  class n18 node_system
  n19@{ shape: hex, label: "**prepare_holder_despawn**<br/>在持有者销毁前停用并卸载持物代理。" }
  class n19 node_observer
