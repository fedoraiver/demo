---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart RL
  accTitle: Node · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**BSN 菜单页面根**<br/>来自菜单与界面 ↗：承载当前菜单页面及其<br/>声明式控件层级。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**可操作菜单按钮**<br/>来自菜单与界面 ↗：承载可操作菜单动作、<br/>设置调整与连续导航。" }
  class n1 node_entity
  class n1 external_node
  n2@{ shape: rounded, label: "**设置面板内容视口**<br/>来自菜单与界面 ↗：为设置标题、字段、说<br/>明与提示提供滚动视口。" }
  class n2 node_entity
  class n2 external_node
  n3@{ shape: rounded, label: "**菜单文字叶节点**<br/>来自菜单与界面 ↗：显示菜单标题、按钮、<br/>按键提示与正文。" }
  class n3 node_entity
  class n3 external_node
  n4@{ shape: rounded, label: "**音量轨道填充**<br/>来自菜单与界面 ↗：显示当前音量对应的轨<br/>道填充。" }
  class n4 node_entity
  class n4 external_node
  n5@{ shape: rounded, label: "**设置右侧纸色面板**<br/>来自菜单与界面 ↗：限定设置内容的显示与<br/>裁切范围。" }
  class n5 node_entity
  class n5 external_node
  n6@{ shape: rounded, label: "**Node**<br/>保存界面节点的布局约束。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**rebuild_page**<br/>来自菜单与界面 ↗：按页面结构变化重建菜<br/>单界面。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**update_volume_visuals**<br/>来自菜单与界面 ↗：原位更新音量百分比文<br/>字与轨道填充。" }
  class n8 node_system
  class n8 external_node
  n6 layout_0@~~~ n0
  n6 layout_1@~~~ n1
  n6 layout_2@~~~ n2
  n6 layout_3@~~~ n3
  n6 layout_4@~~~ n4
  n6 layout_5@~~~ n5
  n7 layout_6@~~~ n6
  n8 layout_7@~~~ n6
  n7 e6@-->|"添加"| n6
  class e6 edge_write
  n8 e7@-->|"字段赋值"| n6
  class e7 edge_write
  n6 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n6 e1@-->|"可能挂载于"| n1
  class e1 edge_reference
  n6 e2@-->|"可能挂载于"| n2
  class e2 edge_reference
  n6 e3@-->|"可能挂载于"| n3
  class e3 edge_reference
  n6 e4@-->|"可能挂载于"| n4
  class e4 edge_reference
  n6 e5@-->|"可能挂载于"| n5
  class e5 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
