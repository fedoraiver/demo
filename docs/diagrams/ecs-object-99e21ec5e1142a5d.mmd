---
flowchart LR
  accTitle: PhysicsSystems::Writeback · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**PhysicsSystems::Writeback**<br/>将求解后的物理位姿写回显示变换。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**PhysicsSystems::StepSimulation**<br/>执行碰撞求解、重力积分与刚体运动。" }
  class n1 node_system_set
  n2@{ shape: rounded, label: "**update_grounded**<br/>来自角色运动 ↗：物理回写之后观察实际接<br/>地状态。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：按最新物理位姿同步持物<br/>与碰撞代理。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**Position**<br/>保存物理模拟中的真实位置。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**Rotation**<br/>保存物理模拟中的真实旋转。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Position**<br/>保存物理模拟中的真实位置。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**Rotation**<br/>保存物理模拟中的真实旋转。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存自由运动或共享持<br/>握时的显示姿态。" }
  class n9 node_component
  class n9 external_node
  n1 e0@--> n0
  class e0 edge_order
  n0 e1@--> n2
  class e1 edge_order
  n0 e2@-->|"Writeback"| n3
  class e2 edge_order
  n4 e3@-->|"查询访问"| n0
  class e3 edge_read
  n5 e4@-->|"查询访问"| n0
  class e4 edge_read
  n6 e5@-->|"查询访问"| n0
  class e5 edge_read
  n7 e6@-->|"查询访问"| n0
  class e6 edge_read
  n0 e7@-->|"可变访问"| n8
  class e7 edge_write
  n0 e8@-->|"可变访问"| n9
  class e8 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
