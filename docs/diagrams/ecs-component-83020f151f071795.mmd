---
flowchart RL
  accTitle: CourierAnimation · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**主角 GLB 播放器节点**<br/>来自Bevy 引擎 ↗：承载主角模型的动画播<br/>放与混合状态。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**CourierAnimation**<br/>保存角色动画混合权重、步相位与跳跃阶段。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**initialize_ready_couriers**<br/>绑定主角命名动画并缓存鞋底补偿节点。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**sync_courier_animation**<br/>按角色运动状态连续混合移动与跳跃动画。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**compensate_courier_sole_penetration**<br/>补偿鞋底穿地并平滑恢复视觉高度。" }
  class n4 node_system
  n1 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n1
  n4 layout_3@~~~ n1
  n2 e1@-->|"添加"| n1
  class e1 edge_write
  n3 e2@-->|"字段赋值"| n1
  class e2 edge_write
  n3 e3@-->|"移除"| n1
  class e3 edge_write
  n1 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n3 e4@---|"查询访问"| n1
  class e4 edge_read
  n4 e5@---|"查询访问"| n1
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
