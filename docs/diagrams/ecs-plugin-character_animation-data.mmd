---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 角色动画 · 数据与实体
  accDescr: 角色动画的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n0@{ shape: rounded, label: "**业务直属 GLB 视觉根实体**<br/>承载业务实体的模型、骨骼与动画子树。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**主角 GLB 播放器节点**<br/>承载主角模型的动画播放与混合状态。" }
  class n1 node_entity
  n2@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n2 node_entity
  class n2 external_node
  n3@{ shape: rounded, label: "**GLB 网格与骨骼节点**<br/>来自Bevy 引擎 ↗：承载导入模型的网格、<br/>骨骼与局部动画姿态。" }
  class n3 node_entity
  class n3 external_node
  n1 e0@-->|"CourierAnimation.character"| n2
  class e0 edge_reference
  n0 e1@-->|"CourierFootGrounding.character"| n2
  class e1 edge_reference
  n0 e2@-->|"CourierFootGrounding.animation_<br/>player"| n1
  class e2 edge_reference
  n0 e3@-->|"CourierFootGrounding.sole_markers"| n3
  class e3 edge_reference
  n3 e4@-->|"AnimatedBy"| n1
  class e4 edge_reference
  end
  style relation_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
