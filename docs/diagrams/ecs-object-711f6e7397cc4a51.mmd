---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-711f6e7397cc4a51-e4{marker-start:url(#object-711f6e7397cc4a51_flowchart-v2-pointStart)!important}\n#object-711f6e7397cc4a51_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: MenuButton · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**MenuButton**<br/>保存菜单动作及按钮的导航序号。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**可操作菜单按钮**<br/>承载可操作菜单动作、设置调整与连续导航。" }
  class n1 node_entity
  n2@{ shape: hex, label: "**primary_press**<br/>记录菜单按钮主键按压的指针身份。" }
  class n2 node_observer
  n3@{ shape: rounded, label: "**pointer_interaction**<br/>将真实鼠标交互转换为共享菜单请求。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**rebuild_page**<br/>按页面结构变化重建菜单界面。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**style_buttons**<br/>按当前输入来源更新按钮背景与焦点边框。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_description**<br/>更新当前聚焦设置的说明标题与正文。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**scroll_focused_button**<br/>将当前聚焦设置按钮滚入可视范围。" }
  class n7 node_system
  n8@{ shape: hex, label: "**previous**<br/>循环选择上一个可操作菜单按钮。" }
  class n8 node_observer
  n9@{ shape: hex, label: "**next**<br/>循环选择下一个可操作菜单按钮。" }
  class n9 node_observer
  n10@{ shape: hex, label: "**left**<br/>向左调整当前聚焦的真实设置字段。" }
  class n10 node_observer
  n11@{ shape: hex, label: "**right**<br/>向右调整当前聚焦的真实设置字段。" }
  class n11 node_observer
  n12@{ shape: hex, label: "**confirm**<br/>执行当前聚焦按钮的菜单动作。" }
  class n12 node_observer
  n13@{ shape: rounded, label: "**sample_slider_pointer**<br/>从光标位置生成音量采样与释放请求。" }
  class n13 node_system
  n0 e0@-->|"可能挂载于"| n1
  class e0 edge_reference
  n0 e1@-->|"存在 / 变更过滤"| n2
  class e1 edge_reference
  n0 e2@-->|"查询访问"| n3
  class e2 edge_read
  n4 e3@-->|"添加"| n0
  class e3 edge_write
  n4 e4@---|"查询访问"| n0
  class e4 edge_read
  n0 e5@-->|"查询访问"| n5
  class e5 edge_read
  n0 e6@-->|"查询访问"| n6
  class e6 edge_read
  n0 e7@-->|"查询访问"| n7
  class e7 edge_read
  n0 e8@-->|"查询访问"| n8
  class e8 edge_read
  n0 e9@-->|"查询访问"| n9
  class e9 edge_read
  n0 e10@-->|"查询访问"| n10
  class e10 edge_read
  n0 e11@-->|"查询访问"| n11
  class e11 edge_read
  n0 e12@-->|"查询访问"| n12
  class e12 edge_read
  n0 e13@-->|"查询访问"| n13
  class e13 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
