---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: enter_main_menu · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**enter_main_menu**<br/>保留主菜单展示时间并冻结物理模拟。" }
  class n0 node_system
  n1@{ shape: cyl, label: "**Time#lt;Virtual#gt;**<br/>来自Bevy 引擎 ↗：提供可暂停的游戏时<br/>间，作为固定步时间来源。" }
  class n1 node_resource
  class n1 external_node
  n2@{ shape: cyl, label: "**Time#lt;Physics#gt;**<br/>来自Avian ↗：保存可随游戏暂停的物理模<br/>拟时间。" }
  class n2 node_resource
  class n2 external_node
  n3@{ shape: fr-rect, label: "**GameFlowPlugin**<br/>管理应用状态、时钟及跨功能阶段顺序。" }
  class n3 node_plugin
  n0 e0@-->|"访问声明"| n1
  class e0 edge_write
  n0 e1@-->|"访问声明"| n2
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
