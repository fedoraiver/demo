---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: SceneAssemblyPlugin · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_app fill:#EFF4F5,stroke:#3A7B87,stroke-width:2.2px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: fr-rect, label: "**SceneAssemblyPlugin**<br/>加载运行资源并装配海岛、碰撞与业务实体。" }
  class n0 node_plugin
  n1@{ shape: fr-rect, label: "**main / App**<br/>来自Bevy 引擎 ↗：装配应用、设置与插件<br/>并管理主循环和退出。" }
  class n1 node_app
  class n1 external_node
  n2@{ shape: rounded, label: "**键盘控制者**<br/>保存玩家身份、输入上下文与受控角色及相<br/>机。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**角色业务根实体**<br/>承载角色身份、运动意图与动态物理身体。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**可搬物品业务根实体**<br/>承载可拾取物品身份及自由运动、共享持握状<br/>态。" }
  class n4 node_entity
  n5@{ shape: rounded, label: "**第一人称相机实体**<br/>提供跟随角色的第一人称视角与观察输入状<br/>态。" }
  class n5 node_entity
  n6@{ shape: rounded, label: "**业务直属 GLB 视觉根实体**<br/>承载业务实体的模型、骨骼与动画子树。" }
  class n6 node_entity
  n7@{ shape: rounded, label: "**海岛静态碰撞实体**<br/>为海岛结构、入口坡道与展示人物提供静态碰<br/>撞。" }
  class n7 node_entity
  n8@{ shape: rounded, label: "**海岛实例根**<br/>承载海岛实例并记录碰撞与业务生成进度。" }
  class n8 node_entity
  n9@{ shape: rounded, label: "**地图展示 NPC**<br/>保留地图展示人物及其静态身体碰撞。" }
  class n9 node_entity
  n10@{ shape: rounded, label: "**spawn_lighting**<br/>为游戏会话创建日光与加载相机。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**log_asset_requests**<br/>记录运行模型资源的加载请求。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**poll_art_assets**<br/>检查资源及其依赖的加载结果。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**begin_island**<br/>请求创建已加载海岛的运行实例。" }
  class n13 node_system
  n14@{ shape: hex, label: "**mark_island_ready**<br/>标记地图实例以进入碰撞准备。" }
  class n14 node_observer
  n15@{ shape: rounded, label: "**prepare_island**<br/>从海岛模型构建静态碰撞、坡道与人物碰撞。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**spawn_actors**<br/>装配玩家、可搬物、控制者与相机。" }
  class n16 node_system
  n1 e0@--> n0
  class e0 edge_registration
  n0 e1@-->|"装配归属"| n2
  class e1 edge_reference
  n0 e2@-->|"装配归属"| n3
  class e2 edge_reference
  n0 e3@-->|"装配归属"| n4
  class e3 edge_reference
  n0 e4@-->|"装配归属"| n5
  class e4 edge_reference
  n0 e5@-->|"装配归属"| n6
  class e5 edge_reference
  n0 e6@-->|"装配归属"| n7
  class e6 edge_reference
  n0 e7@-->|"装配归属"| n8
  class e7 edge_reference
  n0 e8@-->|"装配归属"| n9
  class e8 edge_reference
  n0 e9@--> n10
  class e9 edge_registration
  n0 e10@--> n11
  class e10 edge_registration
  n0 e11@--> n12
  class e11 edge_registration
  n0 e12@--> n13
  class e12 edge_registration
  n0 e13@--> n14
  class e13 edge_registration
  n0 e14@--> n15
  class e14 edge_registration
  n0 e15@--> n16
  class e15 edge_registration
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
