  class n11 node_component
  class n11 external_node
  n12@{ shape: rounded, label: "**CarryGrip**<br/>来自物品交互 ↗：保存握持对齐使用的模型<br/>偏移。" }
  class n12 node_component
  class n12 external_node
  n13@{ shape: rounded, label: "**ItemModel**<br/>来自场景装配 ↗：标识物品采用的美术模型<br/>种类。" }
  class n13 node_component
  class n13 external_node
  n14@{ shape: rounded, label: "**SpawnPoint**<br/>来自越界恢复 ↗：每个业务根独立保存出生<br/>姿态。" }
  class n14 node_component
  class n14 external_node
  n15@{ shape: rounded, label: "**SpawnPoint**<br/>来自越界恢复 ↗：每个业务根独立保存出生<br/>姿态。" }
  class n15 node_component
  class n15 external_node
  n16@{ shape: rounded, label: "**EguiContext**<br/>保存世界检查器的界面交互状态。" }
  class n16 node_component
  n17@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
