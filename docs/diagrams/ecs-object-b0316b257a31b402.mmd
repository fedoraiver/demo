  class n18 external_node
  n19@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存第一人称镜头的显<br/>示姿态。" }
  class n19 node_component
  class n19 external_node
  n20@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存模型相对业务根的<br/>局部显示姿态。" }
  class n20 node_component
  class n20 external_node
  n21@{ shape: rounded, label: "**Visibility**<br/>来自Bevy 引擎 ↗：根实体的可见性，视觉<br/>子实体继承层级可见性。" }
  class n21 node_component
  class n21 external_node
  n22@{ shape: rounded, label: "**Visibility**<br/>来自Bevy 引擎 ↗：根实体可见性。" }
  class n22 node_component
  class n22 external_node
  n23@{ shape: rounded, label: "**Visibility**<br/>来自Bevy 引擎 ↗：控制实体及视觉子树的<br/>显示状态。" }
  class n23 node_component
  class n23 external_node
  n24@{ shape: rounded, label: "**EguiInput**<br/>缓冲检查器界面收到的输入。" }
  class n24 node_component
  n25@{ shape: rounded, label: "**EguiContextSettings**<br/>配置检查器上下文的输入与输出处理。" }
  class n25 node_component
  n26@{ shape: rounded, label: "**EguiSchedule**<br/>指定检查器上下文的内部界面调度。" }
  class n26 node_component
  n27@{ shape: rounded, label: "**EguiFullOutput**<br/>保存检查器界面计算产生的输出。" }
  class n27 node_component
  n28@{ shape: cyl, label: "**AppTypeRegistry**<br/>来自Bevy 引擎 ↗：登记检查器可以读取和<br/>编辑的数据类型。" }
  class n28 node_resource
  class n28 external_node
  n29@{ shape: cyl, label: "**PrototypeConfig**<br/>来自设置与参数 ↗：保存运动、重力、拾取<br/>与握持的共享参数。" }
  class n29 node_resource
  class n29 external_node
  n30@{ shape: cyl, label: "**State#lt;AppState#gt; /**<br/>**NextState#lt;AppState#gt;**<br/>来自应用流程 ↗：保存应用主状态及待处理<br/>的会话切换。" }
  class n30 node_resource
  class n30 external_node
  n31@{ shape: cyl, label: "**State#lt;PlayState#gt; /**<br/>**NextState#lt;PlayState#gt;**<br/>来自应用流程 ↗：保存游戏运行、暂停及待<br/>处理的切换请求。" }
