flowchart LR
  accTitle: world_inspector_ui · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**world_inspector_ui**<br/>展示并编辑开放反射的实体、资源与资产。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**HeldTarget**<br/>来自物品交互 ↗：保存本帧握持姿态的检查<br/>目标。" }
  class n1 node_component
  class n1 external_node
  n2@{ shape: rounded, label: "**Character**<br/>来自角色运动 ↗：标识具有角色运动能力的<br/>实体。" }
  class n2 node_component
  class n2 external_node
  n3@{ shape: rounded, label: "**CharacterIntent**<br/>来自角色运动 ↗：保存持续移动方向与单次<br/>跳跃、交互请求。" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: rounded, label: "**CharacterMotion**<br/>来自角色运动 ↗：保存角色接地等运动观察<br/>结果。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**PlayerId**<br/>来自第一人称控制 ↗：独立于运行时<br/>Entity 的业务身份。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: rounded, label: "**ControlsCharacter**<br/>来自第一人称控制 ↗：普通实体引用，指向<br/>受控角色。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**ControlsCamera**<br/>来自第一人称控制 ↗：普通实体引用，指向<br/>受控相机。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**CharacterVisual**<br/>来自第一人称控制 ↗：标记随第一人称视角<br/>隐藏的角色模型。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**FirstPersonCamera**<br/>来自第一人称控制 ↗：保存跟随目标、眼高<br/>与观察角度。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: rounded, label: "**Parcel**<br/>来自物品交互 ↗：快递身份标记。" }
  class n10 node_component
  class n10 external_node
