---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-f3afbfcf4b168536-e1{marker-start:url(#component-f3afbfcf4b168536_flowchart-v2-pointStart)!important}\n#component-f3afbfcf4b168536-e3{marker-start:url(#component-f3afbfcf4b168536_flowchart-v2-pointStart)!important}\n#component-f3afbfcf4b168536-e4{marker-start:url(#component-f3afbfcf4b168536_flowchart-v2-pointStart)!important}\n#component-f3afbfcf4b168536-e5{marker-start:url(#component-f3afbfcf4b168536_flowchart-v2-pointStart)!important}\n#component-f3afbfcf4b168536-e6{marker-start:url(#component-f3afbfcf4b168536_flowchart-v2-pointStart)!important}\n#component-f3afbfcf4b168536-e7{marker-start:url(#component-f3afbfcf4b168536_flowchart-v2-pointStart)!important}\n#component-f3afbfcf4b168536-e8{marker-start:url(#component-f3afbfcf4b168536_flowchart-v2-pointStart)!important}\n#component-f3afbfcf4b168536-e9{marker-start:url(#component-f3afbfcf4b168536_flowchart-v2-pointStart)!important}\n#component-f3afbfcf4b168536-e10{marker-start:url(#component-f3afbfcf4b168536_flowchart-v2-pointStart)!important}\n#component-f3afbfcf4b168536_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: ControlsCharacter · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**键盘控制者**<br/>来自场景装配 ↗：保存玩家身份、输入上下<br/>文与受控角色及相机。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**ControlsCharacter**<br/>普通实体引用，指向受控角色。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**WorldInspectorPlugin / world_**<br/>**inspector_ui**<br/>来自Egui / Inspector ↗：展示并编辑开<br/>放反射的实体、资源与资产。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**sync_mouse_capture**<br/>管理光标捕获及玩法输入启停。" }
  class n3 node_system
  n4@{ shape: hex, label: "**record_movement**<br/>保存控制角色的持续移动方向。" }
  class n4 node_observer
  n5@{ shape: hex, label: "**clear_completed_movement**<br/>清除已结束动作的角色移动方向。" }
  class n5 node_observer
  n6@{ shape: hex, label: "**clear_cancelled_movement**<br/>清除已取消动作的角色移动方向。" }
  class n6 node_observer
  n7@{ shape: hex, label: "**request_jump**<br/>记录目标角色的单次跳跃请求。" }
  class n7 node_observer
  n8@{ shape: hex, label: "**request_interaction**<br/>记录目标角色的单次交互请求。" }
  class n8 node_observer
  n9@{ shape: rounded, label: "**sync_character_facing**<br/>同步人物朝向并处理持物转向受阻。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**sync_character_visibility**<br/>隐藏第一人称控制角色的自身模型。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**spawn_actors**<br/>来自场景装配 ↗：装配玩家、可搬物、控制<br/>者与相机。" }
  class n11 node_system
  class n11 external_node
  n1 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n1
  n4 layout_3@~~~ n1
