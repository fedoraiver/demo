---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: Enhanced Input · 数据与实体
  accDescr: Enhanced Input的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef external_node stroke-dasharray:6 4
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: cyl, label: "**ContextInstances#lt;PreUpdate#gt;**<br/>索引输入框架当前运行的动作上下文。" }
  class n0 node_resource
  n2@{ shape: cyl, label: "**ConsumedInputs**<br/>记录本轮动作评估已经消费的输入。" }
  class n2 node_resource
  subgraph n37[" "]
  direction TB
  eh1@{ shape: text, label: "**动作实体**        ​<br/>来自第一人称控制 ↗：保存玩法        ​<br/>或调试动作的评估结果与触发状        ​<br/>态。        ​" }
  n38@{ shape: rect, label: "**Name**<br/>来自Bevy 引擎 ↗：Action#lt;A#gt; 要求的动作<br/>名称，用于插件诊断。" }
  class n38 node_component
  class n38 external_node
  n8@{ shape: rect, label: "**Action#lt;A#gt;**<br/>保存具体玩法动作的当前输出。" }
  class n8 node_component
  n9@{ shape: rect, label: "**ActionSettings**<br/>保存动作的输入消费与重新激活策略。" }
  class n9 node_component
  n10@{ shape: rect, label: "**ActionOf#lt;GameplayContext#gt;**<br/>将动作关联到所属控制上下文。" }
  class n10 node_component
  n11@{ shape: rect, label: "**Bindings**<br/>索引动作拥有的输入绑定。" }
  class n11 node_component
  eh1 layout_0@~~~ n38
  n38 layout_1@~~~ n8
  n8 layout_2@~~~ n9
  n9 layout_3@~~~ n10
  n10 layout_4@~~~ n11
  n12@{ shape: rect, label: "**Press**<br/>将按钮按下转换为一次触发。" }
  class n12 node_component
  n13@{ shape: rect, label: "**ActionValue**<br/>保存动作评估产生的通用输入值。" }
  class n13 node_component
  n14@{ shape: rect, label: "**TriggerState**<br/>保存本次动作评估的触发状态。" }
  class n14 node_component
  n15@{ shape: rect, label: "**ActionEvents**<br/>保存本次待派发的动作事件。" }
  class n15 node_component
  eh1 layout_5@~~~ n12
  n12 layout_6@~~~ n13
  n13 layout_7@~~~ n14
  n14 layout_8@~~~ n15
  n16@{ shape: rect, label: "**ActionTime**<br/>动作持续与触发计时，由插件评估更新。" }
  class n16 node_component
  n17@{ shape: rect, label: "**ActionMock**<br/>保存测试使用的模拟动作输入。" }
  class n17 node_component
  n18@{ shape: rect, label: "**ActionFns**<br/>将通用动作值适配为具体动作组件。" }
  class n18 node_component
  n19@{ shape: rect, label: "**ConditionFns**<br/>保存动作触发条件的执行适配。" }
  class n19 node_component
  eh1 layout_9@~~~ n16
  n16 layout_10@~~~ n17
  n17 layout_11@~~~ n18
  n18 layout_12@~~~ n19
  end
  class n37 node_entity
  class n37 external_node
  style n37 fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340,stroke-dasharray:6 4
  n0 layout_13@~~~ n2
  n2 layout_14@~~~ n37
  end
  style column_0 fill:none,stroke:none
  subgraph column_1[" "]
  direction TB
  n1@{ shape: cyl, label: "**ActionSources**<br/>配置输入框架允许使用的输入来源。" }
  class n1 node_resource
  n3@{ shape: cyl, label: "**PendingBindings**<br/>保存上下文停用后仍需重置的输入绑定。" }
  class n3 node_resource
  n30@{ shape: rect, label: "**键盘控制者**        ​<br/>来自场景装配 ↗：保存玩家身        ​<br/>份、输入上下文与受控角色及相        ​<br/>机。        ​" }
  class n30 node_entity
  class n30 external_node
  n39@{ shape: rect, label: "**绑定实体**        ​<br/>来自第一人称控制 ↗：将键盘或        ​<br/>鼠标输入映射到玩法动作。        ​" }
  class n39 node_entity
  class n39 external_node
  n40@{ shape: rect, label: "**菜单输入控制者**        ​<br/>来自菜单与界面 ↗：提供跨页面        ​<br/>与玩法会话保留的菜单动作输入。        ​" }
  class n40 node_entity
  class n40 external_node
  n1 layout_15@~~~ n3
  n3 layout_16@~~~ n30
  n30 layout_17@~~~ n39
  n39 layout_18@~~~ n40
  end
  style column_1 fill:none,stroke:none
  column_0 layout_19@~~~ column_1
  end
