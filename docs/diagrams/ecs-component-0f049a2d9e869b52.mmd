---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-0f049a2d9e869b52-e1{marker-start:url(#component-0f049a2d9e869b52_flowchart-v2-pointStart)!important}\n#component-0f049a2d9e869b52-e4{marker-start:url(#component-0f049a2d9e869b52_flowchart-v2-pointStart)!important}\n#component-0f049a2d9e869b52-e6{marker-start:url(#component-0f049a2d9e869b52_flowchart-v2-pointStart)!important}\n#component-0f049a2d9e869b52-e8{marker-start:url(#component-0f049a2d9e869b52_flowchart-v2-pointStart)!important}\n#component-0f049a2d9e869b52-e11{marker-start:url(#component-0f049a2d9e869b52_flowchart-v2-pointStart)!important}\n#component-0f049a2d9e869b52-e13{marker-start:url(#component-0f049a2d9e869b52_flowchart-v2-pointStart)!important}\n#component-0f049a2d9e869b52-e15{marker-start:url(#component-0f049a2d9e869b52_flowchart-v2-pointStart)!important}\n#component-0f049a2d9e869b52_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: CharacterIntent · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**CharacterIntent**<br/>保存持续移动方向与单次跳跃、交互请求。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**WorldInspectorPlugin / world_**<br/>**inspector_ui**<br/>来自Egui / Inspector ↗：展示并编辑开<br/>放反射的实体、资源与资产。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: hex, label: "**record_movement**<br/>来自第一人称控制 ↗：保存控制角色的持续<br/>移动方向。" }
  class n3 node_observer
  class n3 external_node
  n4@{ shape: hex, label: "**clear_completed_movement**<br/>来自第一人称控制 ↗：清除已结束动作的角<br/>色移动方向。" }
  class n4 node_observer
  class n4 external_node
  n5@{ shape: hex, label: "**clear_cancelled_movement**<br/>来自第一人称控制 ↗：清除已取消动作的角<br/>色移动方向。" }
  class n5 node_observer
  class n5 external_node
  n6@{ shape: hex, label: "**request_jump**<br/>来自第一人称控制 ↗：记录目标角色的单次<br/>跳跃请求。" }
  class n6 node_observer
  class n6 external_node
  n7@{ shape: hex, label: "**request_interaction**<br/>来自第一人称控制 ↗：记录目标角色的单次<br/>交互请求。" }
  class n7 node_observer
  class n7 external_node
  n8@{ shape: rounded, label: "**move_characters**<br/>按移动意图和速度为角色施加水平运动力。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**jump_characters**<br/>执行角色跳跃并消费单次请求。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: rounded, label: "**spawn_actors**<br/>来自场景装配 ↗：装配玩家、可搬物、控制<br/>者与相机。" }
  class n11 node_system
  class n11 external_node
  n12@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n12 node_system
  class n12 external_node
  n13@{ shape: rounded, label: "**clear_character_intents**<br/>清空持续移动意图与单次动作请求。" }
  class n13 node_system
