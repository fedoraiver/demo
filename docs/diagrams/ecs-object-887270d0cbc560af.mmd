---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: RenderApp 渲染流程 · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**RenderApp 渲染流程**<br/>提取场景数据并执行本帧渲染。" }
  class n0 node_engine_flow
  n1@{ shape: rounded, label: "**GlobalTransform**<br/>保存层级传播后的世界姿态。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**GlobalTransform**<br/>保存层级传播后的世界姿态。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**GlobalTransform**<br/>引擎传播后的相机世界变换，供渲染提取。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**GlobalTransform**<br/>保存层级传播后的世界姿态。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**Visibility**<br/>根实体的可见性，视觉子实体继承层级可见<br/>性。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Visibility**<br/>根实体可见性。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**Visibility**<br/>控制实体及视觉子树的显示状态。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**Mesh3d**<br/>关联实体使用的三维网格资产。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**MeshMaterial3d#lt;StandardMaterial#gt;**<br/>关联实体使用的三维网格材质。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**Camera3d**<br/>标记三维场景相机。" }
  class n10 node_component
  n11@{ shape: cyl, label: "**Assets#lt;Mesh#gt;**<br/>保存模型网格并提供碰撞构建所需的顶点。" }
  class n11 node_resource
  n12@{ shape: cyl, label: "**Assets#lt;StandardMaterial#gt;**<br/>保存导入模型使用的材质资产。" }
  class n12 node_resource
  n13@{ shape: cyl, label: "**ClearColor**<br/>保存场景背景清除颜色。" }
  class n13 node_resource
  n14@{ shape: cyl, label: "**GlobalAmbientLight**<br/>保存场景的全局环境光配置。" }
  class n14 node_resource
  n1 e0@-->|"查询访问"| n0
