---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-d43fb4584052fbbf-e3{marker-start:url(#object-d43fb4584052fbbf_flowchart-v2-pointStart)!important}\n#object-d43fb4584052fbbf_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: limit_frame_rate · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**limit_frame_rate**<br/>补足帧间等待以控制显示帧率。" }
  class n0 node_system
  n1@{ shape: cyl, label: "**GameSettings**<br/>保存已应用的玩家设置与音量配置。" }
  class n1 node_resource
  n2@{ shape: lin-rect, label: "**TimeSystems**<br/>来自Bevy 引擎 ↗：推进真实时间与游戏时<br/>间。" }
  class n2 node_system_set
  class n2 external_node
  n3@{ shape: notch-rect, label: "**Local#lt;FramePacing#gt;**<br/>保存帧间等待计时与重复日志抑制状态。" }
  class n3 node_local
  n4@{ shape: fr-rect, label: "**SettingsPlugin**<br/>管理设置持久化、共享原型参数与帧率控制。" }
  class n4 node_plugin
  n1 e0@-->|"设置"| n0
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_order
  n3 e2@-->|"访问声明"| n0
  class e2 edge_read
  n3 e3@---|"访问声明"| n0
  class e3 edge_write
  n4 e4@--> n0
  class e4 edge_registration
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
