  n9 layout_8@~~~ n1
  n10 layout_9@~~~ n1
  n11 layout_10@~~~ n1
  n12 layout_11@~~~ n1
  n13 layout_12@~~~ n1
  n11 e10@-->|"添加"| n1
  class e10 edge_write
  n1 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n2 e1@---|"存在 / 变更过滤"| n1
  class e1 edge_reference
