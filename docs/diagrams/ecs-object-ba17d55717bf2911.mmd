---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-ba17d55717bf2911-e2{marker-start:url(#object-ba17d55717bf2911_flowchart-v2-pointStart)!important}\n#object-ba17d55717bf2911_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Scrollbar · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Scrollbar**<br/>关联滚动条控制的内容视口。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**设置滚动条轨道**<br/>来自菜单与界面 ↗：为设置内容视口提供可<br/>交互滚动轨道。" }
  class n1 node_entity
  class n1 external_node
  n2@{ shape: rounded, label: "**设置面板内容视口**<br/>来自菜单与界面 ↗：为设置标题、字段、说<br/>明与提示提供滚动视口。" }
  class n2 node_entity
  class n2 external_node
  n3@{ shape: rounded, label: "**bind_settings_scrollbars**<br/>来自菜单与界面 ↗：将设置滚动条绑定到对<br/>应内容视口。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**sync_settings_scrollbars**<br/>来自菜单与界面 ↗：同步滚动条显隐、拾取<br/>范围与高亮。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: hex, label: "**scroll_over_settings_scrollbar**<br/>来自菜单与界面 ↗：通过滚动条上的滚轮操<br/>作滚动内容视口。" }
  class n5 node_observer
  class n5 external_node
  n0 e0@-->|"可能挂载于"| n1
  class e0 edge_reference
  n0 e1@-->|"target"| n2
  class e1 edge_reference
  n3 e2@---|"存在 / 变更过滤"| n0
  class e2 edge_reference
  n3 e3@-->|"添加"| n0
  class e3 edge_write
  n0 e4@-->|"查询访问"| n4
  class e4 edge_read
  n0 e5@-->|"查询访问"| n5
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
