  class n11 node_plugin
  end
  style layout_card_n11 fill:none,stroke:none
  subgraph layout_card_n12[" "]
  n12@{ shape: stadium, label: "**Fire#lt;PreviousAction#gt;**<br/>向上循环选择可操作按钮。" }
  class n12 node_event
  end
  style layout_card_n12 fill:none,stroke:none
