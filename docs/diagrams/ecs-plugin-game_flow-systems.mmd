---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 应用流程 · 系统与调度
  accDescr: 应用流程的系统与调度；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_contract fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_note fill:#F7F7F5,stroke:#9A9B88,stroke-width:1.2px,color:#1F3340
  classDef edge_schedule stroke:#334155,stroke-width:3px
  classDef edge_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_constraint stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:10 4 2 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  subgraph sg0["OnEnter"]
  direction TB
  n0@{ shape: rounded, label: "**enter_main_menu**<br/>保留主菜单展示时间并冻结物理模拟。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**pause_simulation**<br/>冻结游戏与物理时钟并清零当前增量。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**resume_simulation**<br/>恢复游戏与物理时钟。" }
  class n2 node_system
  n0 layout_0@~~~ n1
  n1 layout_1@~~~ n2
  end
  subgraph sg1["FixedUpdate"]
  direction TB
  n4@{ shape: lin-rect, label: "**FixedGameplaySystems**<br/>协调恢复、朝向、运动、交互与持握的固定步<br/>顺序。" }
  class n4 node_contract
  n7@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**move_characters**<br/>来自角色运动 ↗：按移动意图和速度为角色<br/>施加水平运动力。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: rounded, label: "**sync_held_presentation**<br/>来自物品交互 ↗：按人物呈现姿态同步持物<br/>模型与握持目标。" }
  class n11 node_system
  class n11 external_node
  n12@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：按人物物理姿态同步持物<br/>位置与碰撞代理。" }
  class n12 node_system
  class n12 external_node
  n4 layout_2@~~~ n7
  n7 layout_3@~~~ n8
  n8 layout_4@~~~ n9
  n9 layout_5@~~~ n10
  n10 layout_6@~~~ n11
  n11 layout_7@~~~ n12
  end
  subgraph sg2["RunFixedMainLoop ·<br/>AfterFixedMainLoop"]
  direction TB
  n5@{ shape: lin-rect, label: "**PresentationSystems**<br/>协调插值后的持物、镜头与可见性同步。" }
  class n5 node_contract
  n13@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n13 node_system
  class n13 external_node
  n14@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：同步本帧持物碰撞朝向与<br/>显示朝向。" }
  class n14 node_system
  class n14 external_node
  n15@{ shape: rounded, label: "**sync_held_presentation**<br/>来自物品交互 ↗：按人物呈现姿态同步持物<br/>模型与握持目标。" }
  class n15 node_system
  class n15 external_node
  n16@{ shape: rounded, label: "**follow_first_person_camera**<br/>来自第一人称控制 ↗：按人物本帧位置与观<br/>察角度更新第一人称镜头。" }
  class n16 node_system
  class n16 external_node
  n17@{ shape: rounded, label: "**sync_character_visibility**<br/>来自第一人称控制 ↗：隐藏第一人称控制角<br/>色的自身模型。" }
  class n17 node_system
  class n17 external_node
  n5 layout_8@~~~ n13
  n13 layout_9@~~~ n14
  n14 layout_10@~~~ n15
  n15 layout_11@~~~ n16
  n16 layout_12@~~~ n17
  end
  subgraph sg3["Update"]
  direction TB
  n6@{ shape: lin-rect, label: "**UI Style → Audio Mix → Playback**<br/>约束界面显示更新先于音量混合与播放。" }
  class n6 node_contract
  n18@{ shape: lin-rect, label: "**UiSystems::Style**<br/>来自菜单与界面 ↗：组织菜单显示、数值与<br/>说明的原位更新。" }
  class n18 node_contract
  class n18 external_node
  n19@{ shape: lin-rect, label: "**AudioSystems**<br/>来自音频播放 ↗：公开音量混合与播放的调<br/>度阶段。" }
  class n19 node_contract
  class n19 external_node
  n6 layout_13@~~~ n18
  n18 layout_14@~~~ n19
  end
  subgraph sg4["约束与说明"]
  direction TB
  n3@{ shape: doc, label: "**InGame / Paused**<br/>保留会话实体并暂停模拟与玩法输入。" }
  class n3 node_note
  end
  sg3 layout_15@~~~ sg4
  sg0 sc0@--> sg1
  class sc0 edge_schedule
  sg1 sc1@--> sg2
  class sc1 edge_schedule
  sg2 sc2@--> sg3
  class sc2 edge_schedule
  n4 e0@-->|"Recover"| n7
  class e0 edge_membership
  n4 e1@-->|"Facing"| n8
  class e1 edge_membership
  n4 e2@-->|"Motion"| n9
  class e2 edge_membership
  n4 e3@-->|"Interaction"| n10
  class e3 edge_membership
  n4 e4@-->|"Target"| n11
  class e4 edge_membership
  n4 e5@-->|"Attachment"| n12
  class e5 edge_membership
  n5 e6@-->|"Facing"| n13
  class e6 edge_membership
  n5 e7@-->|"HeldPhysics"| n14
  class e7 edge_membership
  n5 e8@-->|"HeldPresentation"| n15
  class e8 edge_membership
  n5 e9@-->|"Camera"| n16
  class e9 edge_membership
  n5 e10@-->|"Visibility"| n17
  class e10 edge_membership
  n6 e11@-->|"UI Style"| n18
  class e11 edge_constraint
  n6 e12@-->|"Audio Mix / Playback"| n19
  class e12 edge_constraint
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: basis }
