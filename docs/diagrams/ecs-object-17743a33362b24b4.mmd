---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: CharacterPlugin · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_app fill:#EFF4F5,stroke:#3A7B87,stroke-width:2.2px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: fr-rect, label: "**CharacterPlugin**<br/>提供角色身份、运动、接地与跳跃。" }
  class n0 node_plugin
  n1@{ shape: fr-rect, label: "**main / App**<br/>来自Bevy 引擎 ↗：装配应用、设置与插件<br/>并管理主循环和退出。" }
  class n1 node_app
  class n1 external_node
  n2@{ shape: rounded, label: "**log_configuration**<br/>记录角色运动与持物行为的初始化配置。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**move_characters**<br/>按移动意图和速度为角色施加水平运动力。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**jump_characters**<br/>执行角色跳跃并消费单次请求。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update_grounded**<br/>准备运动前更新接地状态。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_grounded**<br/>物理回写之后观察实际接地状态。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**log_character_velocity**<br/>定期记录角色实际速度与接地状态。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**clear_character_intents**<br/>清空持续移动意图与单次动作请求。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**clear_character_intents**<br/>清空持续移动意图与单次动作请求。" }
  class n9 node_system
  n1 e0@--> n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_registration
  n0 e2@--> n3
  class e2 edge_registration
  n0 e3@--> n4
  class e3 edge_registration
  n0 e4@--> n5
  class e4 edge_registration
  n0 e5@--> n6
  class e5 edge_registration
  n0 e6@--> n7
  class e6 edge_registration
  n0 e7@--> n8
  class e7 edge_registration
  n0 e8@--> n9
  class e8 edge_registration
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
