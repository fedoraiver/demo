digraph "" {
	"compound"="true";
	"splines"="spline";
	"rankdir"="LR";
	"bgcolor"="#0d1117";
	"fontname"="Helvetica";
	"nodesep"="0.15";
	edge ["penwidth"="2"];
	node ["shape"="box", "style"="filled"];
	"node_System(SystemKey(1v1))" ["label"="enter_main_menu", "tooltip"="demo::game_flow::enter_main_menu"]
	"node_System(SystemKey(2v1))" ["label"="clear_character_intents", "tooltip"="demo::character::lifecycle::clear_character_intents"]
	"node_System(SystemKey(3v1))" ["label"="suspend_controls", "tooltip"="demo::first_person::suspend_controls"]
	"node_System(SystemKey(4v1))" ["label"="show_main_menu", "tooltip"="demo::ui::lifecycle::show_main_menu"]
	"node_System(SystemKey(5v1))" ["label"="spawn_backdrop", "tooltip"="demo::ui::backdrop::spawn_backdrop"]
}
