---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-426a40564e84b3a0-e17{marker-start:url(#object-426a40564e84b3a0_flowchart-v2-pointStart)!important}\n#object-426a40564e84b3a0_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: ui_stack_system · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ui_stack_system**<br/>重建稳定的 UI 绘制和命中顺序。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PostUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**UiSystems::Stack**<br/>按层级和 Z 顺序重建 UI 绘制栈。" }
  class n2 node_system_set
  n3@{ shape: notch-rect, label: "**Vec#lt;(Entity, i32)#gt;**<br/>为 UI 层级堆叠遍历复用实体与局部层次缓<br/>存。" }
  class n3 node_local
  n4@{ shape: notch-rect, label: "**Vec#lt;(Entity, StackRoot)#gt;**<br/>收集本轮参与排序的 UI 堆叠根。" }
  class n4 node_local
  n5@{ shape: notch-rect, label: "**EntityHashMap#lt;usize#gt;**<br/>保留上一帧 UI 堆叠根的相对顺序。" }
  class n5 node_local
  n6@{ shape: notch-rect, label: "**EntityHashSet**<br/>避免 UI 根同时从两条查询路径重复加入。" }
  class n6 node_local
  n7@{ shape: cyl, label: "**UiStack**<br/>保存按相机分区的 UI 绘制顺序。" }
  class n7 node_resource
  n8@{ shape: notch-rect, label: "**UiRootNodes**<br/>枚举 UI 布局的根节点。" }
  class n8 node_system_param
  n9@{ shape: rounded, label: "**GlobalZIndex**<br/>跨 UI 层级指定全局绘制层次。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**ZIndex**<br/>设置同级 UI 节点的局部前后顺序。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**ComputedStackIndex**<br/>保存节点计算后的绘制堆叠位置。" }
  class n11 node_component
  n12@{ shape: notch-rect, label: "**UiChildren**<br/>按 UI 层级访问子节点。" }
  class n12 node_system_param
  n13@{ shape: rounded, label: "**Children**<br/>保存以 ChildOf 指向当前父实体的子实体集<br/>合" }
  class n13 node_component
  n14@{ shape: rounded, label: "**Node**<br/>声明 UI 节点的布局规则。" }
  class n14 node_component
  n15@{ shape: rounded, label: "**ChildOf**<br/>保存当前实体的父实体身份" }
  class n15 node_component
