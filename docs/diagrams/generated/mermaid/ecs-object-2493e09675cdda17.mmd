---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-2493e09675cdda17-e5{marker-start:url(#object-2493e09675cdda17_flowchart-v2-pointStart)!important}\n#object-2493e09675cdda17-e6{marker-start:url(#object-2493e09675cdda17_flowchart-v2-pointStart)!important}\n#object-2493e09675cdda17-e8{marker-start:url(#object-2493e09675cdda17_flowchart-v2-pointStart)!important}\n#object-2493e09675cdda17-e9{marker-start:url(#object-2493e09675cdda17_flowchart-v2-pointStart)!important}\n#object-2493e09675cdda17_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: ScrollPosition · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ScrollPosition**<br/>保存内容视口的滚动偏移。" }
  class n0 node_component
  n1@{ shape: hex, label: "**scroll_menu**<br/>来自菜单与界面 ↗：滚动设置内容并限制在<br/>有效范围内。" }
  class n1 node_observer
  class n1 external_node
  n2@{ shape: hex, label: "**scroll_over_settings_scrollbar**<br/>来自菜单与界面 ↗：通过滚动条上的滚轮操<br/>作滚动内容视口。" }
  class n2 node_observer
  class n2 external_node
  n3@{ shape: rounded, label: "**设置面板内容视口**<br/>来自菜单与界面 ↗：为设置标题、字段、说<br/>明与提示提供滚动视口。" }
  class n3 node_entity
  class n3 external_node
  n4@{ shape: rounded, label: "**rebuild_page**<br/>来自菜单与界面 ↗：按页面结构变化重建菜<br/>单界面。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**scroll_focused_button**<br/>来自菜单与界面 ↗：将当前聚焦设置按钮滚<br/>入可视范围。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**sync_settings_scrollbars**<br/>来自菜单与界面 ↗：同步滚动条显隐、拾取<br/>范围与高亮。" }
  class n6 node_system
  class n6 external_node
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n2 e1@-->|"可变访问"| n0
  class e1 edge_write
  n0 e2@-->|"可能挂载于"| n3
  class e2 edge_reference
  n4 e3@-->|"添加"| n0
  class e3 edge_write
  n5 e4@-->|"可变访问"| n0
  class e4 edge_write
  n5 e5@---|"查询访问"| n0
  class e5 edge_read
  n1 e6@---|"查询访问"| n0
  class e6 edge_read
  n6 e7@-->|"可变访问"| n0
  class e7 edge_write
  n6 e8@---|"查询访问"| n0
  class e8 edge_read
  n2 e9@---|"查询访问"| n0
  class e9 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
