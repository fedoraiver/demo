---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-272ac3d709720250-e6{marker-start:url(#object-272ac3d709720250_flowchart-v2-pointStart)!important}\n#object-272ac3d709720250-e8{marker-start:url(#object-272ac3d709720250_flowchart-v2-pointStart)!important}\n#object-272ac3d709720250-e11{marker-start:url(#object-272ac3d709720250_flowchart-v2-pointStart)!important}\n#object-272ac3d709720250_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: EguiContext · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**EguiContext**<br/>包装一个 egui::Context" }
  class n0 node_component
  n1@{ shape: rounded, label: "**world_inspector_ui**<br/>展示并编辑开放反射的实体、资源与资产。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**end_pass_system**<br/>结束 Egui 界面帧并保存完整输出。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**process_output_system**<br/>拆分 Egui 绘制输出并执行平台命令。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**write_egui_wants_input_system**<br/>汇总所有 Egui 上下文的输入占用。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**process_ime_system**<br/>同步 Egui 编辑区域的原生输入法状态。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_ui_screen_rect**<br/>把相机视口换算为 Egui 逻辑屏幕区域。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**setup_primary_egui_context_system**<br/>为首个合适相机建立主 Egui 上下文。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**setup_primary_egui_context_system**<br/>为首个合适相机建立主 Egui 上下文。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**on_egui_context_added_system**<br/>登记新 Egui 上下文对应的窗口。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**update_ui_screen_rect**<br/>把相机视口换算为 Egui 逻辑屏幕区域。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**begin_pass_system**<br/>把本轮输入交给 Egui 并开始界面帧。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**read_egui_zoom_factor_system**<br/>记录 Egui 当前界面缩放因子。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**write_pointer_moved_and_button_**<br/>**messages_system**<br/>按原生事件顺序转换 Egui 指针输入。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**write_window_touch_messages_system**<br/>把窗口触摸转换为 Egui 指针和触摸事件。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**write_non_window_pointer_moved_**<br/>**messages_system**<br/>刷新非窗口 Egui 界面的指针位置。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**write_non_window_touch_messages_**<br/>**system**<br/>向聚焦的非窗口 Egui 界面传递触摸。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**write_mouse_wheel_messages_system**<br/>向悬停 Egui 上下文传递滚轮输入。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**write_keyboard_input_messages_system**<br/>把键盘文本与按键转换为 Egui 输入。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**write_ime_messages_system**<br/>向聚焦的 Egui 上下文传递输入法文本。" }
  class n19 node_system
  n20@{ shape: rounded, label: "**write_file_dnd_messages_system**<br/>把文件拖放路由到对应 Egui 上下文。" }
  class n20 node_system
  n21@{ shape: rounded, label: "**write_egui_input_system**<br/>把界面输入和文件拖放写入 Egui 输入批<br/>次。" }
