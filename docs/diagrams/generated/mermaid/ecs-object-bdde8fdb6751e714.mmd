---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 4,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-bdde8fdb6751e714-e17{marker-start:url(#object-bdde8fdb6751e714_flowchart-v2-pointStart)!important}\n#object-bdde8fdb6751e714_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: PrimaryWindow · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**PrimaryWindow**<br/>标识唯一的主窗口" }
  class n0 node_component
  n1@{ shape: rounded, label: "**mouse_pick_events**<br/>把窗口鼠标事件转换为拾取指针动作。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**touch_pick_events**<br/>把触摸阶段转换为独立拾取指针。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**camera_system**<br/>响应窗口创建、尺寸与缩放变化及图像目标变<br/>化，更新 Camera 与 Projection 的目标<br/>尺寸和投影信息；只读取相机实际引用的图像<br/>目标。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**set_initial_focus**<br/>在没有焦点目标时使用主窗口。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update_accessibility_nodes**<br/>把变化的可访问性节点同步给原生适配器。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**camera_system**<br/>响应窗口创建、尺寸与缩放变化及图像目标变<br/>化，更新 Camera 与 Projection 的目标<br/>尺寸和投影信息；只读取相机实际引用的图像<br/>目标。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**propagate_ui_target_cameras**<br/>为 UI 根配置目标相机和视口信息传播源。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**update_text2d_layout**<br/>重新排版变化的二维文字并准备字形。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**update_ime_position**<br/>把输入法候选窗口放到当前文字光标下方。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**dispatch_focused_input#lt;bevy_input::**<br/>**gamepad::GamepadButtonChangedEvent#gt;**<br/>读取对应输入消息并向当前焦点实体派发可冒<br/>泡的 FocusedInput；焦点无效时回退到主<br/>窗口。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**dispatch_focused_input#lt;bevy_input::**<br/>**mouse::MouseWheel#gt;**<br/>读取对应输入消息并向当前焦点实体派发可冒<br/>泡的 FocusedInput；焦点无效时回退到主<br/>窗口。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**sprite_picking**<br/>将可见、变换有效的精灵按深度排序，结合指<br/>针射线、相机、精灵图像和拾取配置计算命<br/>中，并向拾取后端发布 PointerHits。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**ui_picking**<br/>把各指针位置映射到匹配相机的视口坐标，<br/>按 UiStack 的绘制顺序检查 UI 节点及拾<br/>取规则，输出 PointerHits 供悬停与交互<br/>阶段汇总。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**ui_focus_system**<br/>按鼠标和触摸更新旧式 UI 交互状态。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**listen_for_ime_input_when_text_**<br/>**input_focused**<br/>按可编辑焦点控制主窗口输入法。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**repopulate**<br/>清空 RayMap，再为指针位置落在有效相机视<br/>口内的每个相机与指针组合创建世界射线，并<br/>按 RayId 保存。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**on_egui_context_added_system**<br/>来自Egui / Inspector ↗：登记新 Egui<br/>上下文对应的窗口。" }
  class n17 node_system
  class n17 external_node
  n18@{ shape: rounded, label: "**extract_windows**<br/>将主世界窗口尺寸、显示模式、原生句柄和主<br/>窗口身份同步到渲染世界，标记尺寸及模式变<br/>化，并处理关闭窗口或移除句柄造成的失效状<br/>态。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**extract_cameras**<br/>把主世界活动相机的目标、视口、变换、可见<br/>实体和渲染设置提取到渲染实体，并维护视图<br/>所需格式；对停用或目标尺寸无效的相机移除<br/>失效提取状态。" }
  class n19 node_system
