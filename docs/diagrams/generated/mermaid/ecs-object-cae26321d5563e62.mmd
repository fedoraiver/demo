---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: measure_text_system · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**measure_text_system**<br/>在文本变化后更新内容测量并安排文字重排。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PostUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**UiSystems::Content**<br/>在 UI 布局前测量文字和内容需求。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**load_font_assets_into_font_**<br/>**collection**<br/>把字体资产注册到排版字体数据库。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**detect_text_needs_rerender**<br/>把文字段和层级变化标为需要重绘。" }
  class n4 node_system
  n5@{ shape: cyl, label: "**Assets#lt;Font#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n5 node_resource
  n6@{ shape: rounded, label: "**Text**<br/>保存 UI 文本根的第一段内容。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**TextLayout**<br/>保存文字块的内部对齐与换行策略" }
  class n7 node_component
  n8@{ shape: rounded, label: "**ContentSize**<br/>提供内容驱动的固有尺寸测量。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**TextNodeFlags**<br/>追踪 UI 文本测量与重排状态。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**ComputedTextBlock**<br/>缓存文字块的 Parley 布局、文本实体树和<br/>重绘标记" }
  class n10 node_component
  n11@{ shape: rounded, label: "**ComputedUiRenderTargetInfo**<br/>缓存 UI 目标的尺寸与缩放。" }
  class n11 node_component
  n12@{ shape: rounded, label: "**ComputedNode**<br/>保存 UI 布局计算后的物理尺寸。" }
  class n12 node_component
  n13@{ shape: rounded, label: "**Node**<br/>声明 UI 节点的布局规则。" }
  class n13 node_component
  n14@{ shape: notch-rect, label: "**TextUiReader**<br/>按 UI 文本根读取文本层级。" }
  class n14 node_system_param
  n15@{ shape: cyl, label: "**TextPipeline**<br/>执行文字块布局与渲染数据生成" }
  class n15 node_resource
  n16@{ shape: cyl, label: "**FontCx**<br/>维护字体数据库、家族解析与字体缓存" }
  class n16 node_resource
  n17@{ shape: cyl, label: "**LayoutCx**<br/>持有 Parley 文字布局上下文" }
  class n17 node_resource
  n18@{ shape: cyl, label: "**RemSize**<br/>保存全局根字号" }
