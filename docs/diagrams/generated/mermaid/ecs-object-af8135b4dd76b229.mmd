---
flowchart LR
  accTitle: collect_requested_gizmos<bevy_gizmos::aabb::AabbGizmoConfigGroup, bevy_time::fixed::Fixed> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**collect_requested_gizmos#lt;bevy_**<br/>**gizmos::aabb::AabbGizmoConfigGroup,**<br/>**bevy_time::fixed::Fixed#gt;**<br/>把默认 Update 存储中本轮请求的 Gizmo<br/>图元追加到指定清理上下文，再清空默认请求<br/>存储，使图元按该上下文的生命周期保留。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · FixedLast**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: cyl, label: "**GizmoStorage#lt;AabbGizmoConfigGroup,**<br/>**()#gt;**<br/>按配置组和清理上下文存储调试图元。" }
  class n2 node_resource
  n3@{ shape: cyl, label: "**GizmoStorage#lt;AabbGizmoConfigGroup,**<br/>**Fixed#gt;**<br/>按配置组和清理上下文存储调试图元。" }
  class n3 node_resource
  n1 e0@-->|"main / FixedLast"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_write
  e1@{ curve: basis }
  e2@{ curve: basis }
