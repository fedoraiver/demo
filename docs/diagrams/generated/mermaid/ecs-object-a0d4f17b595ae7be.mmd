---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-a0d4f17b595ae7be-e9{marker-start:url(#object-a0d4f17b595ae7be_flowchart-v2-pointStart)!important}\n#object-a0d4f17b595ae7be-e10{marker-start:url(#object-a0d4f17b595ae7be_flowchart-v2-pointStart)!important}\n#object-a0d4f17b595ae7be_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: extract_ssao_settings · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**extract_ssao_settings**<br/>向渲染相机提取屏幕空间环境光遮蔽配置。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n2 node_system_param
  n3@{ shape: notch-rect, label: "**RenderEntity**<br/>记录主实体对应的渲染世界实体。" }
  class n3 node_query_data
  n4@{ shape: rounded, label: "**Camera**<br/>配置相机视口、输出目标和渲染顺序。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**ScreenSpaceAmbientOcclusion**<br/>配置三维相机的屏幕空间环境光遮蔽。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Msaa**<br/>选择视图的多重采样抗锯齿样本数。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**Camera3d**<br/>启用三维相机主渲染流程。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**DepthPrepass**<br/>为三维相机生成独立的深度纹理。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**NormalPrepass**<br/>输出已应用法线贴图的世界空间法线。" }
  class n9 node_component
  n1 e0@-->|"RenderApp / ExtractSchedule"| n0
  class e0 edge_registration
  n2 e1@-->|"参数 / 查询数据"| n0
  class e1 edge_reference
  n3 e2@-->|"参数 / 查询数据"| n0
  class e2 edge_reference
  n4 e3@--> n0
  class e3 edge_read
  n5 e4@--> n0
  class e4 edge_read
  n6 e5@--> n0
  class e5 edge_read
  n7 e6@-->|"存在 / 变更过滤"| n0
  class e6 edge_reference
  n8 e7@-->|"存在 / 变更过滤"| n0
  class e7 edge_reference
  n9 e8@-->|"存在 / 变更过滤"| n0
  class e8 edge_reference
  n5 e9@---|"延迟添加"| n0
  class e9 edge_write
  n5 e10@---|"延迟移除"| n0
  class e10 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
