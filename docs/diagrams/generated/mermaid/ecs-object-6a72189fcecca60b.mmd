---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: spawn_menu_controller · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**spawn_menu_controller**<br/>创建菜单动作控制者及键盘、手柄绑定。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · Startup**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: rounded, label: "**MenuContext**<br/>标记独立于玩法的菜单动作上下文。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**ContextPriority**<br/>来自Enhanced Input ↗：设置菜单动作高<br/>于玩法的输入评估优先级。" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: rounded, label: "**GamepadDevice**<br/>来自Enhanced Input ↗：配置菜单接受的<br/>手柄输入来源。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**Actions**<br/>来自Enhanced Input ↗：索引控制上下文<br/>拥有的动作实体。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: rounded, label: "**ContextActivity**<br/>来自Enhanced Input ↗：保存动作上下文<br/>的启用状态。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: fr-rect, label: "**GameUiPlugin**<br/>管理菜单、设置编辑、导航与主菜单展示场<br/>景。" }
  class n7 node_plugin
  n1 e0@-->|"main / Startup"| n0
  class e0 edge_registration
  n0 e1@-->|"添加"| n2
  class e1 edge_write
  n0 e2@-->|"添加"| n3
  class e2 edge_write
  n0 e3@-->|"添加"| n4
  class e3 edge_write
  n0 e4@-->|"添加"| n5
  class e4 edge_write
  n0 e5@-->|"可变访问"| n6
  class e5 edge_write
  n7 e6@--> n0
  class e6 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
