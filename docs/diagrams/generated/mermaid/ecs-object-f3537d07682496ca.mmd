  class n0 node_resource
  n1@{ shape: rounded, label: "**prepare​_​mesh2d​_​bind​_​group**<br/>来自crate:bevy​_​sprite​_​render ↗：按网<br/>格元数据分配块建立二维网格绑定组。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**prepare​_​mesh​_​bind​_​groups**<br/>来自crate:bevy​_​pbr ↗：按预处理路径准<br/>备网格、蒙皮和形变资源绑定。" }
