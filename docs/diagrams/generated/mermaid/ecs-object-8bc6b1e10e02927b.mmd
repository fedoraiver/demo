---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-8bc6b1e10e02927b-e17{marker-start:url(#object-8bc6b1e10e02927b_flowchart-v2-pointStart)!important}\n#object-8bc6b1e10e02927b-e22{marker-start:url(#object-8bc6b1e10e02927b_flowchart-v2-pointStart)!important}\n#object-8bc6b1e10e02927b_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Camera3d · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Camera3d**<br/>启用三维相机主渲染流程。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update_mesh_previous_global_**<br/>**transforms**<br/>为下帧保存网格的当前世界变换。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update_previous_view_data**<br/>记录三维及阴影视图未抖动的变换矩阵。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**spawn_gizmo_meshes**<br/>创建变换操作器各轴网格、材质和覆盖相机。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**extract_ui_camera_view**<br/>为活动二维或三维相机维护独立 UI 视图。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**extract_components#lt;bevy_camera::**<br/>**components::Camera3d, bevy_render::**<br/>**RenderApp, ()#gt;**<br/>对已同步到子世界的实体读取<br/>ExtractComponent 指定的查询数据，批量<br/>写入转换后的目标组件；转换返回 None 时<br/>移除对应目标组件。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**extract_core_3d_camera_phases**<br/>为活动三维相机准备主渲染阶段。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**extract_camera_prepass_phase**<br/>同步三维相机的预通道标记与渲染阶段。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**extract_camera_previous_view_data**<br/>把活动三维相机的前帧视图数据提取到渲染<br/>侧。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**gather_light_probes#lt;bevy_light::**<br/>**probe::EnvironmentMapLight#gt;**<br/>按相机可见集合和距离分配已就绪光照探针。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**gather_light_probes#lt;bevy_light::**<br/>**probe::IrradianceVolume#gt;**<br/>按相机可见集合和距离分配已就绪光照探针。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**extract_transmissive_camera_phases**<br/>为活动三维相机准备本帧透射阶段并清理失效<br/>视图。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**extract_atmosphere**<br/>为每个启用 AtmosphereSettings 的三维<br/>相机选择世界距离最近的大气实体，复制大气<br/>和 GPU 设置到渲染世界；设置移除或没有候<br/>选大气时清理旧状态。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**extract_ssao_settings**<br/>向渲染相机提取屏幕空间环境光遮蔽配置。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**prepare_lights**<br/>汇总提取后的各类光源，为视图准备光照<br/>GPU 参数、聚簇索引及阴影贴图和阴影视<br/>图，维护对应缓存及阶段记录，并检查设备和<br/>实现支持的数量限制。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**configure_occlusion_culling_view_**<br/>**targets**<br/>让遮挡剔除相机的深度纹理可被采样。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**configure_camera_depth_usages**<br/>允许 OIT 相机采样自己的深度纹理。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**prepare_view_depth_texture_usages_**<br/>**for_motion_blur**<br/>让运动模糊相机的深度纹理可被采样。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**configure_depth_of_field_view_**<br/>**targets**<br/>允许景深相机采样自己的深度纹理。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**prepare_taa_jitter**<br/>为 TAA 相机逐帧设置 Halton 投影抖动。" }
  class n19 node_system
  n20@{ shape: rounded, label: "**configure_camera_depth_usages**<br/>允许大气相机的深度纹理被着色器采样。" }
  class n20 node_system
  n21@{ shape: rounded, label: "**prepare_core_3d_depth_textures**<br/>按共享目标准备三维深度纹理与清除方式。" }
  class n21 node_system
  n22@{ shape: rounded, label: "**prepare_previous_view_uniforms**<br/>重建前帧抖动矩阵并上传视图历史参数。" }
  class n22 node_system
  n23@{ shape: rounded, label: "**prepare_atmosphere_transforms**<br/>按相机位置构造大气局部坐标变换。" }
  class n23 node_system
  n24@{ shape: rounded, label: "**prepare_atmosphere_bind_groups**<br/>为大气查找表计算和天空绘制绑定视图资源。" }
  class n24 node_system
  n25@{ shape: rounded, label: "**prepare_view_depth_textures_for_**<br/>**volumetric_fog**<br/>允许体积雾着色器读取三维相机深度纹理。" }
  class n25 node_system
