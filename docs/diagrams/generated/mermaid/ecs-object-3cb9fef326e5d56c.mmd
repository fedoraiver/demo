---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: WorldInstanceSpawner · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**WorldInstanceSpawner**<br/>管理世界资产的同步及排队生成、销毁和热更<br/>新" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**world_instance_spawner**<br/>根据世界资产根组件排队生成或替换实例。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**world_instance_spawner_system**<br/>清除父实体已失效的待加载实例，消费<br/>WorldAsset 和 DynamicWorld 资产变化，<br/>执行排队的生成、销毁及实例更新，并触发已<br/>经装配完成的实例就绪事件。" }
  class n2 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@-->|"正文可变访问"| n0
  class e1 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
