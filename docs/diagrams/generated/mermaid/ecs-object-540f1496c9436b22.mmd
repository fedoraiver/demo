---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: camera_system · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**camera_system**<br/>响应窗口创建、尺寸与缩放变化及图像目标变<br/>化，更新 Camera 与 Projection 的目标<br/>尺寸和投影信息；只读取相机实际引用的图像<br/>目标。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PostStartup**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**CameraUpdateSystems**<br/>统一更新相机目标、视口与投影计算结果。" }
  class n2 node_system_set
  n3@{ shape: cyl, label: "**Messages#lt;WindowResized#gt;**<br/>保存 WindowResized 消息。" }
  class n3 node_message_buffer
  n4@{ shape: cyl, label: "**Messages#lt;WindowCreated#gt;**<br/>保存 WindowCreated 消息。" }
  class n4 node_message_buffer
  n5@{ shape: cyl, label: "**Messages#lt;WindowScaleFactorChanged#gt;**<br/>保存 WindowScaleFactorChanged 消息。" }
  class n5 node_message_buffer
  n6@{ shape: cyl, label: "**Messages#lt;AssetEvent#lt;Image#gt;#gt;**<br/>保存 AssetEvent#lt;Image#gt; 消息。" }
  class n6 node_message_buffer
  n7@{ shape: rounded, label: "**PrimaryWindow**<br/>标识唯一的主窗口" }
  class n7 node_component
  n8@{ shape: rounded, label: "**Window**<br/>保存窗口的呈现模式、位置、分辨率、标题、<br/>全屏及平台行为配置" }
  class n8 node_component
  n9@{ shape: cyl, label: "**Assets#lt;Image#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n9 node_resource
  n10@{ shape: cyl, label: "**ManualTextureViews**<br/>注册供相机输出的手动管理纹理视图。" }
  class n10 node_resource
  n11@{ shape: rounded, label: "**Camera**<br/>配置相机视口、输出目标和渲染顺序。" }
  class n11 node_component
  n12@{ shape: rounded, label: "**RenderTarget**<br/>指定相机输出的窗口、图像或纹理。" }
  class n12 node_component
  n13@{ shape: rounded, label: "**Projection**<br/>定义相机从视图到裁剪空间的投影。" }
  class n13 node_component
  n1 e0@-->|"main / PostStartup"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n3 e2@--> n0
  class e2 edge_consume
  n4 e3@--> n0
  class e3 edge_consume
  n5 e4@--> n0
  class e4 edge_consume
  n6 e5@--> n0
  class e5 edge_consume
  n7 e6@-->|"存在 / 变更过滤"| n0
  class e6 edge_reference
  n8 e7@--> n0
  class e7 edge_read
  n9 e8@--> n0
  class e8 edge_read
  n10 e9@--> n0
  class e9 edge_read
  n0 e10@--> n11
  class e10 edge_write
  n12 e11@--> n0
  class e11 edge_read
  n0 e12@--> n13
  class e12 edge_write
