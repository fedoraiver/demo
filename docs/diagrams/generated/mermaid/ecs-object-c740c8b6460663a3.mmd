  n6@{ shape: rounded, label: "**Position**<br/>来自crate:avian3d ↗：保存刚体或碰撞体<br/>的世界位置。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**AngularVelocity**<br/>来自crate:avian3d ↗：保存刚体的世界角<br/>速度。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**Character**<br/>来自character ↗：具有移动和跳跃能力的<br/>角色。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**Rotation**<br/>来自crate:avian3d ↗：保存刚体或碰撞体<br/>的世界旋转。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: rounded, label: "**HeldBy**<br/>物体的持有者；只由交互系统插入或移除。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**align​_​attachments**<br/>有限的小步对齐不会积分箱体力；受阻保留安<br/>全姿态，持续受阻则解除持握。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**ComputedCenterOfMass**<br/>来自crate:avian3d ↗：保存汇总后的刚体<br/>局部质心。" }
  class n12 node_component
  class n12 external_node
  n13@{ shape: lin-rect, label: "**Attachment**<br/>来自game​_​flow ↗：固定模拟阶段；结构变<br/>更在依赖阶段之间提交。" }
  class n13 node_system_set
  class n13 external_node
  n14@{ shape: rounded, label: "**HeldAttachment**<br/>实际碰撞形状相对组合刚体的姿态；箱实体不<br/>成为人物的 ChildOf，避免异常销毁时连带<br/>消失。" }
  class n14 node_component
  n15@{ shape: rounded, label: "**Pickable**<br/>允许被拾取的能力标签。" }
  class n15 node_component
  n16@{ shape: rounded, label: "**HeldCollider**<br/>无视觉碰撞代理对应的物品身份；代理随组合<br/>体清理，业务根始终独立。" }
