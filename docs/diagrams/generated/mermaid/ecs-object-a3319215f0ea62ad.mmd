---
flowchart LR
  accTitle: UiSystems::Propagate · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**UiSystems::Propagate**<br/>沿 UI 层级传播布局所需的组件值。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**main · PostUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**PropagateSet · { _p:**<br/>**PhantomData#lt;fn() -#gt; bevy_ui::ui_**<br/>**node::ComputedUiTargetCamera#gt; }**<br/>沿关系层级传播指定组件值。" }
  class n2 node_system_set
  n3@{ shape: lin-rect, label: "**PropagateSet · { _p:**<br/>**PhantomData#lt;fn() -#gt; bevy_ui::ui_**<br/>**node::ComputedUiRenderTargetInfo#gt; }**<br/>沿关系层级传播指定组件值。" }
  class n3 node_system_set
  n4@{ shape: lin-rect, label: "**UiSystems::Prepare**<br/>建立 PostUpdate 中 UI 更新的准备边界。" }
  class n4 node_system_set
  n5@{ shape: lin-rect, label: "**UiSystems::Content**<br/>在 UI 布局前测量文字和内容需求。" }
  class n5 node_system_set
  n1 e0@-->|"main / PostUpdate"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n4 e3@--> n0
  class e3 edge_order
  n0 e4@--> n5
  class e4 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
