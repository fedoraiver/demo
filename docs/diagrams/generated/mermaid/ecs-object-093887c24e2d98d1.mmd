---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: UpdateLightFrusta · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**UpdateLightFrusta**<br/>组织灯光聚簇与可见性准备。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**check​_​point​_​light​_​mesh​_​visibility**<br/>计算点光与聚光灯阴影可见的网格。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**check​_​dir​_​light​_​mesh​_​visibility**<br/>计算方向光各相机级联可见的投影网格。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update​_​directional​_​light​_​frusta**<br/>从方向光级联投影更新阴影视锥。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**update​_​point​_​light​_​frusta**<br/>更新可见点光的六面阴影视锥。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update​_​spot​_​light​_​frusta**<br/>更新可见聚光灯的阴影视锥。" }
  class n5 node_system
  n0 e0@-->|"先于"| n1
  class e0 edge_order
  n0 e1@-->|"先于"| n2
  class e1 edge_order
  n0 e2@-->|"集合成员"| n3
  class e2 edge_set_membership
  n0 e3@-->|"集合成员"| n4
  class e3 edge_set_membership
  n0 e4@-->|"集合成员"| n5
  class e4 edge_set_membership
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
