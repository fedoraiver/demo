---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: item_interaction::components::Item · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Item**<br/>物品身份与种类；拾取能力由 Pickable 单<br/>独表达。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**emit​_​item​_​land**<br/>检测自由物品支撑撞击并锁存一次落地音效。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**spawn​_​actors · 创建模板**<br/>来自scene​_​assembly ↗：承载海岛物品的<br/>种类、拾取能力、握点和出生姿态。" }
  class n2 node_entity
  class n2 external_node
  n3@{ shape: rounded, label: "**warn​_​hold​_​strain**<br/>持续偏离实际握点时提示一次，误差恢复后允<br/>许下一次告警。" }
  class n3 node_system
  n0 e0@-->|"存在性约束"| n1
  class e0 edge_reference
  n2 e1@-->|"可能包含"| n0
  class e1 edge_reference
  n0 e2@-->|"存在性约束"| n3
  class e2 edge_reference
  e0@{ curve: basis }
  e2@{ curve: basis }
