---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-dd7f409245575a20-e5{marker-start:url(#object-dd7f409245575a20_flowchart-v2-pointStart)!important}\n#object-dd7f409245575a20_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: ScaleEasingState · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ScaleEasingState**<br/>保存固定步缩放插值的起点与终点" }
  class n0 node_component
  n1@{ shape: rounded, label: "**ease​_​scale​_​lerp**<br/>按固定步剩余比例线性插值显示缩放。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update​_​scale​_​interpolation​_​end**<br/>把当前缩放记录为插值终点。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**reset​_​scale​_​easing**<br/>清除旧缩放平滑的起点和终点。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**complete​_​scale​_​easing**<br/>在新一轮插值前完成上一段缩放。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**reset​_​easing​_​states​_​on​_​transform​_​**<br/>**change**<br/>在外部直接改变变换时取消失效的平滑区间。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update​_​scale​_​interpolation​_​start**<br/>把当前缩放记录为插值起点。" }
  class n6 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"赋值"| n0
  class e1 edge_write
  n3 e2@-->|"可变访问"| n0
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_read
  n5 e4@-->|"可变访问"| n0
  class e4 edge_write
  n5 e5@---|"存在性约束"| n0
  class e5 edge_reference
  n2 e6@-->|"可变访问"| n0
  class e6 edge_write
  n6 e7@-->|"可变访问"| n0
  class e7 edge_write
  n6 e8@-->|"赋值"| n0
  class e8 edge_write
  n5 e9@-->|"赋值"| n0
  class e9 edge_write
  n3 e10@-->|"赋值"| n0
  class e10 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
