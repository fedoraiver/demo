---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: update_pending · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**update_pending**<br/>调用 InputReader 的待处理输入更新逻<br/>辑，消费上一阶段排队的绑定与重置操作，使<br/>本轮上下文评估使用更新后的输入读取状态。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PreUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**EnhancedInputSystems::Prepare**<br/>准备动作评估并清理待释放的输入。" }
  class n2 node_system_set
  n3@{ shape: notch-rect, label: "**InputReader**<br/>聚合键盘、鼠标、手柄和自定义输入" }
  class n3 node_system_param
  n4@{ shape: cyl, label: "**ButtonInput#lt;KeyCode#gt;**<br/>来自Bevy 引擎 ↗：保存指定按钮类型当前<br/>按下、本帧刚按下和刚释放的集合" }
  class n4 node_resource
  class n4 external_node
  n5@{ shape: cyl, label: "**ButtonInput#lt;MouseButton#gt;**<br/>来自Bevy 引擎 ↗：保存指定按钮类型当前<br/>按下、本帧刚按下和刚释放的集合" }
  class n5 node_resource
  class n5 external_node
  n6@{ shape: cyl, label: "**AccumulatedMouseMotion**<br/>来自Bevy 引擎 ↗：汇总本帧鼠标位移供观<br/>察动作使用。" }
  class n6 node_resource
  class n6 external_node
  n7@{ shape: cyl, label: "**ActionSources**<br/>配置输入框架允许使用的输入来源。" }
  class n7 node_resource
  n8@{ shape: cyl, label: "**CustomInputs**<br/>保存自定义输入编号到动作值的映射" }
  class n8 node_resource
  n9@{ shape: cyl, label: "**ConsumedInputs**<br/>记录本轮动作评估已经消费的输入。" }
  class n9 node_resource
  n10@{ shape: cyl, label: "**PendingBindings**<br/>保存上下文停用后仍需重置的输入绑定。" }
  class n10 node_resource
  n11@{ shape: notch-rect, label: "**GamepadDevice**<br/>保存输入读取器当前选择的游戏手柄。" }
  class n11 node_local
  n12@{ shape: notch-rect, label: "**bool**<br/>来自Bevy 引擎 ↗：控制输入读取器是否跳<br/>过忽略绑定检查。" }
  class n12 node_local
  class n12 external_node
  n1 e0@-->|"main / PreUpdate"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n3 e2@-->|"参数 / 查询数据"| n0
  class e2 edge_reference
  n4 e3@--> n0
  class e3 edge_read
  n5 e4@--> n0
  class e4 edge_read
  n6 e5@--> n0
  class e5 edge_read
  n7 e6@--> n0
  class e6 edge_read
  n8 e7@--> n0
  class e7 edge_read
  n0 e8@--> n9
  class e8 edge_write
  n0 e9@--> n10
  class e9 edge_write
  n0 e10@--> n11
  class e10 edge_write
  n0 e11@--> n12
  class e11 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: bumpX }
  e10@{ curve: basis }
  e11@{ curve: basis }
