---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: EguiRenderData · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**EguiRenderData**<br/>缓存 EguiPipeline 各特化实例的渲染管线<br/>身份" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**prepare_egui_pass**<br/>消费每个 Egui 视图暂缓处理的绘制回调更<br/>新，构造视口、裁剪、像素比例和目标尺寸信<br/>息，并在当前渲染世界调用回调的 update。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**egui_pass**<br/>读取当前 Egui 视图已准备的绘制数据、纹<br/>理绑定及变换缓冲，在目标颜色附件上执行<br/>Egui 绘制命令，并按相机视口设置渲染范<br/>围。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare_egui_pass**<br/>消费每个 Egui 视图暂缓处理的绘制回调更<br/>新，构造视口、裁剪、像素比例和目标尺寸信<br/>息，并在当前渲染世界调用回调的 update。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**egui_pass**<br/>读取当前 Egui 视图已准备的绘制数据、纹<br/>理绑定及变换缓冲，在目标颜色附件上执行<br/>Egui 绘制命令，并按相机视口设置渲染范<br/>围。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**prepare_egui_render_target_data_**<br/>**system**<br/>准备 Egui 顶点索引和裁剪绘制命令。" }
  class n5 node_system
  n1 e0@-->|"正文可变访问"| n0
  class e0 edge_write
  n0 e1@-->|"正文只读访问"| n2
  class e1 edge_read
  n3 e2@-->|"正文可变访问"| n0
  class e2 edge_write
  n0 e3@-->|"正文只读访问"| n4
  class e3 edge_read
  n5 e4@--> n0
  class e4 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
