---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: SolverBodyIndex · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**SolverBodyIndex**<br/>定位实体对应的求解器刚体。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**clear_velocity_increments**<br/>在子步循环后清零速度积分增量。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**writeback_solver_bodies**<br/>将求解后的位姿和速度回写 ECS。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare_solver_bodies**<br/>把 ECS 刚体状态准备成子步求解数据。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**apply_constant_torques**<br/>按求解器有效惯量换算世界恒定扭矩。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**solve_continuous**<br/>对单步位移相对厚度过大的动态刚体执行连续<br/>碰撞扫掠；发现碰撞时缩短累计运动，使刚体<br/>停在首次撞击位置，并保留后续接触处理所需<br/>信息。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_solver_body_aabbs#lt;avian3d::**<br/>**collision::collider::parry::**<br/>**Collider#gt;**<br/>按物理结果更新活跃刚体的碰撞边界。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**update_sleeping_states**<br/>按刚体静止时间判断物理岛的休眠资格。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**apply_local_acceleration**<br/>在子步中把局部加速度作用到世界速度。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**integrate_velocities**<br/>对采用默认速度积分的活跃动态刚体，先应用<br/>线性和角速度阻尼，再累加当前步的速度增<br/>量；运动学刚体跳过该积分，并记录诊断耗<br/>时。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**clamp_velocities**<br/>分别按 MaxLinearSpeed 和<br/>MaxAngularSpeed 限制求解器刚体的速度大<br/>小，超过上限时保持方向缩放；线速度和角速<br/>度查询通过 ParamSet 分开访问。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**update_solver_body_angular_inertia**<br/>按当前朝向刷新求解器的有效逆惯量。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**joint_damping#lt;avian3d::dynamics::**<br/>**joints::fixed::FixedJoint#gt;**<br/>读取指定关节及 JointDamping，查找两端<br/>刚体的求解器索引并按时间步修正相对速度；<br/>静态端使用占位刚体，同一索引不重复处理。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**joint_damping#lt;avian3d::dynamics::**<br/>**joints::revolute::RevoluteJoint#gt;**<br/>读取指定关节及 JointDamping，查找两端<br/>刚体的求解器索引并按时间步修正相对速度；<br/>静态端使用占位刚体，同一索引不重复处理。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**joint_damping#lt;avian3d::dynamics::**<br/>**joints::spherical::SphericalJoint#gt;**<br/>读取指定关节及 JointDamping，查找两端<br/>刚体的求解器索引并按时间步修正相对速度；<br/>静态端使用占位刚体，同一索引不重复处理。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**joint_damping#lt;avian3d::dynamics::**<br/>**joints::prismatic::PrismaticJoint#gt;**<br/>读取指定关节及 JointDamping，查找两端<br/>刚体的求解器索引并按时间步修正相对速度；<br/>静态端使用占位刚体，同一索引不重复处理。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**joint_damping#lt;avian3d::dynamics::**<br/>**joints::distance::DistanceJoint#gt;**<br/>读取指定关节及 JointDamping，查找两端<br/>刚体的求解器索引并按时间步修正相对速度；<br/>静态端使用占位刚体，同一索引不重复处理。" }
  class n16 node_system
  n0 e0@-->|"存在 / 变更过滤"| n1
  class e0 edge_reference
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  n0 e4@--> n5
  class e4 edge_read
  n0 e5@-->|"存在 / 变更过滤"| n6
  class e5 edge_reference
  n0 e6@--> n7
  class e6 edge_read
  n0 e7@--> n8
  class e7 edge_read
  n0 e8@--> n9
  class e8 edge_read
  n0 e9@--> n10
  class e9 edge_read
  n0 e10@--> n11
  class e10 edge_read
  n0 e11@--> n12
  class e11 edge_read
  n0 e12@--> n13
  class e12 edge_read
  n0 e13@--> n14
  class e13 edge_read
  n0 e14@--> n15
  class e14 edge_read
  n0 e15@--> n16
  class e15 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
