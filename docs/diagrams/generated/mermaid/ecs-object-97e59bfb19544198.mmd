---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: queue_shadows · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**queue_shadows**<br/>遍历各阴影视图中可见的网格，按专用材质管<br/>线、渲染层及投影资格更新阴影分桶；移除失<br/>效项，将资产或管线尚未就绪的网格留到后续<br/>重试。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · Render**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**RenderSystems::QueueMeshes**<br/>在网格资产准备后排入网格绘制项。" }
  class n2 node_system_set
  n3@{ shape: cyl, label: "**RenderMeshInstances**<br/>保存 CPU 或 GPU 构建所需的网格实例。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**ErasedRenderAssets#lt;PreparedMaterial#gt;**<br/>存储源资产对应的类型擦除 GPU 表示。" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**RenderMaterialInstances**<br/>保存提取后的实体材质实例。" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**ViewBinnedRenderPhases#lt;Shadow#gt;**<br/>汇集各视图按分桶组织的绘制指令。" }
  class n6 node_resource
  n7@{ shape: cyl, label: "**GpuPreprocessingSupport**<br/>记录设备可采用的 GPU 预处理级别。" }
  class n7 node_resource
  n8@{ shape: cyl, label: "**MeshAllocator**<br/>分配并管理网格顶点和索引 GPU 缓冲。" }
  class n8 node_resource
  n9@{ shape: rounded, label: "**LightEntity**<br/>标识阴影视图对应的光源面或级联。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**ExtractedView**<br/>描述渲染视图的身份、投影与空间状态。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**RenderLayers**<br/>限定相机与实体可相交的渲染层。" }
  class n11 node_component
  n12@{ shape: rounded, label: "**RenderShadowMapVisibleEntities**<br/>保存每个阴影子视图最终收集的可见实体。" }
  class n12 node_component
  n13@{ shape: cyl, label: "**SpecializedShadowMaterialPipelineCac**<br/>**he**<br/>按光源视图缓存材质阴影专用管线。" }
  class n13 node_resource
  n14@{ shape: cyl, label: "**PendingShadowQueues**<br/>暂存因材质未就绪而无法排队的阴影网格。" }
  class n14 node_resource
  n15@{ shape: cyl, label: "**DirtySpecializations**<br/>记录需刷新或移除管线专用化的对象与视图。" }
  class n15 node_resource
  n16@{ shape: notch-rect, label: "**MainEntityHashSet**<br/>去重阴影阶段本轮需要排队的网格实例。" }
  class n16 node_local
