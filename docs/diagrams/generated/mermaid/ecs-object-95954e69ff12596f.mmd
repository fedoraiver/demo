---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-95954e69ff12596f-e7{marker-start:url(#object-95954e69ff12596f_flowchart-v2-pointStart)!important}\n#object-95954e69ff12596f-e9{marker-start:url(#object-95954e69ff12596f_flowchart-v2-pointStart)!important}\n#object-95954e69ff12596f-e12{marker-start:url(#object-95954e69ff12596f_flowchart-v2-pointStart)!important}\n#object-95954e69ff12596f_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: LinearVelocity · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**LinearVelocity**<br/>实际线速度，由冲量、外力、重力与接触求解<br/>改变。" }
  class n0 node_component
  n1@{ shape: notch-rect, label: "**RecoverableBody**<br/>来自越界恢复 ↗：声明落水恢复需要查询的<br/>组件与存在条件。" }
  class n1 node_query_data
  class n1 external_node
  n2@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n2 node_entity
  class n2 external_node
  n3@{ shape: rounded, label: "**update_grounded**<br/>来自角色运动 ↗：准备运动前更新接地状<br/>态。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**update_grounded**<br/>来自角色运动 ↗：物理回写之后观察实际接<br/>地状态。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**log_character_velocity**<br/>来自角色运动 ↗：定期记录角色实际速度与<br/>接地状态。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**initialize_ready_couriers**<br/>来自角色动画 ↗：绑定主角命名动画并缓存<br/>鞋底补偿节点。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**sync_courier_animation**<br/>来自角色动画 ↗：按角色运动状态连续混合<br/>移动与跳跃动画。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**move_characters**<br/>来自角色运动 ↗：按移动意图和速度为角色<br/>施加水平运动力。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**jump_characters**<br/>来自角色运动 ↗：执行角色跳跃并消费单次<br/>请求。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: lin-rect, label: "**PhysicsSystems::Prepare**<br/>准备物理步所需的位姿、质量与碰撞查询数<br/>据。" }
  class n10 node_system_set
  n11@{ shape: lin-rect, label: "**PhysicsSystems::StepSimulation**<br/>执行碰撞求解、重力积分与刚体运动。" }
  class n11 node_system_set
  n12@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n12 node_system
  class n12 external_node
  n13@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：按人物物理姿态同步持物<br/>位置与碰撞代理。" }
  class n13 node_system
  class n13 external_node
  n14@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：按最新物理位姿同步持物<br/>与碰撞代理。" }
  class n14 node_system
  class n14 external_node
  n15@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：同步本帧持物碰撞朝向与<br/>显示朝向。" }
  class n15 node_system
  class n15 external_node
