---
flowchart LR
  accTitle: box_shadow::BoxShadowPipeline · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**box​_​shadow::BoxShadowPipeline**<br/>提供 UI 方框阴影的视图布局和着色器。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**bevy​_​ui​_​render::box​_​shadow::init​_​**<br/>**box​_​shadow​_​pipeline**<br/>建立 UI 盒阴影的视图布局和着色器资源。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**bevy​_​ui​_​render::box​_​shadow::queue​_​**<br/>**shadows**<br/>为提取的 UI 阴影选择匹配目标格式和阴影<br/>采样数的管线，按节点堆叠顺序及阴影层偏移<br/>加入透明 UI 绘制阶段。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**bevy​_​ui​_​render::box​_​shadow::prepare​_​**<br/>**shadows**<br/>生成并上传 UI 阴影的裁剪几何。" }
  class n3 node_system
  n1 e0@-->|"插入"| n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  e1@{ curve: basis }
  e2@{ curve: basis }
