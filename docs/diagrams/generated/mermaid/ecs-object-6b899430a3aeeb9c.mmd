  class n2 external_node
  n3@{ shape: cyl, label: "**MainWorld**<br/>在提取阶段临时提供主模拟世界。" }
  class n3 node_resource
  n4@{ shape: rounded, label: "**SubEntity#lt;RenderApp#gt;**<br/>记录主实体对应的子世界实体。" }
  class n4 node_component
  n5@{ shape: notch-rect, label: "**Local · arg1**<br/>按上次组件提取数量预留输出容量。" }
  class n5 node_local
  n6@{ shape: rounded, label: "**AtmosphereEnvironmentMap**<br/>来自crate:bevy​_​pbr ↗：保存由大气渲染<br/>更新的环境贴图。" }
