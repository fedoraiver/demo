---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Messages<UiRequest> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Messages#lt;UiRequest#gt;**<br/>缓冲鼠标与动作输入共用的菜单请求。" }
  class n0 node_message_buffer
  n1@{ shape: hex, label: "**left**<br/>向左调整当前聚焦的真实设置字段。" }
  class n1 node_observer
  n2@{ shape: hex, label: "**right**<br/>向右调整当前聚焦的真实设置字段。" }
  class n2 node_observer
  n3@{ shape: hex, label: "**confirm**<br/>执行当前聚焦按钮的菜单动作。" }
  class n3 node_observer
  n4@{ shape: hex, label: "**back**<br/>发出返回、暂停或恢复请求。" }
  class n4 node_observer
  n5@{ shape: rounded, label: "**handle_requests**<br/>处理菜单导航、设置应用与音量编辑请求。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**pointer_interaction**<br/>将真实鼠标交互转换为共享菜单请求。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**sample_slider_pointer**<br/>从光标位置生成音量采样与释放请求。" }
  class n7 node_system
  n1 e0@--> n0
  class e0 edge_publish
  n2 e1@--> n0
  class e1 edge_publish
  n3 e2@--> n0
  class e2 edge_publish
  n4 e3@--> n0
  class e3 edge_publish
  n0 e4@--> n5
  class e4 edge_consume
  n6 e5@-->|"访问声明"| n0
  class e5 edge_publish
  n7 e6@-->|"访问声明"| n0
  class e6 edge_publish
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
