---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: RenderApp · RenderGraph · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**RenderApp · RenderGraph**<br/>保存本应用调度的注册上下文与成员。" }
  class n0 node_engine_flow
  n1@{ shape: rounded, label: "**update_sparse_buffers**<br/>用计算通道把变化元素写入稀疏 GPU 缓冲。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**camera_driver**<br/>遍历辅助根视图及已排序相机，为有效视图设<br/>置 CurrentView 并运行其专属渲染调度；<br/>跳过失效窗口目标，结束后移除<br/>CurrentView 并记录本帧相机覆盖的窗口集<br/>合。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**submit_pending_command_buffers**<br/>将排队完成的渲染命令缓冲提交到 GPU。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**handle_uncovered_swap_chains**<br/>清除本帧没有相机覆盖的窗口交换链。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**ApplyDeferred**<br/>在调度建立的同步点应用前序系统暂存的<br/>Commands 等延迟操作，使后续系统可以观察<br/>到结构变化；此卡片是 ApplyDeferred 的<br/>System 实现。" }
  class n5 node_sync
  n6@{ shape: lin-rect, label: "**RenderGraphSystems::Begin**<br/>在相机渲染前执行本帧渲染准备。" }
  class n6 node_system_set
  n7@{ shape: lin-rect, label: "**RenderGraphSystems::Render**<br/>驱动各相机的实际渲染流水线。" }
  class n7 node_system_set
  n8@{ shape: lin-rect, label: "**RenderGraphSystems::Submit**<br/>提交相机渲染产生的待处理命令缓冲。" }
  class n8 node_system_set
  n9@{ shape: lin-rect, label: "**RenderGraphSystems::Finish**<br/>在渲染和命令提交后执行本帧收尾。" }
  class n9 node_system_set
  n0 e0@-->|"RenderApp / RenderGraph"| n1
  class e0 edge_registration
  n0 e1@-->|"RenderApp / RenderGraph"| n2
  class e1 edge_registration
  n0 e2@-->|"RenderApp / RenderGraph"| n3
  class e2 edge_registration
  n0 e3@-->|"RenderApp / RenderGraph"| n4
  class e3 edge_registration
  n0 e4@-->|"RenderApp / RenderGraph"| n5
  class e4 edge_registration
  n0 e5@-->|"RenderApp / RenderGraph"| n6
  class e5 edge_registration
  n0 e6@-->|"RenderApp / RenderGraph"| n7
  class e6 edge_registration
  n0 e7@-->|"RenderApp / RenderGraph"| n8
  class e7 edge_registration
  n0 e8@-->|"RenderApp / RenderGraph"| n9
  class e8 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
