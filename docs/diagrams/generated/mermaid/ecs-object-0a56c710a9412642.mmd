{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: ValueChange#lt;std::option::Option#lt;bevy_ecs::entity::Entity#gt;#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**ValueChange#lt;Option#lt;Entity#gt;#gt;**<br/>传递控件提出的新值。" }
  class n0 node_event
  n1@{ shape: hex, label: "**tab​_​on​_​key​_​input**<br/>用键盘导航并激活标签页。" }
  class n1 node_observer
  n2@{ shape: hex, label: "**tablist​_​on​_​click**<br/>点击可用标签时请求切换选择。" }
  class n2 node_observer
  n3@{ shape: hex, label: "**tablist​_​on​_​click**<br/>点击可用标签时请求切换选择。" }
  class n3 node_observer
  n4@{ shape: hex, label: "**tab​_​on​_​key​_​input**<br/>用键盘导航并激活标签页。" }
  class n4 node_observer
  n5@{ shape: hex, label: "**tablist​_​on​_​click**<br/>点击可用标签时请求切换选择。" }
  class n5 node_observer
  n6@{ shape: hex, label: "**tab​_​on​_​key​_​input**<br/>用键盘导航并激活标签页。" }
  class n6 node_observer
  n1 e0@-->|"触发事件"| n0
  class e0 edge_emit
  n2 e1@-->|"触发事件"| n0
  class e1 edge_emit
  n3 e2@-->|"触发事件"| n0
  class e2 edge_emit
  n4 e3@-->|"触发事件"| n0
  class e3 edge_emit
  n5 e4@-->|"触发事件"| n0
  class e4 edge_emit
  n6 e5@-->|"触发事件"| n0
  class e5 edge_emit
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
