---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: TaaPipeline · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**TaaPipeline**<br/>提供时域抗锯齿的采样与管线资源。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**temporal_anti_alias**<br/>混合当前颜色与历史帧并更新 TAA 历史目<br/>标。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare_taa_pipelines**<br/>准备 TAA 当前状态及下一帧恢复用管线。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**init_taa_pipeline**<br/>建立 TAA 的当前帧、历史帧和预通道输入布<br/>局。" }
  class n3 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@-->|"延迟添加"| n0
  class e2 edge_write
  e1@{ curve: basis }
  e2@{ curve: basis }
