---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: ExtractedInstances<EnvironmentMapIds, RenderApp> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**ExtractedInstances#lt;EnvironmentMapIds**<br/>**, RenderApp#gt;**<br/>按主实体身份保存子世界提取实例。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**extract_all#lt;bevy_pbr::light_probe::**<br/>**environment_map::EnvironmentMapIds,**<br/>**bevy_render::RenderApp#gt;**<br/>清空当前 ExtractedInstances 映射，遍<br/>历主世界中符合 ExtractInstance 查询条<br/>件的实体，将成功转换的实例按主实体身份存<br/>入子世界资源。" }
  class n1 node_system
  n1 e0@--> n0
  class e0 edge_write
