flowchart LR
  accTitle: bevy_extract::extract_component::extract_components#lt;bevy_render::view::Tonemapping, bevy_render::RenderApp, ()#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**extract​_​components**<br/>批量同步或移除子世界的目标组件。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**SubEntity#lt;RenderApp#gt;**<br/>记录主实体对应的子世界实体。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**Tonemapping**<br/>来自crate:bevy​_​render ↗：选择 HDR 颜<br/>色到显示颜色的映射方式。" }
  class n2 node_component
  class n2 external_node
  n3@{ shape: cyl, label: "**MainWorld**<br/>在提取阶段临时提供主模拟世界。" }
  class n3 node_resource
  n4@{ shape: notch-rect, label: "**Local · arg1**<br/>按上次组件提取数量预留输出容量。" }
  class n4 node_local
  n5@{ shape: rounded, label: "**Camera**<br/>来自crate:bevy​_​camera ↗：配置相机视<br/>口、输出目标和渲染顺序。" }
  class n5 node_component
  class n5 external_node
  n1 e0@--> n0
  class e0 edge_read
  n2 e1@--> n0
  class e1 edge_read
  n3 e2@--> n0
  class e2 edge_read
  n2 e3@---|"移除"| n0
  class e3 edge_write
  n0 e4@-->|"可变访问"| n4
  class e4 edge_write
  n5 e5@-->|"存在性约束"| n0
  class e5 edge_reference
  e0@{ curve: basis }
