---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: UpdateFrusta · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**UpdateFrusta**<br/>组织相机与实体可见性更新。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**update​_​point​_​light​_​bounding​_​spheres**<br/>来自crate:bevy​_​light ↗：按点光位置和<br/>范围更新剔除包围球。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**update​_​spot​_​light​_​bounding​_​spheres**<br/>来自crate:bevy​_​light ↗：按聚光灯位置<br/>和范围更新剔除包围球。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**draw​_​all​_​frustum​_​gizmos**<br/>来自crate:bevy​_​gizmos ↗：绘制未单独标<br/>记实体的视锥调试图形。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**update​_​frusta**<br/>根据相机投影和世界变换更新视锥。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**add​_​light​_​probe​_​and​_​decal​_​aabbs**<br/>来自crate:bevy​_​light ↗：为光照探针和<br/>聚簇贴花补齐包围盒。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: lin-rect, label: "**CheckVisibility**<br/>组织相机与实体可见性更新。" }
  class n6 node_system_set
  n7@{ shape: lin-rect, label: "**Propagate**<br/>来自crate:bevy​_​transform ↗：组织实体<br/>层级变换传播。" }
  class n7 node_system_set
  class n7 external_node
  n8@{ shape: rounded, label: "**draw​_​frustum​_​gizmos**<br/>来自crate:bevy​_​gizmos ↗：绘制带标记实<br/>体的视锥调试图形。" }
  class n8 node_system
  class n8 external_node
  n1 e0@-->|"先于"| n0
  class e0 edge_order
  n2 e1@-->|"先于"| n0
  class e1 edge_order
  n0 e2@-->|"先于"| n3
  class e2 edge_order
  n0 e3@-->|"集合成员"| n4
  class e3 edge_set_membership
  n5 e4@-->|"先于"| n0
  class e4 edge_order
  n0 e5@-->|"先于"| n6
  class e5 edge_order
  n7 e6@-->|"先于"| n0
  class e6 edge_order
  n0 e7@-->|"先于"| n8
  class e7 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
