  n0 e10@--> n11
  class e10 edge_read
  n12 e11@-->|"延迟添加"| n0
  class e11 edge_write
  n13 e12@-->|"延迟添加"| n0
  class e12 edge_write
  n0 e13@--> n14
  class e13 edge_read
  n0 e14@--> n15
  class e14 edge_read
  n0 e15@-->|"存在 / 变更过滤"| n15
  class e15 edge_reference
