---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: AnimationSystems · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**AnimationSystems**<br/>采样动画图并更新骨骼局部姿态。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**compensate_courier_sole_penetration**<br/>来自角色动画 ↗：补偿鞋底穿地并平滑恢复<br/>视觉高度。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: stadium, label: "**main · PostUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n2 node_engine_flow
  n3@{ shape: rounded, label: "**thread_animation_graphs**<br/>维护动画图的快速求值结构。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**advance_transitions**<br/>按帧时间衰减动画过渡权重，从最近的过渡开<br/>始分配剩余权重并更新 AnimationPlayer，<br/>使过渡动画与主动画保持归一化混合。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**advance_animations**<br/>依据帧时间推进各 AnimationPlayer 正在<br/>播放的动画；结合动画图和片段时长更新播放<br/>进度及图节点对应的活动动画状态。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**animate_targets**<br/>依据目标的<br/>AnimatedBy、AnimationTargetId 和当前<br/>动画图，评估正在播放的动画并把结果写入骨<br/>骼等动画目标；缺少播放器或图资产时跳过该<br/>目标。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**trigger_untargeted_animation_events**<br/>派发动画片段的根目标事件。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**expire_completed_transitions**<br/>结束已完全淡出的动画过渡。" }
  class n8 node_system
  n9@{ shape: lin-rect, label: "**UiSystems::Prepare**<br/>建立 PostUpdate 中 UI 更新的准备边界。" }
  class n9 node_system_set
  n10@{ shape: rounded, label: "**update_text2d_layout**<br/>重新排版变化的二维文字并准备字形。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**AnimationPlayer**<br/>驱动模型的动画播放。" }
  class n11 node_component
  n12@{ shape: rounded, label: "**AnimationGraphHandle**<br/>本次绑定生成的命名动作图。" }
  class n12 node_component
  n13@{ shape: rounded, label: "**AnimationTargetId**<br/>标识需要接收动画曲线的模型节点。" }
  class n13 node_component
  n14@{ shape: rounded, label: "**AnimatedBy**<br/>关联负责采样当前节点动画的播放器。" }
  class n14 node_component
  n15@{ shape: rounded, label: "**Transform**<br/>保存骨骼或模型节点的局部动画姿态。" }
  class n15 node_component
  n16@{ shape: cyl, label: "**Assets#lt;AnimationGraph#gt;**<br/>保存模型使用的动画混合图。" }
  class n16 node_resource
  n17@{ shape: cyl, label: "**Assets#lt;AnimationClip#gt;**<br/>保存主角与展示模型使用的动画片段。" }
  class n17 node_resource
