---
flowchart LR
  accTitle: avian3d::prelude::CollisionEnd · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lean-r, label: "**CollisionEnd**<br/>报告一对碰撞体结束接触及其所属刚体。" }
  class n0 node_message
  n1@{ shape: hex, label: "**on​_​add​_​sensor**<br/>清除转为传感器前的旧接触。" }
  class n1 node_observer
  n2@{ shape: hex, label: "**remove​_​collider​_​on**<br/>清理碰撞体接触与对端碰撞记录。" }
  class n2 node_observer
  n3@{ shape: hex, label: "**on​_​remove​_​sensor**<br/>清除传感器转回普通碰撞体的旧接触。" }
  class n3 node_observer
  n4@{ shape: rounded, label: "**update​_​narrow​_​phase**<br/>更新窄相接触并输出碰撞变化消息。" }
  class n4 node_system
  n5@{ shape: hex, label: "**remove​_​body​_​on**<br/>在刚体插入或移除时清理旧接触。" }
  class n5 node_observer
  n6@{ shape: hex, label: "**on​_​disable​_​body**<br/>清理被禁用刚体的接触。" }
  class n6 node_observer
  n7@{ shape: hex, label: "**remove​_​body​_​on**<br/>在刚体插入或移除时清理旧接触。" }
  class n7 node_observer
  n8@{ shape: hex, label: "**on​_​body​_​remove​_​rigid​_​body​_​disabled**<br/>清除刚体重新启用时的旧接触。" }
  class n8 node_observer
  n9@{ shape: hex, label: "**remove​_​collider​_​on**<br/>清理碰撞体接触与对端碰撞记录。" }
  class n9 node_observer
  n10@{ shape: rounded, label: "**trigger​_​collision​_​events**<br/>把碰撞开始和结束消息触发为实体事件。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**log​_​collisions**<br/>来自physics ↗：接触开始和结束属于离散<br/>变化，通过现有文件日志设施记录碰撞双方。" }
