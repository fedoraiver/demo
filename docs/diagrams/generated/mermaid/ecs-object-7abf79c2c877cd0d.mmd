---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-7abf79c2c877cd0d-e6{marker-start:url(#object-7abf79c2c877cd0d_flowchart-v2-pointStart)!important}\n#object-7abf79c2c877cd0d_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: cleanup_background_motion_vectors · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**cleanup_background_motion_vectors**<br/>从不再启用运动矢量预通道或已标记<br/>NoBackgroundMotionVectors 的视图移除<br/>背景运动矢量管线及绑定组，清理失效渲染状<br/>态。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · Render**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**RenderSystems::Prepare**<br/>按已排序绘制项准备 GPU 资源及绑定。" }
  class n2 node_system_set
  n3@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n3 node_system_param
  n4@{ shape: rounded, label: "**BackgroundMotionVectorsPipelineId**<br/>保存相机背景运动矢量管线的标识。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**MotionVectorPrepass**<br/>为相机输出屏幕空间运动矢量。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**NoBackgroundMotionVectors**<br/>禁用相机自动生成的背景运动矢量。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**BackgroundMotionVectorsBindGroup**<br/>绑定计算背景运动矢量所需的前后帧视图参<br/>数。" }
  class n7 node_component
  n1 e0@-->|"RenderApp / Render"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n3 e2@-->|"参数 / 查询数据"| n0
  class e2 edge_reference
  n4 e3@-->|"存在 / 变更过滤"| n0
  class e3 edge_reference
  n5 e4@-->|"存在 / 变更过滤"| n0
  class e4 edge_reference
  n6 e5@-->|"存在 / 变更过滤"| n0
  class e5 edge_reference
  n4 e6@---|"延迟移除"| n0
  class e6 edge_write
  n0 e7@-->|"延迟移除"| n7
  class e7 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
