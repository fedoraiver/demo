  n3@{ shape: hex, label: "**demo::first​_​person::camera::on​_​**<br/>**camera​_​look**<br/>来自first​_​person ↗：Fire 已携带本帧汇<br/>总位移，直接更新角度；有向水平转角留给下<br/>一次碰撞检查消费。" }
  class n3 node_observer
  class n3 external_node
  n4@{ shape: hex, label: "**demo::first​_​person::camera::on​_​**<br/>**camera​_​look**<br/>来自first​_​person ↗：Fire 已携带本帧汇<br/>总位移，直接更新角度；有向水平转角留给下<br/>一次碰撞检查消费。" }
  class n4 node_observer
  class n4 external_node
  n5@{ shape: hex, label: "**demo::first​_​person::camera::on​_​**<br/>**camera​_​look**<br/>来自first​_​person ↗：Fire 已携带本帧汇<br/>总位移，直接更新角度；有向水平转角留给下<br/>一次碰撞检查消费。" }
