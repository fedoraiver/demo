---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-1b33f97597445ce0-e3{marker-start:url(#object-1b33f97597445ce0_flowchart-v2-pointStart)!important}\n#object-1b33f97597445ce0_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: ConsumedInputs · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**ConsumedInputs**<br/>记录本轮动作评估已经消费的输入。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**update_pending**<br/>调用 InputReader 的待处理输入更新逻<br/>辑，消费上一阶段排队的绑定与重置操作，使<br/>本轮上下文评估使用更新后的输入读取状态。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**Enhanced Input update**<br/>按上下文优先级评估输入绑定、修饰器和条<br/>件，计算动作值及触发状态；此卡片的名称由<br/>系统参数元组生成。" }
  class n2 node_system
  n3@{ shape: lin-rect, label: "**EnhancedInputSystems::Prepare**<br/>准备动作评估并清理待释放的输入。" }
  class n3 node_system_set
  n4@{ shape: lin-rect, label: "**EnhancedInputSystems::Update**<br/>评估绑定输入并更新动作值与触发状态。" }
  class n4 node_system_set
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n0 e2@-->|"访问声明"| n3
  class e2 edge_read
  n4 e3@---|"访问声明"| n0
  class e3 edge_read
  n4 e4@-->|"访问声明"| n0
  class e4 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
