  n11@{ shape: rounded, label: "**CourierAnimation**<br/>保存角色动画混合权重、步相位与跳跃阶段。" }
  class n11 node_component
  n12@{ shape: rounded, label: "**AnimationGraphHandle**<br/>来自Bevy 引擎 ↗：本次绑定生成的命名动<br/>作图。" }
  class n12 node_component
  class n12 external_node
  n13@{ shape: cyl, label: "**Time**<br/>来自Bevy 引擎 ↗：提供当前运行阶段的通<br/>用时间。" }
  class n13 node_resource
  class n13 external_node
  n14@{ shape: cyl, label: "**State#lt;AppState#gt; /**<br/>**NextState#lt;AppState#gt;**<br/>来自应用流程 ↗：保存主菜单、运行和暂停<br/>状态及下一次转换。" }
