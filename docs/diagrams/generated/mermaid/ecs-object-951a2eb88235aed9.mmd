    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-951a2eb88235aed9-e10{marker-start:url(#object-951a2eb88235aed9_flowchart-v2-pointStart)!important}\n#object-951a2eb88235aed9-e12{marker-start:url(#object-951a2eb88235aed9_flowchart-v2-pointStart)!important}\n#object-951a2eb88235aed9-e13{marker-start:url(#object-951a2eb88235aed9_flowchart-v2-pointStart)!important}\n#object-951a2eb88235aed9_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
