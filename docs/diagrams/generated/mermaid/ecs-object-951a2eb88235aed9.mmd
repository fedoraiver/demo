  class n3 external_node
  n4@{ shape: rounded, label: "**CourierAnimation**<br/>保存角色动画混合权重、步相位与跳跃阶段。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**AnimationGraphHandle**<br/>来自Bevy 引擎 ↗：选择播放器使用的动画<br/>图资产。" }
