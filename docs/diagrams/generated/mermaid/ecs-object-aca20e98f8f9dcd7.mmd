---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: CourierAnimation · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**CourierAnimation**<br/>保存展示快递员的模型来源以绑定命名动画。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**菜单 GLB 模型与动画子树**<br/>承载主菜单的海岛模型与快递员展示动画。" }
  class n1 node_entity
  n2@{ shape: rounded, label: "**spawn_backdrop**<br/>装配主菜单海岛展示舞台、相机与日光。" }
  class n2 node_system
  n3@{ shape: hex, label: "**mark_courier_animation_ready**<br/>标记展示快递员以等待动画绑定。" }
  class n3 node_observer
  n4@{ shape: rounded, label: "**play_courier_animation**<br/>绑定并循环播放展示快递员的持物待机动画。" }
  class n4 node_system
  n0 e0@-->|"可能挂载于"| n1
  class e0 edge_reference
  n2 e1@-->|"添加"| n0
  class e1 edge_write
  n0 e2@-->|"存在 / 变更过滤"| n3
  class e2 edge_reference
  n0 e3@-->|"查询访问"| n4
  class e3 edge_read
  e0@{ curve: basis }
  e3@{ curve: basis }
