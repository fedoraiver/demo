---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Assets<Mesh> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Assets#lt;Mesh#gt;**<br/>保存模型网格并提供碰撞构建所需的顶点。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**asset_events**<br/>将 Assets 暂存的<br/>Added、Modified、Removed 等变化批量写<br/>入对应 AssetEvent 消息；存在<br/>AssetChanges 时同步记录当前系统 tick，<br/>随后清空待发队列。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**calculate_bounds**<br/>为允许自动包围盒计算的 Mesh3d 实体补充<br/>Aabb，并在网格句柄或资产变化时重新计算<br/>已有包围盒；NoFrustumCulling 和<br/>NoAutoAabb 排除自动处理。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update_skinned_mesh_bounds**<br/>依据当前关节姿态更新动态蒙皮包围盒。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**calculate_bounds_2d**<br/>为二维网格和精灵计算局部包围盒。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**add_mesh**<br/>首次需要时创建并缓存单位矩形网格，为新加<br/>入 Sprite 的实体插入共享的 Mesh2d，使<br/>精灵进入网格渲染路径。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**draw_skinned_mesh_bounds**<br/>绘制带独立显示标记的动态蒙皮包围区域。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**draw_all_skinned_mesh_bounds**<br/>绘制未单独标记的动态蒙皮网格包围区域。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**track_assets**<br/>持有 AssetServer 资产信息锁处理句柄释<br/>放通知，确认没有新强句柄后移除已释放资<br/>产，使 Assets 集合与资产服务器的引用状<br/>态保持一致。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**spawn_gizmo_meshes**<br/>创建变换操作器各轴网格、材质和覆盖相机。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**init_collider_constructors**<br/>来自Avian ↗：把就绪的碰撞构造配置变成<br/>实际形状。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: rounded, label: "**init_collider_constructor_**<br/>**hierarchies**<br/>来自Avian ↗：按<br/>ColliderConstructorHierarchy 的默认<br/>及逐名称配置为后代生成碰撞体，写入碰撞层<br/>和密度；需要场景实例时等待就绪，需要网格<br/>时等待资产可用。完成该层级处理后移除构造<br/>配置并发出<br/>ColliderConstructorHierarchyReady。" }
  class n11 node_system
  class n11 external_node
  n12@{ shape: stadium, label: "**RenderApp 渲染流程**<br/>提取场景数据并执行本帧渲染。" }
  class n12 node_engine_flow
  n13@{ shape: rounded, label: "**prepare_island**<br/>来自场景装配 ↗：从海岛模型构建静态碰<br/>撞、坡道与人物碰撞。" }
  class n13 node_system
  class n13 external_node
  n1 e0@--> n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  n5 e4@--> n0
  class e4 edge_write
  n0 e5@--> n6
  class e5 edge_read
  n0 e6@--> n7
  class e6 edge_read
  n8 e7@--> n0
  class e7 edge_write
  n9 e8@--> n0
  class e8 edge_write
  n0 e9@--> n10
  class e9 edge_read
  n0 e10@--> n11
  class e10 edge_read
  n0 e11@-->|"访问声明"| n12
  class e11 edge_read
  n0 e12@-->|"访问声明"| n13
  class e12 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: basis }
