---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: app::AppExit · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lean-r, label: "**AppExit**<br/>请求应用结束并携带退出结果。" }
  class n0 node_message
  n1@{ shape: rounded, label: "**exit​_​on​_​all​_​closed**<br/>来自crate:bevy​_​window ↗：窗口查询为空<br/>时写入 AppExit::Success，通知应用正常<br/>退出；仍有窗口时不发送退出消息。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**handle​_​requests**<br/>来自ui ↗：每帧只消费一项语义请求，避免<br/>鼠标与确认键同时激活，或旧页面动作穿过页<br/>面切换。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**exit​_​on​_​flag**<br/>把终端退出标志转为应用退出消息。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**despawn​_​windows**<br/>来自crate:bevy​_​winit ↗：处理原生窗口<br/>关闭并延后一轮释放包装器。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**stop​_​on​_​exit**<br/>来自audio ↗：停止音频通道并记录退出。" }
  class n5 node_system
  class n5 external_node
  n1 e0@-->|"消息"| n0
  class e0 edge_publish
  n2 e1@-->|"消息"| n0
  class e1 edge_publish
  n3 e2@-->|"消息"| n0
  class e2 edge_publish
  n1 e3@-->|"可变访问"| n0
  class e3 edge_publish
  n2 e4@-->|"可变访问"| n0
  class e4 edge_publish
  n0 e5@--> n4
  class e5 edge_consume
  n3 e6@-->|"可变访问"| n0
  class e6 edge_publish
  n0 e7@--> n5
  class e7 edge_consume
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
