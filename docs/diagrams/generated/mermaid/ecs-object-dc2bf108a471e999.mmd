---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: GeneratorBindGroups · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**GeneratorBindGroups**<br/>保存环境贴图生成所需的纹理绑定。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**prepare_generated_environment_map_**<br/>**bind_groups**<br/>为环境图各 mip 的降采样和卷积建立绑定。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**downsampling_system**<br/>把环境立方体贴图的基础 mip 复制到生成目<br/>标，再分阶段运行降采样计算，构造环境光卷<br/>积所需的多级纹理。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**filtering_system**<br/>对环境贴图执行镜面辐射卷积和漫反射辐照卷<br/>积，按不同粗糙度生成镜面 mip，并计算六<br/>个面的漫反射环境纹理。" }
  class n3 node_system
  n1 e0@-->|"延迟添加"| n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  e1@{ curve: basis }
  e2@{ curve: basis }
