---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: schedule::CameraWindows · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**CameraWindows**<br/>记录相机输出所覆盖的窗口集合。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**camera​_​driver**<br/>为辅助视图和活动相机运行专属渲染调度。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**handle​_​uncovered​_​swap​_​chains**<br/>清除本帧没有相机覆盖的窗口交换链。" }
  class n2 node_system
  n1 e0@-->|"插入"| n0
  class e0 edge_write
  n2 e1@-->|"移除"| n0
  class e1 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
