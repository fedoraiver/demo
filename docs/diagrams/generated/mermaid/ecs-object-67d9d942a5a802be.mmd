---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: DirtySpecializations · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**DirtySpecializations**<br/>记录需刷新或移除管线专用化的对象与视图。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**clear_dirty_specializations**<br/>清空新帧材质专用化的变化记录。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**extract_entities_needs_**<br/>**specialization#lt;bevy_sprite_render::**<br/>**mesh2d::color_material::**<br/>**ColorMaterial#gt;**<br/>把二维材质变化实体标为渲染专用化脏项。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**extract_entities_needs_**<br/>**specialization#lt;bevy_sprite_render::**<br/>**sprite_mesh::sprite_mesh_material::**<br/>**SpriteMeshMaterial#gt;**<br/>把二维材质变化实体标为渲染专用化脏项。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**extract_entities_needs_**<br/>**specialization#lt;bevy_sprite_render::**<br/>**tilemap_chunk::tilemap_chunk_**<br/>**material::TilemapChunkMaterial#gt;**<br/>把二维材质变化实体标为渲染专用化脏项。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**extract_entities_needs_**<br/>**specialization#lt;bevy_pbr::pbr_**<br/>**material::StandardMaterial#gt;**<br/>把主世界待刷新材质管线的实体身份提取到渲<br/>染侧。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**extract_entities_needs_**<br/>**specialization#lt;bevy_pbr::extended_**<br/>**material::ExtendedMaterial#lt;bevy_**<br/>**pbr::pbr_material::**<br/>**StandardMaterial, bevy_pbr::decal::**<br/>**forward::ForwardDecalMaterialExt#gt;#gt;**<br/>把主世界待刷新材质管线的实体身份提取到渲<br/>染侧。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**extract_entities_that_need_**<br/>**specializations_removed#lt;bevy_sprite_**<br/>**render::mesh2d::color_material::**<br/>**ColorMaterial#gt;**<br/>把二维材质移除实体登记到专用化清理表。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**extract_entities_that_need_**<br/>**specializations_removed#lt;bevy_sprite_**<br/>**render::sprite_mesh::sprite_mesh_**<br/>**material::SpriteMeshMaterial#gt;**<br/>把二维材质移除实体登记到专用化清理表。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**extract_entities_that_need_**<br/>**specializations_removed#lt;bevy_sprite_**<br/>**render::tilemap_chunk::tilemap_**<br/>**chunk_material::**<br/>**TilemapChunkMaterial#gt;**<br/>把二维材质移除实体登记到专用化清理表。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**extract_entities_that_need_**<br/>**specializations_removed#lt;bevy_pbr::**<br/>**pbr_material::StandardMaterial#gt;**<br/>提取需要移除材质管线专用化的实体。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**extract_entities_that_need_**<br/>**specializations_removed#lt;bevy_pbr::**<br/>**extended_material::**<br/>**ExtendedMaterial#lt;bevy_pbr::pbr_**<br/>**material::StandardMaterial, bevy_**<br/>**pbr::decal::forward::**<br/>**ForwardDecalMaterialExt#gt;#gt;**<br/>提取需要移除材质管线专用化的实体。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**expire_specializations_for_views**<br/>移除已失效视图的材质专用化脏标记。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**specialize_prepass_material_meshes**<br/>按深度、材质和运动特性生成预通道专用管<br/>线。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**check_views_need_specialization**<br/>检测二维视图管线配置变化并标记重建。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**specialize_material2d_meshes**<br/>为可见二维网格重建失效的材质专用化。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**specialize_material_meshes**<br/>为变化的可见网格生成并缓存材质专用管线。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**check_views_lights_need_**<br/>**specialization**<br/>检测阴影视图投影类型并标记管线待刷新。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**specialize_shadows**<br/>按阴影视图、网格及材质变化重新选择专用阴<br/>影渲染管线，清理失效缓存，并整理需要补齐<br/>或重新排队的阴影网格任务。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**queue_material2d_meshes**<br/>按透明模式更新二维网格渲染批次。" }
  class n19 node_system
  n20@{ shape: rounded, label: "**queue_prepass_material_meshes**<br/>把有效材质网格分入预通道或延迟几何阶段。" }
  class n20 node_system
  n21@{ shape: rounded, label: "**queue_material_meshes**<br/>按材质模式把可见网格加入相应绘制阶段。" }
  class n21 node_system
  n22@{ shape: rounded, label: "**queue_shadows**<br/>遍历各阴影视图中可见的网格，按专用材质管<br/>线、渲染层及投影资格更新阴影分桶；移除失<br/>效项，将资产或管线尚未就绪的网格留到后续<br/>重试。" }
  class n22 node_system
  n23@{ shape: rounded, label: "**check_prepass_views_need_**<br/>**specialization**<br/>检测采样和预通道配置变化并标记视图待刷<br/>新。" }
  class n23 node_system
  n24@{ shape: rounded, label: "**check_views_need_specialization**<br/>汇总视图渲染特性并检测管线配置变化。" }
  class n24 node_system
