---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-c13540409e1498ba-e0{marker-start:url(#object-c13540409e1498ba_flowchart-v2-pointStart)!important}\n#object-c13540409e1498ba-e3{marker-start:url(#object-c13540409e1498ba_flowchart-v2-pointStart)!important}\n#object-c13540409e1498ba-e5{marker-start:url(#object-c13540409e1498ba_flowchart-v2-pointStart)!important}\n#object-c13540409e1498ba-e7{marker-start:url(#object-c13540409e1498ba_flowchart-v2-pointStart)!important}\n#object-c13540409e1498ba-e10{marker-start:url(#object-c13540409e1498ba_flowchart-v2-pointStart)!important}\n#object-c13540409e1498ba-e15{marker-start:url(#object-c13540409e1498ba_flowchart-v2-pointStart)!important}\n#object-c13540409e1498ba-e21{marker-start:url(#object-c13540409e1498ba_flowchart-v2-pointStart)!important}\n#object-c13540409e1498ba_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
