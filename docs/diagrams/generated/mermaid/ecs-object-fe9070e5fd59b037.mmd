---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: log_collisions · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_external_io fill:#F1F3F4,stroke:#526A78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**log_collisions**<br/>将碰撞开始与结束写入统一日志。" }
  class n0 node_system
  n1@{ shape: lin-rect, label: "**PhysicsSystems::StepSimulation**<br/>来自Avian ↗：执行碰撞求解、重力积分与<br/>刚体运动。" }
  class n1 node_system_set
  class n1 external_node
  n2@{ shape: lean-r, label: "**CollisionStart**<br/>来自Avian ↗：记录碰撞开始及双方实体。" }
  class n2 node_message
  class n2 external_node
  n3@{ shape: lean-r, label: "**CollisionEnd**<br/>来自Avian ↗：记录碰撞结束及双方实体。" }
  class n3 node_message
  class n3 external_node
  n4@{ shape: lean-l, label: "**tracing producer**<br/>来自会话日志 ↗：格式化日志并交给独立文<br/>件与控制台队列。" }
  class n4 node_external_io
  class n4 external_node
  n5@{ shape: stadium, label: "**main · FixedPostUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n5 node_engine_flow
  class n5 external_node
  n6@{ shape: cyl, label: "**Messages#lt;CollisionStart#gt;**<br/>来自Avian ↗：缓冲物理接触开始消息。" }
  class n6 node_message_buffer
  class n6 external_node
  n7@{ shape: cyl, label: "**Messages#lt;CollisionEnd#gt;**<br/>来自Avian ↗：缓冲物理接触结束消息。" }
  class n7 node_message_buffer
  class n7 external_node
  n8@{ shape: fr-rect, label: "**GamePhysicsPlugin**<br/>安装物理引擎并管理重力、提前唤醒与碰撞日<br/>志。" }
  class n8 node_plugin
  n1 e0@-->|"StepSimulation"| n0
  class e0 edge_order
  n2 e1@--> n0
  class e1 edge_consume
  n3 e2@--> n0
  class e2 edge_consume
  n0 e3@-->|"tracing 碰撞日志"| n4
  class e3 edge_write
  n5 e4@-->|"main / FixedPostUpdate"| n0
  class e4 edge_registration
  n1 e5@--> n0
  class e5 edge_order
  n6 e6@-->|"访问声明"| n0
  class e6 edge_consume
  n7 e7@-->|"访问声明"| n0
  class e7 edge_consume
  n8 e8@--> n0
  class e8 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
