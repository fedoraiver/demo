---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: JointGraph · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**JointGraph**<br/>保存刚体之间的关节连接图。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**on_change_joint_entities#lt;avian3d::**<br/>**dynamics::joints::fixed::FixedJoint#gt;**<br/>在关节换端后重接刚体连接图。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**on_change_joint_entities#lt;avian3d::**<br/>**dynamics::joints::revolute::**<br/>**RevoluteJoint#gt;**<br/>在关节换端后重接刚体连接图。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**on_change_joint_entities#lt;avian3d::**<br/>**dynamics::joints::prismatic::**<br/>**PrismaticJoint#gt;**<br/>在关节换端后重接刚体连接图。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**on_change_joint_entities#lt;avian3d::**<br/>**dynamics::joints::distance::**<br/>**DistanceJoint#gt;**<br/>在关节换端后重接刚体连接图。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**on_change_joint_entities#lt;avian3d::**<br/>**dynamics::joints::spherical::**<br/>**SphericalJoint#gt;**<br/>在关节换端后重接刚体连接图。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**collect_collision_pairs#lt;()#gt;**<br/>为移动碰撞代理收集广相候选接触。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**split_island**<br/>物理岛存在待拆分候选时，根据刚体碰撞体、<br/>接触图和关节图重新划分该岛，并更新刚体所<br/>属岛；拆分用于随后正确决定休眠。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**apply_joint_graph_changes**<br/>把关节连接变化同步到模拟岛。" }
  class n8 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_write
  n0 e5@--> n6
  class e5 edge_read
  n0 e6@--> n7
  class e6 edge_read
  n0 e7@--> n8
  class e7 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e7@{ curve: basis }
