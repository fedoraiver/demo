---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: atmosphere::ExtractedAtmosphere · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ExtractedAtmosphere**<br/>保存尚未转为 GPU 参数的大气数据。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**extract​_​atmosphere**<br/>为三维相机选择并提取最近的大气。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**check​_​views​_​need​_​specialization**<br/>汇总视图渲染特性并检测管线配置变化。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare​_​atmosphere​_​bind​_​groups**<br/>为大气查找表计算和天空绘制绑定视图资源。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**prepare​_​atmosphere​_​buffers**<br/>上传各视图的大气和采样设置缓冲。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**prepare​_​atmosphere​_​textures**<br/>按大气设置准备四类查找纹理。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**prepare​_​probe​_​textures**<br/>为环境探针借用大气查找纹理并创建输出视<br/>图。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**queue​_​render​_​sky​_​pipelines**<br/>按多重采样和混合能力选择天空管线。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**configure​_​camera​_​depth​_​usages**<br/>允许大气相机的深度纹理被着色器采样。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**prepare​_​atmosphere​_​uniforms**<br/>把提取的大气几何转换为 GPU Uniform 组<br/>件。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**prepare​_​atmosphere​_​transforms**<br/>按相机位置构造大气局部坐标变换。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**prepare​_​mesh​_​view​_​bind​_​groups**<br/>为视图绑定光照、阴影及各可选渲染效果资<br/>源。" }
  class n11 node_system
  n1 e0@-->|"移除"| n0
  class e0 edge_write
  n0 e1@-->|"存在性约束"| n2
  class e1 edge_reference
  n1 e2@-->|"插入"| n0
  class e2 edge_write
  n0 e3@-->|"存在性约束"| n3
  class e3 edge_reference
  n0 e4@-->|"存在性约束"| n4
  class e4 edge_reference
  n0 e5@-->|"存在性约束"| n5
  class e5 edge_reference
  n0 e6@-->|"存在性约束"| n6
  class e6 edge_reference
  n0 e7@-->|"存在性约束"| n7
  class e7 edge_reference
  n0 e8@-->|"存在性约束"| n8
  class e8 edge_reference
  n0 e9@--> n9
  class e9 edge_read
  n0 e10@--> n3
  class e10 edge_read
  n0 e11@-->|"存在性约束"| n10
  class e11 edge_reference
  n0 e12@-->|"存在性约束"| n11
  class e12 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
