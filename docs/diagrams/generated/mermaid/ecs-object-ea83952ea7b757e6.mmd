---
flowchart LR
  accTitle: PhaseBatchedInstanceBuffers<Transparent3d, BufferData> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**PhaseBatchedInstanceBuffers#lt;Transpar**<br/>**ent3d, BufferData#gt;**<br/>为单个绘制阶段保存 GPU 批次实例缓冲。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**batch_and_prepare_sorted_render_**<br/>**phase#lt;bevy_core_pipeline::core_3d::**<br/>**Transparent3d, bevy_pbr::render::**<br/>**mesh::MeshPipeline#gt;**<br/>按已有绘制顺序合并 GPU 预处理阶段批次。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**collect_buffers_for_phase#lt;bevy_core_**<br/>**pipeline::core_3d::Transparent3d,**<br/>**bevy_pbr::render::mesh::**<br/>**MeshPipeline#gt;**<br/>把并行准备的逐阶段缓冲汇入全局表。" }
  class n2 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
