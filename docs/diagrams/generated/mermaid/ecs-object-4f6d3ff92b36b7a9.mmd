flowchart LR
  accTitle: bevy_pbr::MeshPipelineViewLayouts · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**MeshPipelineViewLayouts**<br/>按网格管线配置提供视图绑定布局。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**init​_​screen​_​space​_​reflections​_​**<br/>**pipeline**<br/>初始化屏幕空间反射的全屏渲染管线资源。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**init​_​volumetric​_​fog​_​pipeline**<br/>初始化体积雾管线的视图布局与着色器。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**init​_​mesh​_​pipeline**<br/>初始化三维网格着色器及设备缓冲策略。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**init​_​mesh​_​pipeline​_​view​_​layouts**<br/>按设备能力汇集网格视图资源布局参数。" }
  class n4 node_system
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n4 e3@-->|"插入"| n0
  class e3 edge_write
  e0@{ curve: basis }
  e2@{ curve: basis }
