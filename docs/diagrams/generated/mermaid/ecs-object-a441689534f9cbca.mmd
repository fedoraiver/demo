---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: style_buttons · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**style_buttons**<br/>按当前输入来源更新按钮背景与焦点边框。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**pointer_interaction**<br/>将真实鼠标交互转换为共享菜单请求。" }
  class n1 node_system
  n2@{ shape: stadium, label: "**Kira 播放输出流程**<br/>来自音频播放 ↗：将声音请求按有效混音与<br/>播放策略提交音频实例。" }
  class n2 node_engine_flow
  class n2 external_node
  n3@{ shape: lin-rect, label: "**UiSystems::Style**<br/>组织菜单显示、数值与说明的原位更新。" }
  class n3 node_system_set
  n4@{ shape: stadium, label: "**main · Update**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n4 node_engine_flow
  class n4 external_node
  n5@{ shape: rounded, label: "**PrimaryPress**<br/>区分菜单主键按压与其他按钮来源。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Pressed**<br/>来自Bevy 引擎 ↗：标记原生按钮当前被按<br/>压。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**MenuButton**<br/>保存菜单动作及按钮的导航序号。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**Hovered**<br/>来自Bevy 引擎 ↗：保存按钮或其子树是否<br/>被悬停。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**BackgroundColor**<br/>来自Bevy 引擎 ↗：保存界面节点的背景颜<br/>色。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: rounded, label: "**BorderColor**<br/>来自Bevy 引擎 ↗：保存界面节点的边框颜<br/>色。" }
  class n10 node_component
  class n10 external_node
  n11@{ shape: cyl, label: "**MenuFocus**<br/>保存当前可操作按钮的导航序号。" }
  class n11 node_resource
  n12@{ shape: cyl, label: "**MenuInputSource**<br/>保存当前可见焦点使用的输入来源。" }
  class n12 node_resource
  n13@{ shape: fr-rect, label: "**GameUiPlugin**<br/>管理菜单、设置编辑、导航与主菜单展示场<br/>景。" }
  class n13 node_plugin
