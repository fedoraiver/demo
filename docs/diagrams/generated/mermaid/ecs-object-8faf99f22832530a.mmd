---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-8faf99f22832530a-e4{marker-start:url(#object-8faf99f22832530a_flowchart-v2-pointStart)!important}\n#object-8faf99f22832530a_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: prepass::background_motion_vectors::BackgroundMotionVectorsPipelineId · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**BackgroundMotionVectorsPipelineId**<br/>保存相机背景运动矢量管线的标识。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**cleanup​_​background​_​motion​_​vectors**<br/>移除不再需要的背景运动矢量渲染状态。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**late​_​prepass**<br/>为遮挡剔除绘制晚期预通道。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare​_​background​_​motion​_​vectors​_​**<br/>**pipelines**<br/>按采样数和法线预通道准备背景运动管线。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**early​_​prepass**<br/>绘制早期不透明与 AlphaMask 预通道。" }
  class n4 node_system
  n1 e0@-->|"移除"| n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n3 e2@-->|"插入"| n0
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_read
  n1 e4@---|"存在性约束"| n0
  class e4 edge_reference
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
