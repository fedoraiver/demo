  class n5 node_system
  n6@{ shape: hex, label: "**build::{closure#35;2}**<br/>按刚体类型迁移碰撞体空间树。" }
  class n6 node_observer
  n7@{ shape: rounded, label: "**finish​_​optimize​_​trees**<br/>合并完成的碰撞体树优化结果。" }
  class n7 node_system
