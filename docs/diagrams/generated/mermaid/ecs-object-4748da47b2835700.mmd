---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-4748da47b2835700-e2{marker-start:url(#object-4748da47b2835700_flowchart-v2-pointStart)!important}\n#object-4748da47b2835700-e3{marker-start:url(#object-4748da47b2835700_flowchart-v2-pointStart)!important}\n#object-4748da47b2835700_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Camera · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Camera**<br/>配置相机视口、输出目标和渲染顺序。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**viewport_picking**<br/>收集正被悬停或拖动的 ViewportNode，将<br/>外部指针位置转换到其相机视口，并以该视口<br/>专用的 PointerId 转发 PointerInput；<br/>未使用的视口清除指针位置。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**camera_system**<br/>响应窗口创建、尺寸与缩放变化及图像目标变<br/>化，更新 Camera 与 Projection 的目标<br/>尺寸和投影信息；只读取相机实际引用的图像<br/>目标。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update_gizmo_meshes**<br/>将变换操作器对齐焦点并更新模式与高亮。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**camera_system**<br/>响应窗口创建、尺寸与缩放变化及图像目标变<br/>化，更新 Camera 与 Projection 的目标<br/>尺寸和投影信息；只读取相机实际引用的图像<br/>目标。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**check_visibility_cpu_culling**<br/>按层、距离和视锥收集各相机可见实体。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**check_visibility_ranges**<br/>按视图距离计算实体可见范围位掩码。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**check_point_light_mesh_visibility**<br/>计算点光与聚光灯阴影可见的网格。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**assign_objects_to_clusters**<br/>将灯光、探针及贴花分配到视图分簇。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**update_directional_light_frusta**<br/>从方向光级联投影更新阴影视锥。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**build_directional_light_cascades**<br/>为投射阴影的方向光构建逐相机级联。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**propagate_ui_target_cameras**<br/>为 UI 根配置目标相机和视口信息传播源。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**check_msaa**<br/>检查带 DeferredPrepass 的相机，发现启<br/>用 MSAA 时发出警告并改为 Msaa::Off，避<br/>免延迟渲染使用不兼容的多重采样。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**check_tonemapping_none**<br/>警告关闭色调映射后仍配置无效效果的相机。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**update_text2d_layout**<br/>重新排版变化的二维文字并准备字形。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**update_ui_screen_rect**<br/>来自Egui / Inspector ↗：把相机视口换<br/>算为 Egui 逻辑屏幕区域。" }
  class n15 node_system
  class n15 external_node
  n16@{ shape: rounded, label: "**setup_primary_egui_context_system**<br/>来自Egui / Inspector ↗：为首个合适相<br/>机建立主 Egui 上下文。" }
  class n16 node_system
  class n16 external_node
  n17@{ shape: rounded, label: "**sprite_picking**<br/>将可见、变换有效的精灵按深度排序，结合指<br/>针射线、相机、精灵图像和拾取配置计算命<br/>中，并向拾取后端发布 PointerHits。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**ui_picking**<br/>把各指针位置映射到匹配相机的视口坐标，<br/>按 UiStack 的绘制顺序检查 UI 节点及拾<br/>取规则，输出 PointerHits 供悬停与交互<br/>阶段汇总。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**ui_focus_system**<br/>按鼠标和触摸更新旧式 UI 交互状态。" }
  class n19 node_system
  n20@{ shape: rounded, label: "**repopulate**<br/>清空 RayMap，再为指针位置落在有效相机视<br/>口内的每个相机与指针组合创建世界射线，并<br/>按 RayId 保存。" }
  class n20 node_system
  n21@{ shape: rounded, label: "**setup_primary_egui_context_system**<br/>来自Egui / Inspector ↗：为首个合适相<br/>机建立主 Egui 上下文。" }
  class n21 node_system
  class n21 external_node
  n22@{ shape: rounded, label: "**update_ui_screen_rect**<br/>来自Egui / Inspector ↗：把相机视口换<br/>算为 Egui 逻辑屏幕区域。" }
  class n22 node_system
  class n22 external_node
  n23@{ shape: rounded, label: "**update_mesh_previous_global_**<br/>**transforms**<br/>为下帧保存网格的当前世界变换。" }
  class n23 node_system
  n24@{ shape: rounded, label: "**update_previous_view_data**<br/>记录三维及阴影视图未抖动的变换矩阵。" }
  class n24 node_system
  n25@{ shape: rounded, label: "**write_egui_input_system**<br/>来自Egui / Inspector ↗：把界面输入和<br/>文件拖放写入 Egui 输入批次。" }
  class n25 node_system
  class n25 external_node
  n26@{ shape: rounded, label: "**spawn_gizmo_meshes**<br/>创建变换操作器各轴网格、材质和覆盖相机。" }
  class n26 node_system
  n27@{ shape: rounded, label: "**extract_ui_camera_view**<br/>为活动二维或三维相机维护独立 UI 视图。" }
  class n27 node_system
  n28@{ shape: rounded, label: "**extract_viewport_nodes**<br/>把视口节点所引用相机的输出图像嵌入 UI。" }
  class n28 node_system
  n29@{ shape: rounded, label: "**extract_meshes_for_gpu_building**<br/>增量提取变化或需重试网格到线程队列。" }
  class n29 node_system
  n30@{ shape: rounded, label: "**extract_cameras**<br/>把主世界活动相机的目标、视口、变换、可见<br/>实体和渲染设置提取到渲染实体，并维护视图<br/>所需格式；对停用或目标尺寸无效的相机移除<br/>失效提取状态。" }
  class n30 node_system
  n31@{ shape: rounded, label: "**extract_core_2d_camera_phases**<br/>为活动二维相机准备渲染阶段并清理失效视<br/>图。" }
  class n31 node_system
  n32@{ shape: rounded, label: "**extract_core_3d_camera_phases**<br/>为活动三维相机准备主渲染阶段。" }
  class n32 node_system
  n33@{ shape: rounded, label: "**extract_camera_prepass_phase**<br/>同步三维相机的预通道标记与渲染阶段。" }
  class n33 node_system
  n34@{ shape: rounded, label: "**extract_taa_settings**<br/>提取有效相机的 TAA 设置并消费历史重置信<br/>号。" }
  class n34 node_system
  n35@{ shape: rounded, label: "**extract_camera_previous_view_data**<br/>把活动三维相机的前帧视图数据提取到渲染<br/>侧。" }
  class n35 node_system
  n36@{ shape: rounded, label: "**extract_transmissive_camera_phases**<br/>为活动三维相机准备本帧透射阶段并清理失效<br/>视图。" }
  class n36 node_system
  n37@{ shape: rounded, label: "**extract_clusters_for_cpu_clustering**<br/>把 CPU 聚簇结果转换为渲染侧对象列表。" }
  class n37 node_system
  n38@{ shape: rounded, label: "**extract_clusters_for_gpu_clustering**<br/>提取视图聚簇配置并回传上帧 GPU 统计。" }
  class n38 node_system
  n39@{ shape: rounded, label: "**extract_shadow_lod_origin**<br/>解析点光与聚光阴影 LOD 的距离参考位置。" }
  class n39 node_system
  n40@{ shape: rounded, label: "**extract_ssao_settings**<br/>向渲染相机提取屏幕空间环境光遮蔽配置。" }
  class n40 node_system
  n41@{ shape: rounded, label: "**extract_egui_camera_view_system**<br/>来自Egui / Inspector ↗：为活动相机提<br/>取独立 Egui 渲染视图。" }
  class n41 node_system
  class n41 external_node
  n42@{ shape: rounded, label: "**queue_render_sky_pipelines**<br/>按多重采样和混合能力选择天空管线。" }
  class n42 node_system
