---
flowchart LR
  accTitle: EguiPixelsPerPoint · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**EguiPixelsPerPoint**<br/>在渲染世界保存 Egui 当前每逻辑点对应的<br/>物理像素数" }
  class n0 node_component
  n1@{ shape: rounded, label: "**prepare_egui_transforms_system**<br/>上传 Egui 屏幕变换缓冲。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**extract_egui_camera_view_system**<br/>为活动相机提取独立 Egui 渲染视图。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare_egui_transforms_system**<br/>上传 Egui 屏幕变换缓冲。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**prepare_egui_render_target_data_**<br/>**system**<br/>准备 Egui 顶点索引和裁剪绘制命令。" }
  class n4 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"延迟添加"| n0
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  e0@{ curve: basis }
  e3@{ curve: basis }
