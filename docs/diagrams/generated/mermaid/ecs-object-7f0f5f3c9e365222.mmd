  n2@{ shape: rounded, label: "**process_recorded_focus_changes**<br/>按记录顺序派发焦点获得和失去事件。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**menu_on_lose_focus**<br/>关闭不再持有内部焦点的菜单。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**update_accessibility_nodes**<br/>把变化的可访问性节点同步给原生适配器。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update_tablist_derived_state**<br/>从标签选择和焦点派生每个标签的状态。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_editable_text_layout**<br/>刷新可编辑文本的字形布局和编辑反馈。" }
