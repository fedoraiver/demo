  class n6 node_component
  n7@{ shape: rounded, label: "**MenuPopup**<br/>定义弹出菜单的布局方向及模态焦点范围" }
  class n7 node_component
  n8@{ shape: rounded, label: "**ChildOf**<br/>保存当前实体的父实体身份" }
  class n8 node_component
  n9@{ shape: cyl, label: "**InputFocus**<br/>保存当前输入焦点实体、待派发的焦点变化及<br/>原焦点" }
