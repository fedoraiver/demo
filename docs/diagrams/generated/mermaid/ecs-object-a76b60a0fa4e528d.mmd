---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: MeshPipelineSystems · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**MeshPipelineSystems**<br/>先初始化网格视图布局，再初始化三维网格管<br/>线。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**RenderApp · RenderStartup**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**init_mesh_pipeline_view_layouts**<br/>按设备能力汇集网格视图资源布局参数。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**init_mesh_pipeline**<br/>初始化三维网格着色器及设备缓冲策略。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**init_material_pipeline**<br/>初始化与网格管线共享接口的材质管线资源。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**init_volumetric_fog_pipeline**<br/>初始化体积雾管线的视图布局与着色器。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**init_line_gizmo_pipelines**<br/>建立三维 Gizmo 线条深度管线和接头资源。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**init_deferred_lighting_layout**<br/>初始化延迟光照的深度标识绑定与着色器。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**init_screen_space_reflections_**<br/>**pipeline**<br/>初始化屏幕空间反射的全屏渲染管线资源。" }
  class n8 node_system
  n1 e0@-->|"RenderApp / RenderStartup"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_order
  n0 e4@--> n5
  class e4 edge_order
  n0 e5@--> n6
  class e5 edge_order
  n0 e6@--> n7
  class e6 edge_order
  n0 e7@--> n8
  class e7 edge_order
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
