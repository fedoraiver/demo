flowchart LR
  accTitle: extract_egui_camera_view_system · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**extract_egui_camera_view_system**<br/>为活动相机提取独立 Egui 渲染视图。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: notch-rect, label: "**Commands**<br/>来自Bevy 引擎 ↗：保存延迟执行的<br/>World 操作队列" }
  class n2 node_system_param
  class n2 external_node
  n3@{ shape: cyl, label: "**MainWorld**<br/>来自Bevy 引擎 ↗：在提取阶段临时提供主<br/>模拟世界。" }
  class n3 node_resource
  class n3 external_node
  n4@{ shape: notch-rect, label: "**HashSet#lt;RetainedViewEntity#gt;**<br/>来自Bevy 引擎 ↗：记录本轮成功提取的<br/>Egui 相机视图身份。" }
  class n4 node_local
  class n4 external_node
  n5@{ shape: notch-rect, label: "**RenderEntity**<br/>来自Bevy 引擎 ↗：记录主实体对应的渲染<br/>世界实体。" }
  class n5 node_query_data
  class n5 external_node
  n6@{ shape: rounded, label: "**Camera**<br/>来自Bevy 引擎 ↗：配置相机视口、输出目<br/>标和渲染顺序。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**EguiOutput**<br/>保存上一轮 Egui 的平台输出和像素点比例" }
  class n7 node_component
  n8@{ shape: rounded, label: "**EguiRenderOutput**<br/>保存 Egui 绘制图元和纹理增量" }
  class n8 node_component
  n9@{ shape: rounded, label: "**EguiCameraView**<br/>在主渲染目标视图上保存对应的 Egui 渲染<br/>视图实体" }
  class n9 node_component
  n10@{ shape: rounded, label: "**ExtractedView**<br/>来自Bevy 引擎 ↗：描述渲染视图的身份、<br/>投影与空间状态。" }
  class n10 node_component
  class n10 external_node
  n11@{ shape: rounded, label: "**EguiViewTarget**<br/>在 Egui 渲染视图上保存对应的主目标视图<br/>实体" }
  class n11 node_component
  n12@{ shape: rounded, label: "**EguiPixelsPerPoint**<br/>在渲染世界保存 Egui 当前每逻辑点对应的<br/>物理像素数" }
  class n12 node_component
  n13@{ shape: rounded, label: "**TemporaryRenderEntity**<br/>来自Bevy 引擎 ↗：标记需要在渲染结束后<br/>销毁的临时实体。" }
