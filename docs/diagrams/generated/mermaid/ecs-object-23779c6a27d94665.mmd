---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: MeshExtractionSystems · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**MeshExtractionSystems**<br/>向渲染世界提取三维网格的实例数据。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**clear​_​batched​_​gpu​_​instance​_​buffers**<br/>来自crate:bevy​_​render ↗：在提取写入实<br/>例数据之前清空本帧 GPU 批处理实例缓冲的<br/>内容和索引，保留既有缓冲分配以便复用。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**extract​_​meshes​_​for​_​gpu​_​building**<br/>增量提取变化或需重试网格到线程队列。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**extract​_​visibility​_​ranges**<br/>来自crate:bevy​_​render ↗：在可见距离变<br/>化后重建渲染侧范围表。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**extract​_​lightmaps**<br/>维护可见光照贴图的渲染槽位与纹理。" }
  class n4 node_system
  n1 e0@-->|"先于"| n0
  class e0 edge_order
  n0 e1@-->|"集合成员"| n2
  class e1 edge_set_membership
  n3 e2@-->|"先于"| n0
  class e2 edge_order
  n0 e3@-->|"先于"| n4
  class e3 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
