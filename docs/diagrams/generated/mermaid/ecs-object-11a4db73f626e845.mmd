---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: ContextActivity<GameplayContext> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ContextActivity#lt;GameplayContext#gt;**<br/>控制保留绑定的输入上下文启停。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**suspend_controls**<br/>来自第一人称控制 ↗：停用玩法输入并释放<br/>光标。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**suspend_controls**<br/>来自第一人称控制 ↗：停用玩法输入并释放<br/>光标。" }
  class n2 node_system
  class n2 external_node
  n1 e0@-->|"延迟添加"| n0
  class e0 edge_write
  n2 e1@-->|"延迟添加"| n0
  class e1 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
