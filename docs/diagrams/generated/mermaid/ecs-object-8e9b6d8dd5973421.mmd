---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: shapecast · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**shapecast**<br/>遍历 ShapeCaster，使用 SpatialQuery<br/>执行已启用的形状扫掠并更新 ShapeHits；<br/>禁用时清除旧命中，最后记录形状查询耗时。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · FixedPostUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**SpatialQuerySystems**<br/>刷新空间投射器并执行射线和形状查询。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**raycast**<br/>遍历 RayCaster，使用 SpatialQuery 执<br/>行已启用的射线查询并更新 RayHits；禁用<br/>时清除旧命中，最后记录射线查询耗时。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**ShapeHits**<br/>保存 ShapeCaster 最近生成的命中。" }
  class n4 node_component
  n5@{ shape: notch-rect, label: "**SpatialQuery**<br/>提供即时射线和形状空间查询。" }
  class n5 node_system_param
  n6@{ shape: cyl, label: "**SpatialQueryDiagnostics**<br/>记录射线与形状查询耗时。" }
  class n6 node_resource
  n1 e0@-->|"main / FixedPostUpdate"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n3 e2@--> n0
  class e2 edge_order
  n0 e3@--> n4
  class e3 edge_write
  n5 e4@-->|"参数 / 查询数据"| n0
  class e4 edge_reference
  n0 e5@--> n6
  class e5 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
