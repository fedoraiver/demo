  class e5 edge_write
  n7 e6@--> n0
  class e6 edge_write
  n8 e7@--> n0
  class e7 edge_write
  n9 e8@--> n0
  class e8 edge_write
  n10 e9@--> n0
  class e9 edge_write
  n11 e10@--> n0
  class e10 edge_write
  n12 e11@--> n0
  class e11 edge_write
  n0 e12@--> n13
  class e12 edge_read
  n0 e13@--> n14
  class e13 edge_read
