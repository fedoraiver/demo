---
flowchart LR
  accTitle: world_instance_spawner_system · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**world_instance_spawner_system**<br/>清除父实体已失效的待加载实例，消费<br/>WorldAsset 和 DynamicWorld 资产变化，<br/>执行排队的生成、销毁及实例更新，并触发已<br/>经装配完成的实例就绪事件。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · SpawnScene**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**SceneSpawnerSystems::**<br/>**WorldInstanceSpawn**<br/>生成或更新世界资产实例。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**world_instance_spawner**<br/>根据世界资产根组件排队生成或替换实例。" }
  class n3 node_system
  n4@{ shape: notch-rect, label: "**World**<br/>保存实体、组件、资源及关联元数据" }
  class n4 node_system_param
  n5@{ shape: cyl, label: "**WorldInstanceSpawner**<br/>管理世界资产的同步及排队生成、销毁和热更<br/>新" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**Messages#lt;AssetEvent#lt;WorldAsset#gt;#gt;**<br/>保存 AssetEvent#lt;WorldAsset#gt; 消息。" }
  class n6 node_message_buffer
  n7@{ shape: cyl, label: "**Messages#lt;AssetEvent#lt;DynamicWorld#gt;#gt;**<br/>保存 AssetEvent#lt;DynamicWorld#gt; 消息。" }
  class n7 node_message_buffer
  n1 e0@-->|"main / SpawnScene"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n3 e2@--> n0
  class e2 edge_order
  n0 e3@--> n4
  class e3 edge_write
  n0 e4@-->|"正文可变访问"| n5
  class e4 edge_write
  n6 e5@-->|"正文只读访问"| n0
  class e5 edge_consume
  n7 e6@-->|"正文只读访问"| n0
  class e6 edge_consume
  e0@{ curve: basis }
  e1@{ curve: basis }
