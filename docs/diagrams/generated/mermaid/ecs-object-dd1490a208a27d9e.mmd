  class n1 external_node
  n2@{ shape: lin-rect, label: "**AudioSystemSet::InstanceCleanup**<br/>清理已停止的音频实例引用。" }
  class n2 node_system_set
  n3@{ shape: tag-rect, label: "**AudioOutput**<br/>持有 Kira 音频管理器及实例、通道、轨道<br/>状态" }
  class n3 node_non_send
  n4@{ shape: cyl, label: "**Assets#lt;AudioInstance#gt;**<br/>保存正在播放或刚就绪的声音实例。" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**AudioChannel#lt;MainTrack#gt;**<br/>保存特定通道类型的音频命令队列及实例播放<br/>状态" }
