---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-7b99c3889fe55f03-e6{marker-start:url(#object-7b99c3889fe55f03_flowchart-v2-pointStart)!important}\n#object-7b99c3889fe55f03_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: ScaleEasingState · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ScaleEasingState**<br/>保存固定步缩放插值的起点与终点" }
  class n0 node_component
  n1@{ shape: rounded, label: "**reset_scale_easing**<br/>清除旧缩放平滑的起点和终点。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update_scale_interpolation_start**<br/>把当前缩放记录为插值起点。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**complete_scale_easing**<br/>在新一轮插值前完成上一段缩放。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**update_scale_interpolation_end**<br/>把当前缩放记录为插值终点。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**ease_scale_lerp**<br/>按固定步剩余比例线性插值显示缩放。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**reset_easing_states_on_transform_**<br/>**change**<br/>在外部直接改变变换时取消失效的平滑区间。" }
  class n6 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_read
  n4 e3@--> n0
  class e3 edge_write
  n0 e4@--> n5
  class e4 edge_read
  n6 e5@--> n0
  class e5 edge_write
  n6 e6@---|"存在 / 变更过滤"| n0
  class e6 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
