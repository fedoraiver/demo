---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: check_keyboard_focus_lost · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**check_keyboard_focus_lost**<br/>处理跨窗口键盘焦点丢失并补发释放。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · Last**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**despawn_windows**<br/>处理 ClosingWindow、Window 组件移除<br/>和 AppExit，通知窗口即将关闭，移出<br/>winit 窗口表并发布 WindowClosed；原生<br/>窗口包装保留到下一轮再由主线程释放。" }
  class n2 node_system
  n3@{ shape: cyl, label: "**Messages#lt;WindowFocused#gt;**<br/>缓冲窗口焦点变化消息。" }
  class n3 node_message_buffer
  n4@{ shape: cyl, label: "**Messages#lt;KeyboardFocusLost#gt;**<br/>通知输入系统清理失焦后残留的按键。" }
  class n4 node_message_buffer
  n5@{ shape: cyl, label: "**Messages#lt;KeyboardInput#gt;**<br/>缓冲底层键盘输入消息。" }
  class n5 node_message_buffer
  n6@{ shape: cyl, label: "**Messages#lt;WindowEvent#gt;**<br/>保存 WindowEvent 消息。" }
  class n6 node_message_buffer
  n7@{ shape: rounded, label: "**WinitWindowPressedKeys**<br/>逐窗口保存当前按下的键" }
  class n7 node_component
  n8@{ shape: cyl, label: "**Messages#lt;Messages#lt;KeyboardFocusLost#gt;**<br/>**#gt;**<br/>保存 Messages#lt;KeyboardFocusLost#gt; 消<br/>息。" }
  class n8 node_message_buffer
  n9@{ shape: cyl, label: "**Messages#lt;Messages#lt;KeyboardInput#gt;#gt;**<br/>保存 Messages#lt;KeyboardInput#gt; 消息。" }
  class n9 node_message_buffer
  n10@{ shape: cyl, label: "**Messages#lt;Messages#lt;WindowEvent#gt;#gt;**<br/>保存 Messages#lt;WindowEvent#gt; 消息。" }
  class n10 node_message_buffer
  n1 e0@-->|"main / Last"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_order
  n3 e2@--> n0
  class e2 edge_consume
  n0 e3@--> n4
  class e3 edge_publish
  n0 e4@--> n5
  class e4 edge_publish
  n0 e5@--> n6
  class e5 edge_publish
  n0 e6@--> n7
  class e6 edge_write
  n0 e7@-->|"正文发布消息"| n8
  class e7 edge_publish
  n0 e8@-->|"正文发布消息"| n9
  class e8 edge_publish
  n0 e9@-->|"正文发布消息"| n10
  class e9 edge_publish
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
