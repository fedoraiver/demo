flowchart LR
  accTitle: spatial_query::diagnostics::SpatialQueryDiagnostics · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**spatial​_​query::diagnostics::**<br/>**SpatialQueryDiagnostics**<br/>记录射线与形状查询耗时。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**#lt;avian3d::spatial​_​query::**<br/>**diagnostics::**<br/>**SpatialQueryDiagnostics as avian3d::**<br/>**diagnostics::PhysicsDiagnostics#gt;::**<br/>**reset**<br/>重置物理诊断测量。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**avian3d::spatial​_​query::shapecast**<br/>执行已启用的形状扫掠并更新命中列表。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**avian3d::spatial​_​query::raycast**<br/>执行已启用的射线查询并更新命中列表。" }
  class n3 node_system
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n2 e1@-->|"可变访问"| n0
  class e1 edge_write
  n3 e2@-->|"赋值"| n0
  class e2 edge_write
  n3 e3@-->|"可变访问"| n0
  class e3 edge_write
  n2 e4@-->|"赋值"| n0
  class e4 edge_write
  n1 e5@-->|"赋值"| n0
  class e5 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
