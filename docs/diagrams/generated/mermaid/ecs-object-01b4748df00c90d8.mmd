---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Messages<MouseWheel> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Messages#lt;MouseWheel#gt;**<br/>保存 MouseWheel 消息。" }
  class n0 node_message_buffer
  n1@{ shape: rounded, label: "**accumulate_mouse_scroll_system**<br/>累计本帧滚轮位移和单位。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**dispatch_focused_input#lt;bevy_input::**<br/>**mouse::MouseWheel#gt;**<br/>读取对应输入消息并向当前焦点实体派发可冒<br/>泡的 FocusedInput；焦点无效时回退到主<br/>窗口。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**write_mouse_wheel_messages_system**<br/>来自Egui / Inspector ↗：向悬停 Egui<br/>上下文传递滚轮输入。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**absorb_bevy_input_system**<br/>来自Egui / Inspector ↗：在 Egui 使用<br/>输入时吸收对应 Bevy 输入。" }
  class n4 node_system
  class n4 external_node
  n0 e0@--> n1
  class e0 edge_consume
  n0 e1@--> n2
  class e1 edge_consume
  n0 e2@--> n3
  class e2 edge_consume
  n4 e3@--> n0
  class e3 edge_publish
  e0@{ curve: basis }
  e2@{ curve: basis }
