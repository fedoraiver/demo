---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-d43fb4584052fbbf-e2{marker-start:url(#object-d43fb4584052fbbf_flowchart-v2-pointStart)!important}\n#object-d43fb4584052fbbf_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: apply_frame_rate_limit · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**apply_frame_rate_limit**<br/>将帧率设置同步给原生窗口循环。" }
  class n0 node_system
  n1@{ shape: cyl, label: "**GameSettings**<br/>保存已应用的玩家设置与音量配置。" }
  class n1 node_resource
  n2@{ shape: notch-rect, label: "**Local#lt;Option#lt;NonZeroU32#gt;#gt;**<br/>缓存窗口循环已采用的帧率设置。" }
  class n2 node_local
  n3@{ shape: cyl, label: "**WinitSettings**<br/>来自Bevy 引擎 ↗：配置窗口主循环的更新<br/>策略。" }
  class n3 node_resource
  class n3 external_node
  n4@{ shape: stadium, label: "**main · Last**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n4 node_engine_flow
  class n4 external_node
  n5@{ shape: fr-rect, label: "**SettingsPlugin**<br/>管理设置持久化、共享原型参数与帧率控制。" }
  class n5 node_plugin
  n1 e0@-->|"max_fps"| n0
  class e0 edge_read
  n2 e1@-->|"已应用值"| n0
  class e1 edge_read
  n2 e2@---|"已应用值"| n0
  class e2 edge_write
  n0 e3@-->|"focused_mode / unfocused_mode"| n3
  class e3 edge_write
  n4 e4@-->|"main / Last"| n0
  class e4 edge_registration
  n5 e5@--> n0
  class e5 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
