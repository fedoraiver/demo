---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: late_prepass · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**late_prepass**<br/>仅在遮挡剔除开启且允许间接绘制时执行晚期<br/>预通道，复用共享实现绘制对应的不透明和<br/>AlphaMask 预通道阶段；其他视图直接跳<br/>过。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · Core3d**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**Core3dSystems::Prepass**<br/>在三维主绘制前执行深度及延迟预通道。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**early_downsample_depth**<br/>生成供本帧晚期遮挡测试使用的深度金字塔。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**late_prepass_build_indirect_**<br/>**parameters**<br/>为本帧新显露对象构建后期预通道间接参数。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**late_deferred_prepass**<br/>为遮挡剔除执行晚期延迟预通道。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**early_deferred_prepass**<br/>执行早期延迟预通道并保存深度结果。" }
  class n6 node_system
  n7@{ shape: notch-rect, label: "**World**<br/>保存实体、组件、资源及关联元数据" }
  class n7 node_system_param
  n8@{ shape: notch-rect, label: "**PrepassViewQueryData**<br/>汇集深度、法线及运动预通道的视图输入。" }
  class n8 node_query_data
  n9@{ shape: cyl, label: "**ViewBinnedRenderPhases#lt;Opaque3dPrepa**<br/>**ss#gt;**<br/>汇集各视图按分桶组织的绘制指令。" }
  class n9 node_resource
  n10@{ shape: cyl, label: "**ViewBinnedRenderPhases#lt;AlphaMask3dPr**<br/>**epass#gt;**<br/>汇集各视图按分桶组织的绘制指令。" }
  class n10 node_resource
  n11@{ shape: cyl, label: "**PipelineCache**<br/>缓存 GPU 渲染、计算管线与待创建队列。" }
  class n11 node_resource
  n12@{ shape: notch-rect, label: "**RenderContext**<br/>向渲染系统提供命令编码器和 GPU 设备。" }
  class n12 node_system_param
  n1 e0@-->|"RenderApp / Core3d"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n3 e2@--> n0
  class e2 edge_order
  n4 e3@--> n0
  class e3 edge_order
  n0 e4@--> n5
  class e4 edge_order
  n6 e5@--> n0
  class e5 edge_order
  n7 e6@--> n0
  class e6 edge_read
  n8 e7@-->|"参数 / 查询数据"| n0
  class e7 edge_reference
  n9 e8@--> n0
  class e8 edge_read
  n10 e9@--> n0
  class e9 edge_read
  n11 e10@--> n0
  class e10 edge_read
  n12 e11@-->|"参数 / 查询数据"| n0
  class e11 edge_reference
