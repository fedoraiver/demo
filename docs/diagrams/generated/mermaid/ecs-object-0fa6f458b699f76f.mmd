      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-0fa6f458b699f76f-e0{marker-start:url(#object-0fa6f458b699f76f_flowchart-v2-pointStart)!important}\n#object-0fa6f458b699f76f-e2{marker-start:url(#object-0fa6f458b699f76f_flowchart-v2-pointStart)!important}\n#object-0fa6f458b699f76f_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
