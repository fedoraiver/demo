---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: avian3d::spatial_query::shapecast · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**shapecast**<br/>执行已启用的形状扫掠并更新命中列表。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**ShapeCaster**<br/>声明实体的形状投射查询。" }
  class n1 node_component
  n2@{ shape: cyl, label: "**ColliderTrees**<br/>按运动类别组织碰撞体加速树。" }
  class n2 node_resource
  n3@{ shape: fr-rect, label: "**SpatialQueryPlugin**<br/>执行组件声明的射线和形状查询。" }
  class n3 node_plugin
  n4@{ shape: rounded, label: "**ShapeHits**<br/>保存 ShapeCaster 最近生成的命中。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**Rotation**<br/>保存刚体或碰撞体的世界旋转。" }
  class n5 node_component
  n6@{ shape: cyl, label: "**SpatialQueryDiagnostics**<br/>记录射线与形状查询耗时。" }
  class n6 node_resource
  n7@{ shape: lin-rect, label: "**SpatialQuerySystems**<br/>刷新空间投射器并执行射线和形状查询。" }
  class n7 node_system_set
  n8@{ shape: rounded, label: "**Position**<br/>保存刚体或碰撞体的世界位置。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**Collider**<br/>保存 Parry 碰撞后端的几何形状。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**raycast**<br/>执行已启用的射线查询并更新命中列表。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**ColliderAabb**<br/>保存碰撞体的世界轴对齐包围盒。" }
  class n11 node_component
  n0 e0@-->|"可变访问"| n1
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_read
  n3 e2@-->|"调用"| n0
  class e2 edge_registration
  n0 e3@-->|"可变访问"| n4
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_read
  n0 e5@-->|"赋值"| n6
  class e5 edge_write
  n7 e6@-->|"集合成员"| n0
  class e6 edge_set_membership
  n8 e7@--> n0
  class e7 edge_read
  n9 e8@--> n0
  class e8 edge_read
  n0 e9@-->|"可变访问"| n6
  class e9 edge_write
  n10 e10@-->|"先于"| n0
  class e10 edge_order
  n11 e11@--> n0
  class e11 edge_read
