---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-94e415e219662983-e15{marker-start:url(#object-94e415e219662983_flowchart-v2-pointStart)!important}\n#object-94e415e219662983_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: warn_hold_strain · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_registration_helper fill:#F6F4F0,stroke:#8A7548,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**warn_hold_strain**<br/>检查持续持握偏差并发出失稳提示音。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**sync_held_presentation**<br/>按人物呈现姿态同步持物模型与握持目标。" }
  class n1 node_system
  n2@{ shape: cyl, label: "**Messages#lt;SoundRequest#gt;**<br/>来自音频播放 ↗：缓冲菜单交互与物品反馈<br/>的短音请求。" }
  class n2 node_message_buffer
  class n2 external_node
  n3@{ shape: tag-rect, label: "**物品反馈收集**<br/>收集持握失稳与物品落地的声音反馈。" }
  class n3 node_registration_helper
  n4@{ shape: stadium, label: "**main · FixedUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n4 node_engine_flow
  class n4 external_node
  n5@{ shape: lin-rect, label: "**FixedGameplaySystems::Target**<br/>来自应用流程 ↗：在装配前同步本帧持物呈<br/>现目标。" }
  class n5 node_system_set
  class n5 external_node
  n6@{ shape: cyl, label: "**Messages#lt;SoundRequest#gt;**<br/>来自Bevy 引擎 ↗：保存 SoundRequest<br/>消息。" }
  class n6 node_message_buffer
  class n6 external_node
  n7@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**HeldBy**<br/>关联当前物品的持有者。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**CarryGrip**<br/>保存握持对齐使用的模型偏移。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**Position**<br/>来自Avian ↗：保存物理模拟中的真实位<br/>置。" }
  class n10 node_component
  class n10 external_node
  n11@{ shape: rounded, label: "**Position**<br/>来自Avian ↗：保存物理模拟中的真实位<br/>置。" }
  class n11 node_component
  class n11 external_node
  n12@{ shape: cyl, label: "**Time#lt;Fixed#gt;**<br/>来自Bevy 引擎 ↗：提供固定模拟的时间步<br/>长。" }
  class n12 node_resource
  class n12 external_node
  n13@{ shape: cyl, label: "**PrototypeConfig**<br/>来自设置与参数 ↗：保存运动、重力、拾取<br/>与握持的共享参数。" }
  class n13 node_resource
  class n13 external_node
  n14@{ shape: notch-rect, label: "**Local#lt;HashMap#lt;Entity, HoldStrain#gt;#gt;**<br/>记录持握偏差计时与失稳提示锁存。" }
  class n14 node_local
  n15@{ shape: cyl, label: "**State#lt;AppState#gt; /**<br/>**NextState#lt;AppState#gt;**<br/>来自应用流程 ↗：保存主菜单、运行和暂停<br/>状态及下一次转换。" }
  class n15 node_resource
  class n15 external_node
  n16@{ shape: fr-rect, label: "**ItemInteractionPlugin**<br/>管理物品拾取、共享持握、安全释放与反馈。" }
  class n16 node_plugin
