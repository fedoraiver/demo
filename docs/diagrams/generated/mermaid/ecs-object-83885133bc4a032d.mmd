    "themeCSS": "#object-83885133bc4a032d-e1{marker-start:url(#object-83885133bc4a032d_flowchart-v2-pointStart)!important}\n#object-83885133bc4a032d_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
