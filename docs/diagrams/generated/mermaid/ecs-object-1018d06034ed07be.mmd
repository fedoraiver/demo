---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-1018d06034ed07be-e0{marker-start:url(#object-1018d06034ed07be_flowchart-v2-pointStart)!important}\n#object-1018d06034ed07be-e11{marker-start:url(#object-1018d06034ed07be_flowchart-v2-pointStart)!important}\n#object-1018d06034ed07be_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: NoTranslationEasing · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**NoTranslationEasing**<br/>显式禁止当前实体的平移插值和外推" }
  class n0 node_component
  n1@{ shape: rounded, label: "**handle​_​interaction**<br/>来自item​_​interaction ↗：拾取建立物理<br/>持握关系；释放只解除控制，保留刚体姿态、<br/>线速度和角速度。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**ease​_​translation​_​hermite**<br/>用两端线速度做 Hermite 位置平滑。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**ease​_​translation​_​lerp**<br/>按固定步剩余比例线性插值显示位置。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**recover​_​from​_​water**<br/>来自bounds​_​recovery ↗：恢复实体自身的<br/>出生姿态；角色落水只释放手中物品，物品落<br/>水时再独立恢复。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**resume​_​carry​_​easing**<br/>来自item​_​interaction ↗：下一固定步在<br/>旧端点清除后恢复自由箱插值，保留原本由其<br/>他模块设置的暂停项。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**update​_​translation​_​interpolation​_​end**<br/>把当前位置记录为插值终点。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**reset​_​translation​_​extrapolation**<br/>在固定步开始前还原真实位置。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**update​_​translation​_​interpolation​_​**<br/>**start**<br/>把当前位置记录为插值起点。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**resume​_​interpolation**<br/>来自bounds​_​recovery ↗：下一固定步从恢<br/>复后的位置重新采样插值，只移除本模块临时<br/>添加的暂停项。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**complete​_​translation​_​easing**<br/>在新一轮插值前完成上一段平移。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**update​_​translation​_​extrapolation​_​**<br/>**states**<br/>依据当前线速度预测下一个位置端点。" }
  class n11 node_system
  n1 e0@---|"存在性约束"| n0
  class e0 edge_reference
  n0 e1@-->|"存在性约束"| n2
  class e1 edge_reference
  n0 e2@-->|"存在性约束"| n3
  class e2 edge_reference
  n4 e3@-->|"插入"| n0
  class e3 edge_write
  n5 e4@-->|"移除"| n0
  class e4 edge_write
  n0 e5@-->|"存在性约束"| n6
  class e5 edge_reference
  n0 e6@-->|"存在性约束"| n7
  class e6 edge_reference
  n0 e7@-->|"存在性约束"| n8
  class e7 edge_reference
  n9 e8@-->|"移除"| n0
  class e8 edge_write
  n0 e9@-->|"存在性约束"| n10
  class e9 edge_reference
  n0 e10@-->|"存在性约束"| n11
  class e10 edge_reference
  n4 e11@---|"存在性约束"| n0
  class e11 edge_reference
  n1 e12@-->|"插入"| n0
  class e12 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: bumpX }
