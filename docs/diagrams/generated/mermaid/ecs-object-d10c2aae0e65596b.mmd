---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: main · PostStartup · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**main · PostStartup**<br/>保存本应用调度的注册上下文与成员。" }
  class n0 node_engine_flow
  n1@{ shape: rounded, label: "**mark_dirty_trees**<br/>沿祖先链标记需要重算变换的子树。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**propagate_parent_transforms**<br/>沿父子层级并行合成世界变换。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**sync_simple_transforms**<br/>同步没有父子层级的独立实体世界变换。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**camera_system**<br/>响应窗口创建、尺寸与缩放变化及图像目标变<br/>化，更新 Camera 与 Projection 的目标<br/>尺寸和投影信息；只读取相机实际引用的图像<br/>目标。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**set_initial_focus**<br/>在没有焦点目标时使用主窗口。" }
  class n5 node_system
  n6@{ shape: lin-rect, label: "**TransformSystems::Propagate**<br/>沿实体层级传播世界变换。" }
  class n6 node_system_set
  n7@{ shape: lin-rect, label: "**CameraUpdateSystems**<br/>统一更新相机目标、视口与投影计算结果。" }
  class n7 node_system_set
  n0 e0@-->|"main / PostStartup"| n1
  class e0 edge_registration
  n0 e1@-->|"main / PostStartup"| n2
  class e1 edge_registration
  n0 e2@-->|"main / PostStartup"| n3
  class e2 edge_registration
  n0 e3@-->|"main / PostStartup"| n4
  class e3 edge_registration
  n0 e4@-->|"main / PostStartup"| n5
  class e4 edge_registration
  n0 e5@-->|"main / PostStartup"| n6
  class e5 edge_registration
  n0 e6@-->|"main / PostStartup"| n7
  class e6 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
