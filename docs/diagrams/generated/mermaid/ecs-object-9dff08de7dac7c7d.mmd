---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: ui::MenuRoot · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**MenuRoot**<br/>页面根实体；页面更换时连同视觉子树一起销<br/>毁。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>组织当前菜单页面与固定页脚。" }
  class n1 node_entity
  n2@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>组织当前菜单页面与固定页脚。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>组织当前菜单页面与固定页脚。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>组织当前菜单页面与固定页脚。" }
  class n4 node_entity
  n5@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>组织当前菜单页面与固定页脚。" }
  class n5 node_entity
  n6@{ shape: rounded, label: "**rebuild​_​page**<br/>只在页面结构或视口变化时重建；数值、提示<br/>与焦点变化保留现有滚动控件。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>组织当前菜单页面与固定页脚。" }
  class n7 node_entity
  n8@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>组织当前菜单页面与固定页脚。" }
  class n8 node_entity
  n1 e0@-->|"可能包含"| n0
  class e0 edge_reference
  n2 e1@-->|"可能包含"| n0
  class e1 edge_reference
  n3 e2@-->|"可能包含"| n0
  class e2 edge_reference
  n4 e3@-->|"可能包含"| n0
  class e3 edge_reference
  n5 e4@-->|"可能包含"| n0
  class e4 edge_reference
  n0 e5@-->|"存在性约束"| n6
  class e5 edge_reference
  n7 e6@-->|"可能包含"| n0
  class e6 edge_reference
  n8 e7@-->|"可能包含"| n0
  class e7 edge_reference
  e0@{ curve: basis }
