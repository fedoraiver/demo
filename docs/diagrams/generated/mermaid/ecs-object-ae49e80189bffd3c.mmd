  n10 e9@--> n0
  class e9 edge_read
  n11 e10@-->|"调用"| n0
  class e10 edge_registration
  n0 e11@-->|"先于"| n12
  class e11 edge_order
  n13 e12@--> n0
  class e12 edge_read
  n14 e13@--> n0
  class e13 edge_read
  n15 e14@--> n0
  class e14 edge_read
