---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: bevy_asset::AssetEvent#lt;bevy_image::Image#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lean-r, label: "**AssetEvent#lt;Image#gt;**<br/>通知指定资产及依赖发生变化。" }
  class n0 node_message
  n1@{ shape: rounded, label: "**asset​_​events**<br/>发布累计的资产变化消息。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**extract​_​render​_​asset**<br/>来自crate:bevy​_​render ↗：按资产变化和<br/>设备恢复请求提取渲染资产。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**extract​_​chromatic​_​phase​_​textures**<br/>来自crate:bevy​_​light ↗：将已加载色度<br/>相函数纹理转换为散射曲线。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**camera​_​system**<br/>来自crate:bevy​_​render ↗：响应目标尺寸<br/>变化并更新相机投影。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**extract​_​sprite​_​events**<br/>来自crate:bevy​_​sprite​_​render ↗：把主<br/>世界图像资产事件复制给精灵渲染。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**free​_​egui​_​textures​_​system**<br/>来自crate:bevy​_​egui ↗：回收 Egui 已<br/>释放或失效的纹理引用。" }
  class n6 node_system
  class n6 external_node
  n1 e0@-->|"消息"| n0
  class e0 edge_publish
  n0 e1@--> n2
  class e1 edge_consume
  n0 e2@--> n3
  class e2 edge_consume
  n0 e3@--> n4
  class e3 edge_consume
  n1 e4@-->|"可变访问"| n0
  class e4 edge_publish
  n0 e5@--> n5
  class e5 edge_consume
  n0 e6@--> n4
  class e6 edge_consume
  n0 e7@--> n6
  class e7 edge_consume
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
