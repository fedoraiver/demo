{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: despawn_windows · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**despawn_windows**<br/>处理 ClosingWindow、Window 组件移除<br/>和 AppExit，通知窗口即将关闭，移出<br/>winit 窗口表并发布 WindowClosed；原生<br/>窗口包装保留到下一轮再由主线程释放。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · Last**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**changed_cursor_options**<br/>把光标配置变化同步到原生窗口。" }
  class n2 node_system
  n3@{ shape: lin-rect, label: "**OnAppExitSystems**<br/>在退出消息发出后执行应用收尾。" }
  class n3 node_system_set
  n4@{ shape: rounded, label: "**check_keyboard_focus_lost**<br/>处理跨窗口键盘焦点丢失并补发释放。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**ClosingWindow**<br/>标记窗口已收到关闭请求并正在关闭" }
  class n5 node_component
  n6@{ shape: notch-rect, label: "**RemovedComponents#lt;Window#gt;**<br/>读取曾移除指定组件或连同该组件一起销毁的<br/>实体身份" }
  class n6 node_system_param
  n7@{ shape: rounded, label: "**Window**<br/>保存窗口的呈现模式、位置、分辨率、标题、<br/>全屏及平台行为配置" }
  class n7 node_component
  n8@{ shape: cyl, label: "**Messages#lt;WindowClosing#gt;**<br/>保存 WindowClosing 消息。" }
  class n8 node_message_buffer
  n9@{ shape: cyl, label: "**Messages#lt;WindowClosed#gt;**<br/>保存 WindowClosed 消息。" }
  class n9 node_message_buffer
  n10@{ shape: notch-rect, label: "**Vec#lt;WindowWrapper#lt;Window#gt;#gt;**<br/>把原生窗口包装器保留到下次主线程调用释<br/>放。" }
  class n10 node_local
  n11@{ shape: cyl, label: "**Messages#lt;AppExit#gt;**<br/>通知音频停止并进入应用退出流程。" }
  class n11 node_message_buffer
  n12@{ shape: notch-rect, label: "**NonSendMarker**<br/>利用不可 Send 的标记约束系统在主线程运<br/>行" }
  class n12 node_system_param
  n13@{ shape: cyl, label: "**Messages#lt;Messages#lt;WindowClosing#gt;#gt;**<br/>保存 Messages#lt;WindowClosing#gt; 消息。" }
  class n13 node_message_buffer
  n14@{ shape: cyl, label: "**Messages#lt;Messages#lt;WindowClosed#gt;#gt;**<br/>保存 Messages#lt;WindowClosed#gt; 消息。" }
