---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: Velocity · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**Velocity**<br/>组织速度与位置积分阶段。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**ClearVelocityIncrements**<br/>组织速度与位置积分阶段。" }
  class n1 node_system_set
  n2@{ shape: lin-rect, label: "**UpdateVelocityIncrements**<br/>组织速度与位置积分阶段。" }
  class n2 node_system_set
  n0 e0@-->|"先于"| n1
  class e0 edge_order
  n2 e1@-->|"先于"| n0
  class e1 edge_order
