  class n4 external_node
  n5@{ shape: rounded, label: "**prepare​_​background​_​motion​_​vectors​_​**<br/>**pipelines**<br/>按采样数和法线预通道准备背景运动管线。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**prepare​_​background​_​motion​_​vectors​_​**<br/>**bind​_​groups**<br/>为背景运动矢量绑定前后两帧视图参数。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**check​_​prepass​_​views​_​need​_​**<br/>**specialization**<br/>来自crate:bevy​_​pbr ↗：检测采样和预通<br/>道配置变化并标记视图待刷新。" }
