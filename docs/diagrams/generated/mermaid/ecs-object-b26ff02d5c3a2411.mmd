---
flowchart LR
  accTitle: LineGizmoUniformBindgroupLayout · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**LineGizmoUniformBindgroupLayout**<br/>定义调试线 GPU 参数的绑定布局。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**init​_​line​_​gizmo​_​uniform​_​bind​_​group​_​**<br/>**layout**<br/>建立 Gizmo 线条动态参数的 GPU 布局。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**init​_​line​_​gizmo​_​pipelines**<br/>建立三维 Gizmo 线条深度管线和接头资源。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**init​_​line​_​gizmo​_​pipelines**<br/>建立二维 Gizmo 线段和接头管线。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**prepare​_​line​_​gizmo​_​bind​_​group**<br/>为 Gizmo 绘制绑定已上传的线条参数。" }
  class n4 node_system
  n1 e0@-->|"插入"| n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  e1@{ curve: basis }
  e3@{ curve: basis }
