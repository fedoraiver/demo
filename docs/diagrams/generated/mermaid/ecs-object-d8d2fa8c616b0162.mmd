  class n3 node_component
  n4@{ shape: rounded, label: "**ViewScreenSpaceReflectionsUniformOff**<br/>**set**<br/>来自crate:bevy​_​pbr ↗：定位视图在反射<br/>设置缓冲中的参数。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**ScreenSpaceReflectionsUniform**<br/>来自crate:bevy​_​pbr ↗：以 GPU 格式保<br/>存反射粗糙度和追踪设置。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: rounded, label: "**ScreenSpaceReflectionsPipelineId**<br/>来自crate:bevy​_​pbr ↗：标识视图需要的<br/>屏幕空间反射管线。" }
