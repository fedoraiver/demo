---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: OnAppExitSystems · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**OnAppExitSystems**<br/>在退出消息发出后执行应用收尾。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**ExitSystems**<br/>来自crate:bevy​_​window ↗：按窗口关闭策<br/>略请求应用退出。" }
  class n1 node_system_set
  class n1 external_node
  n2@{ shape: rounded, label: "**bevy​_​winit::system::despawn​_​windows**<br/>来自crate:bevy​_​winit ↗：处理原生窗口<br/>关闭并延后一轮释放包装器。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**bevy​_​time::delayed​_​commands::**<br/>**silence​_​delayed​_​command​_​queues​_​on​_​**<br/>**exit**<br/>来自crate:bevy​_​time ↗：在退出时关闭未<br/>执行延迟队列的丢弃警告。" }
  class n3 node_system
  class n3 external_node
  n1 e0@-->|"先于"| n0
  class e0 edge_order
  n0 e1@-->|"先于"| n2
  class e1 edge_order
  n0 e2@-->|"集合成员"| n3
  class e2 edge_set_membership
  e1@{ curve: basis }
  e2@{ curve: basis }
