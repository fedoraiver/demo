  n3@{ shape: rounded, label: "**draw​_​frustum​_​gizmos**<br/>来自crate:bevy​_​gizmos ↗：绘制带标记实<br/>体的视锥调试图形。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**assign​_​objects​_​to​_​clusters**<br/>来自crate:bevy​_​light ↗：将灯光、探针<br/>及贴花分配到视图分簇。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**update​_​point​_​light​_​frusta**<br/>来自crate:bevy​_​light ↗：更新可见点光<br/>的六面阴影视锥。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**draw​_​all​_​frustum​_​gizmos**<br/>来自crate:bevy​_​gizmos ↗：绘制未单独标<br/>记实体的视锥调试图形。" }
