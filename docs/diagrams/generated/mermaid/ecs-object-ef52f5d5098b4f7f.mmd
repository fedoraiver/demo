---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: UpdateEnd · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**UpdateEnd**<br/>组织变换缓动端点与帧间应用。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**update​_​rotation​_​extrapolation​_​states**<br/>依据当前角速度预测下一个旋转端点。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update​_​scale​_​interpolation​_​end**<br/>把当前缩放记录为插值终点。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update​_​rotation​_​interpolation​_​end**<br/>把当前旋转记录为插值终点。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**update​_​translation​_​interpolation​_​end**<br/>把当前位置记录为插值终点。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update​_​translation​_​extrapolation​_​**<br/>**states**<br/>依据当前线速度预测下一个位置端点。" }
  class n5 node_system
  n0 e0@-->|"集合成员"| n1
  class e0 edge_set_membership
  n0 e1@-->|"集合成员"| n2
  class e1 edge_set_membership
  n0 e2@-->|"集合成员"| n3
  class e2 edge_set_membership
  n0 e3@-->|"集合成员"| n4
  class e3 edge_set_membership
  n0 e4@-->|"集合成员"| n5
  class e4 edge_set_membership
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
