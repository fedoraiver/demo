  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**receive**<br/>按输入消息更新拾取指针状态。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update​_​interactions**<br/>合并多个指针对目标实体的交互状态。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**deactivate​_​touch​_​pointers**<br/>销毁已经结束或取消的触摸指针。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**generate​_​hovermap**<br/>汇总拾取命中并应用指针捕获。" }
