---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Assets<Image> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Assets#lt;Image#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**update_cursors**<br/>处理 CursorIcon 的变化与待重试窗口，准<br/>备原生或自定义光标；自定义图像按裁切、翻<br/>转和热点生成或复用缓存，资源尚未加载时保<br/>留重试。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**free_egui_textures_system**<br/>来自Egui / Inspector ↗：回收 Egui 已<br/>释放或失效的纹理引用。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**camera_system**<br/>响应窗口创建、尺寸与缩放变化及图像目标变<br/>化，更新 Camera 与 Projection 的目标<br/>尺寸和投影信息；只读取相机实际引用的图像<br/>目标。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**asset_events**<br/>将 Assets 暂存的<br/>Added、Modified、Removed 等变化批量写<br/>入对应 AssetEvent 消息；存在<br/>AssetChanges 时同步记录当前系统 tick，<br/>随后清空待发队列。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**camera_system**<br/>响应窗口创建、尺寸与缩放变化及图像目标变<br/>化，更新 Camera 与 Projection 的目标<br/>尺寸和投影信息；只读取相机实际引用的图像<br/>目标。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**calculate_bounds_2d**<br/>为二维网格和精灵计算局部包围盒。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**update_inline_image_boxes**<br/>把内联图像尺寸同步到文本排版盒。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**text_system**<br/>文本节点尺寸、字形提示或重排标志变化时，<br/>通过 TextPipeline 重算排版并写入<br/>TextLayoutInfo；同时更新字体图集，等待<br/>测量函数的文本暂不排版。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**update_editable_text_layout**<br/>刷新可编辑文本的字形布局和编辑反馈。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**update_egui_textures_system**<br/>来自Egui / Inspector ↗：应用 Egui 托<br/>管纹理的图像增量。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: rounded, label: "**extract_chromatic_phase_textures**<br/>将已加载色度相函数纹理转换为散射曲线。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**update_text2d_layout**<br/>重新排版变化的二维文字并准备字形。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**update_image_content_size_system**<br/>按图像或图集区域更新 UI 的固有尺寸测<br/>量。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**update_viewport_render_target_size**<br/>按 UI 视口节点尺寸调整相机图像目标。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**track_assets**<br/>持有 AssetServer 资产信息锁处理句柄释<br/>放通知，确认没有新强句柄后移除已释放资<br/>产，使 Assets 集合与资产服务器的引用状<br/>态保持一致。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**sprite_picking**<br/>将可见、变换有效的精灵按深度排序，结合指<br/>针射线、相机、精灵图像和拾取配置计算命<br/>中，并向拾取后端发布 PointerHits。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**update_tilemap_chunk_indices**<br/>将变化的瓦片块索引打包写入材质图像。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**generate_environment_map_light**<br/>为环境光生成分配漫反射和镜面目标图像。" }
  class n18 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@--> n0
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_read
  n4 e3@--> n0
  class e3 edge_write
  n0 e4@--> n5
  class e4 edge_read
  n0 e5@--> n6
  class e5 edge_read
  n0 e6@--> n7
  class e6 edge_read
  n8 e7@--> n0
  class e7 edge_write
  n9 e8@--> n0
  class e8 edge_write
  n10 e9@--> n0
  class e9 edge_write
  n0 e10@--> n11
  class e10 edge_read
  n12 e11@--> n0
  class e11 edge_write
  n0 e12@--> n13
  class e12 edge_read
  n14 e13@--> n0
  class e13 edge_write
  n15 e14@--> n0
  class e14 edge_write
  n0 e15@--> n16
  class e15 edge_read
  n17 e16@--> n0
  class e16 edge_write
  n18 e17@--> n0
  class e17 edge_write
