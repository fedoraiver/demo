---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: Menu page root · 对象关系
  accDescr: 实体创建模板与直接关联的非组件对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Menu page root**<br/>组织当前菜单页面与固定页脚。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**Menu page content**<br/>分配固定菜单内容区域的空间。" }
  class n1 node_entity
  n2@{ shape: rounded, label: "**Menu footer**<br/>承载固定菜单内容的背景布局。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**rebuild​_​page**<br/>只在页面结构或视口变化时重建；数值、提示<br/>与焦点变化保留现有滚动控件。" }
  class n3 node_system
  n0 e0@-->|"子实体"| n1
  class e0 edge_relationship
  n0 e1@-->|"子实体"| n2
  class e1 edge_relationship
  n3 e2@-->|"创建模板"| n0
  class e2 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
