---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: AssetExtractionSystems · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**AssetExtractionSystems**<br/>提取各 RenderAsset 类型的资产变化。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**extract_render_asset#lt;bevy_render::**<br/>**mesh::RenderMesh#gt;**<br/>每轮先清空旧提取队列，再根据源资产新增、<br/>修改及设备恢复请求提取 GPU 数据，按<br/>RenderAssetUsages 选择克隆或移出资产数<br/>据；最后一个句柄释放时记录渲染侧移除。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**extract_render_asset#lt;bevy_render::**<br/>**texture::gpu_image::GpuImage#gt;**<br/>每轮先清空旧提取队列，再根据源资产新增、<br/>修改及设备恢复请求提取 GPU 数据，按<br/>RenderAssetUsages 选择克隆或移出资产数<br/>据；最后一个句柄释放时记录渲染侧移除。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**extract_render_asset#lt;bevy_render::**<br/>**storage::GpuShaderBuffer#gt;**<br/>每轮先清空旧提取队列，再根据源资产新增、<br/>修改及设备恢复请求提取 GPU 数据，按<br/>RenderAssetUsages 选择克隆或移出资产数<br/>据；最后一个句柄释放时记录渲染侧移除。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**extract_render_asset#lt;bevy_pbr::**<br/>**medium::GpuScatteringMedium#gt;**<br/>每轮先清空旧提取队列，再根据源资产新增、<br/>修改及设备恢复请求提取 GPU 数据，按<br/>RenderAssetUsages 选择克隆或移出资产数<br/>据；最后一个句柄释放时记录渲染侧移除。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**extract_render_asset#lt;bevy_gizmos_**<br/>**render::GpuLineGizmo#gt;**<br/>每轮先清空旧提取队列，再根据源资产新增、<br/>修改及设备恢复请求提取 GPU 数据，按<br/>RenderAssetUsages 选择克隆或移出资产数<br/>据；最后一个句柄释放时记录渲染侧移除。" }
  class n6 node_system
  n1 e0@-->|"RenderApp / ExtractSchedule"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_set_membership
  n0 e4@--> n5
  class e4 edge_set_membership
  n0 e5@--> n6
  class e5 edge_set_membership
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
