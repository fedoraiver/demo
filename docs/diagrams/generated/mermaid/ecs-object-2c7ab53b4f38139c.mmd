  n1@{ shape: cyl, label: "**FxaaPipeline**<br/>提供 FXAA 的着色器和纹理绑定布局。" }
  class n1 node_resource
  n2@{ shape: rounded, label: "**CameraFxaaPipeline**<br/>保存相机的 FXAA 管线标识。" }
  class n2 node_component
  n3@{ shape: cyl, label: "**CurrentView**<br/>来自crate:bevy​_​render ↗：指定当前正在<br/>渲染的视图实体。" }
  class n3 node_resource
  class n3 external_node
  n4@{ shape: notch-rect, label: "**Local · cached​_​bind​_​group**<br/>按源颜色纹理复用 FXAA 绑定组。" }
