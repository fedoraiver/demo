---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Messages<WindowEvent> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Messages#lt;WindowEvent#gt;**<br/>保存 WindowEvent 消息。" }
  class n0 node_message_buffer
  n1@{ shape: rounded, label: "**mouse_pick_events**<br/>把窗口鼠标事件转换为拾取指针动作。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**touch_pick_events**<br/>把触摸阶段转换为独立拾取指针。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**changed_windows**<br/>将 Window 组件与 CachedWindow 比较，<br/>把标题、模式、位置、分辨率等受支持的变化<br/>同步到 winit 原生窗口，并发布调整尺寸或<br/>缩放等消息；渲染呈现模式由渲染模块另行处<br/>理。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**check_keyboard_focus_lost**<br/>处理跨窗口键盘焦点丢失并补发释放。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**write_pointer_moved_and_button_**<br/>**messages_system**<br/>来自Egui / Inspector ↗：按原生事件顺<br/>序转换 Egui 指针输入。" }
  class n5 node_system
  class n5 external_node
  n0 e0@--> n1
  class e0 edge_consume
  n0 e1@--> n2
  class e1 edge_consume
  n3 e2@--> n0
  class e2 edge_publish
  n4 e3@--> n0
  class e3 edge_publish
  n0 e4@--> n5
  class e4 edge_consume
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
