---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: egui_pass · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**egui_pass**<br/>读取当前 Egui 视图已准备的绘制数据、纹<br/>理绑定及变换缓冲，在目标颜色附件上执行<br/>Egui 绘制命令，并按相机视口设置渲染范<br/>围。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · Core3d**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: rounded, label: "**upscaling**<br/>来自Bevy 引擎 ↗：把视图主颜色纹理通过<br/>Blit 管线写入最终输出附件，遵循相机的输<br/>出模式、清屏颜色和视口；输出模式为<br/>Skip 时不写入。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**prepare_egui_pass**<br/>消费每个 Egui 视图暂缓处理的绘制回调更<br/>新，构造视口、裁剪、像素比例和目标尺寸信<br/>息，并在当前渲染世界调用回调的 update。" }
  class n3 node_system
  n4@{ shape: lin-rect, label: "**Core3dSystems::PostProcess**<br/>来自Bevy 引擎 ↗：执行三维色调映射及最<br/>终屏幕后处理。" }
  class n4 node_system_set
  class n4 external_node
  n5@{ shape: notch-rect, label: "**World**<br/>来自Bevy 引擎 ↗：保存实体、组件、资源<br/>及关联元数据" }
  class n5 node_system_param
  class n5 external_node
  n6@{ shape: rounded, label: "**EguiCameraView**<br/>在主渲染目标视图上保存对应的 Egui 渲染<br/>视图实体" }
  class n6 node_component
  n7@{ shape: rounded, label: "**ExtractedView**<br/>来自Bevy 引擎 ↗：描述渲染视图的身份、<br/>投影与空间状态。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**EguiViewTarget**<br/>在 Egui 渲染视图上保存对应的主目标视图<br/>实体" }
  class n8 node_component
  n9@{ shape: rounded, label: "**ViewTarget**<br/>来自Bevy 引擎 ↗：管理视图主颜色纹理及<br/>最终输出附件。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: rounded, label: "**ExtractedCamera**<br/>来自Bevy 引擎 ↗：保存渲染世界相机的目<br/>标和绘制配置。" }
  class n10 node_component
  class n10 external_node
  n11@{ shape: notch-rect, label: "**RenderContext**<br/>来自Bevy 引擎 ↗：向渲染系统提供命令编<br/>码器和 GPU 设备。" }
  class n11 node_system_param
  class n11 external_node
  n12@{ shape: cyl, label: "**EguiPipelines**<br/>索引每个Egui视图的专用化绘制管线。" }
  class n12 node_resource
  n13@{ shape: cyl, label: "**PipelineCache**<br/>来自Bevy 引擎 ↗：缓存 GPU 渲染、计算<br/>管线与待创建队列。" }
  class n13 node_resource
  class n13 external_node
  n14@{ shape: cyl, label: "**EguiRenderData**<br/>缓存 EguiPipeline 各特化实例的渲染管线<br/>身份" }
  class n14 node_resource
  n15@{ shape: cyl, label: "**EguiTextureBindGroups**<br/>索引Egui纹理绑定组及数组偏移。" }
  class n15 node_resource
  n16@{ shape: cyl, label: "**EguiTransforms**<br/>保存 Egui 变换的动态统一缓冲、主世界实<br/>体到缓冲偏移的映射及对应绑定组" }
  class n16 node_resource
  n1 e0@-->|"RenderApp / Core3d"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_order
  n3 e2@--> n0
  class e2 edge_order
  n4 e3@--> n0
  class e3 edge_order
  n5 e4@--> n0
  class e4 edge_read
  n6 e5@--> n0
  class e5 edge_read
  n7 e6@--> n0
  class e6 edge_read
  n8 e7@--> n0
  class e7 edge_read
  n9 e8@--> n0
  class e8 edge_read
  n10 e9@--> n0
  class e9 edge_read
  n11 e10@-->|"参数 / 查询数据"| n0
  class e10 edge_reference
  n12 e11@-->|"正文只读访问"| n0
  class e11 edge_read
  n13 e12@-->|"正文只读访问"| n0
  class e12 edge_read
  n14 e13@-->|"正文只读访问"| n0
  class e13 edge_read
  n15 e14@-->|"正文只读访问"| n0
  class e14 edge_read
  n16 e15@-->|"正文只读访问"| n0
  class e15 edge_read
