  class n4 node_entity
  n5@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>为设置正文提供垂直滚动条轨道。" }
  class n5 node_entity
  n6@{ shape: rounded, label: "**bind​_​settings​_​scrollbars**<br/>将设置滚动条绑定到对应内容视口。" }
  class n6 node_system
  n1 e0@-->|"可能包含"| n0
  class e0 edge_reference
  n0 e1@-->|"存在性约束"| n2
