  n10@{ shape: rounded, label: "**ComputedAngularInertia**<br/>保存汇总后的刚体局部角惯量。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**LockedAxes**<br/>锁定刚体的平移或旋转轴。" }
