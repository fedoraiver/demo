---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: InputSystems · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**InputSystems**<br/>把原始设备消息汇总为本帧输入状态。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**sync​_​context**<br/>来自ui ↗：按主窗口焦点启停菜单输入上下<br/>文。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**accumulate​_​mouse​_​motion​_​system**<br/>累计本帧鼠标位移。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**dispatch​_​focused​_​input**<br/>来自crate:bevy​_​input​_​focus ↗：向有效<br/>焦点或主窗口派发输入。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**gamepad​_​event​_​processing​_​system**<br/>过滤原始手柄数值并更新设备状态。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**dispatch​_​focused​_​input**<br/>来自crate:bevy​_​input​_​focus ↗：向有效<br/>焦点或主窗口派发输入。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**on​_​ime​_​input**<br/>来自crate:bevy​_​ui​_​widgets ↗：把输入<br/>法组合和提交转换为文字编辑操作。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**gamepad​_​connection​_​system**<br/>按连接消息添加或移除手柄组件。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**dispatch​_​focused​_​input**<br/>来自crate:bevy​_​input​_​focus ↗：向有效<br/>焦点或主窗口派发输入。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**keyboard​_​input​_​system**<br/>把键盘事件汇总为物理和逻辑按键状态。" }
  class n9 node_system
  n10@{ shape: lin-rect, label: "**Update**<br/>来自crate:bevy​_​enhanced​_​input ↗：组<br/>织动作求值、值应用与事件触发。" }
  class n10 node_system_set
  class n10 external_node
  n11@{ shape: rounded, label: "**accumulate​_​mouse​_​scroll​_​system**<br/>累计本帧滚轮位移和单位。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**sync​_​mouse​_​capture**<br/>来自first​_​person ↗：在输入转发前确定<br/>归属；切换前约定其他按键已松开，检查器没<br/>有进行中的交互。" }
  class n12 node_system
  class n12 external_node
  n13@{ shape: lin-rect, label: "**Prepare**<br/>来自crate:bevy​_​enhanced​_​input ↗：组<br/>织动作求值、值应用与事件触发。" }
  class n13 node_system_set
  class n13 external_node
  n14@{ shape: rounded, label: "**touch​_​screen​_​input​_​system**<br/>维护持续触点与本帧触摸边沿。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**mouse​_​button​_​input​_​system**<br/>把鼠标按钮事件汇总为按钮状态。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**ui​_​focus​_​system**<br/>来自crate:bevy​_​ui ↗：按鼠标和触摸更新<br/>旧式 UI 交互状态。" }
  class n16 node_system
  class n16 external_node
  n17@{ shape: lin-rect, label: "**ProcessInput**<br/>来自crate:bevy​_​egui ↗：组织 Egui 上<br/>下文与输入准备。" }
  class n17 node_system_set
  class n17 external_node
  n18@{ shape: rounded, label: "**listen​_​for​_​ime​_​input​_​when​_​text​_​**<br/>**input​_​focused**<br/>来自crate:bevy​_​ui​_​widgets ↗：按可编<br/>辑焦点控制主窗口输入法。" }
  class n18 node_system
  class n18 external_node
  n19@{ shape: rounded, label: "**gilrs​_​event​_​system**<br/>来自crate:bevy​_​gilrs ↗：把 gilrs 原<br/>始手柄事件转换为 Bevy 消息。" }
  class n19 node_system
  class n19 external_node
