---
flowchart LR
  accTitle: handle_internal_asset_events · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**handle_internal_asset_events**<br/>消费资产服务器内部的加载、依赖就绪和失败<br/>通知，完成资产状态更新、唤醒等待任务并发<br/>布对应消息；启用热重载时继续处理依赖和文<br/>件变化。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PreUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**AssetTrackingSystems**<br/>追踪资产句柄生命周期并处理待释放资产。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**publish_asset_server_diagnostics**<br/>发布资产加载任务的启动计数。" }
  class n3 node_system
  n4@{ shape: notch-rect, label: "**World**<br/>保存实体、组件、资源及关联元数据" }
  class n4 node_system_param
  n5@{ shape: cyl, label: "**AssetServer**<br/>加载并查询递归依赖。" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**Messages#lt;UntypedAssetLoadFailedEvent**<br/>**#gt;**<br/>保存 UntypedAssetLoadFailedEvent 消<br/>息。" }
  class n6 node_message_buffer
  n1 e0@-->|"main / PreUpdate"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_order
  n0 e2@--> n3
  class e2 edge_order
  n0 e3@--> n4
  class e3 edge_write
  n0 e4@-->|"正文可变访问"| n5
  class e4 edge_write
  n0 e5@-->|"正文发布消息"| n6
  class e5 edge_publish
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
