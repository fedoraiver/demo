---
flowchart LR
  accTitle: avian3d::prelude::ColliderDensity · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ColliderDensity**<br/>以密度参与碰撞体质量计算。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update​_​collider​_​mass​_​properties**<br/>按变化的形状和密度重算碰撞体质量。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**init​_​collider​_​constructor​_​**<br/>**hierarchies**<br/>按层级构造配置为后代生成碰撞体。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**spawn​_​session · 创建模板**<br/>来自scene​_​assembly ↗：承载灰盒地面的<br/>显示与静态碰撞。" }
  class n3 node_entity
  class n3 external_node
  n4@{ shape: hex, label: "**build::{closure#35;6}**<br/>恢复非传感器碰撞体的质量属性。" }
  class n4 node_observer
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"插入"| n0
  class e1 edge_write
  n3 e2@-->|"可能包含"| n0
  class e2 edge_reference
  n0 e3@--> n4
  class e3 edge_read
  n0 e4@-->|"存在性约束"| n1
  class e4 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
