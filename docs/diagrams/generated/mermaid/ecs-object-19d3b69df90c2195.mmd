---
flowchart LR
  accTitle: gilrs_event_startup_system · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**gilrs_event_startup_system**<br/>登记启动时已经连接的手柄。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PreStartup**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n2 node_system_param
  n3@{ shape: cyl, label: "**Gilrs**<br/>持有 gilrs 手柄后端实例" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**GilrsGamepads**<br/>维护已连接 gilrs 手柄编号与 Bevy 手柄<br/>实体的双向映射" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**Messages#lt;GamepadConnectionEvent#gt;**<br/>保存 GamepadConnectionEvent 消息。" }
  class n5 node_message_buffer
  n6@{ shape: cyl, label: "**Messages#lt;Messages#lt;GamepadConnectionE**<br/>**vent#gt;#gt;**<br/>保存<br/>Messages#lt;GamepadConnectionEvent#gt; 消<br/>息。" }
  class n6 node_message_buffer
  n1 e0@-->|"main / PreStartup"| n0
  class e0 edge_registration
  n2 e1@-->|"参数 / 查询数据"| n0
  class e1 edge_reference
  n0 e2@--> n3
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_write
  n0 e4@--> n5
  class e4 edge_publish
  n0 e5@-->|"正文发布消息"| n6
  class e5 edge_publish
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
