---
flowchart LR
  accTitle: update_tilemap_chunk_indices · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**update_tilemap_chunk_indices**<br/>将变化的瓦片块索引打包写入材质图像。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · Update**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**TilemapChunk**<br/>把矩形瓦片区域作为单个网格渲染。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**TilemapChunkTileData**<br/>保存瓦片块内各格的图集索引或空格状态。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**MeshMaterial2d#lt;TilemapChunkMaterial#gt;**<br/>为二维网格指定材质资产。" }
  class n4 node_component
  n5@{ shape: cyl, label: "**Assets#lt;TilemapChunkMaterial#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**Assets#lt;Image#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n6 node_resource
  n1 e0@-->|"main / Update"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_read
  n3 e2@--> n0
  class e2 edge_read
  n4 e3@--> n0
  class e3 edge_read
  n3 e4@-->|"存在 / 变更过滤"| n0
  class e4 edge_reference
  n0 e5@--> n5
  class e5 edge_write
  n0 e6@--> n6
  class e6 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
