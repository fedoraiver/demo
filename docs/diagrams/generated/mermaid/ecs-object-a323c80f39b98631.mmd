---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: AfterFixedMainLoop · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**AfterFixedMainLoop**<br/>划分固定更新循环的前后边界。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**Visibility**<br/>来自game​_​flow ↗：固定循环后的呈现阶<br/>段，零固定步的帧也执行同一顺序。" }
  class n1 node_system_set
  class n1 external_node
  n2@{ shape: rounded, label: "**bevy​_​gizmos::end​_​gizmo​_​context#lt;bevy​_​**<br/>**gizmos::config::**<br/>**DefaultGizmoConfigGroup, bevy​_​time::**<br/>**fixed::Fixed#gt;**<br/>来自crate:bevy​_​gizmos ↗：清空当前默<br/>认 Gizmo 存储，再与上下文交换缓冲互换，<br/>恢复先前保存的父上下文，供后续图元网格生<br/>成使用。" }
  class n2 node_system
  class n2 external_node
