---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-d283917c9c30bcb8-e0{marker-start:url(#object-d283917c9c30bcb8_flowchart-v2-pointStart)!important}\n#object-d283917c9c30bcb8-e1{marker-start:url(#object-d283917c9c30bcb8_flowchart-v2-pointStart)!important}\n#object-d283917c9c30bcb8-e8{marker-start:url(#object-d283917c9c30bcb8_flowchart-v2-pointStart)!important}\n#object-d283917c9c30bcb8-e9{marker-start:url(#object-d283917c9c30bcb8_flowchart-v2-pointStart)!important}\n#object-d283917c9c30bcb8_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: bevy_app::Inherited#lt;ui_node::ComputedUiRenderTargetInfo#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Inherited#lt;ComputedUiRenderTargetInfo**<br/>**#gt;**<br/>保存层级传播算法继承到当前节点的中间组件<br/>值" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update​_​source**<br/>同步传播源并恢复移除来源后的继承状态。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**propagate​_​inherited**<br/>沿关系层级传播变化的继承组件值。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**propagate​_​output**<br/>把继承结果写入或移出实体实际组件。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**update​_​removed​_​limit**<br/>在传播限制移除后重新标记继承链。" }
  class n4 node_system
  n1 e0@---|"存在性约束"| n0
  class e0 edge_reference
  n2 e1@--- n0
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n1 e3@-->|"插入"| n0
  class e3 edge_write
  n2 e4@-->|"插入"| n0
  class e4 edge_write
  n4 e5@-->|"可变访问"| n0
  class e5 edge_write
  n2 e6@-->|"移除"| n0
  class e6 edge_write
  n0 e7@-->|"存在性约束"| n3
  class e7 edge_reference
  n1 e8@--- n0
  class e8 edge_read
  n2 e9@---|"存在性约束"| n0
  class e9 edge_reference
  n1 e10@-->|"移除"| n0
  class e10 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
