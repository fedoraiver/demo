---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: ThreadedAnimationGraphs · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**ThreadedAnimationGraphs**<br/>缓存动画图的线程化遍历加速结构" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**thread_animation_graphs**<br/>维护动画图的快速求值结构。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**animate_targets**<br/>依据目标的<br/>AnimatedBy、AnimationTargetId 和当前<br/>动画图，评估正在播放的动画并把结果写入骨<br/>骼等动画目标；缺少播放器或图资产时跳过该<br/>目标。" }
  class n2 node_system
  n1 e0@--> n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
