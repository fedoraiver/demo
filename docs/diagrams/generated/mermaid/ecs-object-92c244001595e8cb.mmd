---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-92c244001595e8cb-e3{marker-start:url(#object-92c244001595e8cb_flowchart-v2-pointStart)!important}\n#object-92c244001595e8cb_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: scrollbar::Scrollbar · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Scrollbar**<br/>指定滚动条目标、方向和最小滑块长度。" }
  class n0 node_component
  n1@{ shape: hex, label: "**scrollbar​_​on​_​pointer​_​down**<br/>点击滚动条轨道时翻动一页。" }
  class n1 node_observer
  n2@{ shape: hex, label: "**scrollbar​_​on​_​drag​_​start**<br/>记录滚动条拖动的起始位置。" }
  class n2 node_observer
  n3@{ shape: hex, label: "**scrollbar​_​on​_​pointer​_​down**<br/>点击滚动条轨道时翻动一页。" }
  class n3 node_observer
  n4@{ shape: rounded, label: "**bind​_​settings​_​scrollbars**<br/>来自ui ↗：把设置滚动轨道绑定到实际内容<br/>视口。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: hex, label: "**scrollbar​_​on​_​drag**<br/>随滑块拖动更新目标滚动位置。" }
  class n5 node_observer
  n6@{ shape: hex, label: "**scrollbar​_​on​_​pointer​_​down**<br/>点击滚动条轨道时翻动一页。" }
  class n6 node_observer
  n7@{ shape: rounded, label: "**sync​_​settings​_​scrollbars**<br/>来自ui ↗：同步设置滚动条的有效范围和交<br/>互状态。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: hex, label: "**scrollbar​_​on​_​drag**<br/>随滑块拖动更新目标滚动位置。" }
  class n8 node_observer
  n9@{ shape: rounded, label: "**update​_​scrollbar​_​thumb**<br/>按内容比例与滚动位置更新滚动条滑块。" }
  class n9 node_system
  n10@{ shape: hex, label: "**scrollbar​_​on​_​drag**<br/>随滑块拖动更新目标滚动位置。" }
  class n10 node_observer
  n11@{ shape: hex, label: "**scrollbar​_​on​_​drag​_​start**<br/>记录滚动条拖动的起始位置。" }
  class n11 node_observer
  n12@{ shape: hex, label: "**scrollbar​_​on​_​drag​_​start**<br/>记录滚动条拖动的起始位置。" }
  class n12 node_observer
