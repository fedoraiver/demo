---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-2e9c8772822e1d6d-e9{marker-start:url(#object-2e9c8772822e1d6d_flowchart-v2-pointStart)!important}\n#object-2e9c8772822e1d6d-e10{marker-start:url(#object-2e9c8772822e1d6d_flowchart-v2-pointStart)!important}\n#object-2e9c8772822e1d6d_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: MenuFocus · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**MenuFocus**<br/>保存当前可操作按钮的导航序号。" }
  class n0 node_resource
  n1@{ shape: hex, label: "**previous**<br/>循环选择上一个可操作菜单按钮。" }
  class n1 node_observer
  n2@{ shape: hex, label: "**next**<br/>循环选择下一个可操作菜单按钮。" }
  class n2 node_observer
  n3@{ shape: rounded, label: "**show_main_menu**<br/>打开主菜单并重置页面、返回来源与焦点。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**show_pause_menu**<br/>打开暂停菜单并重置焦点。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**handle_requests**<br/>处理菜单导航、设置应用与音量编辑请求。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**pointer_interaction**<br/>将真实鼠标交互转换为共享菜单请求。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**style_buttons**<br/>按当前输入来源更新按钮背景与焦点边框。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**update_description**<br/>更新当前聚焦设置的说明标题与正文。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**scroll_focused_button**<br/>将当前聚焦设置按钮滚入可视范围。" }
  class n9 node_system
  n10@{ shape: hex, label: "**left**<br/>向左调整当前聚焦的真实设置字段。" }
  class n10 node_observer
  n11@{ shape: hex, label: "**right**<br/>向右调整当前聚焦的真实设置字段。" }
  class n11 node_observer
  n12@{ shape: hex, label: "**confirm**<br/>执行当前聚焦按钮的菜单动作。" }
  class n12 node_observer
  n13@{ shape: rounded, label: "**sample_slider_pointer**<br/>从光标位置生成音量采样与释放请求。" }
  class n13 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@-->|"访问声明"| n0
  class e2 edge_write
  n4 e3@-->|"访问声明"| n0
  class e3 edge_write
  n5 e4@-->|"访问声明"| n0
  class e4 edge_write
  n6 e5@-->|"访问声明"| n0
  class e5 edge_write
  n0 e6@-->|"访问声明"| n7
  class e6 edge_read
  n0 e7@-->|"访问声明"| n8
  class e7 edge_read
  n0 e8@-->|"访问声明"| n9
  class e8 edge_read
  n1 e9@---|"访问声明"| n0
  class e9 edge_read
  n2 e10@---|"访问声明"| n0
  class e10 edge_read
  n0 e11@-->|"访问声明"| n10
  class e11 edge_read
  n0 e12@-->|"访问声明"| n11
  class e12 edge_read
  n0 e13@-->|"访问声明"| n12
  class e13 edge_read
  n13 e14@-->|"访问声明"| n0
  class e14 edge_write
  n1 layout_input_0@~~~ n2
  n2 layout_input_1@~~~ n3
  n3 layout_input_2@~~~ n4
  n4 layout_input_3@~~~ n5
  n5 layout_input_4@~~~ n6
  n6 layout_input_5@~~~ n13
