flowchart LR
  accTitle: ForceSystems::ApplyConstantForces · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**ForceSystems::ApplyConstantForces**<br/>把恒定作用累加为世界或局部速度增量。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**main · PhysicsSchedule**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**IntegrationSystems::**<br/>**UpdateVelocityIncrements**<br/>为子步积分准备外力和重力增量。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**apply_constant_forces**<br/>按总质量把恒力换成待积分线加速度。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**apply_constant_torques**<br/>按求解器有效惯量换算世界恒定扭矩。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**apply_constant_linear_acceleration**<br/>把恒定世界线加速度加入待积分增量。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**apply_constant_angular_acceleration**<br/>把恒定世界角加速度加入待积分增量。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**apply_constant_local_forces**<br/>按总质量把局部恒力转成局部线加速度。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**apply_constant_local_torques**<br/>按局部惯量把恒定局部扭矩转成角加速度。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**apply_constant_local_linear_**<br/>**acceleration**<br/>累加刚体局部坐标中的恒定线加速度。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**apply_constant_local_angular_**<br/>**acceleration**<br/>累加刚体局部坐标中的恒定角加速度。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**pre_process_velocity_increments**<br/>把加速度、重力和轴锁转成子步速度增量。" }
