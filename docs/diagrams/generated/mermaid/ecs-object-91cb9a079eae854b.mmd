---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Mesh2d · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Mesh2d**<br/>为二维可绘制实体指定网格资产。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**calculate_bounds_2d**<br/>为二维网格和精灵计算局部包围盒。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**mark_2d_meshes_as_changed_if_their_**<br/>**assets_changed**<br/>资产内容变化时标记对应二维网格已变更。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**mark_2d_meshes_as_changed_if_their_**<br/>**materials_changed#lt;bevy_sprite_**<br/>**render::mesh2d::color_material::**<br/>**ColorMaterial#gt;**<br/>让材质变化触发二维网格重新提取。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**check_entities_needing_**<br/>**specialization#lt;bevy_sprite_render::**<br/>**mesh2d::color_material::**<br/>**ColorMaterial#gt;**<br/>收集二维网格材质需重建或移除专用化的实<br/>体。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**mark_2d_meshes_as_changed_if_their_**<br/>**materials_changed#lt;bevy_sprite_**<br/>**render::sprite_mesh::sprite_mesh_**<br/>**material::SpriteMeshMaterial#gt;**<br/>让材质变化触发二维网格重新提取。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**check_entities_needing_**<br/>**specialization#lt;bevy_sprite_render::**<br/>**sprite_mesh::sprite_mesh_material::**<br/>**SpriteMeshMaterial#gt;**<br/>收集二维网格材质需重建或移除专用化的实<br/>体。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**add_mesh**<br/>首次需要时创建并缓存单位矩形网格，为新加<br/>入 Sprite 的实体插入共享的 Mesh2d，使<br/>精灵进入网格渲染路径。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**add_material**<br/>精灵、锚点或网格材料计数改变时，清理失效<br/>缓存并按 Sprite 与 Anchor 复用或创建<br/>SpriteMeshMaterial，再插入<br/>MeshMaterial2d；已有材料计数非零的实体<br/>跳过。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**mark_2d_meshes_as_changed_if_their_**<br/>**materials_changed#lt;bevy_sprite_**<br/>**render::tilemap_chunk::tilemap_**<br/>**chunk_material::**<br/>**TilemapChunkMaterial#gt;**<br/>让材质变化触发二维网格重新提取。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**check_entities_needing_**<br/>**specialization#lt;bevy_sprite_render::**<br/>**tilemap_chunk::tilemap_chunk_**<br/>**material::TilemapChunkMaterial#gt;**<br/>收集二维网格材质需重建或移除专用化的实<br/>体。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**extract_2d_meshes**<br/>增量同步二维网格变换和渲染实例信息。" }
  class n11 node_system
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@-->|"存在 / 变更过滤"| n1
  class e1 edge_reference
  n2 e2@--> n0
  class e2 edge_write
  n3 e3@--> n0
  class e3 edge_write
  n0 e4@-->|"存在 / 变更过滤"| n4
  class e4 edge_reference
  n5 e5@--> n0
  class e5 edge_write
  n0 e6@-->|"存在 / 变更过滤"| n6
  class e6 edge_reference
  n7 e7@-->|"延迟添加"| n0
  class e7 edge_write
  n0 e8@-->|"存在 / 变更过滤"| n8
  class e8 edge_reference
  n9 e9@--> n0
  class e9 edge_write
  n0 e10@-->|"存在 / 变更过滤"| n10
  class e10 edge_reference
  n0 e11@-->|"存在 / 变更过滤"| n11
  class e11 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
