  class n4 node_system
  n5@{ shape: rounded, label: "**update_gizmo_meshes#lt;bevy_gizmos::**<br/>**frustum::FrustumGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n5 node_system
