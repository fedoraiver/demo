  class n7 node_system
  n8@{ shape: rounded, label: "**propagate_gizmos#lt;bevy_light::**<br/>**gizmos::LightGizmoConfigGroup, bevy_**<br/>**time::fixed::Fixed#gt;**<br/>把指定上下文与清理阶段的 GizmoStorage<br/>追加到 Update 图元存储，供后续网格构建<br/>和渲染使用；具体配置组和阶段由泛型实参区<br/>分。" }
