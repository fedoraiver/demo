  class n2 node_system
  n3@{ shape: rounded, label: "**update_gizmo_meshes#lt;bevy_gizmos::**<br/>**config::DefaultGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
