---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-024a70ada91ab763-e2{marker-start:url(#object-024a70ada91ab763_flowchart-v2-pointStart)!important}\n#object-024a70ada91ab763-e6{marker-start:url(#object-024a70ada91ab763_flowchart-v2-pointStart)!important}\n#object-024a70ada91ab763-e8{marker-start:url(#object-024a70ada91ab763_flowchart-v2-pointStart)!important}\n#object-024a70ada91ab763-e10{marker-start:url(#object-024a70ada91ab763_flowchart-v2-pointStart)!important}\n#object-024a70ada91ab763_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: CharacterMotion · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**CharacterMotion**<br/>保存角色接地等运动观察结果。" }
  class n0 node_component
  n1@{ shape: notch-rect, label: "**RecoverableBody**<br/>来自越界恢复 ↗：声明落水恢复需要查询的<br/>组件与存在条件。" }
  class n1 node_query_data
  class n1 external_node
  n2@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n2 node_entity
  class n2 external_node
  n3@{ shape: rounded, label: "**world_inspector_ui**<br/>来自Egui / Inspector ↗：展示并编辑开<br/>放反射的实体、资源与资产。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**move_characters**<br/>按移动意图和速度为角色施加水平运动力。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**jump_characters**<br/>执行角色跳跃并消费单次请求。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_grounded**<br/>准备运动前更新接地状态。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**update_grounded**<br/>物理回写之后观察实际接地状态。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**log_character_velocity**<br/>定期记录角色实际速度与接地状态。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**initialize_ready_couriers**<br/>来自角色动画 ↗：绑定主角命名动画并缓存<br/>鞋底补偿节点。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**sync_courier_animation**<br/>来自角色动画 ↗：按角色运动状态连续混合<br/>移动与跳跃动画。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n11 node_system
  class n11 external_node
  n1 e0@-->|"Option#lt;Write#lt;CharacterMotion#gt;#gt; 参数<br/>声明"| n0
  class e0 edge_reference
  n0 e1@-->|"可能挂载于"| n2
  class e1 edge_reference
  n3 e2@---|"反射查看"| n0
  class e2 edge_read
  n3 e3@-->|"反射可选编辑"| n0
  class e3 edge_write
  n0 e4@-->|"查询访问"| n4
  class e4 edge_read
  n5 e5@-->|"可变访问"| n0
  class e5 edge_write
  n5 e6@---|"查询访问"| n0
  class e6 edge_read
  n6 e7@-->|"可变访问"| n0
  class e7 edge_write
  n6 e8@---|"查询访问"| n0
  class e8 edge_read
  n7 e9@-->|"可变访问"| n0
  class e9 edge_write
  n7 e10@---|"查询访问"| n0
  class e10 edge_read
  n0 e11@-->|"查询访问"| n8
  class e11 edge_read
  n0 e12@-->|"查询访问"| n9
  class e12 edge_read
  n0 e13@-->|"查询访问"| n10
  class e13 edge_read
  n11 e14@-->|"可变访问"| n0
  class e14 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: bumpX }
  e7@{ curve: bumpX }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: bumpX }
  e12@{ curve: basis }
