---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Assets<Gltf> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Assets#lt;Gltf#gt;**<br/>保存导入场景与命名动画的资源引用。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**asset_events**<br/>将 Assets 暂存的<br/>Added、Modified、Removed 等变化批量写<br/>入对应 AssetEvent 消息；存在<br/>AssetChanges 时同步记录当前系统 tick，<br/>随后清空待发队列。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**track_assets**<br/>持有 AssetServer 资产信息锁处理句柄释<br/>放通知，确认没有新强句柄后移除已释放资<br/>产，使 Assets 集合与资产服务器的引用状<br/>态保持一致。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**begin_island**<br/>来自场景装配 ↗：请求创建已加载海岛的运<br/>行实例。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**spawn_actors**<br/>来自场景装配 ↗：装配玩家、可搬物、控制<br/>者与相机。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**initialize_ready_couriers**<br/>来自角色动画 ↗：绑定主角命名动画并缓存<br/>鞋底补偿节点。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**play_courier_animation**<br/>来自菜单与界面 ↗：绑定并循环播放展示快<br/>递员的持物待机动画。" }
  class n6 node_system
  class n6 external_node
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n0 e2@-->|"访问声明"| n3
  class e2 edge_read
  n0 e3@-->|"访问声明"| n4
  class e3 edge_read
  n0 e4@-->|"访问声明"| n5
  class e4 edge_read
  n0 e5@-->|"访问声明"| n6
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
