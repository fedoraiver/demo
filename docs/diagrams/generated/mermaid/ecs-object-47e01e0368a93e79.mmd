---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: ContactGraph · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**ContactGraph**<br/>保存物理解算后的真实接触结果。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**apply_contact_status_changes**<br/>把接触增删同步到约束图和物理岛。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**collect_collision_pairs#lt;()#gt;**<br/>为移动碰撞代理收集广相候选接触。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update_narrow_phase#lt;avian3d::**<br/>**collision::collider::parry::**<br/>**Collider, ()#gt;**<br/>更新窄相接触并输出碰撞变化消息。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**split_island**<br/>物理岛存在待拆分候选时，根据刚体碰撞体、<br/>接触图和关节图重新划分该岛，并更新刚体所<br/>属岛；拆分用于随后正确决定休眠。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**prepare_contact_constraints**<br/>从有效接触流形生成本轮求解约束。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**solve_continuous**<br/>对单步位移相对厚度过大的动态刚体执行连续<br/>碰撞扫掠；发现碰撞时缩短累计运动，使刚体<br/>停在首次撞击位置，并保留后续接触处理所需<br/>信息。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**store_contact_impulses**<br/>保存已求得的接触冲量供下一轮热启动。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**apply_contact_status_changes**<br/>把接触增删同步到约束图和物理岛。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**emit_parcel_land**<br/>来自物品交互 ↗：识别自由物品落地并发出<br/>声音请求。" }
  class n9 node_system
  class n9 external_node
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_read
  n0 e4@--> n5
  class e4 edge_read
  n6 e5@--> n0
  class e5 edge_write
  n7 e6@--> n0
  class e6 edge_write
  n0 e7@--> n8
  class e7 edge_read
  n0 e8@-->|"访问声明"| n9
  class e8 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
