---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-0851da3f38e9d5a9-e2{marker-start:url(#object-0851da3f38e9d5a9_flowchart-v2-pointStart)!important}\n#object-0851da3f38e9d5a9_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: bevy::bevy_window::RawHandleWrapper · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**RawHandleWrapper**<br/>持有原始窗口及显示服务器句柄" }
  class n0 node_component
  n1@{ shape: rounded, label: "**create​_​surfaces**<br/>来自crate:bevy​_​render ↗：创建并配置提<br/>取窗口的 GPU 表面。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**extract​_​windows**<br/>来自crate:bevy​_​render ↗：向渲染世界同<br/>步窗口配置与原生句柄。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**install​_​native​_​policy**<br/>来自window​_​policy ↗：安装并维护原生窗<br/>口比例与尺寸策略。" }
  class n3 node_system
  class n3 external_node
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"移除"| n0
  class e1 edge_write
  n2 e2@--- n0
  class e2 edge_read
  n2 e3@-->|"插入"| n0
  class e3 edge_write
  n0 e4@--> n3
  class e4 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
