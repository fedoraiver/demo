---
flowchart LR
  accTitle: gamepad::GamepadConnectionEvent · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lean-r, label: "**GamepadConnectionEvent**<br/>通知手柄连接或断开。" }
  class n0 node_message
  n1@{ shape: rounded, label: "**gamepad​_​connection​_​system**<br/>按连接消息添加或移除手柄组件。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**gilrs​_​event​_​system**<br/>来自crate:bevy​_​gilrs ↗：把 gilrs 原<br/>始手柄事件转换为 Bevy 消息。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**gilrs​_​event​_​startup​_​system**<br/>来自crate:bevy​_​gilrs ↗：登记启动时已<br/>经连接的手柄。" }
  class n3 node_system
  class n3 external_node
  n0 e0@--> n1
  class e0 edge_consume
  n2 e1@-->|"消息"| n0
  class e1 edge_publish
  n3 e2@-->|"消息"| n0
  class e2 edge_publish
  n2 e3@-->|"可变访问"| n0
  class e3 edge_publish
  n3 e4@-->|"可变访问"| n0
  class e4 edge_publish
  e1@{ curve: basis }
  e2@{ curve: bumpX }
  e3@{ curve: bumpX }
  e4@{ curve: basis }
