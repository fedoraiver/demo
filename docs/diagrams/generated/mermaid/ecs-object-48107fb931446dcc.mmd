---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Messages<KeyboardFocusLost> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Messages#lt;KeyboardFocusLost#gt;**<br/>通知输入系统清理失焦后残留的按键。" }
  class n0 node_message_buffer
  n1@{ shape: rounded, label: "**check_keyboard_focus_lost**<br/>处理跨窗口键盘焦点丢失并补发释放。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**keyboard_input_system**<br/>把键盘事件汇总为物理和逻辑按键状态。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**write_modifiers_keys_state_system**<br/>来自Egui / Inspector ↗：更新 Egui 修<br/>饰键并清除失焦残留。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: lin-rect, label: "**InputSystems**<br/>汇总键盘与鼠标输入状态。" }
  class n4 node_system_set
  n1 e0@--> n0
  class e0 edge_publish
  n0 e1@--> n2
  class e1 edge_consume
  n0 e2@--> n3
  class e2 edge_consume
  n0 e3@-->|"访问声明"| n4
  class e3 edge_consume
  e1@{ curve: basis }
  e3@{ curve: basis }
