---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: extract_morphs · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**extract_morphs**<br/>提取可见网格的形变权重，重建本帧权重缓冲<br/>及实体索引，同时保留上一帧权重位置以计算<br/>运动矢量；按 GPU 缓冲能力选择对齐和存储<br/>方式。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: cyl, label: "**MorphIndices**<br/>关联形变网格与当前及上一帧权重位置。" }
  class n2 node_resource
  n3@{ shape: cyl, label: "**MorphUniforms**<br/>以双缓冲保存网格前后帧形变权重。" }
  class n3 node_resource
  n4@{ shape: rounded, label: "**ViewVisibility**<br/>记录实体是否应被提取用于渲染。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**MeshMorphWeights**<br/>为单个网格提供或引用形变权重。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**MorphWeights**<br/>保存可由多个网格共享的形变权重。" }
  class n6 node_component
  n7@{ shape: cyl, label: "**RenderDevice**<br/>创建渲染和计算所需的 GPU 资源。" }
  class n7 node_resource
  n1 e0@-->|"RenderApp / ExtractSchedule"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_read
  n5 e4@--> n0
  class e4 edge_read
  n6 e5@--> n0
  class e5 edge_read
  n7 e6@--> n0
  class e6 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
