---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: ActionTime · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ActionTime**<br/>累计动作处于 Ongoing 或 Fired 状态的时<br/>间" }
  class n0 node_component
  n1@{ shape: rounded, label: "**Enhanced Input update**<br/>按上下文优先级评估输入绑定、修饰器和条<br/>件，计算动作值及触发状态；此卡片的名称由<br/>系统参数元组生成。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**Enhanced Input trigger**<br/>依据动作事件标记向对应动作实体排入带类型<br/>的触发事件，并清理失效实例；此卡片的名称<br/>由系统参数元组生成。" }
  class n2 node_system
  n1 e0@--> n0
  class e0 edge_write
  n0 e1@-->|"正文只读访问"| n2
  class e1 edge_read
