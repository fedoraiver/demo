---
flowchart LR
  accTitle: VolumetricFogUniformBuffer · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**VolumetricFogUniformBuffer**<br/>向 GPU 提供体积雾的视图参数。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**volumetric_fog**<br/>逐个处理视图中的体积雾区域，结合场景深<br/>度、光照和可选密度纹理绘制雾光照；根据相<br/>机位于雾体内外选择平面或立方体网格。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare_volumetric_fog_uniforms**<br/>把各视图和雾体积组合转换为体积雾<br/>Uniform。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**init_gpu_resource#lt;bevy_pbr::**<br/>**volumetric_fog::render::**<br/>**VolumetricFogUniformBuffer#gt;**<br/>通过 FromWorld 构建指定的 GPU 资源，并<br/>将初始化结果插入当前世界。" }
  class n3 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@-->|"正文添加"| n0
  class e2 edge_write
  e1@{ curve: basis }
  e2@{ curve: basis }
