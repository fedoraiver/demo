  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lean-r, label: "**CursorMoved**<br/>通知窗口内光标移动。" }
  class n0 node_message
  n1@{ shape: rounded, label: "**write​_​non​_​window​_​pointer​_​moved​_​**<br/>**messages​_​system**<br/>来自crate:bevy​_​egui ↗：刷新非窗口<br/>Egui 界面的指针位置。" }
