  class n0 node_component
  n1@{ shape: rounded, label: "**check_msaa**<br/>检查启用了顺序无关透明设置的相机；若同时<br/>使用多于一个 MSAA 采样则直接报错，避免<br/>执行不受支持的透明渲染组合。" }
