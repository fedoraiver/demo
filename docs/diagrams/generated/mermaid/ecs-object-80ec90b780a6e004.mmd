  n1@{ shape: fr-rect, label: "**UiRenderPlugin**<br/>提取并准备界面绘制数据。" }
  class n1 node_plugin
  n2@{ shape: cyl, label: "**UiPipeline**<br/>提供普通 UI 节点的视图与图像布局。" }
  class n2 node_resource
  n3@{ shape: cyl, label: "**AssetServer**<br/>来自crate:bevy​_​asset ↗：加载资产并追<br/>踪加载状态。" }
  class n3 node_resource
  class n3 external_node
  n1 e0@-->|"调用"| n0
  class e0 edge_registration
