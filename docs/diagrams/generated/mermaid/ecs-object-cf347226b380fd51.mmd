flowchart LR
  accTitle: Pipe(bevy_state::state::transitions::last_transition<demo::game_flow::PlayState>, bevy_state::state::transitions::run_enter<demo::game_flow::PlayState>) · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_system_group fill:#F2F5F7,stroke:#607C96,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: fr-rect, label: "**Pipe(bevy_state::state::**<br/>**transitions::last_transition#lt;demo::**<br/>**game_flow::PlayState#gt;, bevy_state::**<br/>**state::transitions::run_enter#lt;demo::**<br/>**game_flow::PlayState#gt;)**<br/>按管道顺序执行组合系统。" }
  class n0 node_system_group
  n1@{ shape: stadium, label: "**main · StateTransition**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**EnterSchedules · (PhantomData#lt;demo::**<br/>**game_flow::PlayState#gt;)**<br/>执行新状态的进入调度和进入生命周期。" }
  class n2 node_system_set
  n3@{ shape: cyl, label: "**Messages#lt;StateTransitionEvent#lt;PlaySt**<br/>**ate#gt;#gt;**<br/>来自应用流程 ↗：缓冲游戏运行与暂停转换<br/>的日志输入。" }
  class n3 node_message_buffer
  class n3 external_node
  n4@{ shape: notch-rect, label: "**World**<br/>保存实体、组件、资源及关联元数据" }
