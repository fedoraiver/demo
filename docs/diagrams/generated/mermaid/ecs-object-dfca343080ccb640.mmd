---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-dfca343080ccb640-e1{marker-start:url(#object-dfca343080ccb640_flowchart-v2-pointStart)!important}\n#object-dfca343080ccb640_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: EguiUserTextures · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: cyl, label: "**EguiUserTextures**<br/>登记由用户提供给 Egui 的 Bevy 图像纹理" }
  class n0 node_resource
  end
  style layout_card_n0 fill:none,stroke:none
  n1@{ shape: rounded, label: "**bevy​_​extract::extract​_​resource::**<br/>**extract​_​resource#lt;bevy​_​egui::**<br/>**EguiUserTextures, bevy​_​render::**<br/>**RenderApp, ()#gt;**<br/>来自crate:bevy​_​extract ↗：把存在的主<br/>世界资源转换到子世界。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**bevy​_​egui::render::systems::queue​_​**<br/>**bind​_​groups​_​system**<br/>建立 Egui 纹理与采样器绑定。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**bevy​_​egui::render::systems::queue​_​**<br/>**bind​_​groups​_​system**<br/>建立 Egui 纹理与采样器绑定。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**bevy​_​egui::free​_​egui​_​textures​_​system**<br/>回收 Egui 已释放或失效的纹理引用。" }
  class n4 node_system
  n1 e0@-->|"插入"| n0
  class e0 edge_write
  n1 e1@--- n0
  class e1 edge_read
  n0 e2@--> n2
  class e2 edge_read
  n0 e3@--> n3
  class e3 edge_read
  n4 e4@-->|"可变访问"| n0
  class e4 edge_write
  n1 e5@--->|"可变访问"| n0
  class e5 edge_write
  n1 e6@-->|"赋值"| n0
  class e6 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
