---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-60635aae29dfa138-e5{marker-start:url(#object-60635aae29dfa138_flowchart-v2-pointStart)!important}\n#object-60635aae29dfa138-e11{marker-start:url(#object-60635aae29dfa138_flowchart-v2-pointStart)!important}\n#object-60635aae29dfa138_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: begin_island · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**begin_island**<br/>请求创建已加载海岛的运行实例。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**prepare_island**<br/>从海岛模型构建静态碰撞、坡道与人物碰撞。" }
  class n1 node_system
  n2@{ shape: stadium, label: "**main · Update**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n2 node_engine_flow
  class n2 external_node
  n3@{ shape: lin-rect, label: "**AnonymousSet(1)**<br/>来自Bevy 引擎 ↗：保存本组系统共同的运<br/>行条件。" }
  class n3 node_system_set
  class n3 external_node
  n4@{ shape: rounded, label: "**IslandMap**<br/>海岛身份。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**WorldAssetRoot**<br/>来自Bevy 引擎 ↗：指定需要展开的场景资<br/>产实例。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: cyl, label: "**ArtAssets**<br/>保存运行模型资源并维持其加载寿命。" }
  class n6 node_resource
  n7@{ shape: cyl, label: "**Assets#lt;Gltf#gt;**<br/>来自Bevy 引擎 ↗：保存导入场景与命名动<br/>画的资源引用。" }
  class n7 node_resource
  class n7 external_node
  n8@{ shape: cyl, label: "**ArtLoadState**<br/>保存运行资源的加载进度与就绪结果。" }
  class n8 node_resource
  n9@{ shape: cyl, label: "**State#lt;AppState#gt; /**<br/>**NextState#lt;AppState#gt;**<br/>来自应用流程 ↗：保存主菜单、运行和暂停<br/>状态及下一次转换。" }
  class n9 node_resource
  class n9 external_node
  n10@{ shape: fr-rect, label: "**SceneAssemblyPlugin**<br/>加载运行资源并装配海岛、碰撞与业务实体。" }
  class n10 node_plugin
  n0 e0@-->|"Commands"| n1
  class e0 edge_order
  n2 e1@-->|"main / Update"| n0
  class e1 edge_registration
  n3 e2@--> n0
  class e2 edge_set_membership
  n0 e3@--> n1
  class e3 edge_order
  n4 e4@-->|"存在 / 变更过滤"| n0
  class e4 edge_reference
  n4 e5@---|"添加"| n0
  class e5 edge_write
  n0 e6@-->|"添加"| n5
  class e6 edge_write
  n6 e7@-->|"访问声明"| n0
  class e7 edge_read
  n7 e8@-->|"访问声明"| n0
  class e8 edge_read
  n8 e9@-->|"访问声明"| n0
  class e9 edge_read
  n9 e10@-->|"访问声明"| n0
  class e10 edge_read
  n8 e11@---|"访问声明"| n0
  class e11 edge_write
  n10 e12@--> n0
  class e12 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: bumpX }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: basis }
