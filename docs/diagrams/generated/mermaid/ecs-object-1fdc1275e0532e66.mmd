  class e8 edge_read
  n10 e9@-->|"正文只读访问"| n0
  class e9 edge_read
  n11 e10@-->|"正文只读访问"| n0
  class e10 edge_read
  n0 e11@-->|"正文添加"| n12
  class e11 edge_write
  n0 e12@-->|"正文移除"| n12
  class e12 edge_write
  n0 e13@-->|"正文添加"| n13
  class e13 edge_write
  n0 e14@-->|"正文可变访问"| n14
  class e14 edge_write
