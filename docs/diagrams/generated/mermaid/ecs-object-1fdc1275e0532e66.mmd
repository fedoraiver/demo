---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: camera_driver · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**camera_driver**<br/>遍历辅助根视图及已排序相机，为有效视图设<br/>置 CurrentView 并运行其专属渲染调度；<br/>跳过失效窗口目标，结束后移除<br/>CurrentView 并记录本帧相机覆盖的窗口集<br/>合。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · RenderGraph**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**RenderGraphSystems::Render**<br/>驱动各相机的实际渲染流水线。" }
  class n2 node_system_set
  n3@{ shape: notch-rect, label: "**World**<br/>保存实体、组件、资源及关联元数据" }
  class n3 node_system_param
  n4@{ shape: notch-rect, label: "**SystemState#lt;Query#lt;(MainEntity,**<br/>**ExtractedWindow)#gt;#gt;**<br/>持久保存 SystemParam 的状态及所属<br/>World 身份" }
  class n4 node_system_param
  n5@{ shape: notch-rect, label: "**MainEntity**<br/>查询渲染对象所对应的主世界实体身份。" }
  class n5 node_query_data
  n6@{ shape: rounded, label: "**ExtractedWindow**<br/>保存渲染侧窗口尺寸、呈现模式和交换链状<br/>态。" }
  class n6 node_component
  n7@{ shape: cyl, label: "**SortedCameras**<br/>按相机绘制顺序保存排序结果。" }
  class n7 node_resource
  n8@{ shape: cyl, label: "**RenderDevice**<br/>创建渲染和计算所需的 GPU 资源。" }
  class n8 node_resource
  n9@{ shape: cyl, label: "**DiagnosticsRecorder**<br/>记录渲染诊断区间与 GPU 查询索引的对应。" }
  class n9 node_resource
  n10@{ shape: rounded, label: "**ExtractedCamera**<br/>保存渲染世界相机的目标和绘制配置。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**RootNonCameraView**<br/>为非相机关联的根视图保存渲染调度入口。" }
  class n11 node_component
  n12@{ shape: cyl, label: "**CurrentView**<br/>指定当前正在渲染的视图实体。" }
  class n12 node_resource
  n13@{ shape: cyl, label: "**CameraWindows**<br/>记录相机输出所覆盖的窗口集合。" }
  class n13 node_resource
  n14@{ shape: cyl, label: "**PendingCommandBuffers**<br/>暂存等待提交到渲染队列的命令缓冲和编码<br/>器。" }
  class n14 node_resource
  n1 e0@-->|"RenderApp / RenderGraph"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_write
