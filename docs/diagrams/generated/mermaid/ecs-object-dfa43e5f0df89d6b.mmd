---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: bevy_ecs::message::Messages#lt;app::AppExit#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Messages#lt;AppExit#gt;**<br/>保存最近两次轮换期间产生的指定类型消息" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**exit​_​on​_​flag**<br/>来自crate:bevy​_​app ↗：把终端退出标志<br/>转为应用退出消息。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**despawn​_​windows**<br/>来自crate:bevy​_​winit ↗：处理原生窗口<br/>关闭并延后一轮释放包装器。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**exit​_​on​_​all​_​closed**<br/>来自crate:bevy​_​window ↗：窗口查询为空<br/>时写入 AppExit::Success，通知应用正常<br/>退出；仍有窗口时不发送退出消息。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**build::{{closure}}**<br/>来自crate:bevy​_​time ↗：判断是否进入退<br/>出队列收尾处理。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**handle​_​requests**<br/>来自ui ↗：每帧只消费一项语义请求，避免<br/>鼠标与确认键同时激活，或旧页面动作穿过页<br/>面切换。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**stop​_​on​_​exit**<br/>来自audio ↗：停止音频通道并记录退出。" }
  class n6 node_system
  class n6 external_node
  n1 e0@-->|"赋值"| n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n3 e2@-->|"赋值"| n0
  class e2 edge_write
  n1 e3@-->|"可变访问"| n0
  class e3 edge_write
  n0 e4@--> n4
  class e4 edge_read
  n5 e5@-->|"可变访问"| n0
  class e5 edge_write
  n3 e6@-->|"可变访问"| n0
  class e6 edge_write
  n0 e7@--> n6
  class e7 edge_read
  n5 e8@-->|"赋值"| n0
  class e8 edge_write
  n2 layout_output_0@~~~ n4
  n4 layout_output_1@~~~ n6
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
