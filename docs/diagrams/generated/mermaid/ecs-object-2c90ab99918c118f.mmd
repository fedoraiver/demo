---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: spawn_queued · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**spawn_queued**<br/>消费场景补丁资产加载通知，把已解析的<br/>ScenePatch 或 SceneListPatch 应用到等<br/>待中的实体，并推进排队的场景装配；错误记<br/>录到日志。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · SpawnScene**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**SceneSpawnerSystems::SceneSpawn**<br/>解析并实例化新一代场景补丁。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**resolve_scene_patches**<br/>解析已完成依赖加载的场景补丁。" }
  class n3 node_system
  n4@{ shape: notch-rect, label: "**World**<br/>保存实体、组件、资源及关联元数据" }
  class n4 node_system_param
  n5@{ shape: rounded, label: "**QueryState#lt;ScenePatchInstance#gt;**<br/>缓存查询数据、过滤条件和匹配存储的状态" }
  class n5 node_component
  n6@{ shape: notch-rect, label: "**QueuedScenes**<br/>暂存从世界队列交换出的待生成场景。" }
  class n6 node_local
  n7@{ shape: notch-rect, label: "**BundleScratch**<br/>复用场景补丁应用和实体生成的 Bundle 临<br/>时区。" }
  class n7 node_local
  n8@{ shape: notch-rect, label: "**MessageCursor#lt;AssetEvent#lt;ScenePatch#gt;**<br/>**#gt;**<br/>保留场景补丁资产消息的独立读取游标。" }
  class n8 node_local
  n9@{ shape: notch-rect, label: "**MessageCursor#lt;AssetEvent#lt;SceneListPa**<br/>**tch#gt;#gt;**<br/>保留场景列表补丁资产消息的独立读取游标。" }
  class n9 node_local
  n10@{ shape: cyl, label: "**Assets#lt;SceneListPatch#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n10 node_resource
  n11@{ shape: cyl, label: "**WaitingScenes**<br/>保存等待场景资产加载的实体与场景列表生成<br/>请求" }
  class n11 node_resource
  n12@{ shape: cyl, label: "**Messages#lt;AssetEvent#lt;ScenePatch#gt;#gt;**<br/>保存 AssetEvent#lt;ScenePatch#gt; 消息。" }
  class n12 node_message_buffer
  n13@{ shape: cyl, label: "**Messages#lt;AssetEvent#lt;SceneListPatch#gt;#gt;**<br/>保存 AssetEvent#lt;SceneListPatch#gt; 消<br/>息。" }
  class n13 node_message_buffer
  n14@{ shape: cyl, label: "**Assets#lt;ScenePatch#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n14 node_resource
  n15@{ shape: cyl, label: "**QueuedScenes**<br/>暂存等待创建的场景及关联场景列表。" }
