---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: Content · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**Content**<br/>组织界面交互、布局与堆叠更新。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**mark​_​images​_​as​_​changed​_​if​_​their​_​**<br/>**assets​_​changed**<br/>来自crate:bevy​_​ui​_​render ↗：使图像或<br/>图集资产变化触发 UI 图像更新。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**update​_​editable​_​text​_​styles**<br/>把字体和排版配置同步到可编辑文本引擎。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**measure​_​text​_​system**<br/>在文本变化后更新内容测量并安排文字重排。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**sync​_​font​_​size​_​to​_​em​_​size**<br/>把文本字号解析为节点的 EmSize。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update​_​image​_​content​_​size​_​system**<br/>按图像或图集区域更新 UI 的固有尺寸测<br/>量。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update​_​inline​_​image​_​boxes**<br/>把内联图像尺寸同步到文本排版盒。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**update​_​texture​_​atlas​_​layout​_​**<br/>**components**<br/>来自crate:bevy​_​ui​_​render ↗：同步 UI<br/>图像所引用的图集布局组件。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: lin-rect, label: "**Layout**<br/>组织界面交互、布局与堆叠更新。" }
  class n8 node_system_set
  n9@{ shape: lin-rect, label: "**Propagate**<br/>组织界面交互、布局与堆叠更新。" }
  class n9 node_system_set
  n10@{ shape: rounded, label: "**update​_​editable​_​text​_​content​_​size**<br/>按可见字符宽度和行数设置输入框固有尺寸。" }
  class n10 node_system
  n0 e0@-->|"先于"| n1
  class e0 edge_order
  n0 e1@-->|"集合成员"| n2
  class e1 edge_set_membership
  n0 e2@-->|"集合成员"| n3
  class e2 edge_set_membership
  n0 e3@-->|"集合成员"| n4
  class e3 edge_set_membership
  n0 e4@-->|"集合成员"| n5
  class e4 edge_set_membership
  n0 e5@-->|"集合成员"| n6
  class e5 edge_set_membership
  n0 e6@-->|"先于"| n7
  class e6 edge_order
  n0 e7@-->|"先于"| n8
  class e7 edge_order
  n9 e8@-->|"先于"| n0
  class e8 edge_order
  n0 e9@-->|"集合成员"| n10
  class e9 edge_set_membership
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e9@{ curve: basis }
