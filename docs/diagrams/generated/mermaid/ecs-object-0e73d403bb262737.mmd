---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Complete<MoveAction> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**Complete#lt;MoveAction#gt;**<br/>通知目标控制者的移动动作已正常结束。" }
  class n0 node_event
  n1@{ shape: hex, label: "**clear_completed_movement**<br/>清除已结束动作的角色移动方向。" }
  class n1 node_observer
  n2@{ shape: lin-rect, label: "**EnhancedInputSystems::Trigger**<br/>来自Enhanced Input ↗：按上下文顺序排<br/>入动作事件命令。" }
  class n2 node_system_set
  class n2 external_node
  n3@{ shape: hex, label: "**reset_action#lt;GameplayContext#gt;**<br/>来自Enhanced Input ↗：动作移除时清零<br/>并派发条件性的结束事件。" }
  class n3 node_observer
  class n3 external_node
  n0 e0@-->|"Complete#lt;MoveAction#gt;"| n1
  class e0 edge_observe
  n2 e1@-->|"Commands::trigger<br/>Complete#lt;MoveAction#gt;"| n0
  class e1 edge_emit
  n3 e2@-->|"Complete#lt;MoveAction#gt;（旧状态 Fired）"| n0
  class e2 edge_emit
  e1@{ curve: basis }
  e2@{ curve: basis }
