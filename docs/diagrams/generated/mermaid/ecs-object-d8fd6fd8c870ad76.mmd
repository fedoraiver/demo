---
flowchart LR
  accTitle: cluster::gpu::ViewGpuClusteringBuffers · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ViewGpuClusteringBuffers**<br/>保存单个视图的 GPU 聚簇工作缓冲。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**prepare​_​clustering​_​bind​_​groups**<br/>为视图的聚簇计算与光栅阶段绑定工作缓冲。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**upload​_​view​_​gpu​_​clustering​_​buffers**<br/>上传聚簇深度切片、元数据和计数暂存。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare​_​clusters​_​for​_​gpu​_​clustering**<br/>按视图规模和回读容量分配 GPU 聚簇缓冲。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**cluster​_​on​_​gpu**<br/>执行深度切片、计数、分配和填充的 GPU 聚<br/>簇。" }
  class n4 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"可变访问"| n0
  class e1 edge_write
  n3 e2@-->|"插入"| n0
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
