---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: 场景实例生成流程 · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**场景实例生成流程**<br/>展开场景资产层级并通知实例就绪。" }
  class n0 node_engine_flow
  n1@{ shape: stadium, label: "**WorldInstanceReady**<br/>通知对应场景资产已完成实体层级实例化。" }
  class n1 node_event
  n2@{ shape: stadium, label: "**WorldInstanceReady**<br/>通知展示快递员进入命名动画绑定准备。" }
  class n2 node_event
  n3@{ shape: rounded, label: "**WorldAssetRoot**<br/>主角和物品模板的实例化入口。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**WorldAssetRoot**<br/>指定需要展开的场景资产实例。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**Children**<br/>索引当前实体的直接子实体。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Children**<br/>索引当前实体的直接子实体。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**ChildOf**<br/>关联父实体并跟随父级生命周期。" }
  class n7 node_component
  n8@{ shape: cyl, label: "**Assets#lt;WorldAsset#gt;**<br/>保存可以展开为实体层级的场景资产。" }
  class n8 node_resource
  n0 e0@--> n1
  class e0 edge_emit
  n0 e1@-->|"Commands::trigger WorldInstanceReady"| n2
  class e1 edge_emit
  n3 e2@-->|"查询访问"| n0
  class e2 edge_read
  n4 e3@-->|"查询访问"| n0
  class e3 edge_read
  n0 e4@-->|"可变访问"| n5
  class e4 edge_write
  n0 e5@-->|"可变访问"| n6
  class e5 edge_write
  n0 e6@-->|"可变访问"| n7
  class e6 edge_write
  n8 e7@-->|"访问声明"| n0
  class e7 edge_read
  n3 layout_input_0@~~~ n4
  n4 layout_input_1@~~~ n8
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
