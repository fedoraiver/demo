---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: AnonymousSet(2) · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**AnonymousSet(2)**<br/>保存一组系统的共同配置。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**bevy​_​pbr::cluster::gpu::prepare​_​**<br/>**clusters​_​for​_​gpu​_​clustering**<br/>来自crate:bevy​_​pbr ↗：按视图规模和回<br/>读容量分配 GPU 聚簇缓冲。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**bevy​_​pbr::cluster::gpu::upload​_​view​_​**<br/>**gpu​_​clustering​_​buffers**<br/>来自crate:bevy​_​pbr ↗：上传聚簇深度切<br/>片、元数据和计数暂存。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**bevy​_​pbr::cluster::gpu​_​clustering​_​**<br/>**is​_​enabled**<br/>来自crate:bevy​_​pbr ↗：判断常规更新是<br/>否使用 GPU 聚簇。" }
  class n3 node_system
  class n3 external_node
  n0 e0@-->|"集合成员"| n1
  class e0 edge_set_membership
  n0 e1@-->|"集合成员"| n2
  class e1 edge_set_membership
  n3 e2@-->|"运行条件"| n0
  class e2 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
