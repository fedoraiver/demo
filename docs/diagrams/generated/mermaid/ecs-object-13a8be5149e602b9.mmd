  n14@{ shape: rounded, label: "**bevy​_​pbr::decal::clustered::prepare​_​**<br/>**decals**<br/>来自crate:bevy​_​pbr ↗：将已提取贴花的<br/>索引登记到全局聚簇元数据。" }
  class n14 node_system
  class n14 external_node
  n15@{ shape: rounded, label: "**bevy​_​render::view::window::**<br/>**screenshot::prepare​_​screenshots**<br/>为有效截图目标准备捕获资源和输出附件。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**bevy​_​render::view::window::prepare​_​**<br/>**windows**<br/>为有相机输出或需要首次呈现的窗口取得交换<br/>链纹理，保留可复用的未呈现帧，并处理尺<br/>寸、模式变化及表面获取错误。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**bevy​_​post​_​process::dof::configure​_​**<br/>**depth​_​of​_​field​_​view​_​targets**<br/>来自crate:bevy​_​post​_​process ↗：允许<br/>景深相机采样自己的深度纹理。" }
