---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: PrepareNextFrameAssets<RenderMesh> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**PrepareNextFrameAssets#lt;RenderMesh#gt;**<br/>保留下一帧待准备的渲染源资产。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**prepare_assets#lt;bevy_render::mesh::**<br/>**RenderMesh#gt;**<br/>消费新提取和上帧待重试的渲染资产，按每帧<br/>字节预算调用 RenderAsset::prepare_<br/>asset，写入成功结果、保留待重试项，并卸<br/>载已移除资产的 GPU 状态。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**collect_render_assets_to_**<br/>**reextract#lt;bevy_render::mesh::**<br/>**RenderMesh#gt;**<br/>排空渲染资产并登记设备恢复后的重新提取。" }
  class n2 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
