---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: MainWorld · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**MainWorld**<br/>在提取阶段临时提供主模拟世界。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**extract_render_asset#lt;bevy_render::**<br/>**mesh::RenderMesh#gt;**<br/>每轮先清空旧提取队列，再根据源资产新增、<br/>修改及设备恢复请求提取 GPU 数据，按<br/>RenderAssetUsages 选择克隆或移出资产数<br/>据；最后一个句柄释放时记录渲染侧移除。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**extract_render_asset#lt;bevy_render::**<br/>**texture::gpu_image::GpuImage#gt;**<br/>每轮先清空旧提取队列，再根据源资产新增、<br/>修改及设备恢复请求提取 GPU 数据，按<br/>RenderAssetUsages 选择克隆或移出资产数<br/>据；最后一个句柄释放时记录渲染侧移除。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**extract_render_asset#lt;bevy_render::**<br/>**storage::GpuShaderBuffer#gt;**<br/>每轮先清空旧提取队列，再根据源资产新增、<br/>修改及设备恢复请求提取 GPU 数据，按<br/>RenderAssetUsages 选择克隆或移出资产数<br/>据；最后一个句柄释放时记录渲染侧移除。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**extract_render_asset#lt;bevy_pbr::**<br/>**medium::GpuScatteringMedium#gt;**<br/>每轮先清空旧提取队列，再根据源资产新增、<br/>修改及设备恢复请求提取 GPU 数据，按<br/>RenderAssetUsages 选择克隆或移出资产数<br/>据；最后一个句柄释放时记录渲染侧移除。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**extract_render_asset#lt;bevy_gizmos_**<br/>**render::GpuLineGizmo#gt;**<br/>每轮先清空旧提取队列，再根据源资产新增、<br/>修改及设备恢复请求提取 GPU 数据，按<br/>RenderAssetUsages 选择克隆或移出资产数<br/>据；最后一个句柄释放时记录渲染侧移除。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**extract_erased_render_asset#lt;bevy_**<br/>**sprite_render::mesh2d::material::**<br/>**MeshMaterial2d#lt;bevy_sprite_render::**<br/>**mesh2d::color_material::**<br/>**ColorMaterial#gt;#gt;**<br/>提取变化及设备恢复后失效的擦除渲染资产。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**extract_erased_render_asset#lt;bevy_**<br/>**sprite_render::mesh2d::material::**<br/>**MeshMaterial2d#lt;bevy_sprite_render::**<br/>**sprite_mesh::sprite_mesh_material::**<br/>**SpriteMeshMaterial#gt;#gt;**<br/>提取变化及设备恢复后失效的擦除渲染资产。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**extract_erased_render_asset#lt;bevy_**<br/>**sprite_render::mesh2d::material::**<br/>**MeshMaterial2d#lt;bevy_sprite_render::**<br/>**tilemap_chunk::tilemap_chunk_**<br/>**material::TilemapChunkMaterial#gt;#gt;**<br/>提取变化及设备恢复后失效的擦除渲染资产。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**extract_erased_render_asset#lt;bevy_**<br/>**pbr::mesh_material::**<br/>**MeshMaterial3d#lt;bevy_pbr::pbr_**<br/>**material::StandardMaterial#gt;#gt;**<br/>提取变化及设备恢复后失效的擦除渲染资产。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**extract_erased_render_asset#lt;bevy_**<br/>**pbr::mesh_material::**<br/>**MeshMaterial3d#lt;bevy_pbr::extended_**<br/>**material::ExtendedMaterial#lt;bevy_**<br/>**pbr::pbr_material::**<br/>**StandardMaterial, bevy_pbr::decal::**<br/>**forward::ForwardDecalMaterialExt#gt;#gt;#gt;**<br/>提取变化及设备恢复后失效的擦除渲染资产。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**extract_screenshots**<br/>在主世界收集尚未捕获的截图请求，规范化窗<br/>口或纹理目标并为本帧去重；记录渲染截图目<br/>标、标记 Capturing，并销毁同一目标的重<br/>复请求实体。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**sync_readbacks**<br/>接收已映射 GPU 回读任务的完成数据，在主<br/>世界触发 ReadbackComplete，再归还暂存<br/>缓冲并清理超过保留帧数的缓冲池条目。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**extract_taa_settings**<br/>提取有效相机的 TAA 设置并消费历史重置信<br/>号。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**extract_clusters_for_gpu_clustering**<br/>提取视图聚簇配置并回传上帧 GPU 统计。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**extract_egui_camera_view_system**<br/>来自Egui / Inspector ↗：为活动相机提<br/>取独立 Egui 渲染视图。" }
  class n15 node_system
  class n15 external_node
