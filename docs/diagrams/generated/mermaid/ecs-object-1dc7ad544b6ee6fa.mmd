---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Disabled · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Disabled**<br/>标记被禁用的实体" }
  class n0 node_component
  n1@{ shape: rounded, label: "**apply_contact_status_changes**<br/>来自Avian ↗：把接触增删同步到约束图和<br/>物理岛。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**split_island**<br/>来自Avian ↗：物理岛存在待拆分候选时，<br/>根据刚体碰撞体、接触图和关节图重新划分该<br/>岛，并更新刚体所属岛；拆分用于随后正确决<br/>定休眠。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**apply_contact_status_changes**<br/>来自Avian ↗：把接触增删同步到约束图和<br/>物理岛。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**apply_joint_graph_changes**<br/>来自Avian ↗：把关节连接变化同步到模拟<br/>岛。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**wake_islands_with_sleeping_disabled**<br/>来自Avian ↗：让禁止休眠或已禁用的刚体<br/>所属岛保持清醒。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**enable_entities_on_exit_state#lt;demo::**<br/>**game_flow::AppState#gt;**<br/>有效状态转换退出指定值时，对匹配<br/>EnableOnExit 且已禁用的实体及<br/>Children 后代递归移除 Disabled，重新启<br/>用该子树。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**enable_entities_on_exit_state#lt;demo::**<br/>**game_flow::PlayState#gt;**<br/>有效状态转换退出指定值时，对匹配<br/>EnableOnExit 且已禁用的实体及<br/>Children 后代递归移除 Disabled，重新启<br/>用该子树。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**enable_entities_when_state#lt;demo::**<br/>**game_flow::AppState#gt;**<br/>读取最新有效状态转换，调用 EnableWhen<br/>的转换判定函数；命中时从当前禁用实体及<br/>Children 后代递归移除 Disabled。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**enable_entities_when_state#lt;demo::**<br/>**game_flow::PlayState#gt;**<br/>读取最新有效状态转换，调用 EnableWhen<br/>的转换判定函数；命中时从当前禁用实体及<br/>Children 后代递归移除 Disabled。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**enable_entities_on_enter_**<br/>**state#lt;demo::game_flow::AppState#gt;**<br/>有效状态转换进入指定值时，对匹配<br/>EnableOnEnter 且已禁用的实体及<br/>Children 后代递归移除 Disabled。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**enable_entities_on_enter_**<br/>**state#lt;demo::game_flow::PlayState#gt;**<br/>有效状态转换进入指定值时，对匹配<br/>EnableOnEnter 且已禁用的实体及<br/>Children 后代递归移除 Disabled。" }
  class n11 node_system
  n0 e0@-->|"存在 / 变更过滤"| n1
  class e0 edge_reference
  n0 e1@-->|"存在 / 变更过滤"| n2
  class e1 edge_reference
  n0 e2@-->|"存在 / 变更过滤"| n3
  class e2 edge_reference
  n0 e3@-->|"存在 / 变更过滤"| n4
  class e3 edge_reference
  n0 e4@-->|"存在 / 变更过滤"| n5
  class e4 edge_reference
  n0 e5@-->|"存在 / 变更过滤"| n6
  class e5 edge_reference
  n0 e6@-->|"存在 / 变更过滤"| n7
  class e6 edge_reference
  n0 e7@-->|"存在 / 变更过滤"| n8
  class e7 edge_reference
  n0 e8@-->|"存在 / 变更过滤"| n9
  class e8 edge_reference
  n0 e9@-->|"存在 / 变更过滤"| n10
  class e9 edge_reference
  n0 e10@-->|"存在 / 变更过滤"| n11
  class e10 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
