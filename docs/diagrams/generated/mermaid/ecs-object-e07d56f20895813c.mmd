---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: RenderSystems::QueueMeshes · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**RenderSystems::QueueMeshes**<br/>在网格资产准备后排入网格绘制项。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**RenderApp · Render**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**RenderSystems::Queue**<br/>把可绘制实体排入对应渲染阶段。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**queue_material2d_meshes**<br/>按透明模式更新二维网格渲染批次。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**queue_prepass_material_meshes**<br/>把有效材质网格分入预通道或延迟几何阶段。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**queue_material_meshes**<br/>按材质模式把可见网格加入相应绘制阶段。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**queue_shadows**<br/>遍历各阴影视图中可见的网格，按专用材质管<br/>线、渲染层及投影资格更新阴影分桶；移除失<br/>效项，将资产或管线尚未就绪的网格留到后续<br/>重试。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**prepare_assets#lt;bevy_render::mesh::**<br/>**RenderMesh#gt;**<br/>消费新提取和上帧待重试的渲染资产，按每帧<br/>字节预算调用 RenderAsset::prepare_<br/>asset，写入成功结果、保留待重试项，并卸<br/>载已移除资产的 GPU 状态。" }
  class n7 node_system
  n8@{ shape: lin-rect, label: "**RenderSystems::QueueSweep**<br/>从绘制分箱移除不可见或已切换阶段的网格。" }
  class n8 node_system_set
  n1 e0@-->|"RenderApp / Render"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_set_membership
  n0 e4@--> n5
  class e4 edge_set_membership
  n0 e5@--> n6
  class e5 edge_set_membership
  n7 e6@--> n0
  class e6 edge_order
  n0 e7@--> n8
  class e7 edge_order
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
