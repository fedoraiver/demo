  n0@{ shape: cyl, label: "**settings::config::SettingsFile**<br/>设置文件的保存位置；测试可覆盖该资源而不<br/>触及玩家的真实配置。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**demo::ui::requests::handle​_​requests**<br/>来自ui ↗：每帧只消费一项语义请求，避免<br/>鼠标与确认键同时激活，或旧页面动作穿过页<br/>面切换。" }
