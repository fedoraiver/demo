---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: SystemChangeTick · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: notch-rect, label: "**SystemChangeTick**<br/>提供系统上次与本次运行的变化刻度" }
  class n0 node_system_param
  n1@{ shape: rounded, label: "**transform_to_position**<br/>来自Avian ↗：把用户改变的世界变换同步<br/>到物理位姿。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**update_moved_collider_**<br/>**aabbs#lt;avian3d::collision::collider::**<br/>**parry::Collider#gt;**<br/>来自Avian ↗：重算物理步后被手动改变的<br/>碰撞边界。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**update_last_physics_tick**<br/>来自Avian ↗：记录本次物理阶段结束的<br/>ECS 变化刻度。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**update_solver_body_aabbs#lt;avian3d::**<br/>**collision::collider::parry::**<br/>**Collider#gt;**<br/>来自Avian ↗：按物理结果更新活跃刚体的<br/>碰撞边界。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**wake_on_changed**<br/>来自Avian ↗：因外部位姿、速度或受力变<br/>化标记物理岛唤醒。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**update_last_easing_tick**<br/>来自Avian ↗：记录平滑系统完成后的变化<br/>检测边界。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**reset_easing_states_on_transform_**<br/>**change**<br/>来自Avian ↗：在外部直接改变变换时取消<br/>失效的平滑区间。" }
  class n7 node_system
  class n7 external_node
  n0 e0@-->|"参数 / 查询数据"| n1
  class e0 edge_reference
  n0 e1@-->|"参数 / 查询数据"| n2
  class e1 edge_reference
  n0 e2@-->|"参数 / 查询数据"| n3
  class e2 edge_reference
  n0 e3@-->|"参数 / 查询数据"| n4
  class e3 edge_reference
  n0 e4@-->|"参数 / 查询数据"| n5
  class e4 edge_reference
  n0 e5@-->|"参数 / 查询数据"| n6
  class e5 edge_reference
  n0 e6@-->|"参数 / 查询数据"| n7
  class e6 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
