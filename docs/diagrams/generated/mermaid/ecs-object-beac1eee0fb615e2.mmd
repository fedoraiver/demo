---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: reset_action<GameplayContext> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: hex, label: "**reset_action#lt;GameplayContext#gt;**<br/>动作移除时清零并派发条件性的结束事件。" }
  class n0 node_observer
  n1@{ shape: stadium, label: "**RemoveEvent**<br/>来自Bevy 引擎 ↗：通知<br/>GameplayContext 的动作关系正在移除。" }
  class n1 node_event
  class n1 external_node
  n2@{ shape: stadium, label: "**Complete#lt;MoveAction#gt;**<br/>来自第一人称控制 ↗：通知目标控制者的移<br/>动动作已正常结束。" }
  class n2 node_event
  class n2 external_node
  n3@{ shape: stadium, label: "**Cancel#lt;MoveAction#gt;**<br/>来自第一人称控制 ↗：通知目标控制者的移<br/>动动作已取消。" }
  class n3 node_event
  class n3 external_node
  n4@{ shape: rounded, label: "**ActionOf#lt;GameplayContext#gt;**<br/>将动作关联到所属控制上下文。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**ActionFns**<br/>将通用动作值适配为具体动作组件。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**ActionSettings**<br/>保存动作的输入消费与重新激活策略。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**Bindings**<br/>索引动作拥有的输入绑定。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**Binding**<br/>保存设备输入到动作的映射。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**ActionValue**<br/>保存动作评估产生的通用输入值。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**TriggerState**<br/>保存本次动作评估的触发状态。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**ActionEvents**<br/>保存本次待派发的动作事件。" }
  class n11 node_component
  n12@{ shape: rounded, label: "**ActionTime**<br/>动作持续与触发计时，由插件评估更新。" }
  class n12 node_component
  n13@{ shape: cyl, label: "**PendingBindings**<br/>保存上下文停用后仍需重置的输入绑定。" }
  class n13 node_resource
  n1 e0@-->|"Remove#lt;ActionOf#lt;GameplayContext#gt;#gt;"| n0
  class e0 edge_observe
  n0 e1@-->|"Complete#lt;MoveAction#gt;（旧状态 Fired）"| n2
  class e1 edge_emit
  n0 e2@-->|"Cancel#lt;MoveAction#gt;（旧状态 Ongoing）"| n3
  class e2 edge_emit
  n4 e3@-->|"查询访问"| n0
  class e3 edge_read
  n5 e4@-->|"查询访问"| n0
  class e4 edge_read
  n6 e5@-->|"查询访问"| n0
  class e5 edge_read
  n7 e6@-->|"查询访问"| n0
  class e6 edge_read
  n8 e7@-->|"查询访问"| n0
  class e7 edge_read
  n0 e8@-->|"可变访问"| n9
  class e8 edge_write
  n0 e9@-->|"可变访问"| n10
  class e9 edge_write
  n0 e10@-->|"可变访问"| n11
  class e10 edge_write
  n0 e11@-->|"可变访问"| n12
  class e11 edge_write
  n0 e12@-->|"访问声明"| n13
  class e12 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: basis }
