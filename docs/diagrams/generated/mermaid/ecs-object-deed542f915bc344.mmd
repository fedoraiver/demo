---
flowchart LR
  accTitle: avian3d::ancestor_marker::{impl#35;1}::build::{closure#35;1} · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: hex, label: "**build::{closure#35;1}**<br/>清理不再需要的祖先标记。" }
  class n0 node_observer
  n1@{ shape: rounded, label: "**ChildOf**<br/>来自crate:bevy​_​ecs ↗：保存当前实体的<br/>父实体身份" }
  class n1 node_component
  class n1 external_node
  n2@{ shape: rounded, label: "**Children**<br/>来自crate:bevy​_​ecs ↗：保存以<br/>ChildOf 指向当前父实体的子实体集合" }
  class n2 node_component
  class n2 external_node
  n3@{ shape: stadium, label: "**DiscardEvent**<br/>来自crate:bevy​_​ecs ↗：在组件旧值丢弃<br/>前发出通知。" }
  class n3 node_event
  class n3 external_node
  n1 e0@--> n0
  class e0 edge_read
  n2 e1@--> n0
  class e1 edge_read
  n3 e2@-->|"接收事件"| n0
  class e2 edge_observe
  e0@{ curve: basis }
  e2@{ curve: basis }
