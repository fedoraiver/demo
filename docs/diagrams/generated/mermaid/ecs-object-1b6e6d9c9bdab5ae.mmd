  n11@{ shape: cyl, label: "**AssetServer**<br/>加载资产并追踪加载状态。" }
  class n11 node_resource
  n12@{ shape: notch-rect, label: "**EntityHashMap#lt;(OitResolvePipelineKey**<br/>**, CachedRenderPipelineId)#gt;**<br/>按视图和配置键缓存 OIT 解析管线标识。" }
  class n12 node_local
  n13@{ shape: rounded, label: "**OitResolvePipelineId**<br/>记录视图的透明解析管线标识。" }
