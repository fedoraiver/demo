---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: HeldPresentation · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**HeldPresentation**<br/>固定循环后的呈现阶段，零固定步的帧也执行<br/>同一顺序。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**UpdateEasingTick**<br/>来自crate:bevy​_​transform​_​<br/>interpolation ↗：组织变换缓动端点与帧<br/>间应用。" }
  class n1 node_system_set
  class n1 external_node
  n2@{ shape: lin-rect, label: "**HeldPhysics**<br/>固定循环后的呈现阶段，零固定步的帧也执行<br/>同一顺序。" }
  class n2 node_system_set
  n3@{ shape: lin-rect, label: "**Ease**<br/>来自crate:bevy​_​transform​_​<br/>interpolation ↗：组织变换缓动端点与帧<br/>间应用。" }
  class n3 node_system_set
  class n3 external_node
  n4@{ shape: lin-rect, label: "**Camera**<br/>固定循环后的呈现阶段，零固定步的帧也执行<br/>同一顺序。" }
  class n4 node_system_set
  n5@{ shape: lin-rect, label: "**AfterFixedMainLoop**<br/>来自crate:bevy​_​app ↗：划分固定更新循<br/>环的前后边界。" }
  class n5 node_system_set
  class n5 external_node
  n6@{ shape: rounded, label: "**sync​_​held​_​presentation**<br/>来自item​_​interaction ↗：帧末跟随同一<br/>份已呈现人物姿态，零固定步时也不在箱体上<br/>叠加第二份插值。" }
  class n6 node_system
  class n6 external_node
  n0 e0@-->|"先于"| n1
  class e0 edge_order
  n2 e1@-->|"先于"| n0
  class e1 edge_order
  n3 e2@-->|"先于"| n0
  class e2 edge_order
  n0 e3@-->|"先于"| n4
  class e3 edge_order
  n5 e4@-->|"集合成员"| n0
  class e4 edge_set_membership
  n0 e5@-->|"集合成员"| n6
  class e5 edge_set_membership
  e0@{ curve: basis }
  e1@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
