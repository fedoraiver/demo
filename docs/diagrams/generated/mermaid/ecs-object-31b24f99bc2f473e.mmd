---
flowchart LR
  accTitle: avian3d::prelude::BodySizeMetrics · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**BodySizeMetrics**<br/>缓存刚体及碰撞体的尺寸指标。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update​_​body​_​size​_​metrics**<br/>重算刚体的 CCD 厚度和最大扫掠半径。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update​_​narrow​_​phase**<br/>更新窄相接触并输出碰撞变化消息。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**spawn​_​session · 创建模板**<br/>来自scene​_​assembly ↗：承载灰盒地面的<br/>显示与静态碰撞。" }
  class n3 node_entity
  class n3 external_node
  n4@{ shape: rounded, label: "**solve​_​continuous**<br/>通过连续扫掠限制快速刚体穿透。" }
  class n4 node_system
  n1 e0@-->|"赋值"| n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n1 e2@-->|"可变访问"| n0
  class e2 edge_write
  n3 e3@-->|"可能包含"| n0
  class e3 edge_reference
  n0 e4@--> n4
  class e4 edge_read
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
