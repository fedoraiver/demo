---
flowchart LR
  accTitle: bevy::bevy_ecs::message::Messages#lt;collision::collision_events::CollisionStart#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Messages#lt;CollisionStart#gt;**<br/>保存最近两次轮换期间产生的指定类型消息" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**update​_​narrow​_​phase**<br/>来自crate:avian3d ↗：更新窄相接触并输<br/>出碰撞变化消息。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**trigger​_​collision​_​events**<br/>来自crate:avian3d ↗：把碰撞开始和结束<br/>消息触发为实体事件。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**log​_​collisions**<br/>来自physics ↗：接触开始和结束属于离散<br/>变化，通过现有文件日志设施记录碰撞双方。" }
  class n3 node_system
  class n3 external_node
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n1 e2@-->|"赋值"| n0
  class e2 edge_write
  n0 e3@--> n3
  class e3 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
