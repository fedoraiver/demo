  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: add_material · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**add_material**<br/>精灵、锚点或网格材料计数改变时，清理失效<br/>缓存并按 Sprite 与 Anchor 复用或创建<br/>SpriteMeshMaterial，再插入<br/>MeshMaterial2d；已有材料计数非零的实体<br/>跳过。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PostUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**check_entities_needing_**<br/>**specialization#lt;bevy_sprite_render::**<br/>**sprite_mesh::sprite_mesh_material::**<br/>**SpriteMeshMaterial#gt;**<br/>收集二维网格材质需重建或移除专用化的实<br/>体。" }
  class n2 node_system
  n3@{ shape: lin-rect, label: "**AssetEventSystems**<br/>发布资产容器积累的变更消息。" }
  class n3 node_system_set
  n4@{ shape: rounded, label: "**mark_2d_meshes_as_changed_if_their_**<br/>**assets_changed**<br/>资产内容变化时标记对应二维网格已变更。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**add_mesh**<br/>首次需要时创建并缓存单位矩形网格，为新加<br/>入 Sprite 的实体插入共享的 Mesh2d，使<br/>精灵进入网格渲染路径。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**mark_2d_meshes_as_changed_if_their_**<br/>**materials_changed#lt;bevy_sprite_**<br/>**render::sprite_mesh::sprite_mesh_**<br/>**material::SpriteMeshMaterial#gt;**<br/>让材质变化触发二维网格重新提取。" }
  class n6 node_system
  n7@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n7 node_system_param
  n8@{ shape: rounded, label: "**Sprite**<br/>描述二维精灵的图像、图集、颜色、翻转、尺<br/>寸和裁剪区域" }
  class n8 node_component
  n9@{ shape: rounded, label: "**Anchor**<br/>保存二维可渲染实体相对自身尺寸的归一化锚<br/>点偏移" }
  class n9 node_component
  n10@{ shape: rounded, label: "**SpriteMaterialCount**<br/>记录精灵实体上自定义材质的数量。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**Mesh2d**<br/>为二维可绘制实体指定网格资产。" }
  class n11 node_component
  n12@{ shape: cyl, label: "**Assets#lt;TextureAtlasLayout#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n12 node_resource
  n13@{ shape: notch-rect, label: "**SpriteMaterialCache**<br/>按精灵与锚点配置复用默认网格材质。" }
  class n13 node_local
  n14@{ shape: cyl, label: "**Assets#lt;SpriteMeshMaterial#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n14 node_resource
  n15@{ shape: rounded, label: "**MeshMaterial2d#lt;SpriteMeshMaterial#gt;**<br/>为二维网格指定材质资产。" }
