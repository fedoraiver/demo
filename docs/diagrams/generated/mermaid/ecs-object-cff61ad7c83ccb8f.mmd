flowchart LR
  accTitle: bevy_kira_audio::AudioChannel#lt;audio::UiTrack#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**AudioChannel#lt;UiTrack#gt;**<br/>保存特定通道类型的音频命令队列及实例播放<br/>状态" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**play​_​requests**<br/>来自audio ↗：按有效音量与播放策略处理<br/>短音请求。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**play​_​audio​_​channel**<br/>执行指定类型音频通道的命令队列。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update​_​instance​_​states**<br/>把实际播放状态回写到类型通道。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**stop​_​on​_​exit**<br/>来自audio ↗：停止音频通道并记录退出。" }
  class n4 node_system
  class n4 external_node
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_read
  n3 e2@-->|"可变访问"| n0
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_read
  e0@{ curve: basis }
  e3@{ curve: basis }
