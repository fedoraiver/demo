---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: time::Time#lt;virt::Virtual#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Time#lt;Virtual#gt;**<br/>保存时钟上下文、帧间隔及累计时间" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**time​_​system**<br/>按时间更新策略推进真实与虚拟时钟。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**pause​_​simulation**<br/>来自game​_​flow ↗：冻结游戏与物理时钟并<br/>清零当前增量。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**run​_​fixed​_​main​_​schedule**<br/>按累计时间推进固定主调度。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**resume​_​simulation**<br/>来自game​_​flow ↗：恢复游戏与物理时钟。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**enter​_​main​_​menu**<br/>来自game​_​flow ↗：保留主菜单展示时间并<br/>冻结物理模拟。" }
  class n5 node_system
  class n5 external_node
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n2 e1@-->|"可变访问"| n0
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_read
  n4 e3@-->|"可变访问"| n0
  class e3 edge_write
  n2 e4@-->|"赋值"| n0
  class e4 edge_write
  n5 e5@-->|"可变访问"| n0
  class e5 edge_write
  n1 e6@-->|"赋值"| n0
  class e6 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
