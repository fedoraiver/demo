  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**bevy​_​ui::widget::text::measure​_​text​_​**<br/>**system**<br/>来自crate:bevy​_​ui ↗：在文本变化后更新<br/>内容测量并安排文字重排。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**bevy​_​ui::widget::text​_​input​_​layout::**<br/>**update​_​editable​_​text​_​styles**<br/>来自crate:bevy​_​ui ↗：把字体和排版配置<br/>同步到可编辑文本引擎。" }
