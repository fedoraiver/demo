---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-fe302847a361142d-e2{marker-start:url(#object-fe302847a361142d_flowchart-v2-pointStart)!important}\n#object-fe302847a361142d-e6{marker-start:url(#object-fe302847a361142d_flowchart-v2-pointStart)!important}\n#object-fe302847a361142d-e13{marker-start:url(#object-fe302847a361142d_flowchart-v2-pointStart)!important}\n#object-fe302847a361142d_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Aabb · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Aabb**<br/>以局部轴对齐包围盒支持可见性裁剪。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**check_visibility_cpu_culling**<br/>按层、距离和视锥收集各相机可见实体。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**check_visibility_ranges**<br/>按视图距离计算实体可见范围位掩码。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**calculate_bounds**<br/>为允许自动包围盒计算的 Mesh3d 实体补充<br/>Aabb，并在网格句柄或资产变化时重新计算<br/>已有包围盒；NoFrustumCulling 和<br/>NoAutoAabb 排除自动处理。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**update_skinned_mesh_bounds**<br/>依据当前关节姿态更新动态蒙皮包围盒。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**calculate_bounds_2d**<br/>为二维网格和精灵计算局部包围盒。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**calculate_bounds_text2d**<br/>按文字布局与锚点更新二维文字包围盒。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**check_dir_light_mesh_visibility**<br/>计算方向光各相机级联可见的投影网格。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**check_point_light_mesh_visibility**<br/>计算点光与聚光灯阴影可见的网格。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**add_light_probe_and_decal_aabbs**<br/>为尚无 Aabb 的光照探针及聚簇贴花补入以<br/>原点为中心的单位立方体包围盒，使它们参与<br/>后续可见性判定；实际尺寸由全局变换缩放表<br/>达。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**draw_aabbs**<br/>为带 ShowAabbGizmo 且可见的实体，使用<br/>Aabb 和 GlobalTransform 绘制三维包围<br/>盒；颜色来自组件、配置默认值或实体派生<br/>色。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**draw_all_aabbs**<br/>绘制未单独标记实体的可见 AABB 调试线<br/>框。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**extract_meshes_for_gpu_building**<br/>增量提取变化或需重试网格到线程队列。" }
  class n12 node_system
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_read
  n3 e2@---|"存在 / 变更过滤"| n0
  class e2 edge_reference
  n3 e3@--> n0
  class e3 edge_write
  n3 e4@-->|"延迟添加"| n0
  class e4 edge_write
  n4 e5@--> n0
  class e5 edge_write
  n5 e6@---|"存在 / 变更过滤"| n0
  class e6 edge_reference
  n5 e7@--> n0
  class e7 edge_write
  n5 e8@-->|"延迟添加"| n0
  class e8 edge_write
  n6 e9@--> n0
  class e9 edge_write
  n6 e10@-->|"延迟添加"| n0
  class e10 edge_write
  n0 e11@--> n7
  class e11 edge_read
  n0 e12@--> n8
  class e12 edge_read
  n9 e13@---|"存在 / 变更过滤"| n0
  class e13 edge_reference
  n9 e14@-->|"延迟添加"| n0
  class e14 edge_write
  n0 e15@--> n10
  class e15 edge_read
  n0 e16@--> n11
  class e16 edge_read
  n0 e17@-->|"存在 / 变更过滤"| n12
  class e17 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e13@{ curve: basis }
  e14@{ curve: basis }
  e15@{ curve: basis }
  e16@{ curve: basis }
  e17@{ curve: basis }
