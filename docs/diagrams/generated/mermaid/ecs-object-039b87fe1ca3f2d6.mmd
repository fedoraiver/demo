---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: extract_generated_environment_map_entities · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef node_scheduling_constraint fill:#F5F3F8,stroke:#7C6AA6,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**extract_generated_environment_map_**<br/>**entities**<br/>提取环境图生成所需的三张 GPU 图像。" }
  class n0 node_system
  end
  style layout_card_n0 fill:none,stroke:none
  subgraph layout_card_n1[" "]
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: lin-rect, label: "**#lt;missing#gt; generate_environment_map_**<br/>**light**<br/>保留本调度中未注册目标系统的顺序约束。" }
  class n2 node_scheduling_constraint
  end
  style layout_card_n2 fill:none,stroke:none
  subgraph layout_card_n3[" "]
  n3@{ shape: notch-rect, label: "**RenderEntity**<br/>记录主实体对应的渲染世界实体。" }
  class n3 node_query_data
  end
  style layout_card_n3 fill:none,stroke:none
  subgraph layout_card_n4[" "]
  n4@{ shape: rounded, label: "**GeneratedEnvironmentMapLight**<br/>在运行时过滤源立方体贴图生成环境光。" }
  class n4 node_component
  end
  style layout_card_n4 fill:none,stroke:none
  subgraph layout_card_n5[" "]
  n5@{ shape: rounded, label: "**EnvironmentMapLight**<br/>用漫反射与镜面反射立方体贴图提供环境光。" }
  class n5 node_component
  end
  style layout_card_n5 fill:none,stroke:none
  subgraph layout_card_n6[" "]
  n6@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n6 node_system_param
  end
  style layout_card_n6 fill:none,stroke:none
  subgraph layout_card_n7[" "]
  n7@{ shape: cyl, label: "**RenderAssets#lt;GpuImage#gt;**<br/>按源资产身份保存 GPU 渲染表示。" }
  class n7 node_resource
  end
  style layout_card_n7 fill:none,stroke:none
  subgraph layout_card_n8[" "]
  n8@{ shape: rounded, label: "**RenderEnvironmentMap**<br/>保存渲染侧环境光纹理及方向设置。" }
  class n8 node_component
  end
  style layout_card_n8 fill:none,stroke:none
  n1 e0@-->|"RenderApp / ExtractSchedule"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_order
  n3 e2@-->|"参数 / 查询数据"| n0
  class e2 edge_reference
  n4 e3@--> n0
  class e3 edge_read
  n5 e4@--> n0
  class e4 edge_read
  n6 e5@-->|"参数 / 查询数据"| n0
  class e5 edge_reference
  n7 e6@--> n0
  class e6 edge_read
  n0 e7@-->|"延迟添加"| n8
  class e7 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
