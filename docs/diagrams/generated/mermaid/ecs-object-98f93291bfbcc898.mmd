---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-98f93291bfbcc898-e0{marker-start:url(#object-98f93291bfbcc898_flowchart-v2-pointStart)!important}\n#object-98f93291bfbcc898-e5{marker-start:url(#object-98f93291bfbcc898_flowchart-v2-pointStart)!important}\n#object-98f93291bfbcc898_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: upscaling::ViewUpscalingPipeline · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ViewUpscalingPipeline**<br/>记录视图颜色输出所用的缩放管线。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**clear​_​view​_​upscaling​_​pipelines**<br/>清除视图缩放管线以便设备恢复后重建。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare​_​view​_​upscaling​_​pipelines**<br/>按相机合成方式准备输出缩放管线。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**upscaling**<br/>将主颜色纹理缩放写入最终输出附件。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**upscaling**<br/>将主颜色纹理缩放写入最终输出附件。" }
  class n4 node_system
  n1 e0@---|"存在性约束"| n0
  class e0 edge_reference
  n2 e1@-->|"插入"| n0
  class e1 edge_write
  n1 e2@-->|"移除"| n0
  class e2 edge_write
  n0 e3@--> n3
  class e3 edge_read
  n0 e4@--> n4
  class e4 edge_read
  n2 e5@--- n0
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: bumpX }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
