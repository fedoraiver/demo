  class n3 node_system
  n4@{ shape: rounded, label: "**late_prepass_build_indirect_**<br/>**parameters**<br/>为本帧新显露对象构建后期预通道间接参数。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**main_build_indirect_parameters**<br/>为主不透明及透明通道构建间接绘制参数。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**prepare_indirect_parameters_build_**<br/>**jobs**<br/>按视图阶段的批范围登记间接参数构建任务。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**init_gpu_resource#lt;bevy_render::**<br/>**batching::gpu_preprocessing::**<br/>**BuildIndirectParametersMetadata#gt;**<br/>通过 FromWorld 构建指定的 GPU 资源，并<br/>将初始化结果插入当前世界。" }
