---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: MeshPipelineSystems · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**MeshPipelineSystems**<br/>先初始化网格视图布局，再初始化三维网格管<br/>线。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**bevy​_​pbr::render::mesh::init​_​mesh​_​**<br/>**pipeline**<br/>初始化三维网格着色器及设备缓冲策略。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**bevy​_​pbr::render::mesh​_​view​_​**<br/>**bindings::init​_​mesh​_​pipeline​_​view​_​**<br/>**layouts**<br/>按设备能力汇集网格视图资源布局参数。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**bevy​_​pbr::volumetric​_​fog::render::**<br/>**init​_​volumetric​_​fog​_​pipeline**<br/>初始化体积雾管线的视图布局与着色器。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**bevy​_​pbr::ssr::init​_​screen​_​space​_​**<br/>**reflections​_​pipeline**<br/>初始化屏幕空间反射的全屏渲染管线资源。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**bevy​_​pbr::material::init​_​material​_​**<br/>**pipeline**<br/>初始化与网格管线共享接口的材质管线资源。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**bevy​_​pbr::deferred::init​_​deferred​_​**<br/>**lighting​_​layout**<br/>初始化延迟光照的深度标识绑定与着色器。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**bevy​_​gizmos​_​render::pipeline​_​3d::**<br/>**init​_​line​_​gizmo​_​pipelines**<br/>来自crate:bevy​_​gizmos​_​render ↗：建立<br/>三维 Gizmo 线条深度管线和接头资源。" }
  class n7 node_system
  class n7 external_node
  n0 e0@-->|"集合成员"| n1
  class e0 edge_set_membership
  n0 e1@-->|"集合成员"| n2
  class e1 edge_set_membership
  n0 e2@-->|"先于"| n3
  class e2 edge_order
  n0 e3@-->|"先于"| n4
  class e3 edge_order
  n0 e4@-->|"先于"| n5
  class e4 edge_order
  n0 e5@-->|"先于"| n6
  class e5 edge_order
  n0 e6@-->|"先于"| n7
  class e6 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
