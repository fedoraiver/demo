---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Assets<StandardMaterial> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Assets#lt;StandardMaterial#gt;**<br/>保存导入模型使用的材质资产。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**update_gizmo_meshes**<br/>将变换操作器对齐焦点并更新模式与高亮。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**asset_events**<br/>将 Assets 暂存的<br/>Added、Modified、Removed 等变化批量写<br/>入对应 AssetEvent 消息；存在<br/>AssetChanges 时同步记录当前系统 tick，<br/>随后清空待发队列。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**track_assets**<br/>持有 AssetServer 资产信息锁处理句柄释<br/>放通知，确认没有新强句柄后移除已释放资<br/>产，使 Assets 集合与资产服务器的引用状<br/>态保持一致。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**spawn_gizmo_meshes**<br/>创建变换操作器各轴网格、材质和覆盖相机。" }
  class n4 node_system
  n5@{ shape: stadium, label: "**RenderApp 渲染流程**<br/>提取场景数据并执行本帧渲染。" }
  class n5 node_engine_flow
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_write
  n0 e4@-->|"访问声明"| n5
  class e4 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
