flowchart LR
  accTitle: bevy_pbr::render::mesh::mark_all_meshes_for_reextraction · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**mark​_​all​_​meshes​_​for​_​reextraction**<br/>清空网格实例并把全部实体标为待重新提取。" }
  class n0 node_system
  n1@{ shape: cyl, label: "**MeshesToReextractNextFrame**<br/>记录因材质未准备而需要再次提取的网格。" }
  class n1 node_resource
  n2@{ shape: cyl, label: "**RenderMeshInstances**<br/>保存 CPU 或 GPU 构建所需的网格实例。" }
  class n2 node_resource
  n0 e0@-->|"可变访问"| n1
  class e0 edge_write
  n0 e1@-->|"可变访问"| n2
  class e1 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
