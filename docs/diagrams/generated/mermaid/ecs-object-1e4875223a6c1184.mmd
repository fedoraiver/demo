---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: asset_events · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**asset_events**<br/>将 Assets 暂存的<br/>Added、Modified、Removed 等变化批量写<br/>入对应 AssetEvent 消息；存在<br/>AssetChanges 时同步记录当前系统 tick，<br/>随后清空待发队列。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PostUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**AssetEventSystems**<br/>发布资产容器积累的变更消息。" }
  class n2 node_system_set
  n3@{ shape: cyl, label: "**Assets#lt;AudioSource#gt;**<br/>来自Kira ↗：保存已加载的短音资产。" }
  class n3 node_resource
  class n3 external_node
  n4@{ shape: cyl, label: "**Messages#lt;AssetEvent#lt;AudioSource#gt;#gt;**<br/>保存 AssetEvent#lt;AudioSource#gt; 消息。" }
  class n4 node_message_buffer
  n5@{ shape: cyl, label: "**AssetChanges#lt;AudioSource#gt;**<br/>记录资产最近变化的系统刻度。" }
  class n5 node_resource
  n6@{ shape: notch-rect, label: "**SystemChangeTick**<br/>提供系统上次与本次运行的变化刻度" }
  class n6 node_system_param
  n1 e0@-->|"main / PostUpdate"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_publish
  n0 e4@--> n5
  class e4 edge_write
  n6 e5@-->|"参数 / 查询数据"| n0
  class e5 edge_reference
  n0 e6@-->|"正文发布消息"| n4
  class e6 edge_publish
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
