---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: Writeback · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**Writeback**<br/>划分物理准备、模拟与回写边界。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**log​_​character​_​velocity**<br/>来自character ↗：采样物理解算后的实际<br/>速度，便于检查加速度、刹车和碰撞反馈。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**sync​_​held​_​physics**<br/>来自item​_​interaction ↗：同步组合体内<br/>箱子的真实世界姿态和速度，不依赖人物是否<br/>具有视觉 Children。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: lin-rect, label: "**Propagate**<br/>来自crate:bevy​_​transform ↗：组织实体<br/>层级变换传播。" }
  class n3 node_system_set
  class n3 external_node
  n4@{ shape: lin-rect, label: "**PositionToTransform**<br/>组织实体变换与物理姿态同步。" }
  class n4 node_system_set
  n5@{ shape: lin-rect, label: "**StepSimulation**<br/>划分物理准备、模拟与回写边界。" }
  class n5 node_system_set
  n6@{ shape: rounded, label: "**update​_​grounded**<br/>来自character ↗：脚底附近的小球向下探<br/>测支撑面；墙面法线和上升中的角色不能算接<br/>地。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: lin-rect, label: "**Last**<br/>划分物理准备、模拟与回写边界。" }
  class n7 node_system_set
  n0 e0@-->|"先于"| n1
  class e0 edge_order
  n0 e1@-->|"先于"| n2
  class e1 edge_order
  n0 e2@-->|"先于"| n3
  class e2 edge_order
  n0 e3@-->|"集合成员"| n4
  class e3 edge_set_membership
  n5 e4@-->|"先于"| n0
  class e4 edge_order
  n0 e5@-->|"先于"| n6
  class e5 edge_order
  n0 e6@-->|"先于"| n7
  class e6 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
