---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: PhysicsIslands · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**PhysicsIslands**<br/>管理模拟岛及接触和关节连接。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**apply_contact_status_changes**<br/>把接触增删同步到约束图和物理岛。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**split_island**<br/>物理岛存在待拆分候选时，根据刚体碰撞体、<br/>接触图和关节图重新划分该岛，并更新刚体所<br/>属岛；拆分用于随后正确决定休眠。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**apply_contact_status_changes**<br/>把接触增删同步到约束图和物理岛。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**apply_joint_graph_changes**<br/>把关节连接变化同步到模拟岛。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update_sleeping_states**<br/>按刚体静止时间判断物理岛的休眠资格。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**wake_all_islands**<br/>批量请求唤醒当前全部休眠物理岛。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**sleep_islands**<br/>依据活跃岛位图和待拆分状态收集需要休眠或<br/>唤醒的物理岛，通过 World 命令应用状态变<br/>化，并同步岛内刚体的休眠状态。" }
  class n7 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_write
  n0 e5@--> n6
  class e5 edge_read
  n7 e6@--> n0
  class e6 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e6@{ curve: basis }
