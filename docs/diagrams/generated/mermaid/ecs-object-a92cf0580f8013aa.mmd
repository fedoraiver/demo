---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-a92cf0580f8013aa-e0{marker-start:url(#object-a92cf0580f8013aa_flowchart-v2-pointStart)!important}\n#object-a92cf0580f8013aa-e2{marker-start:url(#object-a92cf0580f8013aa_flowchart-v2-pointStart)!important}\n#object-a92cf0580f8013aa_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: install_native_policy · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_non_send fill:#F8F3EF,stroke:#A5633A,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**install_native_policy**<br/>安装并维护原生窗口比例与尺寸策略。" }
  class n0 node_system
  n1@{ shape: tag-rect, label: "**NativePolicies**<br/>持有原生窗口策略的线程专属守卫。" }
  class n1 node_non_send
  n2@{ shape: stadium, label: "**main · PreUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n2 node_engine_flow
  class n2 external_node
  n3@{ shape: rounded, label: "**Window**<br/>来自Bevy 引擎 ↗：保存主窗口的尺寸与显<br/>示配置。" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: rounded, label: "**RawHandleWrapper**<br/>来自Bevy 引擎 ↗：提供安装原生窗口策略<br/>所需的底层句柄。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**PrimaryWindow**<br/>来自Bevy 引擎 ↗：标识鼠标捕获系统要求<br/>唯一的主窗口。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: fr-rect, label: "**WindowPolicyPlugin**<br/>维护主窗口的原生比例与尺寸策略。" }
  class n6 node_plugin
  n1 e0@---|"守卫"| n0
  class e0 edge_write
  n2 e1@-->|"main / PreUpdate"| n0
  class e1 edge_registration
  n3 e2@---|"可变访问"| n0
  class e2 edge_write
  n3 e3@-->|"查询访问"| n0
  class e3 edge_read
  n4 e4@-->|"查询访问"| n0
  class e4 edge_read
  n5 e5@-->|"存在 / 变更过滤"| n0
  class e5 edge_reference
  n1 e6@-->|"访问声明"| n0
  class e6 edge_read
  n6 e7@--> n0
  class e7 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
