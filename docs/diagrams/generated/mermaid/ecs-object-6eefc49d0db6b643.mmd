  class n4 external_node
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@-->|"存在性约束"| n1
  class e1 edge_reference
  n0 e2@--> n2
  class e2 edge_read
  n3 e3@-->|"可能包含"| n0
  class e3 edge_reference
  n4 e4@-->|"可能包含"| n0
