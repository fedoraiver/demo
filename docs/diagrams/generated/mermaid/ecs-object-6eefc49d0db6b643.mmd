  class n1 external_node
  n2@{ shape: rounded, label: "**build​_​directional​_​light​_​cascades**<br/>为投射阴影的方向光构建逐相机级联。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**spawn​_​lighting · 创建模板**<br/>来自scene​_​assembly ↗：为玩法海岛创建<br/>会话日光。" }
  class n3 node_entity
  class n3 external_node
  n4@{ shape: rounded, label: "**spawn​_​backdrop · 创建模板**<br/>来自ui ↗：为菜单展示舞台提供带阴影的日<br/>光。" }
