  n7@{ shape: rounded, label: "**Mass**<br/>来自Avian ↗：保存显式配置的质量。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**CarryBaseMass**<br/>挂接时保存，释放或箱体销毁时恢复原人物质<br/>量。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**HoldingItems**<br/>索引角色当前持有的物品。" }
  class n9 node_component
  n10@{ shape: fr-rect, label: "**ItemInteractionPlugin**<br/>管理物品拾取、共享持握、安全释放与反馈。" }
