---
flowchart LR
  accTitle: bevy_pbr::prepass::update_previous_view_data · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**update​_​previous​_​view​_​data**<br/>记录三维及阴影视图未抖动的变换矩阵。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**Camera**<br/>来自crate:bevy​_​camera ↗：配置相机视<br/>口、输出目标和渲染顺序。" }
  class n1 node_component
  class n1 external_node
  n2@{ shape: rounded, label: "**Camera3d**<br/>来自crate:bevy​_​camera ↗：启用三维相机<br/>主渲染流程。" }
  class n2 node_component
  class n2 external_node
  n3@{ shape: fr-rect, label: "**PrepassPlugin**<br/>安装材质预通道处理。" }
  class n3 node_plugin
  n4@{ shape: rounded, label: "**ShadowView**<br/>描述阴影绘制的深度附件与通道名称。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**PreviousViewData**<br/>来自crate:bevy​_​core​_​pipeline ↗：保存<br/>上一帧的相机视图与投影矩阵。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: rounded, label: "**GlobalTransform**<br/>来自crate:bevy​_​transform ↗：保存实体<br/>合并祖先变换后的世界空间仿射变换" }
  class n6 node_component
  class n6 external_node
  n1 e0@--> n0
  class e0 edge_read
  n2 e1@-->|"存在性约束"| n0
  class e1 edge_reference
  n3 e2@-->|"调用"| n0
  class e2 edge_registration
  n4 e3@-->|"存在性约束"| n0
  class e3 edge_reference
  n0 e4@-->|"插入"| n5
  class e4 edge_write
  n6 e5@--> n0
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
