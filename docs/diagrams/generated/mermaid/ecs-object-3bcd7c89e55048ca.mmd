  n5@{ shape: rounded, label: "**Previous**<br/>指定线速度插值的历史数据类型。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Current**<br/>指定线速度插值的当前数据类型。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**NoTranslationEasing**<br/>显式禁止当前实体的平移插值和外推" }
  class n7 node_component
  n8@{ shape: cyl, label: "**Time#lt;Fixed#gt;**<br/>来自Bevy 引擎 ↗：提供固定模拟的时间步<br/>长。" }
