---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: NoBackgroundMotionVectors · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**NoBackgroundMotionVectors**<br/>禁用相机自动生成的背景运动矢量。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**extract_components#lt;bevy_core_**<br/>**pipeline::prepass::background_**<br/>**motion_vectors::**<br/>**NoBackgroundMotionVectors, bevy_**<br/>**render::RenderApp, ()#gt;**<br/>对已同步到子世界的实体读取<br/>ExtractComponent 指定的查询数据，批量<br/>写入转换后的目标组件；转换返回 None 时<br/>移除对应目标组件。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare_background_motion_vectors_**<br/>**bind_groups**<br/>为背景运动矢量绑定前后两帧视图参数。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**cleanup_background_motion_vectors**<br/>从不再启用运动矢量预通道或已标记<br/>NoBackgroundMotionVectors 的视图移除<br/>背景运动矢量管线及绑定组，清理失效渲染状<br/>态。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**prepare_background_motion_vectors_**<br/>**pipelines**<br/>按采样数和法线预通道准备背景运动管线。" }
  class n4 node_system
  n1 e0@-->|"延迟移除"| n0
  class e0 edge_write
  n1 e1@-->|"延迟添加"| n0
  class e1 edge_write
  n0 e2@-->|"存在 / 变更过滤"| n2
  class e2 edge_reference
  n0 e3@-->|"存在 / 变更过滤"| n3
  class e3 edge_reference
  n0 e4@-->|"存在 / 变更过滤"| n4
  class e4 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
