---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: AccessibilitySystems::Update · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**AccessibilitySystems::Update**<br/>同步原生可访问性树和窗口节点。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**main · PostUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**poll_receivers**<br/>轮询各窗口无障碍动作请求处理器，在持有其<br/>锁期间取出排队请求，并包装为<br/>ActionRequestWrapper 消息供应用消费。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update_accessibility_nodes**<br/>把变化的可访问性节点同步给原生适配器。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**window_closed**<br/>消费 WindowClosed 消息，移除对应窗口<br/>的 AccessKit 适配器和无障碍请求处理<br/>器，避免关闭后的窗口继续保留后端状态。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**mark_images_as_changed_if_their_**<br/>**assets_changed**<br/>使图像或图集资产变化触发 UI 图像更新。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**label_changed**<br/>Label 改变时收集其文本元素，把拼接后的<br/>内容写为无障碍标签节点的值；已有节点原位<br/>更新，缺少节点时排入创建命令。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**sync_bounds_and_transforms**<br/>把 UI 几何同步到无障碍树。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**update_ime_position**<br/>把输入法候选窗口放到当前文字光标下方。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**image_changed**<br/>非按钮 ImageNode 改变时从 UI 子节点提<br/>取说明，设置无障碍图像角色和标签；尚无<br/>AccessibilityNode 时排入创建命令。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**button_changed**<br/>Button 改变时从 UI 子节点提取文本标<br/>签，更新已有 AccessibilityNode 的按钮<br/>角色和标签，或通过命令补入对应无障碍节<br/>点。" }
  class n10 node_system
  n1 e0@-->|"main / PostUpdate"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_set_membership
  n0 e4@--> n5
  class e4 edge_order
  n6 e5@--> n0
  class e5 edge_order
  n7 e6@--> n0
  class e6 edge_order
  n8 e7@--> n0
  class e7 edge_order
  n9 e8@--> n0
  class e8 edge_order
  n10 e9@--> n0
  class e9 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
