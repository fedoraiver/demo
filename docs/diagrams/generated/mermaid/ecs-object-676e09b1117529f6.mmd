{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: FullscreenShader · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**FullscreenShader**<br/>提供覆盖整个屏幕的顶点着色器。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**queue_oit_resolve_pipeline**<br/>按 OIT 相机设置缓存透明解析管线。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare_depth_of_field_pipelines**<br/>按景深模式和视图格式准备两阶段管线。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**init_copy_deferred_lighting_id_**<br/>**pipeline**<br/>建立延迟光照标识到深度的复制管线。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**init_blit_pipeline**<br/>建立全屏颜色复制与缩放的 Blit 资源。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**init_tonemapping_pipeline**<br/>建立色调映射的颜色、视图与 LUT 输入布<br/>局。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**init_bloom_downsampling_pipeline**<br/>建立 Bloom 降采样的纹理与参数管线。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**init_bloom_upscaling_pipeline**<br/>建立 Bloom 升采样的纹理和参数布局。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**init_motion_blur_pipeline**<br/>加载运动模糊着色器并构造管线资源。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**init_post_processing_pipeline**<br/>建立色差、暗角和镜头畸变的共用后处理资<br/>源。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**init_fxaa_pipeline**<br/>建立 FXAA 的纹理采样布局和着色器资源。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**init_taa_pipeline**<br/>建立 TAA 的当前帧、历史帧和预通道输入布<br/>局。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**init_cas_pipeline**<br/>建立 CAS 锐化的纹理、参数布局和管线变体<br/>资源。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**init_screen_space_reflections_**<br/>**pipeline**<br/>初始化屏幕空间反射的全屏渲染管线资源。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**init_background_motion_vectors_**<br/>**pipeline**<br/>建立背景运动矢量的全屏管线资源。" }
  class n14 node_system
  n0 e0@--> n1
