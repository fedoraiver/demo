---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: prepare_preprocess_pipelines · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**prepare_preprocess_pipelines**<br/>按设备裁剪能力准备网格预处理管线变体。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · Render**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**RenderSystems::Prepare**<br/>按已排序绘制项准备 GPU 资源及绑定。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**prepare_preprocess_bind_groups**<br/>绑定各视图网格预处理和间接参数构建资源。" }
  class n3 node_system
  n4@{ shape: cyl, label: "**PipelineCache**<br/>缓存 GPU 渲染、计算管线与待创建队列。" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**RenderDevice**<br/>创建渲染和计算所需的 GPU 资源。" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**SpecializedComputePipelines#lt;Preproce**<br/>**ssPipeline#gt;**<br/>按配置键缓存计算管线变体。" }
  class n6 node_resource
  n7@{ shape: cyl, label: "**SpecializedComputePipelines#lt;ResetInd**<br/>**irectBatchSetsPipeline#gt;**<br/>按配置键缓存计算管线变体。" }
  class n7 node_resource
  n8@{ shape: cyl, label: "**SpecializedComputePipelines#lt;BuildInd**<br/>**irectParametersPipeline#gt;**<br/>按配置键缓存计算管线变体。" }
  class n8 node_resource
  n9@{ shape: cyl, label: "**SpecializedComputePipelines#lt;BinUnpac**<br/>**kingPipeline#gt;**<br/>按配置键缓存计算管线变体。" }
  class n9 node_resource
  n10@{ shape: cyl, label: "**SpecializedComputePipelines#lt;UniformA**<br/>**llocationLocalScanPipeline#gt;**<br/>按配置键缓存计算管线变体。" }
  class n10 node_resource
  n11@{ shape: cyl, label: "**SpecializedComputePipelines#lt;UniformA**<br/>**llocationGlobalScanPipeline#gt;**<br/>按配置键缓存计算管线变体。" }
  class n11 node_resource
  n12@{ shape: cyl, label: "**SpecializedComputePipelines#lt;UniformA**<br/>**llocationFanPipeline#gt;**<br/>按配置键缓存计算管线变体。" }
  class n12 node_resource
  n13@{ shape: cyl, label: "**PreprocessPipelines**<br/>汇集网格预处理与间接参数构建管线。" }
  class n13 node_resource
  n14@{ shape: cyl, label: "**GpuPreprocessingSupport**<br/>记录设备可采用的 GPU 预处理级别。" }
