{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-a637996908ea3334-e13{marker-start:url(#object-a637996908ea3334_flowchart-v2-pointStart)!important}\n#object-a637996908ea3334-e15{marker-start:url(#object-a637996908ea3334_flowchart-v2-pointStart)!important}\n#object-a637996908ea3334-e21{marker-start:url(#object-a637996908ea3334_flowchart-v2-pointStart)!important}\n#object-a637996908ea3334-e23{marker-start:url(#object-a637996908ea3334_flowchart-v2-pointStart)!important}\n#object-a637996908ea3334-e25{marker-start:url(#object-a637996908ea3334_flowchart-v2-pointStart)!important}\n#object-a637996908ea3334_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: move_characters · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**move_characters**<br/>按移动意图和速度为角色施加水平运动力。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**CharacterIntent**<br/>保存持续移动方向与单次跳跃、交互请求。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**update_grounded**<br/>准备运动前更新接地状态。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**jump_characters**<br/>执行角色跳跃并消费单次请求。" }
  class n3 node_system
  n4@{ shape: cyl, label: "**PrototypeConfig**<br/>来自设置与参数 ↗：保存运动、重力、拾取<br/>与握持的共享参数。" }
  class n4 node_resource
  class n4 external_node
  n5@{ shape: lin-rect, label: "**FixedGameplaySystems**<br/>来自应用流程 ↗：协调恢复、朝向、运动、<br/>交互与持握的固定步顺序。" }
  class n5 node_system_set
  class n5 external_node
  n6@{ shape: stadium, label: "**main · FixedUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n6 node_engine_flow
  class n6 external_node
  n7@{ shape: lin-rect, label: "**FixedGameplaySystems::Motion**<br/>来自应用流程 ↗：观察接地并施加角色移动<br/>与跳跃。" }
  class n7 node_system_set
  class n7 external_node
  n8@{ shape: lin-rect, label: "**AnonymousSet(0)**<br/>来自Bevy 引擎 ↗：保存本组系统共同的运<br/>行条件。" }
  class n8 node_system_set
  class n8 external_node
  n9@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: rounded, label: "**CharacterMotion**<br/>保存角色接地等运动观察结果。" }
