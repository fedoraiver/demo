  n13@{ shape: rounded, label: "**LinearVelocity**<br/>来自Avian ↗：实际线速度，由冲量、外<br/>力、重力与接触求解改变。" }
  class n13 node_component
  class n13 external_node
  n14@{ shape: rounded, label: "**AngularVelocity**<br/>来自Avian ↗：保存物理模拟中的角速度。" }
  class n14 node_component
  class n14 external_node
  n15@{ shape: rounded, label: "**ComputedMass**<br/>来自Avian ↗：保存物理求解使用的计算质<br/>量。" }
  class n15 node_component
  class n15 external_node
  n16@{ shape: rounded, label: "**ComputedAngularInertia**<br/>来自Avian ↗：保存物理求解使用的计算角<br/>惯量。" }
  class n16 node_component
  class n16 external_node
  n17@{ shape: rounded, label: "**ComputedCenterOfMass**<br/>来自Avian ↗：保存物理求解使用的计算质<br/>心。" }
  class n17 node_component
  class n17 external_node
  n18@{ shape: rounded, label: "**LockedAxes**<br/>来自Avian ↗：限制刚体可移动或旋转的<br/>轴。" }
  class n18 node_component
  class n18 external_node
  n19@{ shape: rounded, label: "**VelocityIntegrationData**<br/>来自Avian ↗：累计本物理步的世界加速度<br/>与外力。" }
  class n19 node_component
  class n19 external_node
  n20@{ shape: rounded, label: "**AccumulatedLocalAcceleration**<br/>来自Avian ↗：累计本物理步的局部加速<br/>度。" }
  class n20 node_component
  class n20 external_node
  n21@{ shape: rounded, label: "**SleepTimer**<br/>来自Avian ↗：记录刚体休眠计时。" }
  class n21 node_component
  class n21 external_node
  n22@{ shape: cyl, label: "**Time#lt;Fixed#gt;**<br/>来自Bevy 引擎 ↗：提供固定模拟的时间步<br/>长。" }
  class n22 node_resource
  class n22 external_node
  n23@{ shape: cyl, label: "**State#lt;AppState#gt; /**<br/>**NextState#lt;AppState#gt;**<br/>来自应用流程 ↗：保存应用主状态及待处理<br/>的会话切换。" }
  class n23 node_resource
  class n23 external_node
  n24@{ shape: cyl, label: "**State#lt;PlayState#gt; /**<br/>**NextState#lt;PlayState#gt;**<br/>来自应用流程 ↗：保存游戏运行、暂停及待<br/>处理的切换请求。" }
  class n24 node_resource
  class n24 external_node
  n25@{ shape: fr-rect, label: "**CharacterPlugin**<br/>提供角色身份、运动、接地与跳跃。" }
