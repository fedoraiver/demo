---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-8671fe9c325fc8b6-e0{marker-start:url(#object-8671fe9c325fc8b6_flowchart-v2-pointStart)!important}\n#object-8671fe9c325fc8b6-e2{marker-start:url(#object-8671fe9c325fc8b6_flowchart-v2-pointStart)!important}\n#object-8671fe9c325fc8b6_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: NoAutomaticBatching · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**NoAutomaticBatching**<br/>禁止网格实体参与自动合批。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**no_automatic_skin_batching**<br/>在 Uniform 限制路径上禁止蒙皮网格自动合<br/>批。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**no_automatic_morph_batching**<br/>在 Uniform 限制路径上禁止形变网格自动合<br/>批。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**extract_meshes_for_gpu_building**<br/>增量提取变化或需重试网格到线程队列。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**extract_2d_meshes**<br/>增量同步二维网格变换和渲染实例信息。" }
  class n4 node_system
  n1 e0@---|"存在 / 变更过滤"| n0
  class e0 edge_reference
  n1 e1@-->|"延迟添加"| n0
  class e1 edge_write
  n2 e2@---|"存在 / 变更过滤"| n0
  class e2 edge_reference
  n2 e3@-->|"延迟添加"| n0
  class e3 edge_write
  n0 e4@-->|"存在 / 变更过滤"| n3
  class e4 edge_reference
  n0 e5@-->|"存在 / 变更过滤"| n4
  class e5 edge_reference
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: bumpX }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
