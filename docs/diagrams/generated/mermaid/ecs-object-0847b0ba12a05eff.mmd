---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: extract_gizmo_data · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**extract_gizmo_data**<br/>把启用的即时 Gizmo 数据提取为渲染实体。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: cyl, label: "**GizmoHandles**<br/>按配置组记录当前调试图元资产句柄。" }
  class n2 node_resource
  n3@{ shape: cyl, label: "**GizmoConfigStore**<br/>按配置组保存调试图元绘制设置。" }
  class n3 node_resource
  n4@{ shape: rounded, label: "**LineGizmoUniform**<br/>上传调试线的变换、宽度和样式参数。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**GizmoMeshConfig**<br/>配置调试线条的样式、接头和渲染层。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**MainEntity**<br/>在子世界中关联原始主世界实体。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**TemporaryRenderEntity**<br/>标记需要在渲染结束后销毁的临时实体。" }
  class n7 node_component
  n1 e0@-->|"RenderApp / ExtractSchedule"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_read
  n3 e2@--> n0
  class e2 edge_read
  n0 e3@-->|"延迟添加"| n4
  class e3 edge_write
  n0 e4@-->|"延迟添加"| n5
  class e4 edge_write
  n0 e5@-->|"延迟添加"| n6
  class e5 edge_write
  n0 e6@-->|"延迟添加"| n7
  class e6 edge_write
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
