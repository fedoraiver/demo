---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-5f87b42294cc3540-e2{marker-start:url(#object-5f87b42294cc3540_flowchart-v2-pointStart)!important}\n#object-5f87b42294cc3540_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Time<Substeps> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Time#lt;Substeps#gt;**<br/>保存时钟上下文、帧间隔及累计时间" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**run_physics_schedule**<br/>来自Avian ↗：使用物理时钟推进<br/>PhysicsSchedule 并恢复原时钟。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**pre_process_velocity_increments**<br/>来自Avian ↗：把加速度、重力和轴锁转成<br/>子步速度增量。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**run_substep_schedule**<br/>来自Avian ↗：按 SubstepCount 平分本<br/>物理步时间，切换通用 Time 为子步时钟并<br/>重复运行 SubstepSchedule，结束后恢复<br/>Time#lt;Physics#gt; 对应的通用时钟。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**update_contact_softness**<br/>来自Avian ↗：按时间步和配置更新接触柔<br/>度系数。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**apply_local_acceleration**<br/>来自Avian ↗：在子步中把局部加速度作用<br/>到世界速度。" }
  class n5 node_system
  class n5 external_node
  n1 e0@-->|"正文可变访问"| n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n3 e2@---|"正文只读访问"| n0
  class e2 edge_read
  n3 e3@-->|"正文可变访问"| n0
  class e3 edge_write
  n0 e4@--> n4
  class e4 edge_read
  n0 e5@--> n5
  class e5 edge_read
  n1 layout_input_0@~~~ n3
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: bumpX }
  e3@{ curve: basis }
  e5@{ curve: basis }
