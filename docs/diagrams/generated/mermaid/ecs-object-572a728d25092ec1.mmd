---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-572a728d25092ec1-e1{marker-start:url(#object-572a728d25092ec1_flowchart-v2-pointStart)!important}\n#object-572a728d25092ec1-e4{marker-start:url(#object-572a728d25092ec1_flowchart-v2-pointStart)!important}\n#object-572a728d25092ec1-e7{marker-start:url(#object-572a728d25092ec1_flowchart-v2-pointStart)!important}\n#object-572a728d25092ec1-e9{marker-start:url(#object-572a728d25092ec1_flowchart-v2-pointStart)!important}\n#object-572a728d25092ec1_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: FirstPersonCamera · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**FirstPersonCamera**<br/>保存跟随目标、眼高与观察角度。" }
  class n0 node_component
  n1@{ shape: hex, label: "**on_camera_look**<br/>将观察输入转为第一人称水平角与俯仰角。" }
  class n1 node_observer
  n2@{ shape: rounded, label: "**sync_character_facing**<br/>同步人物朝向并处理持物转向受阻。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**第一人称相机实体**<br/>来自场景装配 ↗：提供跟随角色的第一人称<br/>视角与观察输入状态。" }
  class n3 node_entity
  class n3 external_node
  n4@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n4 node_entity
  class n4 external_node
  n5@{ shape: rounded, label: "**world_inspector_ui**<br/>来自Egui / Inspector ↗：展示并编辑开<br/>放反射的实体、资源与资产。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**sync_mouse_capture**<br/>管理光标捕获及玩法输入启停。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**sync_character_facing**<br/>同步人物朝向并处理持物转向受阻。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**follow_first_person_camera**<br/>按人物本帧位置与观察角度更新第一人称镜<br/>头。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**sync_character_visibility**<br/>隐藏第一人称控制角色的自身模型。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**spawn_actors**<br/>来自场景装配 ↗：装配玩家、可搬物、控制<br/>者与相机。" }
  class n10 node_system
  class n10 external_node
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n2 e1@---|"查询访问"| n0
  class e1 edge_read
  n0 e2@-->|"可能挂载于"| n3
  class e2 edge_reference
  n0 e3@-->|"target"| n4
  class e3 edge_reference
  n5 e4@---|"反射查看"| n0
  class e4 edge_read
  n5 e5@-->|"反射可选编辑"| n0
  class e5 edge_write
  n0 e6@-->|"查询访问"| n6
  class e6 edge_read
  n1 e7@---|"查询访问"| n0
  class e7 edge_read
  n7 e8@-->|"可变访问"| n0
  class e8 edge_write
  n7 e9@---|"查询访问"| n0
  class e9 edge_read
  n2 e10@-->|"可变访问"| n0
  class e10 edge_write
  n0 e11@-->|"查询访问"| n8
  class e11 edge_read
  n0 e12@-->|"查询访问"| n9
  class e12 edge_read
  n10 e13@-->|"添加"| n0
  class e13 edge_write
