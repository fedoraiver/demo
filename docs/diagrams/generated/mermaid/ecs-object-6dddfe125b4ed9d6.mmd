---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: event::WindowEvent · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lean-r, label: "**WindowEvent**<br/>按顺序汇集窗口与输入消息。" }
  class n0 node_message
  n1@{ shape: rounded, label: "**mouse​_​pick​_​events**<br/>来自crate:bevy​_​picking ↗：把窗口鼠标<br/>事件转换为拾取指针动作。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**write​_​pointer​_​moved​_​and​_​button​_​**<br/>**messages​_​system**<br/>来自crate:bevy​_​egui ↗：按原生事件顺序<br/>转换 Egui 指针输入。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**touch​_​pick​_​events**<br/>来自crate:bevy​_​picking ↗：把触摸阶段<br/>转换为独立拾取指针。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**check​_​keyboard​_​focus​_​lost**<br/>来自crate:bevy​_​winit ↗：处理跨窗口键<br/>盘焦点丢失并补发释放。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**changed​_​windows**<br/>来自crate:bevy​_​winit ↗：把窗口组件变<br/>化同步到 winit 后端。" }
  class n5 node_system
  class n5 external_node
  n0 e0@--> n1
  class e0 edge_consume
  n0 e1@--> n2
  class e1 edge_consume
  n0 e2@--> n3
  class e2 edge_consume
  n4 e3@-->|"可变访问"| n0
  class e3 edge_publish
  n5 e4@-->|"可变访问"| n0
  class e4 edge_publish
  n4 e5@-->|"消息"| n0
  class e5 edge_publish
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: bumpX }
