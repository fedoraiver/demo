  class e6 edge_write
  n8 e7@-->|"查询访问"| n0
  class e7 edge_read
  n9 e8@-->|"查询访问"| n0
  class e8 edge_read
  n10 e9@-->|"查询访问"| n0
  class e9 edge_read
  n0 e10@-->|"可变访问"| n11
  class e10 edge_write
  n12 e11@-->|"查询访问"| n0
  class e11 edge_read
  n13 e12@-->|"访问声明"| n0
  class e12 edge_read
  n14 e13@-->|"访问声明"| n0
  class e13 edge_read
  n15 e14@-->|"访问声明"| n0
  class e14 edge_read
  n16 e15@--> n0
