---
flowchart LR
  accTitle: EntitiesNeedingSpecialization<ExtendedMaterial<StandardMaterial, ForwardDecalMaterialExt>> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**EntitiesNeedingSpecialization#lt;Extend**<br/>**edMaterial#lt;StandardMaterial,**<br/>**ForwardDecalMaterialExt#gt;#gt;**<br/>暂存需要更新或移除专用管线的实体。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**check_entities_needing_**<br/>**specialization#lt;bevy_pbr::extended_**<br/>**material::ExtendedMaterial#lt;bevy_**<br/>**pbr::pbr_material::**<br/>**StandardMaterial, bevy_pbr::decal::**<br/>**forward::ForwardDecalMaterialExt#gt;#gt;**<br/>收集几何或材质变化及移除的三维网格。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**extract_entities_needs_**<br/>**specialization#lt;bevy_pbr::extended_**<br/>**material::ExtendedMaterial#lt;bevy_**<br/>**pbr::pbr_material::**<br/>**StandardMaterial, bevy_pbr::decal::**<br/>**forward::ForwardDecalMaterialExt#gt;#gt;**<br/>把主世界待刷新材质管线的实体身份提取到渲<br/>染侧。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**extract_entities_that_need_**<br/>**specializations_removed#lt;bevy_pbr::**<br/>**extended_material::**<br/>**ExtendedMaterial#lt;bevy_pbr::pbr_**<br/>**material::StandardMaterial, bevy_**<br/>**pbr::decal::forward::**<br/>**ForwardDecalMaterialExt#gt;#gt;**<br/>提取需要移除材质管线专用化的实体。" }
  class n3 node_system
  n1 e0@--> n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  e1@{ curve: basis }
  e2@{ curve: basis }
