---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: EnterSchedules · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**EnterSchedules**<br/>组织状态转换及进入退出调度。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**TransitionSchedules**<br/>组织状态转换及进入退出调度。" }
  class n1 node_system_set
  n2@{ shape: rounded, label: "**bevy​_​state::state​_​scoped::enable​_​**<br/>**entities​_​on​_​enter​_​state#lt;demo::game​_​**<br/>**flow::AppState#gt;**<br/>进入指定状态时重新启用实体子树。" }
  class n2 node_system
  n3@{ shape: lin-rect, label: "**EnterSchedules(PhantomData#lt;demo::**<br/>**game​_​flow::AppState#gt;)**<br/>执行新状态的进入调度和进入生命周期。" }
  class n3 node_system_set
  n4@{ shape: rounded, label: "**bevy​_​state::state​_​scoped::disable​_​**<br/>**entities​_​on​_​enter​_​state#lt;demo::game​_​**<br/>**flow::AppState#gt;**<br/>进入指定状态时禁用实体子树。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**bevy​_​state::state​_​scoped::despawn​_​**<br/>**entities​_​on​_​enter​_​state#lt;demo::game​_​**<br/>**flow::AppState#gt;**<br/>进入指定状态时销毁匹配实体。" }
  class n5 node_system
  n1 e0@-->|"先于"| n0
  class e0 edge_order
  n0 e1@-->|"集合成员"| n2
  class e1 edge_set_membership
  n0 e2@-->|"集合成员"| n3
  class e2 edge_set_membership
  n0 e3@-->|"集合成员"| n4
  class e3 edge_set_membership
  n0 e4@-->|"集合成员"| n5
  class e4 edge_set_membership
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
