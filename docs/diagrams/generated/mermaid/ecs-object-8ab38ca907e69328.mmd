---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: pre_process_velocity_increments · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**pre_process_velocity_increments**<br/>把加速度、重力和轴锁转成子步速度增量。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PhysicsSchedule**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**IntegrationSystems::**<br/>**UpdateVelocityIncrements**<br/>为子步积分准备外力和重力增量。" }
  class n2 node_system_set
  n3@{ shape: lin-rect, label: "**ForceSystems::ApplyConstantForces**<br/>把恒定作用累加为世界或局部速度增量。" }
  class n3 node_system_set
  n4@{ shape: rounded, label: "**RigidBody**<br/>选择动态、静态或运动学刚体行为。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**VelocityIntegrationData**<br/>缓存子步速度增量和阻尼系数。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**LinearDamping**<br/>随物理步衰减刚体线速度。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**AngularDamping**<br/>随物理步衰减刚体角速度。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**GravityScale**<br/>缩放单个刚体受到的重力。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**LockedAxes**<br/>锁定刚体的平移或旋转轴。" }
  class n9 node_component
  n10@{ shape: cyl, label: "**Gravity**<br/>保存物理世界使用的全局重力。" }
  class n10 node_resource
  n11@{ shape: cyl, label: "**Time#lt;Substeps#gt;**<br/>来自Bevy 引擎 ↗：保存时钟上下文、帧间<br/>隔及累计时间" }
  class n11 node_resource
  class n11 external_node
  n12@{ shape: cyl, label: "**SolverDiagnostics**<br/>记录物理求解各阶段耗时。" }
  class n12 node_resource
  n1 e0@-->|"main / PhysicsSchedule"| n0
