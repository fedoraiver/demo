---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: SubstepCount · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**SubstepCount**<br/>把一次物理步分为指定数量的求解子步。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**run_physics_schedule**<br/>使用物理时钟推进 PhysicsSchedule 并恢<br/>复原时钟。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**run_substep_schedule**<br/>按 SubstepCount 平分本物理步时间，切换<br/>通用 Time 为子步时钟并重复运行<br/>SubstepSchedule，结束后恢复<br/>Time#lt;Physics#gt; 对应的通用时钟。" }
  class n2 node_system
  n0 e0@-->|"正文只读访问"| n1
  class e0 edge_read
  n0 e1@-->|"正文只读访问"| n2
  class e1 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
