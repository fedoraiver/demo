---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-cf4ef4fde4d28222-e6{marker-start:url(#object-cf4ef4fde4d28222_flowchart-v2-pointStart)!important}\n#object-cf4ef4fde4d28222_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: position_popover · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**position_popover**<br/>根据父节点几何、窗口边距和 Popover 配置<br/>计算弹出层位置，调整 Node 与局部、全局<br/>UI 变换，并同步受影响后代的全局变换。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PostUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**UiSystems::Layout**<br/>计算界面内容与视口的本帧布局。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**update_scrollbar_thumb**<br/>按内容与视口比例更新滚动条滑块几何。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**ui_layout_system**<br/>求解 UI 布局并回写节点尺寸和二维变换。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**Node**<br/>声明 UI 节点的布局规则。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**UiTransform**<br/>配置 UI 节点的相对二维变换。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**UiGlobalTransform**<br/>保存 UI 节点的绝对二维变换。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**ComputedNode**<br/>保存 UI 布局计算后的物理尺寸。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**ComputedUiRenderTargetInfo**<br/>缓存 UI 目标的尺寸与缩放。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**Popover**<br/>保存弹出层相对父元素的候选位置及窗口边缘<br/>留白" }
  class n10 node_component
  n11@{ shape: rounded, label: "**ChildOf**<br/>保存当前实体的父实体身份" }
  class n11 node_component
  n12@{ shape: rounded, label: "**Children**<br/>保存以 ChildOf 指向当前父实体的子实体集<br/>合" }
  class n12 node_component
  n1 e0@-->|"main / PostUpdate"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_order
  n4 e3@--> n0
  class e3 edge_order
  n0 e4@--> n5
  class e4 edge_write
  n0 e5@--> n6
  class e5 edge_write
  n7 e6@--- n0
  class e6 edge_write
  n8 e7@--> n0
  class e7 edge_read
  n9 e8@--> n0
  class e8 edge_read
  n10 e9@--> n0
  class e9 edge_read
  n11 e10@--> n0
  class e10 edge_read
  n7 e11@--> n0
  class e11 edge_read
  n10 e12@-->|"存在 / 变更过滤"| n0
  class e12 edge_reference
  n12 e13@--> n0
  class e13 edge_read
