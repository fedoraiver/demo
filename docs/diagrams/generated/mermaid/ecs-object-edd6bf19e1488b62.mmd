---
flowchart LR
  accTitle: bevy_picking::backend::PointerHits · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lean-r, label: "**PointerHits**<br/>传递拾取后端的实体命中结果。" }
  class n0 node_message
  n1@{ shape: rounded, label: "**update​_​window​_​hits**<br/>把所在窗口作为拾取的最底层命中。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**sprite​_​picking**<br/>来自crate:bevy​_​sprite ↗：按精灵图像和<br/>拾取配置计算指针命中。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**ui​_​picking**<br/>来自crate:bevy​_​ui ↗：按 UI 堆叠与相机<br/>视口计算指针命中。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**generate​_​hovermap**<br/>汇总拾取命中并应用指针捕获。" }
  class n4 node_system
  n1 e0@-->|"可变访问"| n0
  class e0 edge_publish
  n2 e1@-->|"可变访问"| n0
  class e1 edge_publish
  n1 e2@-->|"消息"| n0
  class e2 edge_publish
  n3 e3@-->|"消息"| n0
  class e3 edge_publish
  n3 e4@-->|"可变访问"| n0
  class e4 edge_publish
  n0 e5@--> n4
  class e5 edge_consume
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
