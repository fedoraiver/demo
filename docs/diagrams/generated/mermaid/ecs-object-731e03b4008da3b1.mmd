---
flowchart LR
  accTitle: extract_lightmaps · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**extract_lightmaps**<br/>为可见的新增光照贴图分配渲染槽位，记录<br/>UV 和采样设置，释放移除项，并在 GPU 图<br/>像就绪后完成待处理槽位的纹理更新。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**MeshExtractionSystems**<br/>向渲染世界提取三维网格的实例数据。" }
  class n2 node_system_set
  n3@{ shape: cyl, label: "**RenderLightmaps**<br/>管理渲染侧光照贴图的槽位和纹理。" }
  class n3 node_resource
  n4@{ shape: rounded, label: "**ViewVisibility**<br/>记录实体是否应被提取用于渲染。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**Lightmap**<br/>为网格应用烘焙的间接漫反射光照。" }
  class n5 node_component
  n6@{ shape: notch-rect, label: "**RemovedComponents#lt;Lightmap#gt;**<br/>读取曾移除指定组件或连同该组件一起销毁的<br/>实体身份" }
  class n6 node_system_param
  n7@{ shape: cyl, label: "**RenderAssets#lt;GpuImage#gt;**<br/>按源资产身份保存 GPU 渲染表示。" }
  class n7 node_resource
  n8@{ shape: cyl, label: "**FallbackImage**<br/>为未指定图像的绑定提供不透明白纹理。" }
  class n8 node_resource
  n1 e0@-->|"RenderApp / ExtractSchedule"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_order
  n0 e2@--> n3
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_read
  n5 e4@--> n0
  class e4 edge_read
  n4 e5@-->|"存在 / 变更过滤"| n0
  class e5 edge_reference
  n5 e6@-->|"存在 / 变更过滤"| n0
  class e6 edge_reference
  n6 e7@-->|"参数 / 查询数据"| n0
  class e7 edge_reference
  n7 e8@--> n0
  class e8 edge_read
  n8 e9@--> n0
  class e9 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: bumpX }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
