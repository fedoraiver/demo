---
flowchart LR
  accTitle: demo::settings::frame_pacing::apply_frame_rate_limit · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**demo::settings::frame​_​pacing::apply​_​**<br/>**frame​_​rate​_​limit**<br/>只同步更新策略；计时与等待由 Winit 执<br/>行，Local 仅保存已应用值以去重和记录变<br/>更。" }
  class n0 node_system
  n1@{ shape: cyl, label: "**settings::config::GameSettings**<br/>全局玩家设置；非零类型保证帧率上限始终能<br/>够转换为等待间隔。" }
  class n1 node_resource
  n2@{ shape: cyl, label: "**winit​_​config::WinitSettings**<br/>来自crate:bevy​_​winit ↗：配置窗口事件<br/>循环的更新策略。" }
  class n2 node_resource
  class n2 external_node
  n3@{ shape: notch-rect, label: "**Local · applied​_​max​_​fps**<br/>记住已应用的帧率上限。" }
  class n3 node_local
  n4@{ shape: fr-rect, label: "**settings::SettingsPlugin**<br/>注册设置资源、原型参数反射与渲染限帧，不<br/>覆盖调用方已提供的配置或固定时间步。" }
  class n4 node_plugin
  n1 e0@--> n0
  class e0 edge_read
  n0 e1@-->|"可变访问"| n2
  class e1 edge_write
  n0 e2@-->|"赋值"| n2
  class e2 edge_write
  n0 e3@-->|"可变访问"| n3
  class e3 edge_write
  n4 e4@-->|"调用"| n0
  class e4 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
