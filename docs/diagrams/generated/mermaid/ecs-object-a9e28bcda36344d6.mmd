  n0@{ shape: rounded, label: "**sync​_​held​_​presentation**<br/>帧末跟随同一份已呈现人物姿态，零固定步时<br/>也不在箱体上叠加第二份插值。" }
  class n0 node_system
  n1@{ shape: fr-rect, label: "**ItemInteractionPlugin**<br/>注册交互、持握生命周期、物理与呈现同步及<br/>物品反馈；物理插件由调用方显式安装。" }
  class n1 node_plugin
  n2@{ shape: rounded, label: "**HeldTarget**<br/>手前的目标姿态；对齐期间与真实局部挂接姿<br/>态分离，完成后由共享刚体保持相对位置。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**HeldAttachment**<br/>实际碰撞形状相对组合刚体的姿态；箱实体不<br/>成为人物的 ChildOf，避免异常销毁时连带<br/>消失。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**Character**<br/>来自character ↗：具有移动和跳跃能力的<br/>角色。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**gameplay​_​running**<br/>来自game​_​flow ↗：独立功能测试没有应用<br/>状态；真实游戏只在 Running 推进玩法。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**Pickable**<br/>允许被拾取的能力标签。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**Transform**<br/>来自crate:bevy​_​transform ↗：保存实体<br/>相对父实体的平移、旋转和缩放" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: lin-rect, label: "**Target**<br/>来自game​_​flow ↗：固定模拟阶段；结构变<br/>更在依赖阶段之间提交。" }
  class n8 node_system_set
  class n8 external_node
  n9@{ shape: cyl, label: "**PrototypeConfig**<br/>来自settings ↗：原型的运动、平地和持箱<br/>参数。" }
  class n9 node_resource
  class n9 external_node
  n10@{ shape: rounded, label: "**HeldBy**<br/>物体的持有者；只由交互系统插入或移除。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**CarryGrip**<br/>模型对应的手前偏移；未指定时继续使用原型<br/>配置，纸箱对齐持箱动作的双手。" }
