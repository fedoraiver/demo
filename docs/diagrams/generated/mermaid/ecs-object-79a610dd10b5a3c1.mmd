---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-79a610dd10b5a3c1-e12{marker-start:url(#object-79a610dd10b5a3c1_flowchart-v2-pointStart)!important}\n#object-79a610dd10b5a3c1_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: EnhancedInputSystems::Prepare · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**EnhancedInputSystems::Prepare**<br/>准备动作评估并清理待释放的输入。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**ApplyDeferred（捕获 → 动作准备）**<br/>来自Bevy 引擎 ↗：使本帧玩法输入启停变<br/>更对动作评估可见。" }
  class n1 node_sync
  class n1 external_node
  n2@{ shape: lin-rect, label: "**EnhancedInputSystems::Update**<br/>评估绑定输入并更新动作值与触发状态。" }
  class n2 node_system_set
  n3@{ shape: stadium, label: "**main · PreUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n3 node_engine_flow
  class n3 external_node
  n4@{ shape: rounded, label: "**update_pending**<br/>调用 InputReader 的待处理输入更新逻<br/>辑，消费上一阶段排队的绑定与重置操作，使<br/>本轮上下文评估使用更新后的输入读取状态。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**sync_mouse_capture**<br/>来自第一人称控制 ↗：管理光标捕获及玩法<br/>输入启停。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**sync_context**<br/>来自菜单与界面 ↗：跟随窗口焦点启停菜单<br/>输入。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: cyl, label: "**ButtonInput#lt;KeyCode#gt;**<br/>来自Bevy 引擎 ↗：保存键盘按键的当前状<br/>态与变化。" }
  class n7 node_resource
  class n7 external_node
  n8@{ shape: cyl, label: "**ButtonInput#lt;MouseButton#gt;**<br/>来自Bevy 引擎 ↗：保存鼠标按钮的当前状<br/>态与变化。" }
  class n8 node_resource
  class n8 external_node
  n9@{ shape: cyl, label: "**AccumulatedMouseMotion**<br/>来自Bevy 引擎 ↗：汇总本帧鼠标位移供观<br/>察动作使用。" }
  class n9 node_resource
  class n9 external_node
  n10@{ shape: cyl, label: "**ActionSources**<br/>配置输入框架允许使用的输入来源。" }
  class n10 node_resource
  n11@{ shape: cyl, label: "**ConsumedInputs**<br/>记录本轮动作评估已经消费的输入。" }
  class n11 node_resource
  n12@{ shape: cyl, label: "**PendingBindings**<br/>保存上下文停用后仍需重置的输入绑定。" }
  class n12 node_resource
  n1 e0@--> n0
  class e0 edge_order
  n0 e1@--> n2
  class e1 edge_order
  n3 e2@-->|"main / PreUpdate"| n0
  class e2 edge_registration
  n0 e3@--> n4
  class e3 edge_set_membership
  n5 e4@--> n0
  class e4 edge_order
  n6 e5@--> n0
  class e5 edge_order
  n7 e6@-->|"访问声明"| n0
  class e6 edge_read
  n8 e7@-->|"访问声明"| n0
  class e7 edge_read
  n9 e8@-->|"访问声明"| n0
  class e8 edge_read
  n10 e9@-->|"访问声明"| n0
  class e9 edge_read
  n11 e10@-->|"访问声明"| n0
  class e10 edge_read
  n12 e11@-->|"访问声明"| n0
  class e11 edge_read
  n12 e12@---|"访问声明"| n0
  class e12 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e8@{ curve: basis }
