---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: PostInput · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**PostInput**<br/>组织指针拾取和悬停处理阶段。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**viewport​_​picking**<br/>来自crate:bevy​_​ui ↗：把外部指针转换并<br/>转发到 UI 内嵌视口。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: lin-rect, label: "**Input**<br/>组织指针拾取和悬停处理阶段。" }
  class n2 node_system_set
  n3@{ shape: lin-rect, label: "**MessageUpdateSystems**<br/>来自crate:bevy​_​ecs ↗：统一轮换已登记<br/>的消息缓冲。" }
  class n3 node_system_set
  class n3 external_node
  n4@{ shape: lin-rect, label: "**TimeSystems**<br/>来自crate:bevy​_​time ↗：更新真实、虚拟<br/>及当前通用时钟。" }
  class n4 node_system_set
  class n4 external_node
  n0 e0@-->|"集合成员"| n1
  class e0 edge_set_membership
  n2 e1@-->|"先于"| n0
  class e1 edge_order
  n3 e2@-->|"先于"| n0
  class e2 edge_order
  n4 e3@-->|"先于"| n0
  class e3 edge_order
  e1@{ curve: basis }
  e3@{ curve: basis }
