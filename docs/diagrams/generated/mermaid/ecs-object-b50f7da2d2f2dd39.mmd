---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Node · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Node**<br/>声明 UI 节点的布局规则。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**propagate_ui_target_cameras**<br/>为 UI 根配置目标相机和视口信息传播源。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**measure_text_system**<br/>在文本变化后更新内容测量并安排文字重排。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**sync_font_size_to_em_size**<br/>把文本字号解析为节点的 EmSize。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**ui_layout_system**<br/>求解 UI 布局并回写节点尺寸和二维变换。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**position_popover**<br/>根据父节点几何、窗口边距和 Popover 配置<br/>计算弹出层位置，调整 Node 与局部、全局<br/>UI 变换，并同步受影响后代的全局变换。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_clipping_system**<br/>从 UI 根递归更新继承裁剪范围。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**ui_stack_system**<br/>重建稳定的 UI 绘制和命中顺序。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**button_changed**<br/>Button 改变时从 UI 子节点提取文本标<br/>签，更新已有 AccessibilityNode 的按钮<br/>角色和标签，或通过命令补入对应无障碍节<br/>点。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**image_changed**<br/>非按钮 ImageNode 改变时从 UI 子节点提<br/>取说明，设置无障碍图像角色和标签；尚无<br/>AccessibilityNode 时排入创建命令。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**extract_uinode_borders**<br/>提取 UI 各边颜色边框与外轮廓。" }
  class n10 node_system
  n0 e0@-->|"存在 / 变更过滤"| n1
  class e0 edge_reference
  n0 e1@-->|"存在 / 变更过滤"| n2
  class e1 edge_reference
  n0 e2@-->|"存在 / 变更过滤"| n3
  class e2 edge_reference
  n0 e3@-->|"存在 / 变更过滤"| n4
  class e3 edge_reference
  n0 e4@--> n4
  class e4 edge_read
  n5 e5@--> n0
  class e5 edge_write
  n0 e6@--> n6
  class e6 edge_read
  n0 e7@-->|"存在 / 变更过滤"| n6
  class e7 edge_reference
  n0 e8@-->|"存在 / 变更过滤"| n7
  class e8 edge_reference
  n0 e9@-->|"存在 / 变更过滤"| n8
  class e9 edge_reference
  n0 e10@-->|"存在 / 变更过滤"| n9
  class e10 edge_reference
  n0 e11@--> n10
  class e11 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: bumpX }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
