---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-546b39b8188fcb1e-e2{marker-start:url(#object-546b39b8188fcb1e_flowchart-v2-pointStart)!important}\n#object-546b39b8188fcb1e_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: FocusedNonWindowEguiContext · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**FocusedNonWindowEguiContext**<br/>保存当前获得键盘焦点的非窗口 Egui 上下<br/>文实体" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**write_pointer_moved_and_button_**<br/>**messages_system**<br/>按原生事件顺序转换 Egui 指针输入。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**write_window_touch_messages_system**<br/>把窗口触摸转换为 Egui 指针和触摸事件。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**write_non_window_touch_messages_**<br/>**system**<br/>向聚焦的非窗口 Egui 界面传递触摸。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**write_mouse_wheel_messages_system**<br/>向悬停 Egui 上下文传递滚轮输入。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**write_keyboard_input_messages_system**<br/>把键盘文本与按键转换为 Egui 输入。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**write_ime_messages_system**<br/>向聚焦的 Egui 上下文传递输入法文本。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**write_file_dnd_messages_system**<br/>把文件拖放路由到对应 Egui 上下文。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**write_egui_input_system**<br/>把界面输入和文件拖放写入 Egui 输入批<br/>次。" }
  class n8 node_system
  n1 e0@-->|"延迟添加"| n0
  class e0 edge_write
  n1 e1@-->|"延迟移除"| n0
  class e1 edge_write
  n2 e2@--- n0
  class e2 edge_read
  n2 e3@-->|"延迟添加"| n0
  class e3 edge_write
  n2 e4@-->|"延迟移除"| n0
  class e4 edge_write
  n0 e5@--> n3
  class e5 edge_read
  n0 e6@--> n4
  class e6 edge_read
  n0 e7@--> n5
  class e7 edge_read
  n0 e8@--> n6
  class e8 edge_read
  n0 e9@--> n7
  class e9 edge_read
  n0 e10@--> n8
  class e10 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
