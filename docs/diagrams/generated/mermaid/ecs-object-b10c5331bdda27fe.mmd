---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: solve_contacts<false> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**solve_contacts#lt;false#gt;**<br/>迭代接触约束并向碰撞刚体施加冲量；泛型<br/>USE_BIAS 决定是否加入重叠修正，用带偏置<br/>求解和无偏置松弛分别处理穿透与速度过冲。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · SubstepSchedule**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**SubstepSolverSystems::Relax**<br/>用无偏置约束求解放松过强响应。" }
  class n2 node_system_set
  n3@{ shape: cyl, label: "**SolverBodies**<br/>连续存储活跃刚体的求解状态。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**ConstraintGraph**<br/>为并行接触求解维护约束着色图。" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**SolverConfig**<br/>配置接触与关节约束求解参数。" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**Time**<br/>来自Bevy 引擎 ↗：提供当前运行阶段的通<br/>用时间。" }
  class n6 node_resource
  class n6 external_node
  n7@{ shape: cyl, label: "**SolverDiagnostics**<br/>记录物理求解各阶段耗时。" }
  class n7 node_resource
  n1 e0@-->|"main / SubstepSchedule"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_read
  n6 e5@--> n0
  class e5 edge_read
  n0 e6@--> n7
  class e6 edge_write
  n1 layout_input_0@~~~ n2
  n2 layout_input_1@~~~ n5
  n5 layout_input_2@~~~ n6
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
