---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: Solver · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**Solver**<br/>组织一次物理模拟步的主要阶段。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**NarrowPhase**<br/>组织一次物理模拟步的主要阶段。" }
  class n1 node_system_set
  n2@{ shape: rounded, label: "**apply​_​contact​_​status​_​changes**<br/>把接触增删同步到约束图和物理岛。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**apply​_​joint​_​graph​_​changes**<br/>把关节连接变化同步到模拟岛。" }
  class n3 node_system
  n4@{ shape: lin-rect, label: "**PrepareContactConstraints**<br/>组织约束求解的准备、子步与回写。" }
  class n4 node_system_set
  n5@{ shape: lin-rect, label: "**Restitution**<br/>组织约束求解的准备、子步与回写。" }
  class n5 node_system_set
  n6@{ shape: lin-rect, label: "**Sleeping**<br/>组织一次物理模拟步的主要阶段。" }
  class n6 node_system_set
  n7@{ shape: lin-rect, label: "**PrepareSolverBodies**<br/>组织约束求解的准备、子步与回写。" }
  class n7 node_system_set
  n8@{ shape: lin-rect, label: "**Substep**<br/>组织约束求解的准备、子步与回写。" }
  class n8 node_system_set
  n9@{ shape: lin-rect, label: "**PrepareJoints**<br/>组织约束求解的准备、子步与回写。" }
  class n9 node_system_set
  n10@{ shape: lin-rect, label: "**ContinuousCollision**<br/>组织约束求解的准备、子步与回写。" }
  class n10 node_system_set
  n11@{ shape: lin-rect, label: "**Finalize**<br/>组织约束求解的准备、子步与回写。" }
  class n11 node_system_set
  n12@{ shape: lin-rect, label: "**StoreContactImpulses**<br/>组织约束求解的准备、子步与回写。" }
  class n12 node_system_set
  n13@{ shape: lin-rect, label: "**PostSubstep**<br/>组织约束求解的准备、子步与回写。" }
  class n13 node_system_set
  n14@{ shape: lin-rect, label: "**PreSubstep**<br/>组织约束求解的准备、子步与回写。" }
  class n14 node_system_set
  n15@{ shape: rounded, label: "**update​_​body​_​size​_​metrics**<br/>重算刚体的 CCD 厚度和最大扫掠半径。" }
  class n15 node_system
  n1 e0@-->|"先于"| n0
  class e0 edge_order
  n0 e1@-->|"集合成员"| n2
  class e1 edge_set_membership
  n0 e2@-->|"集合成员"| n3
  class e2 edge_set_membership
  n0 e3@-->|"集合成员"| n4
  class e3 edge_set_membership
  n0 e4@-->|"集合成员"| n5
  class e4 edge_set_membership
  n0 e5@-->|"先于"| n6
  class e5 edge_order
  n0 e6@-->|"集合成员"| n7
  class e6 edge_set_membership
  n0 e7@-->|"集合成员"| n8
  class e7 edge_set_membership
  n0 e8@-->|"集合成员"| n9
  class e8 edge_set_membership
  n0 e9@-->|"集合成员"| n10
  class e9 edge_set_membership
  n0 e10@-->|"集合成员"| n11
  class e10 edge_set_membership
  n0 e11@-->|"集合成员"| n12
  class e11 edge_set_membership
  n0 e12@-->|"集合成员"| n13
  class e12 edge_set_membership
  n0 e13@-->|"集合成员"| n14
  class e13 edge_set_membership
  n15 e14@-->|"先于"| n0
  class e14 edge_order
