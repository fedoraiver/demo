---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: transform_to_position · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**transform_to_position**<br/>把用户改变的世界变换同步到物理位姿。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · FixedPostUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**PhysicsTransformSystems::**<br/>**TransformToPosition**<br/>把外部变换变化同步到物理姿态。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**GlobalTransform**<br/>来自Bevy 引擎 ↗：保存实体合并祖先变换<br/>后的世界空间仿射变换" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: rounded, label: "**Position**<br/>保存刚体或碰撞体的世界位置。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**Rotation**<br/>保存刚体或碰撞体的世界旋转。" }
  class n5 node_component
  n6@{ shape: cyl, label: "**LastPhysicsTick**<br/>区分外部修改与上一物理步自身的回写。" }
  class n6 node_resource
  n7@{ shape: notch-rect, label: "**SystemChangeTick**<br/>来自Bevy 引擎 ↗：提供系统上次与本次运<br/>行的变化刻度" }
  class n7 node_system_param
  class n7 external_node
  n1 e0@-->|"main / FixedPostUpdate"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n3 e2@--> n0
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_write
  n0 e4@--> n5
  class e4 edge_write
  n6 e5@--> n0
  class e5 edge_read
  n7 e6@-->|"参数 / 查询数据"| n0
  class e6 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
