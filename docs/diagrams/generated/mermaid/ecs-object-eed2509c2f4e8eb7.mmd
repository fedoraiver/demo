---
flowchart LR
  accTitle: ui::pages::SettingsStatus · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**SettingsStatus**<br/>保存结果和草稿提示原位更新，不改变滚动区<br/>域或按钮的实体身份。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update​_​settings​_​text**<br/>原位更新设置草稿数值与保存提示。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>显示并原位刷新设置保存状态与草稿提示。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>显示并原位刷新设置保存状态与草稿提示。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>显示并原位刷新设置保存状态与草稿提示。" }
  class n4 node_entity
  n5@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>显示并原位刷新设置保存状态与草稿提示。" }
  class n5 node_entity
  n0 e0@-->|"存在性约束"| n1
  class e0 edge_reference
  n2 e1@-->|"可能包含"| n0
  class e1 edge_reference
  n3 e2@-->|"可能包含"| n0
  class e2 edge_reference
  n4 e3@-->|"可能包含"| n0
  class e3 edge_reference
  n5 e4@-->|"可能包含"| n0
  class e4 edge_reference
  e1@{ curve: basis }
