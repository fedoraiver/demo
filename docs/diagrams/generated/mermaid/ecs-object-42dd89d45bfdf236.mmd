---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-42dd89d45bfdf236-e1{marker-start:url(#object-42dd89d45bfdf236_flowchart-v2-pointStart)!important}\n#object-42dd89d45bfdf236-e3{marker-start:url(#object-42dd89d45bfdf236_flowchart-v2-pointStart)!important}\n#object-42dd89d45bfdf236-e5{marker-start:url(#object-42dd89d45bfdf236_flowchart-v2-pointStart)!important}\n#object-42dd89d45bfdf236-e7{marker-start:url(#object-42dd89d45bfdf236_flowchart-v2-pointStart)!important}\n#object-42dd89d45bfdf236-e9{marker-start:url(#object-42dd89d45bfdf236_flowchart-v2-pointStart)!important}\n#object-42dd89d45bfdf236-e11{marker-start:url(#object-42dd89d45bfdf236_flowchart-v2-pointStart)!important}\n#object-42dd89d45bfdf236-e13{marker-start:url(#object-42dd89d45bfdf236_flowchart-v2-pointStart)!important}\n#object-42dd89d45bfdf236-e15{marker-start:url(#object-42dd89d45bfdf236_flowchart-v2-pointStart)!important}\n#object-42dd89d45bfdf236_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: CarryBaseMass · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**CarryBaseMass**<br/>挂接时保存，释放或箱体销毁时恢复原人物质<br/>量。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n1 node_entity
  class n1 external_node
  n2@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**handle_interaction**<br/>处理物品拾取、共享持握与主动释放。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**release_orphaned_items**<br/>清理失效持握并恢复物品独立运动。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**restore_empty_holder_mass**<br/>归还不再持物角色的原有质量。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**finish_attachments**<br/>为持物装配共享碰撞代理并累计质量。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**align_attachments**<br/>沿安全碰撞路径将物品对齐双手。" }
  class n9 node_system
  n0 e0@-->|"可能挂载于"| n1
  class e0 edge_reference
