---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-d4d83fa403170cfb-e6{marker-start:url(#object-d4d83fa403170cfb_flowchart-v2-pointStart)!important}\n#object-d4d83fa403170cfb_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: bevy::bevy_time::Time#lt;schedule::time::Physics#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Time#lt;Physics#gt;**<br/>保存时钟上下文、帧间隔及累计时间" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**resume​_​simulation**<br/>来自game​_​flow ↗：恢复游戏与物理时钟。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**enter​_​main​_​menu**<br/>来自game​_​flow ↗：保留主菜单展示时间并<br/>冻结物理模拟。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**run​_​physics​_​schedule**<br/>来自crate:avian3d ↗：使用物理时钟推<br/>进 PhysicsSchedule 并恢复原时钟。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**run​_​substep​_​schedule**<br/>来自crate:avian3d ↗：按子步数划分物理<br/>时间并运行子步调度。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**pause​_​simulation**<br/>来自game​_​flow ↗：冻结游戏与物理时钟并<br/>清零当前增量。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**update​_​contact​_​softness**<br/>来自crate:avian3d ↗：按时间步和配置更<br/>新接触柔度系数。" }
  class n6 node_system
  class n6 external_node
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n2 e1@-->|"可变访问"| n0
  class e1 edge_write
  n3 e2@-->|"可变访问"| n0
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_read
  n5 e4@-->|"可变访问"| n0
  class e4 edge_write
  n0 e5@--> n6
  class e5 edge_read
  n3 e6@--- n0
  class e6 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
