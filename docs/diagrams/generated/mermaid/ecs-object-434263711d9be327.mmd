---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: PipelineCache · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**PipelineCache**<br/>缓存 GPU 渲染、计算管线与待创建队列。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**tonemapping**<br/>为启用色调映射的 HDR 视图绑定颜色源、视<br/>图参数和 LUT，执行全屏色调映射并写入后<br/>处理目标；模式关闭或管线尚未就绪时跳过。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**bloom**<br/>对 HDR 视图颜色执行 Bloom 降采样和上采<br/>样通道，将亮部扩散合成回视图；强度为零、<br/>非 HDR 或所需管线和参数缓冲未就绪时不执<br/>行。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**fxaa**<br/>在 FXAA 开启且相机管线就绪时，读取当前<br/>视图颜色并执行全屏抗锯齿，写入下一后处理<br/>目标；复用与源纹理对应的绑定组。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**smaa**<br/>按边缘检测、混合权重计算和邻域混合三个阶<br/>段执行 SMAA，将抗锯齿结果写入视图后处理<br/>目标；任何所需管线未就绪时跳过整个流程。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**cas**<br/>绑定视图颜色和 CAS 参数，执行对比度自适<br/>应锐化并写入后处理目标；缓存对应参数缓冲<br/>与源纹理的绑定组，管线或参数不可用时跳<br/>过。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**upscaling**<br/>把视图主颜色纹理通过 Blit 管线写入最终<br/>输出附件，遵循相机的输出模式、清屏颜色和<br/>视口；输出模式为 Skip 时不写入。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**msaa_writeback**<br/>在 MSAA 开启时把当前后处理颜色绘制回多<br/>采样主纹理，并解析到下一颜色目标，使后续<br/>通道继续使用一致的多采样附件；MSAA 关闭<br/>时跳过。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**post_processing**<br/>为当前视图组合已启用的色差、暗角和镜头畸<br/>变效果，绑定各效果参数及颜色 LUT 后执行<br/>全屏后处理；没有效果或所需资产和管线未就<br/>绪时跳过。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**egui_pass**<br/>来自Egui / Inspector ↗：读取当前<br/>Egui 视图已准备的绘制数据、纹理绑定及变<br/>换缓冲，在目标颜色附件上执行 Egui 绘制<br/>命令，并按相机视口设置渲染范围。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**early_prepass**<br/>从当前视图取得深度、预通道纹理及前后帧参<br/>数，调用共享预通道实现绘制不透明和<br/>AlphaMask 预通道阶段，供后续深度、法线<br/>及运动矢量相关处理使用。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**late_prepass**<br/>仅在遮挡剔除开启且允许间接绘制时执行晚期<br/>预通道，复用共享实现绘制对应的不透明和<br/>AlphaMask 预通道阶段；其他视图直接跳<br/>过。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**cluster_on_gpu**<br/>执行深度切片、计数、分配和填充的 GPU 聚<br/>簇。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**main_opaque_pass_3d**<br/>绘制三维不透明、AlphaMask 与天空盒。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**main_transparent_pass_3d**<br/>绘制三维透明物体并保护 OIT 链表状态。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**oit_resolve**<br/>在透明主通道之后解析顺序无关透明数据并合<br/>成到视图颜色，同时重置 OIT 原子计数与链<br/>表头，避免下一次透明通道使用损坏的数据。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**screen_space_reflections**<br/>采样场景颜色、深度与蓝噪声绘制屏幕空间反<br/>射。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**deferred_lighting**<br/>绑定网格视图、延迟光照管线及通道深度标识<br/>参数，在延迟光照深度附件约束下执行全屏光<br/>照计算，将结果写入视图颜色。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**temporal_anti_alias**<br/>混合当前颜色与历史帧并更新 TAA 历史目<br/>标。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**tonemapping**<br/>为启用色调映射的 HDR 视图绑定颜色源、视<br/>图参数和 LUT，执行全屏色调映射并写入后<br/>处理目标；模式关闭或管线尚未就绪时跳过。" }
  class n19 node_system
  n20@{ shape: rounded, label: "**late_downsample_depth**<br/>更新供下一帧早期遮挡测试使用的深度金字<br/>塔。" }
  class n20 node_system
  n21@{ shape: rounded, label: "**bloom**<br/>对 HDR 视图颜色执行 Bloom 降采样和上采<br/>样通道，将亮部扩散合成回视图；强度为零、<br/>非 HDR 或所需管线和参数缓冲未就绪时不执<br/>行。" }
  class n21 node_system
  n22@{ shape: rounded, label: "**motion_blur**<br/>读取当前视图颜色、预通道运动矢量和深度，<br/>按快门角度及采样数执行运动模糊；采样关<br/>闭、所需纹理或管线不可用时跳过。" }
  class n22 node_system
  n23@{ shape: rounded, label: "**fxaa**<br/>在 FXAA 开启且相机管线就绪时，读取当前<br/>视图颜色并执行全屏抗锯齿，写入下一后处理<br/>目标；复用与源纹理对应的绑定组。" }
  class n23 node_system
  n24@{ shape: rounded, label: "**smaa**<br/>按边缘检测、混合权重计算和邻域混合三个阶<br/>段执行 SMAA，将抗锯齿结果写入视图后处理<br/>目标；任何所需管线未就绪时跳过整个流程。" }
  class n24 node_system
  n25@{ shape: rounded, label: "**cas**<br/>绑定视图颜色和 CAS 参数，执行对比度自适<br/>应锐化并写入后处理目标；缓存对应参数缓冲<br/>与源纹理的绑定组，管线或参数不可用时跳<br/>过。" }
  class n25 node_system
  n26@{ shape: rounded, label: "**copy_deferred_lighting_id**<br/>把延迟光照通道标识复制到深度目标。" }
  class n26 node_system
  n27@{ shape: rounded, label: "**upscaling**<br/>把视图主颜色纹理通过 Blit 管线写入最终<br/>输出附件，遵循相机的输出模式、清屏颜色和<br/>视口；输出模式为 Skip 时不写入。" }
  class n27 node_system
  n28@{ shape: rounded, label: "**early_downsample_depth**<br/>生成供本帧晚期遮挡测试使用的深度金字塔。" }
  class n28 node_system
  n29@{ shape: rounded, label: "**msaa_writeback**<br/>在 MSAA 开启时把当前后处理颜色绘制回多<br/>采样主纹理，并解析到下一颜色目标，使后续<br/>通道继续使用一致的多采样附件；MSAA 关闭<br/>时跳过。" }
  class n29 node_system
  n30@{ shape: rounded, label: "**depth_of_field**<br/>以两阶段全屏通道执行景深模糊。" }
  class n30 node_system
  n31@{ shape: rounded, label: "**post_processing**<br/>为当前视图组合已启用的色差、暗角和镜头畸<br/>变效果，绑定各效果参数及颜色 LUT 后执行<br/>全屏后处理；没有效果或所需资产和管线未就<br/>绪时跳过。" }
  class n31 node_system
  n32@{ shape: rounded, label: "**volumetric_fog**<br/>逐个处理视图中的体积雾区域，结合场景深<br/>度、光照和可选密度纹理绘制雾光照；根据相<br/>机位于雾体内外选择平面或立方体网格。" }
  class n32 node_system
  n33@{ shape: rounded, label: "**per_view_shadow_pass#lt;false#gt;**<br/>绘制相机相关的平行光级联阴影。" }
  class n33 node_system
  n34@{ shape: rounded, label: "**per_view_shadow_pass#lt;true#gt;**<br/>绘制相机相关的平行光级联阴影。" }
  class n34 node_system
  n35@{ shape: rounded, label: "**egui_pass**<br/>来自Egui / Inspector ↗：读取当前<br/>Egui 视图已准备的绘制数据、纹理绑定及变<br/>换缓冲，在目标颜色附件上执行 Egui 绘制<br/>命令，并按相机视口设置渲染范围。" }
  class n35 node_system
  class n35 external_node
  n36@{ shape: rounded, label: "**ssao**<br/>依据视口尺寸依次调度深度预处理、屏幕空间<br/>环境光遮蔽及空间去噪计算通道，为当前视图<br/>生成 SSAO 结果；所需管线未完成编译时跳<br/>过。" }
  class n36 node_system
  n37@{ shape: rounded, label: "**allocate_uniforms**<br/>遍历当前视图及其阴影级联的各批次集合，<br/>在 GPU 上执行局部扫描、全局扫描和分配计<br/>算，确定 MeshUniform 的存储位置，避免<br/>CPU 每帧遍历全部可见网格。" }
  class n37 node_system
  n38@{ shape: rounded, label: "**unpack_bins**<br/>针对当前视图及其阴影级联的索引和非索引批<br/>次，在 GPU 上解包已缓存的分桶数据，生成<br/>后续网格预处理所需的任务列表。" }
  class n38 node_system
  n39@{ shape: rounded, label: "**early_gpu_preprocess**<br/>为当前视图及阴影级联执行早期网格转换与裁<br/>剪。" }
  class n39 node_system
  n40@{ shape: rounded, label: "**early_prepass_build_indirect_**<br/>**parameters**<br/>构建早期预通道使用的多重间接绘制参数。" }
  class n40 node_system
  n41@{ shape: rounded, label: "**late_gpu_preprocess**<br/>对后期遮挡工作项执行间接网格预处理。" }
  class n41 node_system
  n42@{ shape: rounded, label: "**late_prepass_build_indirect_**<br/>**parameters**<br/>为本帧新显露对象构建后期预通道间接参数。" }
  class n42 node_system
  n43@{ shape: rounded, label: "**main_build_indirect_parameters**<br/>为主不透明及透明通道构建间接绘制参数。" }
  class n43 node_system
  n44@{ shape: rounded, label: "**atmosphere_luts**<br/>根据当前大气、视图和光照参数调度计算管<br/>线，生成透射、多重散射、天空视图及空气透<br/>视查找表，供天空和大气渲染使用。" }
  class n44 node_system
  n45@{ shape: rounded, label: "**atmosphere_environment**<br/>使用当前视图的大气和光照参数，为每个大气<br/>环境贴图的六个立方体面调度计算着色器，更<br/>新环境光源纹理。" }
  class n45 node_system
  n46@{ shape: rounded, label: "**render_sky**<br/>绑定大气查找表及视图、光照参数，按相机视<br/>口和可选分辨率覆盖设置绘制全屏天空，将结<br/>果写入视图颜色附件。" }
  class n46 node_system
  n47@{ shape: rounded, label: "**extract_shaders**<br/>消费主世界 Shader 资产变更，合并全局<br/>shader 定义并更新或移除管线缓存中的着色<br/>器；全量重载时重新提交全部 Shader 并清<br/>空已覆盖的事件。" }
  class n47 node_system
  n48@{ shape: rounded, label: "**prepare_screenshots**<br/>为本帧窗口、图像或手工纹理视图的截图请求<br/>创建匹配尺寸和格式的截图资源，并替换相应<br/>输出附件以供捕获；未知目标被跳过。" }
  class n48 node_system
  n49@{ shape: rounded, label: "**queue_line_and_joint_gizmos_2d**<br/>将二维 Gizmo 线段与接头加入透明阶段。" }
  class n49 node_system
  n50@{ shape: rounded, label: "**queue_line_gizmos_3d**<br/>将三维 Gizmo 线列表和线条带加入透明阶<br/>段。" }
  class n50 node_system
  n51@{ shape: rounded, label: "**queue_line_joint_gizmos_3d**<br/>将三维 Gizmo 折线接头加入透明阶段。" }
  class n51 node_system
  n52@{ shape: rounded, label: "**queue_sprites**<br/>按相机可见性筛选已提取精灵，结合目标格<br/>式、MSAA、色调映射和合成空间选择精灵管<br/>线，并将绘制项加入对应透明二维阶段。" }
  class n52 node_system
  n53@{ shape: rounded, label: "**queue_uinodes**<br/>为提取的 UI 节点找到目标相机的透明 UI<br/>阶段，按目标格式与 UI 抗锯齿设置选择管<br/>线，并以节点堆叠顺序加入本帧绘制项。" }
  class n53 node_system
  n54@{ shape: rounded, label: "**queue_ui_slices**<br/>将 UI 图像切片排入对应相机透明阶段。" }
  class n54 node_system
  n55@{ shape: rounded, label: "**queue_gradient**<br/>将提取的背景和边框渐变加入目标相机的透<br/>明 UI 阶段，按颜色空间、目标格式及抗锯<br/>齿配置选择管线，并保留各自堆叠偏移。" }
  class n55 node_system
  n56@{ shape: rounded, label: "**queue_shadows**<br/>为提取的 UI 阴影选择匹配目标格式和阴影<br/>采样数的管线，按节点堆叠顺序及阴影层偏移<br/>加入透明 UI 绘制阶段。" }
  class n56 node_system
  n57@{ shape: rounded, label: "**queue_oit_resolve_pipeline**<br/>按 OIT 相机设置缓存透明解析管线。" }
  class n57 node_system
  n58@{ shape: rounded, label: "**queue_render_sky_pipelines**<br/>按多重采样和混合能力选择天空管线。" }
  class n58 node_system
  n59@{ shape: rounded, label: "**queue_bind_groups_system**<br/>来自Egui / Inspector ↗：建立 Egui 纹<br/>理与采样器绑定。" }
  class n59 node_system
  class n59 external_node
  n60@{ shape: rounded, label: "**queue_pipelines_system**<br/>来自Egui / Inspector ↗：按目标格式选<br/>择 Egui 渲染管线。" }
  class n60 node_system
  class n60 external_node
  n61@{ shape: rounded, label: "**prepare_mip_generator_pipelines**<br/>为本帧 mip 生成任务准备并复用 GPU 资<br/>源。" }
  class n61 node_system
  n62@{ shape: rounded, label: "**write_batched_instance_buffers#lt;bevy_**<br/>**pbr::render::mesh::MeshPipeline#gt;**<br/>上传实例输入、预处理任务并准备稀疏更新。" }
  class n62 node_system
  n63@{ shape: rounded, label: "**write_mesh_culling_data_buffer**<br/>上传网格裁剪数据并准备稀疏填充任务。" }
  class n63 node_system
  n64@{ shape: rounded, label: "**prepare_material_bind_groups**<br/>重建本帧变化材质所需的 GPU 绑定组。" }
  class n64 node_system
  n65@{ shape: rounded, label: "**prepare_skybox_bind_groups**<br/>为有效天空盒图像建立视图绑定组。" }
  class n65 node_system
  n66@{ shape: rounded, label: "**prepare_bloom_bind_groups**<br/>为 Bloom 各 mip 层准备降采样与升采样绑<br/>定。" }
  class n66 node_system
  n67@{ shape: rounded, label: "**prepare_depth_of_field_global_bind_**<br/>**group**<br/>把景深参数与采样器绑定为共享 GPU 输入。" }
  class n67 node_system
  n68@{ shape: rounded, label: "**prepare_smaa_bind_groups**<br/>为视图绑定 SMAA 中间纹理与查找表。" }
  class n68 node_system
  n69@{ shape: rounded, label: "**prepare_mesh2d_bind_group**<br/>按网格元数据分配块建立二维网格绑定组。" }
  class n69 node_system
  n70@{ shape: rounded, label: "**prepare_mesh2d_view_bind_groups**<br/>为二维相机绑定视图、全局参数与色调<br/>LUT。" }
  class n70 node_system
  n71@{ shape: rounded, label: "**prepare_sprite_image_bind_groups**<br/>合并连续同图像精灵并上传实例与索引数据。" }
  class n71 node_system
  n72@{ shape: rounded, label: "**prepare_sprite_view_bind_groups**<br/>为精灵视图绑定参数和色调映射 LUT。" }
  class n72 node_system
  n73@{ shape: rounded, label: "**prepare_uinodes**<br/>按透明 UI 阶段顺序生成裁剪后的节点顶点<br/>和索引，按图像合并绘制批次，维护视图及图<br/>像绑定组，并上传本帧 UI 几何数据。" }
  class n73 node_system
  n74@{ shape: rounded, label: "**prepare_ui_slices**<br/>为 UI 切片生成裁剪几何并合并图像批次。" }
  class n74 node_system
  n75@{ shape: rounded, label: "**prepare_gradient**<br/>将已排队的线性、径向和锥形渐变转换为<br/>GPU 顶点、索引与颜色停靠点数据，建立渐<br/>变绘制批次并上传相关缓冲。" }
  class n75 node_system
  n76@{ shape: rounded, label: "**prepare_shadows**<br/>为已排队的 UI 阴影生成经过裁剪的四边形<br/>顶点、索引和阴影参数，为每项记录对应相机<br/>及绘制区间，建立绑定组并上传本帧阴影几<br/>何。" }
  class n76 node_system
  n77@{ shape: rounded, label: "**prepare_mesh_bind_groups**<br/>按预处理路径准备网格、蒙皮和形变资源绑<br/>定。" }
  class n77 node_system
  n78@{ shape: rounded, label: "**prepare_mesh_view_bind_groups**<br/>为视图绑定光照、阴影及各可选渲染效果资<br/>源。" }
  class n78 node_system
  n79@{ shape: rounded, label: "**prepare_prepass_view_bind_group**<br/>绑定预通道的视图、全局和前帧缓冲。" }
  class n79 node_system
  n80@{ shape: rounded, label: "**prepare_line_gizmo_bind_group**<br/>为 Gizmo 绘制绑定已上传的线条参数。" }
  class n80 node_system
  n81@{ shape: rounded, label: "**prepare_oit_resolve_bind_group**<br/>为 OIT 解析阶段绑定视图和片元链表。" }
  class n81 node_system
  n82@{ shape: rounded, label: "**prepare_background_motion_vectors_**<br/>**bind_groups**<br/>为背景运动矢量绑定前后两帧视图参数。" }
  class n82 node_system
