flowchart LR
  accTitle: UiTextureSliceImageBindGroups · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**UiTextureSliceImageBindGroups**<br/>缓存 UI 纹理切片的图像绑定组。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**prepare_ui_slices**<br/>为 UI 切片生成裁剪几何并合并图像批次。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**init_gpu_resource#lt;bevy_ui_render::**<br/>**ui_texture_slice_pipeline::**<br/>**UiTextureSliceImageBindGroups#gt;**<br/>通过 FromWorld 构建指定的 GPU 资源，并<br/>将初始化结果插入当前世界。" }
  class n2 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@-->|"正文添加"| n0
  class e1 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
