---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: extract_core_2d_camera_phases · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**extract_core_2d_camera_phases**<br/>为活动二维相机准备渲染阶段并清理失效视<br/>图。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: cyl, label: "**ViewSortedRenderPhases#lt;Transparent2d**<br/>**#gt;**<br/>汇集各视图需要排序的绘制指令。" }
  class n2 node_resource
  n3@{ shape: cyl, label: "**ViewBinnedRenderPhases#lt;Opaque2d#gt;**<br/>汇集各视图按分桶组织的绘制指令。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**ViewBinnedRenderPhases#lt;AlphaMask2d#gt;**<br/>汇集各视图按分桶组织的绘制指令。" }
  class n4 node_resource
  n5@{ shape: rounded, label: "**Camera**<br/>配置相机视口、输出目标和渲染顺序。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Camera2d**<br/>标记使用二维渲染流程的相机。" }
  class n6 node_component
  n7@{ shape: notch-rect, label: "**HashSet#lt;RetainedViewEntity#gt;**<br/>记录本帧仍活动的二维相机渲染阶段。" }
  class n7 node_local
  n1 e0@-->|"RenderApp / ExtractSchedule"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_read
  n6 e5@-->|"存在 / 变更过滤"| n0
  class e5 edge_reference
  n0 e6@--> n7
  class e6 edge_write
  n1 layout_input_0@~~~ n5
  n5 layout_input_1@~~~ n6
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
