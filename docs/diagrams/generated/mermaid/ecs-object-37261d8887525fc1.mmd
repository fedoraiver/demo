---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: spawn_lighting · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**spawn_lighting**<br/>进入游戏会话时创建日光场景和加载相机，配<br/>置默认 UI、主 Egui 上下文及退出清理；资<br/>源就绪后继续复用同一相机实体。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · Startup**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: rounded, label: "**Camera3d**<br/>来自Bevy 引擎 ↗：标记三维场景相机。" }
  class n2 node_component
  class n2 external_node
  n3@{ shape: rounded, label: "**IsDefaultUiCamera**<br/>来自Bevy 引擎 ↗：指定菜单界面的默认绘<br/>制相机。" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: rounded, label: "**PrimaryEguiContext**<br/>来自Egui / Inspector ↗：指定主检查器<br/>界面的相机上下文。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**DespawnOnEnter**<br/>来自Bevy 引擎 ↗：返回主菜单时清理当前<br/>会话根。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: rounded, label: "**LoadingCamera**<br/>加载期间相机身份，准备后移除。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存第一人称镜头的显<br/>示姿态。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: fr-rect, label: "**SceneAssemblyPlugin**<br/>加载运行资源并装配海岛、碰撞与业务实体。" }
  class n8 node_plugin
  n1 e0@-->|"main / Startup"| n0
  class e0 edge_registration
  n0 e1@-->|"添加"| n2
  class e1 edge_write
  n0 e2@-->|"添加"| n3
  class e2 edge_write
  n0 e3@-->|"添加"| n4
  class e3 edge_write
  n0 e4@-->|"添加"| n5
  class e4 edge_write
  n0 e5@-->|"添加"| n6
  class e5 edge_write
  n0 e6@-->|"添加"| n7
  class e6 edge_write
  n8 e7@--> n0
  class e7 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
