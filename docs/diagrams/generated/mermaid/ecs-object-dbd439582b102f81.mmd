---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-dbd439582b102f81-e1{marker-start:url(#object-dbd439582b102f81_flowchart-v2-pointStart)!important}\n#object-dbd439582b102f81-e2{marker-start:url(#object-dbd439582b102f81_flowchart-v2-pointStart)!important}\n#object-dbd439582b102f81-e5{marker-start:url(#object-dbd439582b102f81_flowchart-v2-pointStart)!important}\n#object-dbd439582b102f81-e10{marker-start:url(#object-dbd439582b102f81_flowchart-v2-pointStart)!important}\n#object-dbd439582b102f81_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
