flowchart LR
  accTitle: motion_blur::MotionBlurUniform · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**MotionBlurUniform**<br/>向运动模糊着色器传递快门角度和采样数。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**extract​_​components**<br/>来自crate:bevy​_​extract ↗：批量同步或<br/>移除子世界的目标组件。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**prepare​_​view​_​depth​_​texture​_​usages​_​**<br/>**for​_​motion​_​blur**<br/>让运动模糊相机的深度纹理可被采样。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare​_​motion​_​blur​_​pipelines**<br/>按颜色格式与采样数准备运动模糊管线。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**motion​_​blur**<br/>读取当前视图颜色、预通道运动矢量和深度，<br/>按快门角度及采样数执行运动模糊；采样关<br/>闭、所需纹理或管线不可用时跳过。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**prepare​_​uniform​_​components**<br/>来自crate:bevy​_​render ↗：将组件值批量<br/>上传为动态着色器参数。" }
  class n5 node_system
  class n5 external_node
  n1 e0@-->|"移除"| n0
  class e0 edge_write
  n0 e1@-->|"存在性约束"| n2
  class e1 edge_reference
  n0 e2@-->|"存在性约束"| n3
  class e2 edge_reference
  n0 e3@--> n4
  class e3 edge_read
  n0 e4@--> n5
  class e4 edge_read
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
