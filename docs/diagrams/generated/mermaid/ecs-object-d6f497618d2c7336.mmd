{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: sprite_picking · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**sprite_picking**<br/>将可见、变换有效的精灵按深度排序，结合指<br/>针射线、相机、精灵图像和拾取配置计算命<br/>中，并向拾取后端发布 PointerHits。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PreUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**PickingSystems::Backend**<br/>通过拾取后端生成指针命中。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**PointerId**<br/>以鼠标、触摸编号或自定义 UUID 提供稳定<br/>指针身份" }
  class n3 node_component
  n4@{ shape: rounded, label: "**PointerLocation**<br/>保存指针当前目标及该目标上的位置" }
  class n4 node_component
  n5@{ shape: rounded, label: "**Camera**<br/>配置相机视口、输出目标和渲染顺序。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**RenderTarget**<br/>指定相机输出的窗口、图像或纹理。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**GlobalTransform**<br/>保存实体合并祖先变换后的世界空间仿射变换" }
  class n7 node_component
  n8@{ shape: rounded, label: "**Projection**<br/>定义相机从视图到裁剪空间的投影。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**SpritePickingCamera**<br/>在精灵拾取启用标记限制时" }
  class n9 node_component
  n10@{ shape: rounded, label: "**RenderLayers**<br/>限定相机与实体可相交的渲染层。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**PrimaryWindow**<br/>标识唯一的主窗口" }
  class n11 node_component
  n12@{ shape: cyl, label: "**Assets#lt;Image#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n12 node_resource
  n13@{ shape: cyl, label: "**Assets#lt;TextureAtlasLayout#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n13 node_resource
  n14@{ shape: cyl, label: "**SpritePickingSettings**<br/>配置精灵拾取是否要求相机标记" }
  class n14 node_resource
  n15@{ shape: rounded, label: "**Sprite**<br/>描述二维精灵的图像、图集、颜色、翻转、尺<br/>寸和裁剪区域" }
  class n15 node_component
  n16@{ shape: rounded, label: "**Anchor**<br/>保存二维可渲染实体相对自身尺寸的归一化锚<br/>点偏移" }
  class n16 node_component
  n17@{ shape: rounded, label: "**Pickable**<br/>配置实体是否可被拾取及是否阻挡深度更低的<br/>命中目标" }
  class n17 node_component
  n18@{ shape: rounded, label: "**ViewVisibility**<br/>记录实体是否应被提取用于渲染。" }
  class n18 node_component
  n19@{ shape: cyl, label: "**Messages#lt;PointerHits#gt;**<br/>保存 PointerHits 消息。" }
  class n19 node_message_buffer
  n20@{ shape: cyl, label: "**RayMap**<br/>按指针和相机组合保存拾取射线" }
