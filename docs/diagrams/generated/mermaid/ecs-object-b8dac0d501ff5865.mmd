flowchart LR
  accTitle: demo::first_person::suspend_controls · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**suspend​_​controls**<br/>停用玩法输入并释放光标。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**CursorOptions**<br/>来自crate:bevy​_​window ↗：保存窗口光标<br/>的可见、捕获和命中测试等选项" }
  class n1 node_component
  class n1 external_node
  n2@{ shape: rounded, label: "**MouseLookState**<br/>每个相机的捕获状态；恢复捕获的第一帧跳过<br/>自由光标位移。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**GameplayContext**<br/>控制者的步行输入上下文；角色实体不直接持<br/>有设备绑定。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**ContextActivity#lt;GameplayContext#gt;**<br/>来自crate:bevy​_​enhanced​_​input ↗：控<br/>制保留绑定的输入上下文启停。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: fr-rect, label: "**FirstPersonPlugin**<br/>注册第一人称动作、捕获、朝向与镜头，不安<br/>装输入基础设施或物理插件。" }
  class n5 node_plugin
