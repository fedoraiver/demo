---
flowchart LR
  accTitle: dynamics::solver::constraint_graph::ConstraintGraph · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**ConstraintGraph**<br/>为并行接触求解维护约束着色图。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**warm​_​start**<br/>用历史接触冲量初始化本轮约束求解。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**solve​_​contacts**<br/>迭代接触冲量以处理穿透与相对速度。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**store​_​contact​_​impulses**<br/>保存已求得的接触冲量供下一轮热启动。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**solve​_​contacts**<br/>迭代接触冲量以处理穿透与相对速度。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**solve​_​restitution**<br/>对接触刚体施加碰撞恢复冲量。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**apply​_​contact​_​status​_​changes**<br/>把接触增删同步到约束图和物理岛。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**prepare​_​contact​_​constraints**<br/>从有效接触流形生成本轮求解约束。" }
  class n7 node_system
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
