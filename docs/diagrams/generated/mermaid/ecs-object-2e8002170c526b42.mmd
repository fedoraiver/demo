---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Source · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Source**<br/>声明 Egui 纹理资源提取所使用的源类型" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**extract_resource#lt;bevy_egui::render::**<br/>**systems::**<br/>**ExtractedEguiManagedTextures, bevy_**<br/>**render::RenderApp, ()#gt;**<br/>来自Bevy 引擎 ↗：读取主世界中的可选源<br/>资源，经 ExtractResource 转换后更新子<br/>世界目标资源；源值变化时替换现有目标，目<br/>标不存在时通过 Commands 插入。" }
  class n1 node_system
  class n1 external_node
  n0 e0@--> n1
  class e0 edge_read
