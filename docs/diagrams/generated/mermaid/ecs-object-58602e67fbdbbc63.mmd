{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-58602e67fbdbbc63-e6{marker-start:url(#object-58602e67fbdbbc63_flowchart-v2-pointStart)!important}\n#object-58602e67fbdbbc63-e15{marker-start:url(#object-58602e67fbdbbc63_flowchart-v2-pointStart)!important}\n#object-58602e67fbdbbc63-e23{marker-start:url(#object-58602e67fbdbbc63_flowchart-v2-pointStart)!important}\n#object-58602e67fbdbbc63-e25{marker-start:url(#object-58602e67fbdbbc63_flowchart-v2-pointStart)!important}\n#object-58602e67fbdbbc63_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
