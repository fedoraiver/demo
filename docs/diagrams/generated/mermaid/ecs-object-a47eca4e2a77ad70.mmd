---
flowchart LR
  accTitle: TransformEasingSystems::UpdateStart · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**TransformEasingSystems::UpdateStart**<br/>记录当前固定步的插值起点。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**ApplyDeferred · 恢复插值**<br/>来自越界恢复 ↗：使插值暂停清理在新固定<br/>步采样前可见。" }
  class n1 node_sync
  class n1 external_node
  n2@{ shape: stadium, label: "**main · FixedFirst**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n2 node_engine_flow
  class n2 external_node
  n3@{ shape: rounded, label: "**update_translation_interpolation_**<br/>**start**<br/>把当前位置记录为插值起点。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**update_rotation_interpolation_start**<br/>把当前旋转记录为插值起点。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update_scale_interpolation_start**<br/>把当前缩放记录为插值起点。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**resume_carry_easing**<br/>来自物品交互 ↗：恢复物品释放前未暂停的<br/>插值通道。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**resume_interpolation**<br/>来自越界恢复 ↗：撤销落水恢复添加的临时<br/>插值暂停。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存自由运动或共享持<br/>握时的显示姿态。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: rounded, label: "**TranslationEasingState**<br/>保存固定步平移插值的起止端点。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**TranslationEasingState**<br/>保存固定步平移插值的起止端点。" }
  class n11 node_component
  n12@{ shape: rounded, label: "**RotationEasingState**<br/>保存旋转显示插值的起止端点。" }
  class n12 node_component
  n1 e0@--> n0
  class e0 edge_order
  n2 e1@-->|"main / FixedFirst"| n0
  class e1 edge_registration
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_set_membership
  n0 e4@--> n5
  class e4 edge_set_membership
  n6 e5@--> n0
  class e5 edge_order
  n7 e6@--> n0
  class e6 edge_order
  n8 e7@-->|"查询访问"| n0
  class e7 edge_read
  n9 e8@-->|"查询访问"| n0
  class e8 edge_read
  n0 e9@-->|"可变访问"| n10
  class e9 edge_write
  n0 e10@-->|"可变访问"| n11
  class e10 edge_write
  n0 e11@-->|"可变访问"| n12
  class e11 edge_write
