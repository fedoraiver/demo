---
flowchart LR
  accTitle: propagate_collider_transforms · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**propagate_collider_transforms**<br/>沿实体层级计算碰撞体相对刚体的变换。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · FixedPostUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**TransformSystems::Propagate**<br/>来自Bevy 引擎 ↗：沿实体层级传播世界变<br/>换。" }
  class n2 node_system_set
  class n2 external_node
  n3@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存实体相对父实体的<br/>平移、旋转和缩放" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: rounded, label: "**Children**<br/>来自Bevy 引擎 ↗：保存以 ChildOf 指向<br/>当前父实体的子实体集合" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**ChildOf**<br/>来自Bevy 引擎 ↗：保存当前实体的父实体<br/>身份" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: rounded, label: "**AncestorMarker#lt;ColliderMarker#gt;**<br/>标记含指定组件的实体祖先。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**ColliderTransform**<br/>缓存碰撞体相对于刚体的变换。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**RigidBody**<br/>选择动态、静态或运动学刚体行为。" }
  class n8 node_component
  n1 e0@-->|"main / FixedPostUpdate"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n3 e2@--> n0
  class e2 edge_read
  n4 e3@--> n0
  class e3 edge_read
  n5 e4@-->|"存在 / 变更过滤"| n0
  class e4 edge_reference
  n6 e5@-->|"存在 / 变更过滤"| n0
  class e5 edge_reference
  n0 e6@--> n7
  class e6 edge_write
  n8 e7@-->|"存在 / 变更过滤"| n0
  class e7 edge_reference
  n5 e8@--> n0
  class e8 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
