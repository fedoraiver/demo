---
flowchart LR
  accTitle: MotionBlurUniform · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**MotionBlurUniform**<br/>向运动模糊着色器传递快门角度和采样数。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**motion_blur**<br/>读取当前视图颜色、预通道运动矢量和深度，<br/>按快门角度及采样数执行运动模糊；采样关<br/>闭、所需纹理或管线不可用时跳过。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**extract_components#lt;bevy_post_**<br/>**process::motion_blur::MotionBlur,**<br/>**bevy_render::RenderApp, ()#gt;**<br/>对已同步到子世界的实体读取<br/>ExtractComponent 指定的查询数据，批量<br/>写入转换后的目标组件；转换返回 None 时<br/>移除对应目标组件。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare_view_depth_texture_usages_**<br/>**for_motion_blur**<br/>让运动模糊相机的深度纹理可被采样。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**prepare_uniform_components#lt;bevy_**<br/>**post_process::motion_blur::**<br/>**MotionBlurUniform#gt;**<br/>将组件值批量上传为动态着色器参数。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**prepare_motion_blur_pipelines**<br/>按颜色格式与采样数准备运动模糊管线。" }
  class n5 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"延迟移除"| n0
  class e1 edge_write
  n2 e2@-->|"延迟添加"| n0
  class e2 edge_write
  n0 e3@-->|"存在 / 变更过滤"| n3
  class e3 edge_reference
  n0 e4@--> n4
  class e4 edge_read
  n0 e5@-->|"存在 / 变更过滤"| n5
  class e5 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
