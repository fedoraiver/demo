---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: cluster_on_gpu · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**cluster_on_gpu**<br/>执行深度切片、计数、分配和填充的 GPU 聚<br/>簇。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · Core3d**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**Core3dSystems::Prepass**<br/>在三维主绘制前执行深度及延迟预通道。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**early_prepass**<br/>从当前视图取得深度、预通道纹理及前后帧参<br/>数，调用共享预通道实现绘制不透明和<br/>AlphaMask 预通道阶段，供后续深度、法线<br/>及运动矢量相关处理使用。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**ViewGpuClusteringBuffers**<br/>保存单个视图的 GPU 聚簇工作缓冲。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**ViewGpuClusteringPipelineIds**<br/>记录视图 GPU 聚簇各阶段的管线。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**ViewClusteringDummyTexture**<br/>为聚簇光栅化提供可设置视口的附件。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**ViewClusteringBindGroups**<br/>保存视图各 GPU 聚簇通道的绑定组。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**ViewLightProbesUniformOffset**<br/>定位相机在光照探针缓冲中的参数。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**ViewLightsUniformOffset**<br/>定位视图在光照 Uniform 缓冲中的参数。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**ViewUniformOffset**<br/>定位当前视图在共享 Uniform 缓冲中的参<br/>数。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**ExtractedClusterConfig**<br/>保存视图聚簇的深度范围与网格划分。" }
  class n11 node_component
  n12@{ shape: cyl, label: "**PipelineCache**<br/>缓存 GPU 渲染、计算管线与待创建队列。" }
  class n12 node_resource
  n13@{ shape: cyl, label: "**GpuClusteringMeshBuffers**<br/>提供聚簇深度切片的四边形几何。" }
  class n13 node_resource
  n14@{ shape: cyl, label: "**RenderViewClusteringReadbackData**<br/>管理各视图的 GPU 聚簇统计回读。" }
  class n14 node_resource
  n15@{ shape: notch-rect, label: "**RenderContext**<br/>向渲染系统提供命令编码器和 GPU 设备。" }
  class n15 node_system_param
