---
flowchart LR
  accTitle: audio::playback::SoundBank · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**SoundBank**<br/>短音的句柄生命周期与播放状态集中维护；只<br/>保留每种事件最后一次获准的播放时间。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**sync​_​voice​_​volumes**<br/>将有效混音与素材音量同步到播放实例。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**preload​_​sounds**<br/>预加载界面与音效短音并保存播放策略。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**play​_​requests**<br/>按有效音量与播放策略处理短音请求。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**sync​_​voice​_​volumes**<br/>将有效混音与素材音量同步到播放实例。" }
  class n4 node_system
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n2 e1@-->|"可变访问"| n0
  class e1 edge_write
  n3 e2@-->|"可变访问"| n0
  class e2 edge_write
  n4 e3@-->|"可变访问"| n0
  class e3 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
