---
flowchart LR
  accTitle: demo::ui::navigation::LeftAction · 对象关系
  accDescr: 实体创建模板与直接关联的非组件对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**demo::ui::navigation::LeftAction**<br/>把向左导航输入转成聚焦设置项的减少请求。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**Menu input controller**<br/>统一路由菜单键盘与手柄操作。" }
  class n1 node_entity
  n2@{ shape: rounded, label: "**Decrease menu value keyboard binding**<br/>把设备输入接到聚焦设置项的减少操作。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**Decrease menu value gamepad binding**<br/>把设备输入接到聚焦设置项的减少操作。" }
  class n3 node_entity
  n1 e0@-->|"子实体"| n0
  class e0 edge_relationship
  n0 e1@-->|"子实体"| n2
  class e1 edge_relationship
  n0 e2@-->|"子实体"| n3
  class e2 edge_relationship
  e1@{ curve: basis }
  e2@{ curve: basis }
