  n36@{ shape: rounded, label: "**write_batched_instance_buffer#lt;bevy_**<br/>**sprite_render::mesh2d::mesh::**<br/>**Mesh2dPipeline#gt;**<br/>上传 CPU 已合批的实例参数缓冲。" }
  class n36 node_system
