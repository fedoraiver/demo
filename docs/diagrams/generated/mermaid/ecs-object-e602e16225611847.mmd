  class n37 node_system
  n38@{ shape: rounded, label: "**write_batched_instance_buffers#lt;bevy_**<br/>**pbr::render::mesh::MeshPipeline#gt;**<br/>上传实例输入、预处理任务并准备稀疏更新。" }
  class n38 node_system
  n39@{ shape: rounded, label: "**write_mesh_culling_data_buffer**<br/>上传网格裁剪数据并准备稀疏填充任务。" }
