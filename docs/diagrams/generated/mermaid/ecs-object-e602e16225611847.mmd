  n40@{ shape: rounded, label: "**write_material_bind_group_buffers**<br/>上传材质分配器管理的无绑定缓冲内容。" }
  class n40 node_system
  n41@{ shape: rounded, label: "**prepare_sprite_image_bind_groups**<br/>合并连续同图像精灵并上传实例与索引数据。" }
  class n41 node_system
  n42@{ shape: rounded, label: "**prepare_uinodes**<br/>按透明 UI 阶段顺序生成裁剪后的节点顶点<br/>和索引，按图像合并绘制批次，维护视图及图<br/>像绑定组，并上传本帧 UI 几何数据。" }
  class n42 node_system
  n43@{ shape: rounded, label: "**prepare_ui_slices**<br/>为 UI 切片生成裁剪几何并合并图像批次。" }
  class n43 node_system
  n44@{ shape: rounded, label: "**prepare_gradient**<br/>将已排队的线性、径向和锥形渐变转换为<br/>GPU 顶点、索引与颜色停靠点数据，建立渐<br/>变绘制批次并上传相关缓冲。" }
  class n44 node_system
  n45@{ shape: rounded, label: "**prepare_shadows**<br/>为已排队的 UI 阴影生成经过裁剪的四边形<br/>顶点、索引和阴影参数，为每项记录对应相机<br/>及绘制区间，建立绑定组并上传本帧阴影几<br/>何。" }
  class n45 node_system
  n46@{ shape: rounded, label: "**prepare_generated_environment_map_**<br/>**bind_groups**<br/>为环境图各 mip 的降采样和卷积建立绑定。" }
  class n46 node_system
  n47@{ shape: rounded, label: "**prepare_post_processing_uniforms**<br/>收集并上传逐视图色差、暗角和畸变参数。" }
  class n47 node_system
  n48@{ shape: rounded, label: "**prepare_volumetric_fog_uniforms**<br/>把各视图和雾体积组合转换为体积雾<br/>Uniform。" }
  class n48 node_system
  n49@{ shape: rounded, label: "**prepare_egui_transforms_system**<br/>来自Egui / Inspector ↗：上传 Egui 屏<br/>幕变换缓冲。" }
  class n49 node_system
  class n49 external_node
  n50@{ shape: rounded, label: "**prepare_egui_render_target_data_**<br/>**system**<br/>来自Egui / Inspector ↗：准备 Egui 顶<br/>点索引和裁剪绘制命令。" }
  class n50 node_system
  class n50 external_node
  n51@{ shape: rounded, label: "**render_system**<br/>运行根 RenderGraph 调度，提交截图及<br/>GPU 回读收尾命令，并呈现需要输出的窗口<br/>交换链；随后收集截图结果。" }
  class n51 node_system
  n52@{ shape: rounded, label: "**allocate_and_free_meshes**<br/>为新增变化网格分配 GPU 存储并释放旧分<br/>配。" }
  class n52 node_system
  n53@{ shape: rounded, label: "**prepare_clusters_for_gpu_clustering**<br/>按视图规模和回读容量分配 GPU 聚簇缓冲。" }
  class n53 node_system
  n54@{ shape: rounded, label: "**upload_view_gpu_clustering_buffers**<br/>上传聚簇深度切片、元数据和计数暂存。" }
  class n54 node_system
  n55@{ shape: rounded, label: "**submit_pending_command_buffers**<br/>将排队完成的渲染命令缓冲提交到 GPU。" }
  class n55 node_system
