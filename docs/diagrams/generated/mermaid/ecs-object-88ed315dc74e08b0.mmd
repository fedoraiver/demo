---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-88ed315dc74e08b0-e2{marker-start:url(#object-88ed315dc74e08b0_flowchart-v2-pointStart)!important}\n#object-88ed315dc74e08b0_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Hovered · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Hovered**<br/>保存按钮或其子树是否被悬停。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update_is_hovered**<br/>按鼠标HoverMap及祖先关系替换已<br/>有Hovered值。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**可操作菜单按钮**<br/>来自菜单与界面 ↗：承载可操作菜单动作、<br/>设置调整与连续导航。" }
  class n2 node_entity
  class n2 external_node
  n3@{ shape: rounded, label: "**style_buttons**<br/>来自菜单与界面 ↗：按当前输入来源更新按<br/>钮背景与焦点边框。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**pointer_interaction**<br/>来自菜单与界面 ↗：将真实鼠标交互转换为<br/>共享菜单请求。" }
  class n4 node_system
  class n4 external_node
  n1 e0@-->|"添加"| n0
  class e0 edge_write
  n0 e1@-->|"可能挂载于"| n2
  class e1 edge_reference
  n1 e2@---|"查询访问"| n0
  class e2 edge_read
  n0 e3@-->|"查询访问"| n3
  class e3 edge_read
  n0 e4@-->|"查询访问"| n4
  class e4 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
