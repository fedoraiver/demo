---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-b09219b986444bde-e9{marker-start:url(#object-b09219b986444bde_flowchart-v2-pointStart)!important}\n#object-b09219b986444bde_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: AccessibilityNode · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**AccessibilityNode**<br/>把实体转换为 AccessKit 可访问性节点" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update_accessibility_nodes**<br/>把变化的可访问性节点同步给原生适配器。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**button_changed**<br/>Button 改变时从 UI 子节点提取文本标<br/>签，更新已有 AccessibilityNode 的按钮<br/>角色和标签，或通过命令补入对应无障碍节<br/>点。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**image_changed**<br/>非按钮 ImageNode 改变时从 UI 子节点提<br/>取说明，设置无障碍图像角色和标签；尚无<br/>AccessibilityNode 时排入创建命令。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**label_changed**<br/>Label 改变时收集其文本元素，把拼接后的<br/>内容写为无障碍标签节点的值；已有节点原位<br/>更新，缺少节点时排入创建命令。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**sync_bounds_and_transforms**<br/>把 UI 几何同步到无障碍树。" }
  class n5 node_system
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@-->|"存在 / 变更过滤"| n1
  class e1 edge_reference
  n2 e2@--> n0
  class e2 edge_write
  n2 e3@-->|"延迟添加"| n0
  class e3 edge_write
  n3 e4@--> n0
  class e4 edge_write
  n3 e5@-->|"延迟添加"| n0
  class e5 edge_write
  n4 e6@--> n0
  class e6 edge_write
  n4 e7@-->|"延迟添加"| n0
  class e7 edge_write
  n5 e8@--> n0
  class e8 edge_write
  n5 e9@---|"存在 / 变更过滤"| n0
  class e9 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
