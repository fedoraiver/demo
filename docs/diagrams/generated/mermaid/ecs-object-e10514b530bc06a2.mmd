  class e5 edge_read
  n0 e6@--> n7
  class e6 edge_read
  n0 e7@--> n8
  class e7 edge_read
  n0 e8@--> n9
  class e8 edge_read
  n0 e9@--> n10
  class e9 edge_read
  n0 e10@--> n11
  class e10 edge_read
  n0 e11@--> n12
  class e11 edge_read
  n0 e12@--> n13
  class e12 edge_read
  n0 e13@--> n14
  class e13 edge_read
