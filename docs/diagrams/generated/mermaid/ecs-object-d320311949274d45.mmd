  class n4 node_system
  n5@{ shape: rounded, label: "**draw​_​lights**<br/>为显式标记的各类光源绘制调试轮廓。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**check​_​dir​_​light​_​mesh​_​visibility**<br/>计算方向光各相机级联可见的投影网格。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**Greybox daylight**<br/>来自scene​_​assembly ↗：照亮灰盒地面与<br/>方块。" }
