  class n4 external_node
  n5@{ shape: rounded, label: "**Scrollbar**<br/>来自crate:bevy​_​ui​_​widgets ↗：指定滚<br/>动条目标、方向和最小滑块长度。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: fr-rect, label: "**GameUiPlugin**<br/>组装菜单功能，不安装窗口或重复初始化会话<br/>日志。" }
