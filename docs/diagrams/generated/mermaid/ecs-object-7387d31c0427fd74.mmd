---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: NoTranslationEasing · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**NoTranslationEasing**<br/>显式禁止当前实体的平移插值和外推" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update_translation_interpolation_**<br/>**start**<br/>把当前位置记录为插值起点。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**complete_translation_easing**<br/>在新一轮插值前完成上一段平移。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**reset_translation_extrapolation**<br/>在固定步开始前还原真实位置。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**resume_carry_easing**<br/>来自物品交互 ↗：恢复物品释放前未暂停的<br/>插值通道。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**resume_interpolation**<br/>来自越界恢复 ↗：撤销落水恢复添加的临时<br/>插值暂停。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**update_translation_interpolation_end**<br/>把当前位置记录为插值终点。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**update_translation_extrapolation_**<br/>**states#lt;avian3d::interpolation::**<br/>**LinVelSource#gt;**<br/>依据当前线速度预测下一个位置端点。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**ease_translation_hermite#lt;avian3d::**<br/>**interpolation::LinVelSource#gt;**<br/>用两端线速度做 Hermite 位置平滑。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**ease_translation_lerp**<br/>按固定步剩余比例线性插值显示位置。" }
  class n11 node_system
  n0 e0@-->|"存在 / 变更过滤"| n1
  class e0 edge_reference
  n0 e1@-->|"存在 / 变更过滤"| n2
  class e1 edge_reference
  n0 e2@-->|"存在 / 变更过滤"| n3
  class e2 edge_reference
  n4 e3@-->|"延迟移除"| n0
  class e3 edge_write
  n5 e4@-->|"延迟移除"| n0
  class e4 edge_write
  n0 e5@-->|"存在 / 变更过滤"| n6
  class e5 edge_reference
  n0 e6@-->|"存在 / 变更过滤"| n7
  class e6 edge_reference
  n8 e7@-->|"延迟添加"| n0
  class e7 edge_write
  n9 e8@-->|"延迟添加"| n0
  class e8 edge_write
  n0 e9@-->|"存在 / 变更过滤"| n10
  class e9 edge_reference
  n0 e10@-->|"存在 / 变更过滤"| n11
  class e10 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
