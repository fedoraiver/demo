---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: gilrs_event_system · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**gilrs_event_system**<br/>把 gilrs 原始手柄事件转换为 Bevy 消<br/>息。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PreUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**InputSystems**<br/>汇总键盘与鼠标输入状态。" }
  class n2 node_system_set
  n3@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n3 node_system_param
  n4@{ shape: cyl, label: "**Gilrs**<br/>持有 gilrs 手柄后端实例" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**GilrsGamepads**<br/>维护已连接 gilrs 手柄编号与 Bevy 手柄<br/>实体的双向映射" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**Messages#lt;RawGamepadEvent#gt;**<br/>保存 RawGamepadEvent 消息。" }
  class n6 node_message_buffer
  n7@{ shape: cyl, label: "**Messages#lt;GamepadConnectionEvent#gt;**<br/>保存 GamepadConnectionEvent 消息。" }
  class n7 node_message_buffer
  n8@{ shape: cyl, label: "**Messages#lt;RawGamepadButtonChangedEven**<br/>**t#gt;**<br/>保存 RawGamepadButtonChangedEvent 消<br/>息。" }
  class n8 node_message_buffer
  n9@{ shape: cyl, label: "**Messages#lt;RawGamepadAxisChangedEvent#gt;**<br/>保存 RawGamepadAxisChangedEvent 消<br/>息。" }
  class n9 node_message_buffer
  n10@{ shape: cyl, label: "**Messages#lt;Messages#lt;RawGamepadEvent#gt;#gt;**<br/>保存 Messages#lt;RawGamepadEvent#gt; 消息。" }
  class n10 node_message_buffer
  n11@{ shape: cyl, label: "**Messages#lt;Messages#lt;GamepadConnectionE**<br/>**vent#gt;#gt;**<br/>保存<br/>Messages#lt;GamepadConnectionEvent#gt; 消<br/>息。" }
  class n11 node_message_buffer
  n12@{ shape: cyl, label: "**Messages#lt;Messages#lt;RawGamepadButtonCh**<br/>**angedEvent#gt;#gt;**<br/>保存<br/>Messages#lt;RawGamepadButtonChangedEven<br/>t#gt; 消息。" }
  class n12 node_message_buffer
  n13@{ shape: cyl, label: "**Messages#lt;Messages#lt;RawGamepadAxisChan**<br/>**gedEvent#gt;#gt;**<br/>保存<br/>Messages#lt;RawGamepadAxisChangedEvent#gt;<br/>消息。" }
  class n13 node_message_buffer
