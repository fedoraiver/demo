---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: GizmoHandles · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**GizmoHandles**<br/>按配置组记录当前调试图元资产句柄。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**update_gizmo_meshes#lt;bevy_light::**<br/>**gizmos::LightGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update_gizmo_meshes#lt;bevy_gizmos::**<br/>**config::DefaultGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update_gizmo_meshes#lt;bevy_gizmos::**<br/>**aabb::AabbGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**update_gizmo_meshes#lt;bevy_gizmos::**<br/>**frustum::FrustumGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update_gizmo_meshes#lt;bevy_gizmos::**<br/>**skinned_mesh_bounds::**<br/>**SkinnedMeshBoundsGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**extract_gizmo_data**<br/>把启用的即时 Gizmo 数据提取为渲染实体。" }
  class n6 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_write
  n0 e5@--> n6
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
