---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-eae05d7e518f057d-e6{marker-start:url(#object-eae05d7e518f057d_flowchart-v2-pointStart)!important}\n#object-eae05d7e518f057d_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Projection · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Projection**<br/>定义相机从视图到裁剪空间的投影。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**camera_system**<br/>响应窗口创建、尺寸与缩放变化及图像目标变<br/>化，更新 Camera 与 Projection 的目标<br/>尺寸和投影信息；只读取相机实际引用的图像<br/>目标。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**camera_system**<br/>响应窗口创建、尺寸与缩放变化及图像目标变<br/>化，更新 Camera 与 Projection 的目标<br/>尺寸和投影信息；只读取相机实际引用的图像<br/>目标。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update_frusta**<br/>相机 GlobalTransform 或 Projection<br/>改变时，根据投影和世界变换重新计算<br/>Frustum，供后续可见性裁剪使用。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**build_directional_light_cascades**<br/>为投射阴影的方向光构建逐相机级联。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**sprite_picking**<br/>将可见、变换有效的精灵按深度排序，结合指<br/>针射线、相机、精灵图像和拾取配置计算命<br/>中，并向拾取后端发布 PointerHits。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**extract_cameras**<br/>把主世界活动相机的目标、视口、变换、可见<br/>实体和渲染设置提取到渲染实体，并维护视图<br/>所需格式；对停用或目标尺寸无效的相机移除<br/>失效提取状态。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**extract_depth_of_field_settings**<br/>把透视相机景深设置转换为 GPU 参数。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**check_views_need_specialization**<br/>汇总视图渲染特性并检测管线配置变化。" }
  class n8 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@-->|"存在 / 变更过滤"| n3
  class e3 edge_reference
  n0 e4@--> n4
  class e4 edge_read
  n0 e5@--> n5
  class e5 edge_read
  n6 e6@--- n0
  class e6 edge_read
  n6 e7@-->|"延迟移除"| n0
  class e7 edge_write
  n6 e8@-->|"延迟添加"| n0
  class e8 edge_write
  n0 e9@--> n7
  class e9 edge_read
  n0 e10@--> n8
  class e10 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
