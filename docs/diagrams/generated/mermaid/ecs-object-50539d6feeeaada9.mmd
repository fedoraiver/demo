---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: AnonymousSet(0) · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**AnonymousSet(0)**<br/>保存本组系统共同的运行条件。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**main · PhysicsSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**update_sleeping_states**<br/>来自Avian ↗：按刚体静止时间判断物理岛<br/>的休眠资格。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**wake_islands_with_sleeping_disabled**<br/>来自Avian ↗：让禁止休眠或已禁用的刚体<br/>所属岛保持清醒。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**wake_on_changed**<br/>来自Avian ↗：因外部位姿、速度或受力变<br/>化标记物理岛唤醒。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**wake_all_islands**<br/>来自Avian ↗：批量请求唤醒当前全部休眠<br/>物理岛。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**sleep_islands**<br/>来自Avian ↗：依据活跃岛位图和待拆分状<br/>态收集需要休眠或唤醒的物理岛，通过<br/>World 命令应用状态变化，并同步岛内刚体<br/>的休眠状态。" }
  class n6 node_system
  class n6 external_node
  n1 e0@-->|"main / PhysicsSchedule"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_set_membership
  n0 e4@--> n5
  class e4 edge_set_membership
  n0 e5@--> n6
  class e5 edge_set_membership
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
