---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Assets<AudioSource> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Assets#lt;AudioSource#gt;**<br/>保存已加载的短音资产。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**asset_events**<br/>来自Bevy 引擎 ↗：将 Assets 暂存的<br/>Added、Modified、Removed 等变化批量写<br/>入对应 AssetEvent 消息；存在<br/>AssetChanges 时同步记录当前系统 tick，<br/>随后清空待发队列。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**play_dynamic_channels**<br/>执行按名称创建的动态音频通道命令。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**play_audio_channel#lt;bevy_kira_audio::**<br/>**MainTrack#gt;**<br/>执行指定类型音频通道的命令队列。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**play_audio_channel#lt;demo::audio::**<br/>**UiTrack#gt;**<br/>执行指定类型音频通道的命令队列。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**play_audio_channel#lt;demo::audio::**<br/>**SfxTrack#gt;**<br/>执行指定类型音频通道的命令队列。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**track_assets**<br/>来自Bevy 引擎 ↗：持有 AssetServer 资<br/>产信息锁处理句柄释放通知，确认没有新强句<br/>柄后移除已释放资产，使 Assets 集合与资<br/>产服务器的引用状态保持一致。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**play_requests**<br/>来自音频播放 ↗：按有效音量与播放策略处<br/>理短音请求。" }
  class n7 node_system
  class n7 external_node
  n1 e0@--> n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  n0 e4@--> n5
  class e4 edge_read
  n6 e5@--> n0
  class e5 edge_write
  n0 e6@-->|"访问声明"| n7
  class e6 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
