flowchart LR
  accTitle: bevy_enhanced_input::context::deactivate · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: hex, label: "**deactivate**<br/>为停用上下文登记输入释放等待。" }
  class n0 node_observer
  n1@{ shape: rounded, label: "**Binding**<br/>描述动作输入源" }
  class n1 node_component
  n2@{ shape: fr-rect, label: "**FirstPersonPlugin**<br/>来自first​_​person ↗：注册第一人称动<br/>作、捕获、朝向与镜头，不安装输入基础设施<br/>或物理插件。" }
  class n2 node_plugin
  class n2 external_node
  n3@{ shape: rounded, label: "**Bindings**<br/>保存属于当前动作实体的输入绑定实体集合" }
  class n3 node_component
  n4@{ shape: rounded, label: "**Actions#lt;GameplayContext#gt;**<br/>列出上下文关联的输入动作。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**ContextActivity#lt;GameplayContext#gt;**<br/>控制保留绑定的输入上下文启停。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**ActionSettings**<br/>配置输入动作的值累积、首次激活重置及输入<br/>吞取消费策略" }
  class n6 node_component
  n7@{ shape: stadium, label: "**InsertEvent**<br/>来自crate:bevy​_​ecs ↗：通知组件值插入<br/>实体。" }
  class n7 node_event
  class n7 external_node
  n8@{ shape: cyl, label: "**PendingBindings**<br/>等待已移除绑定的输入释放。" }
  class n8 node_resource
  n1 e0@--> n0
  class e0 edge_read
  n2 e1@-->|"调用"| n0
  class e1 edge_registration
  n3 e2@--> n0
  class e2 edge_read
  n4 e3@--> n0
  class e3 edge_read
  n5 e4@--> n0
  class e4 edge_read
  n6 e5@--> n0
  class e5 edge_read
  n7 e6@-->|"接收事件"| n0
