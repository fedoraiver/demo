---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: InputSystems · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**InputSystems**<br/>汇总键盘与鼠标输入状态。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**EguiPreUpdateSet::ProcessInput**<br/>来自Egui / Inspector ↗：将窗口和设备<br/>输入转换为检查器界面输入。" }
  class n1 node_system_set
  class n1 external_node
  n2@{ shape: rounded, label: "**dispatch_focused_**<br/>**input#lt;KeyboardInput#gt;**<br/>将键盘消息转为焦点实体上的键盘事件。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**sync_mouse_capture**<br/>来自第一人称控制 ↗：管理光标捕获及玩法<br/>输入启停。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: stadium, label: "**main · PreUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n4 node_engine_flow
  n5@{ shape: rounded, label: "**keyboard_input_system**<br/>把键盘事件汇总为物理和逻辑按键状态。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**mouse_button_input_system**<br/>把鼠标按钮事件汇总为按钮状态。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**accumulate_mouse_motion_system**<br/>累计本帧鼠标位移。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**accumulate_mouse_scroll_system**<br/>累计本帧滚轮位移和单位。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**gamepad_connection_system**<br/>按连接消息添加或移除手柄组件。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**gamepad_event_processing_system**<br/>过滤原始手柄数值并更新设备状态。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**touch_screen_input_system**<br/>维护持续触点与本帧触摸边沿。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**on_ime_input**<br/>把输入法组合和提交转换为文字编辑操作。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**listen_for_ime_input_when_text_**<br/>**input_focused**<br/>按可编辑焦点控制主窗口输入法。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**sync_context**<br/>来自菜单与界面 ↗：跟随窗口焦点启停菜单<br/>输入。" }
  class n14 node_system
  class n14 external_node
  n15@{ shape: rounded, label: "**gilrs_event_system**<br/>把 gilrs 原始手柄事件转换为 Bevy 消<br/>息。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**ui_focus_system**<br/>按鼠标和触摸更新旧式 UI 交互状态。" }
  class n16 node_system
  n17@{ shape: cyl, label: "**Messages#lt;KeyboardInput#gt;**<br/>缓冲底层键盘输入消息。" }
  class n17 node_message_buffer
  n18@{ shape: cyl, label: "**Messages#lt;KeyboardFocusLost#gt;**<br/>通知输入系统清理失焦后残留的按键。" }
  class n18 node_message_buffer
  n19@{ shape: cyl, label: "**Messages#lt;MouseButtonInput#gt;**<br/>缓冲底层鼠标按钮输入消息。" }
  class n19 node_message_buffer
  n20@{ shape: cyl, label: "**Messages#lt;MouseMotion#gt;**<br/>缓冲底层鼠标位移消息。" }
  class n20 node_message_buffer
  n21@{ shape: cyl, label: "**ButtonInput#lt;KeyCode#gt;**<br/>保存键盘按键的当前状态与变化。" }
  class n21 node_resource
  n22@{ shape: cyl, label: "**ButtonInput#lt;MouseButton#gt;**<br/>保存鼠标按钮的当前状态与变化。" }
  class n22 node_resource
  n23@{ shape: cyl, label: "**AccumulatedMouseMotion**<br/>汇总本帧鼠标位移供观察动作使用。" }
  class n23 node_resource
