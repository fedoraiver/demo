  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**CourierFootGrounding**<br/>导出鞋底四角作为骨骼子节点；接地补偿只抬<br/>视觉根，不改物理或持握来源。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**compensate​_​courier​_​sole​_​penetration**<br/>方向混合可能把弯腿插值成更直的腿；逐帧按<br/>真实鞋底边界修正最终视觉高度。" }
