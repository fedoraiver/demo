---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-569c9a217e07c6b5-e0{marker-start:url(#object-569c9a217e07c6b5_flowchart-v2-pointStart)!important}\n#object-569c9a217e07c6b5-e2{marker-start:url(#object-569c9a217e07c6b5_flowchart-v2-pointStart)!important}\n#object-569c9a217e07c6b5_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: deferred::PbrDeferredLightingDepthId · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**PbrDeferredLightingDepthId**<br/>限定延迟光照通道处理的材质集合。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**extract​_​components**<br/>来自crate:bevy​_​extract ↗：批量同步或<br/>移除子世界的目标组件。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**insert​_​deferred​_​lighting​_​pass​_​id​_​**<br/>**component**<br/>为延迟预通道视图补齐光照通道标识。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare​_​uniform​_​components**<br/>来自crate:bevy​_​render ↗：将组件值批量<br/>上传为动态着色器参数。" }
  class n3 node_system
  class n3 external_node
  n1 e0@--- n0
  class e0 edge_read
  n1 e1@-->|"移除"| n0
  class e1 edge_write
  n2 e2@---|"存在性约束"| n0
  class e2 edge_reference
  n0 e3@--> n3
  class e3 edge_read
  n2 e4@-->|"插入"| n0
  class e4 edge_write
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: bumpX }
  e4@{ curve: basis }
