---
flowchart LR
  accTitle: bevy_core_pipeline::prepass::PreviousViewUniforms · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**PreviousViewUniforms**<br/>集中上传各视图上一帧的相机矩阵。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**init​_​gpu​_​resource**<br/>来自crate:bevy​_​render ↗：构造并插入渲<br/>染所需资源。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**prepare​_​previous​_​view​_​uniforms**<br/>来自crate:bevy​_​pbr ↗：重建前帧抖动矩<br/>阵并上传视图历史参数。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**prepare​_​prepass​_​view​_​bind​_​group**<br/>来自crate:bevy​_​pbr ↗：绑定预通道的视<br/>图、全局和前帧缓冲。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**prepare​_​background​_​motion​_​vectors​_​**<br/>**bind​_​groups**<br/>为背景运动矢量绑定前后两帧视图参数。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**prepare​_​preprocess​_​bind​_​groups**<br/>来自crate:bevy​_​pbr ↗：绑定各视图网格<br/>预处理和间接参数构建资源。" }
  class n5 node_system
  class n5 external_node
  n1 e0@-->|"插入"| n0
  class e0 edge_write
  n2 e1@-->|"可变访问"| n0
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  n0 e4@--> n5
  class e4 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
