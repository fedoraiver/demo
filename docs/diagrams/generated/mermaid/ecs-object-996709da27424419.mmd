  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Messages<EguiInputEvent> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Messages#lt;EguiInputEvent#gt;**<br/>保存 EguiInputEvent 消息。" }
  class n0 node_message_buffer
  n1@{ shape: rounded, label: "**write_pointer_moved_and_button_**<br/>**messages_system**<br/>来自Egui / Inspector ↗：按原生事件顺<br/>序转换 Egui 指针输入。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**write_window_touch_messages_system**<br/>来自Egui / Inspector ↗：把窗口触摸转<br/>换为 Egui 指针和触摸事件。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**write_non_window_pointer_moved_**<br/>**messages_system**<br/>来自Egui / Inspector ↗：刷新非窗口<br/>Egui 界面的指针位置。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**write_non_window_touch_messages_**<br/>**system**<br/>来自Egui / Inspector ↗：向聚焦的非窗<br/>口 Egui 界面传递触摸。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**write_mouse_wheel_messages_system**<br/>来自Egui / Inspector ↗：向悬停 Egui<br/>上下文传递滚轮输入。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**write_pinch_gesture_messages_system**<br/>来自Egui / Inspector ↗：把捏合手势转<br/>换为 Egui 缩放。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**write_keyboard_input_messages_system**<br/>来自Egui / Inspector ↗：把键盘文本与<br/>按键转换为 Egui 输入。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**write_ime_messages_system**<br/>来自Egui / Inspector ↗：向聚焦的<br/>Egui 上下文传递输入法文本。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**write_egui_input_system**<br/>来自Egui / Inspector ↗：把界面输入和<br/>文件拖放写入 Egui 输入批次。" }
