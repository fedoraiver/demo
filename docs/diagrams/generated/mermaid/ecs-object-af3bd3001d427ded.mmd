---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: run_main · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**run_main**<br/>首次调用时依 MainScheduleOrder 执行启<br/>动调度，之后每次依 labels 顺序尝试运行<br/>主应用各阶段；Local 标志防止重复执行启<br/>动阶段。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · Main**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: notch-rect, label: "**World**<br/>保存实体、组件、资源及关联元数据" }
  class n2 node_system_param
  n3@{ shape: notch-rect, label: "**bool**<br/>确保主调度的启动阶段只执行一次。" }
  class n3 node_local
  n4@{ shape: cyl, label: "**MainScheduleOrder**<br/>规定主调度及启动调度的运行顺序。" }
  class n4 node_resource
  n1 e0@-->|"main / Main"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_write
  n0 e3@-->|"正文可变访问"| n4
  class e3 edge_write
  e1@{ curve: basis }
  e3@{ curve: basis }
