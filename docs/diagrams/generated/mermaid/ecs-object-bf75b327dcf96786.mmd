---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: LinearVelocity · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**LinearVelocity**<br/>保存刚体的世界线速度。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**assert_components_finite**<br/>在调试构建检查物理位置和速度是否有限。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**release_orphaned_items**<br/>来自物品交互 ↗：清理失效持握并恢复物品<br/>独立运动。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**align_attachments**<br/>来自物品交互 ↗：沿安全碰撞路径将物品对<br/>齐双手。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**update_previous_velocity**<br/>更新平滑显示所需的历史速度快照。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**writeback_solver_bodies**<br/>将求解后的位姿和速度回写 ECS。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**prepare_solver_bodies**<br/>把 ECS 刚体状态准备成子步求解数据。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**update_solver_body_aabbs#lt;avian3d::**<br/>**collision::collider::parry::**<br/>**Collider#gt;**<br/>按物理结果更新活跃刚体的碰撞边界。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**wake_on_changed**<br/>因外部位姿、速度或受力变化标记物理岛唤<br/>醒。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n12 node_system
  class n12 external_node
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"延迟添加"| n0
  class e1 edge_write
  n3 e2@-->|"延迟添加"| n0
  class e2 edge_write
  n4 e3@-->|"延迟添加"| n0
  class e3 edge_write
  n5 e4@-->|"延迟添加"| n0
  class e4 edge_write
  n6 e5@-->|"延迟添加"| n0
  class e5 edge_write
  n0 e6@--> n7
  class e6 edge_read
  n8 e7@--> n0
  class e7 edge_write
  n0 e8@--> n9
  class e8 edge_read
  n0 e9@--> n10
  class e9 edge_read
  n0 e10@--> n11
  class e10 edge_read
  n0 e11@-->|"存在 / 变更过滤"| n11
  class e11 edge_reference
  n12 e12@-->|"延迟添加"| n0
  class e12 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: basis }
