  class n17 node_system
  class n17 external_node
  n18@{ shape: rounded, label: "**prepare​_​post​_​processing​_​pipelines**<br/>来自crate:bevy​_​post​_​process ↗：按视<br/>图颜色格式准备内置后处理管线。" }
