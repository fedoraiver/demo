  class n29 node_system
  class n29 external_node
  n30@{ shape: rounded, label: "**prepare​_​skybox​_​pipelines**<br/>来自crate:bevy​_​core​_​pipeline ↗：按目<br/>标格式与采样数准备天空盒管线。" }
