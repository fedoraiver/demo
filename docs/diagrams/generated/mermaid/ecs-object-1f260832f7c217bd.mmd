---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-1f260832f7c217bd-e2{marker-start:url(#object-1f260832f7c217bd_flowchart-v2-pointStart)!important}\n#object-1f260832f7c217bd-e4{marker-start:url(#object-1f260832f7c217bd_flowchart-v2-pointStart)!important}\n#object-1f260832f7c217bd_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: AudioChannel<SfxTrack> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**AudioChannel#lt;SfxTrack#gt;**<br/>承载物品等音效短音的播放命令。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**play_audio_channel#lt;demo::audio::**<br/>**SfxTrack#gt;**<br/>来自Kira ↗：执行指定类型音频通道的命令<br/>队列。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**update_instance_states#lt;demo::audio::**<br/>**SfxTrack#gt;**<br/>来自Kira ↗：把实际播放状态回写到类型通<br/>道。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**play_requests**<br/>按有效音量与播放策略处理短音请求。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**stop_on_exit**<br/>停止音频通道并记录退出。" }
  class n4 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@---|"访问声明"| n0
  class e2 edge_read
  n3 e3@-->|"访问声明"| n0
  class e3 edge_write
  n4 e4@---|"访问声明"| n0
  class e4 edge_read
  n4 e5@-->|"访问声明"| n0
  class e5 edge_write
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
