---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-4ee23f4e4334d676-e2{marker-start:url(#object-4ee23f4e4334d676_flowchart-v2-pointStart)!important}\n#object-4ee23f4e4334d676_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: clear_cancelled_primary_presses · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**clear_cancelled_primary_presses**<br/>清理被取消、失焦或离窗的菜单主键按压。" }
  class n0 node_system
  n1@{ shape: lin-rect, label: "**PickingSystems::Last**<br/>来自Bevy 引擎 ↗：界定原生命中处理完成<br/>后的清理时机。" }
  class n1 node_system_set
  class n1 external_node
  n2@{ shape: cyl, label: "**Messages#lt;PointerInput#gt;**<br/>来自Bevy 引擎 ↗：Picking 归一化输入消<br/>息；项目仅消费 Cancel 以补清原生按压生<br/>命周期。" }
  class n2 node_message_buffer
  class n2 external_node
  n3@{ shape: rounded, label: "**PrimaryPress**<br/>区分菜单主键按压与其他按钮来源。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**Pressed**<br/>来自Bevy 引擎 ↗：标记原生按钮当前被按<br/>压。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: stadium, label: "**RemoveEvent**<br/>来自Bevy 引擎 ↗：正移除 Pressed 且仍<br/>具有 MenuButton 的实体" }
  class n5 node_event
  class n5 external_node
  n6@{ shape: stadium, label: "**main · PreUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n6 node_engine_flow
  class n6 external_node
  n7@{ shape: rounded, label: "**PrimaryPress**<br/>区分菜单主键按压与其他按钮来源。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**Pressed**<br/>来自Bevy 引擎 ↗：标记按钮或控件当前处<br/>于按住状态。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**Window**<br/>来自Bevy 引擎 ↗：保存主窗口的尺寸与显<br/>示配置。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: fr-rect, label: "**GameUiPlugin**<br/>管理菜单、设置编辑、导航与主菜单展示场<br/>景。" }
  class n10 node_plugin
  n1 e0@-->|"PickingSystems::Last"| n0
  class e0 edge_order
  n2 e1@-->|"缓冲消息"| n0
  class e1 edge_consume
  n3 e2@---|"移除"| n0
  class e2 edge_write
  n0 e3@-->|"移除"| n4
  class e3 edge_write
  n0 e4@-->|"移除 Pressed 后触发生命周期"| n5
  class e4 edge_emit
  n6 e5@-->|"main / PreUpdate"| n0
  class e5 edge_registration
  n1 e6@--> n0
  class e6 edge_order
