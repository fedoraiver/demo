---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: main · OnEnter(Running) · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**main · OnEnter(Running)**<br/>保存本应用调度的注册上下文与成员。" }
  class n0 node_engine_flow
  n1@{ shape: rounded, label: "**resume_simulation**<br/>来自应用流程 ↗：恢复游戏与物理时钟。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**resume_capture**<br/>来自第一人称控制 ↗：重置光标捕获并丢弃<br/>自由光标阶段位移。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**hide_menu**<br/>来自菜单与界面 ↗：隐藏菜单并清除提示。" }
  class n3 node_system
  class n3 external_node
  n0 e0@-->|"main / OnEnter(Running)"| n1
  class e0 edge_registration
  n0 e1@-->|"main / OnEnter(Running)"| n2
  class e1 edge_registration
  n0 e2@-->|"main / OnEnter(Running)"| n3
  class e2 edge_registration
  e0@{ curve: basis }
  e2@{ curve: basis }
