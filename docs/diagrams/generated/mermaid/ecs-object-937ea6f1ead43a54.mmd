---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: RenderSystems::Render · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**RenderSystems::Render**<br/>处理待建管线并执行实际渲染。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**RenderApp · Render**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**process_pipeline_queue_system**<br/>推进排队中的渲染、计算和网格管线创建。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**render_system**<br/>运行根 RenderGraph 调度，提交截图及<br/>GPU 回读收尾命令，并呈现需要输出的窗口<br/>交换链；随后收集截图结果。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**clear_batched_cpu_instance_**<br/>**buffers#lt;bevy_pbr::render::mesh::**<br/>**MeshPipeline#gt;**<br/>在 CPU 批处理使用实例缓冲之前清空其本帧<br/>内容；资源尚未创建时直接跳过。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**clear_batched_cpu_instance_**<br/>**buffers#lt;bevy_sprite_render::mesh2d::**<br/>**mesh::Mesh2dPipeline#gt;**<br/>在 CPU 批处理使用实例缓冲之前清空其本帧<br/>内容；资源尚未创建时直接跳过。" }
  class n5 node_system
  n6@{ shape: lin-rect, label: "**RenderSystems::Prepare**<br/>按已排序绘制项准备 GPU 资源及绑定。" }
  class n6 node_system_set
  n7@{ shape: rounded, label: "**filtering_system**<br/>对环境贴图执行镜面辐射卷积和漫反射辐照卷<br/>积，按不同粗糙度生成镜面 mip，并计算六<br/>个面的漫反射环境纹理。" }
  class n7 node_system
  n8@{ shape: lin-rect, label: "**RenderSystems::Cleanup**<br/>清理本帧渲染缓存、资产变化和回读状态。" }
  class n8 node_system_set
  n1 e0@-->|"RenderApp / Render"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_order
  n0 e4@--> n5
  class e4 edge_order
  n6 e5@--> n0
  class e5 edge_order
  n7 e6@--> n0
  class e6 edge_order
  n0 e7@--> n8
  class e7 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
