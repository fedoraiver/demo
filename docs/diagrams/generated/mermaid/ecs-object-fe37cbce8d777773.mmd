  n7@{ shape: rounded, label: "**ExtractedView**<br/>描述渲染视图的身份、投影与空间状态。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**PreviousViewData**<br/>保存上一帧的相机视图与投影矩阵。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**PreviousTemporalJitter**<br/>记录上一帧实际采用的抖动与视口尺寸。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**TemporalJitter**<br/>为透视相机视锥提供亚像素抖动。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**MainPassResolutionOverride**<br/>覆盖三维主通道的渲染分辨率。" }
