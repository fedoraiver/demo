---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: WaitingScenes · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**WaitingScenes**<br/>保存等待场景资产加载的实体与场景列表生成<br/>请求" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**resolve_scene_patches**<br/>解析已完成依赖加载的场景补丁。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**spawn_queued**<br/>消费场景补丁资产加载通知，把已解析的<br/>ScenePatch 或 SceneListPatch 应用到等<br/>待中的实体，并推进排队的场景装配；错误记<br/>录到日志。" }
  class n2 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@-->|"正文可变访问"| n0
  class e1 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
