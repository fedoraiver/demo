---
flowchart LR
  accTitle: bevy_window::WindowClosing · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lean-r, label: "**WindowClosing**<br/>通知窗口正在关闭。" }
  class n0 node_message
  n1@{ shape: rounded, label: "**despawn​_​windows**<br/>来自crate:bevy​_​winit ↗：处理原生窗口<br/>关闭并延后一轮释放包装器。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**extract​_​windows**<br/>来自crate:bevy​_​render ↗：向渲染世界同<br/>步窗口配置与原生句柄。" }
  class n2 node_system
  class n2 external_node
  n1 e0@-->|"可变访问"| n0
  class e0 edge_publish
  n0 e1@--> n2
  class e1 edge_consume
  n1 e2@-->|"消息"| n0
  class e2 edge_publish
  e0@{ curve: basis }
  e2@{ curve: basis }
