---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Camera2d · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Camera2d**<br/>标记使用二维渲染流程的相机。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**extract_ui_camera_view**<br/>为活动二维或三维相机维护独立 UI 视图。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**extract_components#lt;bevy_camera::**<br/>**components::Camera2d, bevy_render::**<br/>**RenderApp, ()#gt;**<br/>对已同步到子世界的实体读取<br/>ExtractComponent 指定的查询数据，批量<br/>写入转换后的目标组件；转换返回 None 时<br/>移除对应目标组件。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**extract_core_2d_camera_phases**<br/>为活动二维相机准备渲染阶段并清理失效视<br/>图。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**resolve_composition_spaces**<br/>协调共享纹理相机的合成色彩空间。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**prepare_core_2d_depth_textures**<br/>为有效二维视图准备共享目标深度纹理。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**prepare_mesh2d_view_bind_groups**<br/>为二维相机绑定视图、全局参数与色调<br/>LUT。" }
  class n6 node_system
  n0 e0@-->|"存在 / 变更过滤"| n1
  class e0 edge_reference
  n2 e1@-->|"延迟移除"| n0
  class e1 edge_write
  n2 e2@-->|"延迟添加"| n0
  class e2 edge_write
  n0 e3@-->|"存在 / 变更过滤"| n3
  class e3 edge_reference
  n0 e4@-->|"存在 / 变更过滤"| n4
  class e4 edge_reference
  n0 e5@-->|"存在 / 变更过滤"| n5
  class e5 edge_reference
  n0 e6@-->|"存在 / 变更过滤"| n6
  class e6 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
