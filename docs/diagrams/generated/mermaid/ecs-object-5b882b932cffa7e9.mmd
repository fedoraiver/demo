---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-5b882b932cffa7e9-e5{marker-start:url(#object-5b882b932cffa7e9_flowchart-v2-pointStart)!important}\n#object-5b882b932cffa7e9-e7{marker-start:url(#object-5b882b932cffa7e9_flowchart-v2-pointStart)!important}\n#object-5b882b932cffa7e9_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: play_courier_animation · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**play_courier_animation**<br/>绑定并循环播放展示快递员的持物待机动画。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · Update**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: rounded, label: "**CourierAnimationPending**<br/>等待菜单展示角色的命名动画资源就绪。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**AnimationGraphHandle**<br/>来自Bevy 引擎 ↗：选择播放器使用的动画<br/>图资产。" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: rounded, label: "**CourierAnimation**<br/>保存展示快递员的模型来源以绑定命名动画。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**CourierAnimationPending**<br/>标记等待命名动画绑定的模型。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Children**<br/>来自Bevy 引擎 ↗：索引展示模型及包裹附<br/>件的子实体。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**AnimationPlayer**<br/>来自Bevy 引擎 ↗：驱动模型的动画播放。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**AnimationGraphHandle**<br/>来自Bevy 引擎 ↗：关联模型使用的动画混<br/>合图。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: cyl, label: "**Assets#lt;Gltf#gt;**<br/>来自Bevy 引擎 ↗：保存导入场景与命名动<br/>画的资源引用。" }
  class n9 node_resource
  class n9 external_node
  n10@{ shape: cyl, label: "**Assets#lt;AnimationClip#gt;**<br/>来自Bevy 引擎 ↗：保存主角与展示模型使<br/>用的动画片段。" }
  class n10 node_resource
  class n10 external_node
  n11@{ shape: cyl, label: "**Assets#lt;AnimationGraph#gt;**<br/>来自Bevy 引擎 ↗：保存模型使用的动画混<br/>合图。" }
  class n11 node_resource
  class n11 external_node
  n12@{ shape: fr-rect, label: "**GameUiPlugin**<br/>管理菜单、设置编辑、导航与主菜单展示场<br/>景。" }
  class n12 node_plugin
  n1 e0@-->|"main / Update"| n0
