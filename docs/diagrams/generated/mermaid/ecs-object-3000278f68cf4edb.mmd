---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: main · PreStartup · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**main · PreStartup**<br/>保存本应用调度的注册上下文与成员。" }
  class n0 node_engine_flow
  n1@{ shape: rounded, label: "**update_ui_screen_rect**<br/>来自Egui / Inspector ↗：把相机视口换<br/>算为 Egui 逻辑屏幕区域。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**gilrs_event_startup_system**<br/>登记启动时已经连接的手柄。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**ApplyDeferred**<br/>在调度建立的同步点应用前序系统暂存的<br/>Commands 等延迟操作，使后续系统可以观察<br/>到结构变化；此卡片是 ApplyDeferred 的<br/>System 实现。" }
  class n3 node_sync
  n4@{ shape: rounded, label: "**setup_primary_egui_context_system**<br/>来自Egui / Inspector ↗：为首个合适相<br/>机建立主 Egui 上下文。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**ApplyDeferred**<br/>在调度建立的同步点应用前序系统暂存的<br/>Commands 等延迟操作，使后续系统可以观察<br/>到结构变化；此卡片是 ApplyDeferred 的<br/>System 实现。" }
  class n5 node_sync
  n6@{ shape: lin-rect, label: "**AnonymousSet(0)**<br/>保存本组系统共同的运行条件。" }
  class n6 node_system_set
  n7@{ shape: lin-rect, label: "**EguiStartupSet::InitContexts**<br/>来自Egui / Inspector ↗：在启动时初始<br/>化主 Egui 上下文。" }
  class n7 node_system_set
  class n7 external_node
  n0 e0@-->|"main / PreStartup"| n1
  class e0 edge_registration
  n0 e1@-->|"main / PreStartup"| n2
  class e1 edge_registration
  n0 e2@-->|"main / PreStartup"| n3
  class e2 edge_registration
  n0 e3@-->|"main / PreStartup"| n4
  class e3 edge_registration
  n0 e4@-->|"main / PreStartup"| n5
  class e4 edge_registration
  n0 e5@-->|"main / PreStartup"| n6
  class e5 edge_registration
  n0 e6@-->|"main / PreStartup"| n7
  class e6 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
