---
flowchart LR
  accTitle: bevy_core_pipeline::upscaling::clear_view_upscaling_pipelines · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**bevy​_​core​_​pipeline::upscaling::**<br/>**clear​_​view​_​upscaling​_​pipelines**<br/>清除视图缩放管线以便设备恢复后重建。" }
  class n0 node_system
  end
  style layout_card_n0 fill:none,stroke:none
  subgraph layout_card_n1[" "]
  n1@{ shape: rounded, label: "**upscaling::ViewUpscalingPipeline**<br/>记录视图颜色输出所用的缩放管线。" }
  class n1 node_component
  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: fr-rect, label: "**upscaling::UpscalingPlugin**<br/>准备视图输出放大与合成管线。" }
  class n2 node_plugin
  end
  style layout_card_n2 fill:none,stroke:none
  n1 e0@-->|"存在性约束"| n0
  class e0 edge_reference
  n1 e1@---|"移除"| n0
  class e1 edge_write
  n2 e2@-->|"调用"| n0
  class e2 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
