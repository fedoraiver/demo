---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: bevy_render::render_phase::ViewSortedRenderPhases#lt;render_pass::TransparentUi#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: cyl, label: "**ViewSortedRenderPhases#lt;TransparentUi**<br/>**#gt;**<br/>汇集各视图需要排序的绘制指令。" }
  class n0 node_resource
  end
  style layout_card_n0 fill:none,stroke:none
  n1@{ shape: rounded, label: "**extract​_​ui​_​camera​_​view**<br/>来自crate:bevy​_​ui​_​render ↗：为活动二<br/>维或三维相机维护独立 UI 视图。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**prepare​_​uinodes**<br/>来自crate:bevy​_​ui​_​render ↗：生成裁剪<br/>后的 UI 几何并合并图像批次。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**ui​_​pass**<br/>来自crate:bevy​_​ui​_​render ↗：把透明<br/>UI 绘制项渲染到关联视图。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**prepare​_​gradient**<br/>来自crate:bevy​_​ui​_​render ↗：将已排队<br/>的线性、径向和锥形渐变转换为 GPU 顶点、<br/>索引与颜色停靠点数据，建立渐变绘制批次并<br/>上传相关缓冲。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**queue​_​shadows**<br/>来自crate:bevy​_​ui​_​render ↗：为提取<br/>的 UI 阴影选择匹配目标格式和阴影采样数<br/>的管线，按节点堆叠顺序及阴影层偏移加入透<br/>明 UI 绘制阶段。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**queue​_​ui​_​slices**<br/>来自crate:bevy​_​ui​_​render ↗：将 UI 图<br/>像切片排入对应相机透明阶段。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**sort​_​phase​_​system**<br/>按各视图重新计算并排序阶段绘制项。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**prepare​_​shadows**<br/>来自crate:bevy​_​ui​_​render ↗：生成并上<br/>传 UI 阴影的裁剪几何。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**queue​_​uinodes**<br/>来自crate:bevy​_​ui​_​render ↗：按目标相<br/>机和堆叠顺序排队 UI 节点。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**prepare​_​ui​_​slices**<br/>来自crate:bevy​_​ui​_​render ↗：为 UI 切<br/>片生成裁剪几何并合并图像批次。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: rounded, label: "**queue​_​gradient**<br/>来自crate:bevy​_​ui​_​render ↗：按目标视<br/>图与堆叠顺序排队 UI 渐变。" }
  class n11 node_system
  class n11 external_node
