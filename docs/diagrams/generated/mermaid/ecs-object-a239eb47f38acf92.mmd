{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Messages<TouchInput> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Messages#lt;TouchInput#gt;**<br/>保存 TouchInput 消息。" }
  class n0 node_message_buffer
  n1@{ shape: rounded, label: "**deactivate_touch_pointers**<br/>销毁已经结束或取消的触摸指针。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**touch_screen_input_system**<br/>维护持续触点与本帧触摸边沿。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**write_window_touch_messages_system**<br/>来自Egui / Inspector ↗：把窗口触摸转<br/>换为 Egui 指针和触摸事件。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**write_non_window_touch_messages_**<br/>**system**<br/>来自Egui / Inspector ↗：向聚焦的非窗<br/>口 Egui 界面传递触摸。" }
  class n4 node_system
  class n4 external_node
  n0 e0@--> n1
  class e0 edge_consume
  n0 e1@--> n2
  class e1 edge_consume
  n0 e2@--> n3
  class e2 edge_consume
  n0 e3@--> n4
  class e3 edge_consume
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
