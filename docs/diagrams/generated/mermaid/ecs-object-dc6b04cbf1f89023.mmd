---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: Propagate · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**Propagate**<br/>组织实体层级变换传播。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**StepSimulation**<br/>来自crate:avian3d ↗：划分物理准备、模<br/>拟与回写边界。" }
  class n1 node_system_set
  class n1 external_node
  n2@{ shape: lin-rect, label: "**First**<br/>来自crate:avian3d ↗：划分物理准备、模<br/>拟与回写边界。" }
  class n2 node_system_set
  class n2 external_node
  n3@{ shape: lin-rect, label: "**Writeback**<br/>来自crate:avian3d ↗：划分物理准备、模<br/>拟与回写边界。" }
  class n3 node_system_set
  class n3 external_node
  n4@{ shape: lin-rect, label: "**Prepare**<br/>来自crate:avian3d ↗：划分物理准备、模<br/>拟与回写边界。" }
  class n4 node_system_set
  class n4 external_node
  n5@{ shape: lin-rect, label: "**Last**<br/>来自crate:avian3d ↗：划分物理准备、模<br/>拟与回写边界。" }
  class n5 node_system_set
  class n5 external_node
  n6@{ shape: lin-rect, label: "**SpatialQuerySystems**<br/>来自crate:avian3d ↗：刷新空间投射器并<br/>执行射线和形状查询。" }
  class n6 node_system_set
  class n6 external_node
  n1 e0@-->|"先于"| n0
  class e0 edge_order
  n2 e1@-->|"先于"| n0
  class e1 edge_order
  n3 e2@-->|"先于"| n0
  class e2 edge_order
  n4 e3@-->|"先于"| n0
  class e3 edge_order
  n5 e4@-->|"先于"| n0
  class e4 edge_order
  n0 e5@-->|"先于"| n6
  class e5 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
