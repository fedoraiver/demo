---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Messages<SoundRequest> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Messages#lt;SoundRequest#gt;**<br/>保存 SoundRequest 消息。" }
  class n0 node_message_buffer
  n1@{ shape: rounded, label: "**emit_parcel_land**<br/>来自物品交互 ↗：识别自由物品落地并发出<br/>声音请求。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**warn_hold_strain**<br/>来自物品交互 ↗：检查持续持握偏差并发出<br/>失稳提示音。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**handle_requests**<br/>来自菜单与界面 ↗：处理菜单导航、设置应<br/>用与音量编辑请求。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**pointer_interaction**<br/>来自菜单与界面 ↗：将真实鼠标交互转换为<br/>共享菜单请求。" }
  class n7 node_system
  class n7 external_node
  n1 e0@-->|"正文发布消息"| n0
  class e0 edge_publish
  n2 e1@-->|"延迟发布消息"| n0
  class e1 edge_publish
  n3 e2@-->|"延迟发布消息"| n0
  class e2 edge_publish
  n4 e3@-->|"正文发布消息"| n0
  class e3 edge_publish
  n5 e4@-->|"正文发布消息"| n0
  class e4 edge_publish
  n6 e5@-->|"延迟发布消息"| n0
  class e5 edge_publish
  n7 e6@-->|"正文发布消息"| n0
  class e6 edge_publish
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
