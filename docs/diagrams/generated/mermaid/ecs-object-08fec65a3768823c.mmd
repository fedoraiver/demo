---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Mesh3d · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Mesh3d**<br/>为三维可绘制实体指定网格资产。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**calculate_bounds**<br/>为允许自动包围盒计算的 Mesh3d 实体补充<br/>Aabb，并在网格句柄或资产变化时重新计算<br/>已有包围盒；NoFrustumCulling 和<br/>NoAutoAabb 排除自动处理。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update_skinned_mesh_bounds**<br/>依据当前关节姿态更新动态蒙皮包围盒。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**check_dir_light_mesh_visibility**<br/>计算方向光各相机级联可见的投影网格。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**check_point_light_mesh_visibility**<br/>计算点光与聚光灯阴影可见的网格。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**mark_3d_meshes_as_changed_if_their_**<br/>**assets_changed**<br/>资产内容变化时标记对应三维网格已变更。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**mark_meshes_as_changed_if_their_**<br/>**materials_changed#lt;bevy_pbr::pbr_**<br/>**material::StandardMaterial#gt;**<br/>材质组件或资产变化时请求网格重新提取。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**check_entities_needing_**<br/>**specialization#lt;bevy_pbr::pbr_**<br/>**material::StandardMaterial#gt;**<br/>收集几何或材质变化及移除的三维网格。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**mark_meshes_as_changed_if_their_**<br/>**materials_changed#lt;bevy_pbr::**<br/>**extended_material::**<br/>**ExtendedMaterial#lt;bevy_pbr::pbr_**<br/>**material::StandardMaterial, bevy_**<br/>**pbr::decal::forward::**<br/>**ForwardDecalMaterialExt#gt;#gt;**<br/>材质组件或资产变化时请求网格重新提取。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**check_entities_needing_**<br/>**specialization#lt;bevy_pbr::extended_**<br/>**material::ExtendedMaterial#lt;bevy_**<br/>**pbr::pbr_material::**<br/>**StandardMaterial, bevy_pbr::decal::**<br/>**forward::ForwardDecalMaterialExt#gt;#gt;**<br/>收集几何或材质变化及移除的三维网格。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**draw_skinned_mesh_bounds**<br/>绘制带独立显示标记的动态蒙皮包围区域。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**draw_all_skinned_mesh_bounds**<br/>绘制未单独标记的动态蒙皮网格包围区域。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**spawn_gizmo_meshes**<br/>创建变换操作器各轴网格、材质和覆盖相机。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**init_collider_constructors**<br/>来自Avian ↗：把就绪的碰撞构造配置变成<br/>实际形状。" }
  class n13 node_system
  class n13 external_node
  n14@{ shape: rounded, label: "**init_collider_constructor_**<br/>**hierarchies**<br/>来自Avian ↗：按<br/>ColliderConstructorHierarchy 的默认<br/>及逐名称配置为后代生成碰撞体，写入碰撞层<br/>和密度；需要场景实例时等待就绪，需要网格<br/>时等待资产可用。完成该层级处理后移除构造<br/>配置并发出<br/>ColliderConstructorHierarchyReady。" }
  class n14 node_system
  class n14 external_node
  n15@{ shape: rounded, label: "**extract_meshes_for_gpu_building**<br/>增量提取变化或需重试网格到线程队列。" }
  class n15 node_system
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@-->|"存在 / 变更过滤"| n1
  class e1 edge_reference
  n0 e2@--> n2
  class e2 edge_read
  n0 e3@-->|"存在 / 变更过滤"| n3
  class e3 edge_reference
  n0 e4@-->|"存在 / 变更过滤"| n4
  class e4 edge_reference
  n5 e5@--> n0
  class e5 edge_write
  n6 e6@--> n0
  class e6 edge_write
  n0 e7@-->|"存在 / 变更过滤"| n7
  class e7 edge_reference
  n8 e8@--> n0
  class e8 edge_write
  n0 e9@-->|"存在 / 变更过滤"| n9
  class e9 edge_reference
  n0 e10@--> n10
  class e10 edge_read
  n0 e11@--> n11
  class e11 edge_read
  n12 e12@-->|"延迟添加"| n0
  class e12 edge_write
  n0 e13@--> n13
  class e13 edge_read
  n0 e14@--> n14
  class e14 edge_read
  n0 e15@-->|"存在 / 变更过滤"| n15
  class e15 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
