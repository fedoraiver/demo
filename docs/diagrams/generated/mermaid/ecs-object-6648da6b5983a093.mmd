---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-6648da6b5983a093-e19{marker-start:url(#object-6648da6b5983a093_flowchart-v2-pointStart)!important}\n#object-6648da6b5983a093-e22{marker-start:url(#object-6648da6b5983a093_flowchart-v2-pointStart)!important}\n#object-6648da6b5983a093-e23{marker-start:url(#object-6648da6b5983a093_flowchart-v2-pointStart)!important}\n#object-6648da6b5983a093_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
