    "themeCSS": "#object-2aca408374e22719-e5{marker-start:url(#object-2aca408374e22719_flowchart-v2-pointStart)!important}\n#object-2aca408374e22719_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
