---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: bevy_asset::Assets#lt;font::Font#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Assets#lt;Font#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**load​_​font​_​assets​_​into​_​font​_​**<br/>**collection**<br/>来自crate:bevy​_​text ↗：把字体资产注册<br/>到排版字体数据库。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**update​_​text2d​_​layout**<br/>来自crate:bevy​_​sprite ↗：重新排版变化<br/>的二维文字并准备字形。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**measure​_​text​_​system**<br/>来自crate:bevy​_​ui ↗：在文本变化后更新<br/>内容测量并安排文字重排。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**asset​_​events​_​condition**<br/>判断是否有待发布的资产变化。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**asset​_​events**<br/>发布累计的资产变化消息。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update​_​editable​_​text​_​styles**<br/>来自crate:bevy​_​ui ↗：把字体和排版配置<br/>同步到可编辑文本引擎。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**track​_​assets**<br/>同步资产存活状态并处理句柄释放。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**update​_​editable​_​text​_​content​_​size**<br/>来自crate:bevy​_​ui ↗：按可见字符宽度和<br/>行数设置输入框固有尺寸。" }
  class n8 node_system
  class n8 external_node
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  n5 e4@-->|"可变访问"| n0
  class e4 edge_write
  n0 e5@--> n6
  class e5 edge_read
  n7 e6@-->|"可变访问"| n0
  class e6 edge_write
  n0 e7@--> n8
  class e7 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: bumpX }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
