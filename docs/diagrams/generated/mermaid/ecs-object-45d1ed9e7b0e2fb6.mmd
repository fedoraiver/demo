flowchart LR
  accTitle: avian3d::collision::broad_phase::bvh_broad_phase::collect_collision_pairs#lt;()#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**collect​_​collision​_​pairs**<br/>为移动碰撞代理收集广相候选接触。" }
  class n0 node_system
  n1@{ shape: cyl, label: "**JointGraph**<br/>保存刚体之间的关节连接图。" }
  class n1 node_resource
  n2@{ shape: cyl, label: "**MovedProxies**<br/>收集需要重检碰撞对的移动代理。" }
  class n2 node_resource
  n3@{ shape: cyl, label: "**CollisionDiagnostics**<br/>汇总碰撞检测耗时与接触数量。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**ContactGraph**<br/>维护碰撞体接触对及其碰撞数据。" }
  class n4 node_resource
  n5@{ shape: lin-rect, label: "**CollectCollisions**<br/>组织宽阶段碰撞候选收集。" }
  class n5 node_system_set
  n6@{ shape: cyl, label: "**ColliderTrees**<br/>按运动类别组织碰撞体加速树。" }
  class n6 node_resource
  n1 e0@--> n0
  class e0 edge_read
  n2 e1@--> n0
  class e1 edge_read
  n0 e2@-->|"可变访问"| n3
  class e2 edge_write
  n0 e3@-->|"可变访问"| n4
  class e3 edge_write
  n5 e4@-->|"集合成员"| n0
  class e4 edge_set_membership
  n0 e5@-->|"可变访问"| n6
  class e5 edge_write
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
