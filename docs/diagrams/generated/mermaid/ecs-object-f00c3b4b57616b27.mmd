---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-f00c3b4b57616b27-e2{marker-start:url(#object-f00c3b4b57616b27_flowchart-v2-pointStart)!important}\n#object-f00c3b4b57616b27_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: SettingsDraft · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**SettingsDraft**<br/>保存待应用的设置草稿与临时音量编辑。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**handle_requests**<br/>来自菜单与界面 ↗：处理菜单导航、设置应<br/>用与音量编辑请求。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**update_settings_text**<br/>来自菜单与界面 ↗：原位更新设置草稿数值<br/>与保存提示。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**rebuild_page**<br/>来自菜单与界面 ↗：按页面结构变化重建菜<br/>单界面。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**update_volume_visuals**<br/>来自菜单与界面 ↗：原位更新音量百分比文<br/>字与轨道填充。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**publish_audio_preview**<br/>来自菜单与界面 ↗：向音频功能发布或清除<br/>临时音量预览。" }
  class n5 node_system
  class n5 external_node
  n1 e0@-->|"草稿"| n0
  class e0 edge_write
  n0 e1@-->|"草稿显示"| n2
  class e1 edge_read
  n1 e2@---|"访问声明"| n0
  class e2 edge_read
  n0 e3@-->|"访问声明"| n3
  class e3 edge_read
  n0 e4@-->|"访问声明"| n4
  class e4 edge_read
  n0 e5@-->|"访问声明"| n5
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
