flowchart LR
  accTitle: RemovedComponents<MeshMaterial2d<ColorMaterial>> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: notch-rect, label: "**RemovedComponents#lt;MeshMaterial2d#lt;Col**<br/>**orMaterial#gt;#gt;**<br/>读取曾移除指定组件或连同该组件一起销毁的<br/>实体身份" }
  class n0 node_system_param
  n1@{ shape: rounded, label: "**mark_2d_meshes_as_changed_if_their_**<br/>**materials_changed#lt;bevy_sprite_**<br/>**render::mesh2d::color_material::**<br/>**ColorMaterial#gt;**<br/>让材质变化触发二维网格重新提取。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**check_entities_needing_**<br/>**specialization#lt;bevy_sprite_render::**<br/>**mesh2d::color_material::**<br/>**ColorMaterial#gt;**<br/>收集二维网格材质需重建或移除专用化的实<br/>体。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**extract_mesh_materials_2d#lt;bevy_**<br/>**sprite_render::mesh2d::color_**<br/>**material::ColorMaterial#gt;**<br/>同步可见二维网格使用的材质资产身份。" }
  class n3 node_system
  n0 e0@-->|"参数 / 查询数据"| n1
  class e0 edge_reference
  n0 e1@-->|"参数 / 查询数据"| n2
  class e1 edge_reference
  n0 e2@-->|"参数 / 查询数据"| n3
  class e2 edge_reference
  e0@{ curve: basis }
  e2@{ curve: basis }
