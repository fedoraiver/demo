  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: rounded, label: "**suspend​_​controls**<br/>来自first​_​person ↗：停用玩法输入并释<br/>放光标。" }
