---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: collect_collision_pairs<()> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**collect_collision_pairs#lt;()#gt;**<br/>为移动碰撞代理收集广相候选接触。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PhysicsSchedule**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**BroadPhaseSystems::CollectCollisions**<br/>搜集包围盒重叠的潜在碰撞对。" }
  class n2 node_system_set
  n3@{ shape: cyl, label: "**ColliderTrees**<br/>索引碰撞体以加速接地、拾取与持物路径查<br/>询。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**MovedProxies**<br/>收集需要重检碰撞对的移动代理。" }
  class n4 node_resource
  n5@{ shape: notch-rect, label: "**StaticSystemParam#lt;()#gt;**<br/>来自Bevy 引擎 ↗：适配泛型 SystemParam" }
  class n5 node_system_param
  class n5 external_node
  n6@{ shape: cyl, label: "**ContactGraph**<br/>保存物理解算后的真实接触结果。" }
  class n6 node_resource
  n7@{ shape: cyl, label: "**JointGraph**<br/>保存刚体之间的关节连接图。" }
  class n7 node_resource
  n8@{ shape: cyl, label: "**CollisionDiagnostics**<br/>汇总碰撞检测耗时与接触数量。" }
  class n8 node_resource
  n1 e0@-->|"main / PhysicsSchedule"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_read
  n5 e4@-->|"参数 / 查询数据"| n0
  class e4 edge_reference
  n0 e5@--> n6
  class e5 edge_write
  n7 e6@--> n0
  class e6 edge_read
  n0 e7@--> n8
  class e7 edge_write
  n1 layout_input_0@~~~ n2
  n2 layout_input_1@~~~ n4
  n4 layout_input_2@~~~ n5
  n5 layout_input_3@~~~ n7
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
