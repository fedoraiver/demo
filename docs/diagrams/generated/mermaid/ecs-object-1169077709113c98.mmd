---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: 角色业务根实体 · 对象关系
  accDescr: 中心实体与直接关联的非组件对象；组件清单在右侧查看，保留原关系方向及身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>承载角色身份、运动意图与动态物理身体。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**键盘控制者**<br/>保存玩家身份、输入上下文与受控角色及相<br/>机。" }
  class n1 node_entity
  n2@{ shape: rounded, label: "**第一人称相机实体**<br/>提供跟随角色的第一人称视角与观察输入状<br/>态。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**业务直属 GLB 视觉根实体**<br/>承载业务实体的模型、骨骼与动画子树。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**可搬物品业务根实体**<br/>承载可拾取物品身份及自由运动、共享持握状<br/>态。" }
  class n4 node_entity
  n5@{ shape: rounded, label: "**主角 GLB 播放器节点**<br/>来自Bevy 引擎 ↗：承载主角模型的动画播<br/>放与混合状态。" }
  class n5 node_entity
  class n5 external_node
  n6@{ shape: rounded, label: "**持物无视觉碰撞代理**<br/>来自物品交互 ↗：为持物共享人物刚体提供<br/>无视觉碰撞形状。" }
  class n6 node_entity
  class n6 external_node
  n7@{ shape: fr-rect, label: "**SceneAssemblyPlugin**<br/>加载运行资源并装配海岛、碰撞与业务实体。" }
  class n7 node_plugin
  n1 e0@-->|"ControlsCharacter"| n0
  class e0 edge_reference
  n2 e1@-->|"FirstPersonCamera.target"| n0
  class e1 edge_reference
  n3 e2@-->|"ChildOf"| n0
  class e2 edge_relationship
  n4 e3@-->|"HeldBy"| n0
  class e3 edge_relationship
  n5 e4@-->|"CourierAnimation.character"| n0
  class e4 edge_reference
  n3 e5@-->|"CourierFootGrounding.character"| n0
  class e5 edge_reference
  n6 e6@-->|"ColliderOf"| n0
  class e6 edge_relationship
  n7 e7@-->|"装配归属"| n0
  class e7 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
