---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: taa::TemporalAntiAliasing · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**TemporalAntiAliasing**<br/>启用相机的历史帧混合抗锯齿。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**prepare​_​taa​_​jitter**<br/>为 TAA 相机逐帧设置 Halton 投影抖动。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare​_​taa​_​history​_​textures**<br/>按帧奇偶为 TAA 轮换读写历史纹理。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**extract​_​taa​_​settings**<br/>提取有效相机的 TAA 设置并消费历史重置信<br/>号。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**prepare​_​taa​_​pipelines**<br/>准备 TAA 当前状态及下一帧恢复用管线。" }
  class n4 node_system
  n0 e0@-->|"存在性约束"| n1
  class e0 edge_reference
  n0 e1@-->|"存在性约束"| n2
  class e1 edge_reference
  n3 e2@-->|"插入"| n0
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_read
  n3 e4@-->|"移除"| n0
  class e4 edge_write
  n3 e5@-->|"赋值"| n0
  class e5 edge_write
  n3 e6@-->|"可变访问"| n0
  class e6 edge_write
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
