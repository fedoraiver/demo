  n19@{ shape: cyl, label: "**DirtySpecializations**<br/>记录需刷新或移除管线专用化的对象与视图。" }
  class n19 node_resource
  n20@{ shape: notch-rect, label: "**MainEntityHashSet**<br/>去重三维材质本轮需要重新排队的网格。" }
