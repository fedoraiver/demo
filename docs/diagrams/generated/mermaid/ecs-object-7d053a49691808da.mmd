---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Core3dSystems::PostProcess · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**Core3dSystems::PostProcess**<br/>执行三维色调映射及最终屏幕后处理。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**RenderApp · Core3d**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**tonemapping**<br/>为启用色调映射的 HDR 视图绑定颜色源、视<br/>图参数和 LUT，执行全屏色调映射并写入后<br/>处理目标；模式关闭或管线尚未就绪时跳过。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**late_downsample_depth**<br/>更新供下一帧早期遮挡测试使用的深度金字<br/>塔。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**bloom**<br/>对 HDR 视图颜色执行 Bloom 降采样和上采<br/>样通道，将亮部扩散合成回视图；强度为零、<br/>非 HDR 或所需管线和参数缓冲未就绪时不执<br/>行。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**motion_blur**<br/>读取当前视图颜色、预通道运动矢量和深度，<br/>按快门角度及采样数执行运动模糊；采样关<br/>闭、所需纹理或管线不可用时跳过。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**fxaa**<br/>在 FXAA 开启且相机管线就绪时，读取当前<br/>视图颜色并执行全屏抗锯齿，写入下一后处理<br/>目标；复用与源纹理对应的绑定组。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**smaa**<br/>按边缘检测、混合权重计算和邻域混合三个阶<br/>段执行 SMAA，将抗锯齿结果写入视图后处理<br/>目标；任何所需管线未就绪时跳过整个流程。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**cas**<br/>绑定视图颜色和 CAS 参数，执行对比度自适<br/>应锐化并写入后处理目标；缓存对应参数缓冲<br/>与源纹理的绑定组，管线或参数不可用时跳<br/>过。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**ui_pass**<br/>找到 UI 相机对应的视图、颜色目标及透明<br/>UI 阶段，按相机视口渲染已排队的 UI 项；<br/>视图缺失或阶段为空时不创建绘制通道。" }
  class n9 node_system
  n10@{ shape: lin-rect, label: "**Core3dSystems::EarlyPostProcess**<br/>安排三维主绘制后的早期后处理。" }
  class n10 node_system_set
  n11@{ shape: rounded, label: "**upscaling**<br/>把视图主颜色纹理通过 Blit 管线写入最终<br/>输出附件，遵循相机的输出模式、清屏颜色和<br/>视口；输出模式为 Skip 时不写入。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**egui_pass**<br/>来自Egui / Inspector ↗：读取当前<br/>Egui 视图已准备的绘制数据、纹理绑定及变<br/>换缓冲，在目标颜色附件上执行 Egui 绘制<br/>命令，并按相机视口设置渲染范围。" }
  class n12 node_system
  class n12 external_node
  n1 e0@-->|"RenderApp / Core3d"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_set_membership
  n0 e4@--> n5
  class e4 edge_set_membership
  n0 e5@--> n6
  class e5 edge_set_membership
  n0 e6@--> n7
  class e6 edge_set_membership
  n0 e7@--> n8
  class e7 edge_set_membership
  n0 e8@--> n9
  class e8 edge_order
  n10 e9@--> n0
  class e9 edge_order
  n0 e10@--> n11
  class e10 edge_order
  n0 e11@--> n12
  class e11 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
