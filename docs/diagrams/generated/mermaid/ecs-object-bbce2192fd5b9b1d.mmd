---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-bbce2192fd5b9b1d-e9{marker-start:url(#object-bbce2192fd5b9b1d_flowchart-v2-pointStart)!important}\n#object-bbce2192fd5b9b1d-e12{marker-start:url(#object-bbce2192fd5b9b1d_flowchart-v2-pointStart)!important}\n#object-bbce2192fd5b9b1d_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: init_collider_constructor_hierarchies · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**init_collider_constructor_**<br/>**hierarchies**<br/>按 ColliderConstructorHierarchy 的默<br/>认及逐名称配置为后代生成碰撞体，写入碰撞<br/>层和密度；需要场景实例时等待就绪，需要网<br/>格时等待资产可用。完成该层级处理后移除构<br/>造配置并发出<br/>ColliderConstructorHierarchyReady。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · Update**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: notch-rect, label: "**Commands**<br/>来自Bevy 引擎 ↗：保存延迟执行的<br/>World 操作队列" }
  class n2 node_system_param
  class n2 external_node
  n3@{ shape: cyl, label: "**Assets#lt;Mesh#gt;**<br/>来自Bevy 引擎 ↗：保存模型网格并提供碰<br/>撞构建所需的顶点。" }
  class n3 node_resource
  class n3 external_node
  n4@{ shape: rounded, label: "**Mesh3d**<br/>来自Bevy 引擎 ↗：为三维可绘制实体指定<br/>网格资产。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: cyl, label: "**ColliderCache**<br/>复用由网格构建的碰撞体形状。" }
  class n5 node_resource
  n6@{ shape: rounded, label: "**ColliderConstructorHierarchy**<br/>批量配置层级中的碰撞体构造。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**Children**<br/>来自Bevy 引擎 ↗：保存以 ChildOf 指向<br/>当前父实体的子实体集合" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**Name**<br/>来自Bevy 引擎 ↗：保存供调试和界面展示<br/>的实体名称及缓存哈希" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**Collider**<br/>保存 Parry 碰撞后端的几何形状。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**CollisionLayers**<br/>声明碰撞体所属层和可交互层。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**ColliderDensity**<br/>以密度参与碰撞体质量计算。" }
  class n11 node_component
  n12@{ shape: stadium, label: "**ColliderConstructorHierarchyReady**<br/>通知层级碰撞体构造尝试已经结束。" }
  class n12 node_event
  n1 e0@-->|"main / Update"| n0
  class e0 edge_registration
  n2 e1@-->|"参数 / 查询数据"| n0
  class e1 edge_reference
  n3 e2@--> n0
  class e2 edge_read
  n4 e3@--> n0
  class e3 edge_read
  n0 e4@--> n5
  class e4 edge_write
  n6 e5@--> n0
  class e5 edge_read
  n7 e6@--> n0
  class e6 edge_read
  n8 e7@--> n0
