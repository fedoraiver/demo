  n9 e8@--> n0
  class e8 edge_read
  n9 e9@---|"延迟添加"| n0
  class e9 edge_write
  n0 e10@-->|"延迟添加"| n10
  class e10 edge_write
  n0 e11@-->|"延迟添加"| n11
  class e11 edge_write
  n6 e12@---|"延迟移除"| n0
  class e12 edge_write
  n0 e13@-->|"延迟触发事件"| n12
  class e13 edge_emit
