flowchart LR
  accTitle: motion_blur · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**motion_blur**<br/>读取当前视图颜色、预通道运动矢量和深度，<br/>按快门角度及采样数执行运动模糊；采样关<br/>闭、所需纹理或管线不可用时跳过。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · Core3d**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**Core3dSystems::PostProcess**<br/>执行三维色调映射及最终屏幕后处理。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**bloom**<br/>对 HDR 视图颜色执行 Bloom 降采样和上采<br/>样通道，将亮部扩散合成回视图；强度为零、<br/>非 HDR 或所需管线和参数缓冲未就绪时不执<br/>行。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**ViewTarget**<br/>管理视图主颜色纹理及最终输出附件。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**MotionBlurPipelineId**<br/>记录当前视图的运动模糊管线标识。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**ViewPrepassTextures**<br/>汇集视图已启用的预通道输出纹理。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**ViewDepthStencilTexture**<br/>提供视图绘制的深度模板附件。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**MotionBlurUniform**<br/>向运动模糊着色器传递快门角度和采样数。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**Msaa**<br/>选择视图的多重采样抗锯齿样本数。" }
  class n9 node_component
  n10@{ shape: cyl, label: "**MotionBlurPipeline**<br/>提供运动模糊的采样器、布局和着色器。" }
  class n10 node_resource
  n11@{ shape: cyl, label: "**PipelineCache**<br/>缓存 GPU 渲染、计算管线与待创建队列。" }
  class n11 node_resource
  n12@{ shape: cyl, label: "**ComponentUniforms#lt;MotionBlurUniform#gt;**<br/>汇集同类组件的动态 Uniform 数据。" }
  class n12 node_resource
  n13@{ shape: cyl, label: "**GlobalsBuffer**<br/>向着色器提供全局时间等 Uniform 数据。" }
  class n13 node_resource
  n14@{ shape: notch-rect, label: "**RenderContext**<br/>向渲染系统提供命令编码器和 GPU 设备。" }
