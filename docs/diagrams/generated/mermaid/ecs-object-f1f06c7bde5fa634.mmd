{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: PhysicsSystems::Prepare · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**PhysicsSystems::Prepare**<br/>准备物理步所需的位姿、质量与碰撞查询数<br/>据。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**PhysicsSystems::StepSimulation**<br/>执行碰撞求解、重力积分与刚体运动。" }
  class n1 node_system_set
  n2@{ shape: rounded, label: "**ApplyDeferred（提前唤醒 → 物理准备）**<br/>来自物理基础 ↗：使提前唤醒命令在物理准<br/>备前可见。" }
  class n2 node_sync
  class n2 external_node
  n3@{ shape: stadium, label: "**main · FixedPostUpdate**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n3 node_engine_flow
  class n3 external_node
  n4@{ shape: lin-rect, label: "**MassPropertySystems::**<br/>**UpdateColliderMassProperties**<br/>从碰撞体几何和密度更新质量属性。" }
  class n4 node_system_set
  n5@{ shape: lin-rect, label: "**PhysicsTransformSystems::**<br/>**TransformToPosition**<br/>把外部变换变化同步到物理姿态。" }
  class n5 node_system_set
  n6@{ shape: lin-rect, label: "**MassPropertySystems::**<br/>**QueueRecomputation**<br/>标记需要重新计算质量属性的实体。" }
  class n6 node_system_set
  n7@{ shape: lin-rect, label: "**MassPropertySystems::**<br/>**UpdateComputedMassProperties**<br/>重新计算刚体有效质量、质心和惯量。" }
  class n7 node_system_set
  n8@{ shape: lin-rect, label: "**TransformSystems::Propagate**<br/>来自Bevy 引擎 ↗：沿实体层级传播世界变<br/>换。" }
  class n8 node_system_set
  class n8 external_node
  n9@{ shape: rounded, label: "**update_collider_scale#lt;avian3d::**<br/>**collision::collider::parry::**<br/>**Collider#gt;**<br/>把根节点和附属碰撞体的缩放传给形状。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**wake_changed_bodies**<br/>来自物理基础 ↗：使休眠身体的外部受力和<br/>位姿修改在本固定步生效。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: lin-rect, label: "**PhysicsSystems::First**<br/>在所有 Avian 物理系统之前提供准备边界。" }
  class n11 node_system_set
  n12@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n12 node_component
  class n12 external_node
  n13@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存自由运动或共享持<br/>握时的显示姿态。" }
  class n13 node_component
  class n13 external_node
  n14@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存静态碰撞与原模型<br/>共用的位姿。" }
  class n14 node_component
  class n14 external_node
