  class e4 edge_reference
  n6 e5@-->|"存在 / 变更过滤"| n0
  class e5 edge_reference
  n7 e6@-->|"参数 / 查询数据"| n0
  class e6 edge_reference
  n0 e7@--> n8
  class e7 edge_write
  n5 e8@--> n0
  class e8 edge_read
  n9 e9@--> n0
  class e9 edge_read
  n0 e10@--> n10
  class e10 edge_write
