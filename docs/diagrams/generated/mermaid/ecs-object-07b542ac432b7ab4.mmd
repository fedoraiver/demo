---
flowchart LR
  accTitle: gamepad_connection_system · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**gamepad_connection_system**<br/>按连接消息添加或移除手柄组件。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PreUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**InputSystems**<br/>汇总键盘与鼠标输入状态。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**gamepad_event_processing_system**<br/>过滤原始手柄数值并更新设备状态。" }
  class n3 node_system
  n4@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n4 node_system_param
  n5@{ shape: cyl, label: "**Messages#lt;GamepadConnectionEvent#gt;**<br/>保存 GamepadConnectionEvent 消息。" }
  class n5 node_message_buffer
  n6@{ shape: rounded, label: "**Name**<br/>保存供调试和界面展示的实体名称及缓存哈希" }
  class n6 node_component
  n7@{ shape: rounded, label: "**Gamepad**<br/>保存一个手柄的数字按钮状态、模拟轴值及厂<br/>商产品信息" }
  class n7 node_component
  n1 e0@-->|"main / PreUpdate"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_order
  n4 e3@-->|"参数 / 查询数据"| n0
  class e3 edge_reference
  n5 e4@--> n0
  class e4 edge_consume
  n0 e5@-->|"延迟添加"| n6
  class e5 edge_write
  n0 e6@-->|"延迟添加"| n7
  class e6 edge_write
  n0 e7@-->|"延迟移除"| n7
  class e7 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: bumpX }
  e6@{ curve: basis }
  e7@{ curve: basis }
