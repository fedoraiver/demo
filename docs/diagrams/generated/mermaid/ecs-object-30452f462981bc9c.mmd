---
flowchart LR
  accTitle: ImageNodeTextureAtlasLayout · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ImageNodeTextureAtlasLayout**<br/>缓存 UI 图像节点引用的纹理图集布局。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**mark_images_as_changed_if_their_**<br/>**assets_changed**<br/>使图像或图集资产变化触发 UI 图像更新。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update_texture_atlas_layout_**<br/>**components**<br/>同步 UI 图像所引用的图集布局组件。" }
  class n2 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@-->|"延迟添加"| n0
  class e1 edge_write
  n2 e2@-->|"延迟移除"| n0
  class e2 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
