---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: 子状态转换闭包 · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**子状态转换闭包**<br/>监听父状态变化与待处理的子状态切换，计<br/>算 demo::game_flow::PlayState 是否仍<br/>应存在，应用转换并写入状态转换消息；闭包<br/>由 demo::game_flow::AppState 的<br/>StateSet 实现注册。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · StateTransition**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**ApplyStateTransition ·**<br/>**(PhantomData#lt;demo::game_flow::**<br/>**PlayState#gt;)**<br/>应用待处理状态及其依赖子状态转换。" }
  class n2 node_system_set
  n3@{ shape: cyl, label: "**Messages#lt;StateTransitionEvent#lt;AppSta**<br/>**te#gt;#gt;**<br/>来自应用流程 ↗：缓冲应用主状态转换的日<br/>志输入。" }
  class n3 node_message_buffer
  class n3 external_node
  n4@{ shape: cyl, label: "**Messages#lt;StateTransitionEvent#lt;PlaySt**<br/>**ate#gt;#gt;**<br/>来自应用流程 ↗：缓冲游戏运行与暂停转换<br/>的日志输入。" }
  class n4 node_message_buffer
  class n4 external_node
  n5@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n5 node_system_param
  n6@{ shape: cyl, label: "**State#lt;PlayState#gt;**<br/>保存某个状态类型当前生效的值" }
  class n6 node_resource
  n7@{ shape: cyl, label: "**PreviousState#lt;PlayState#gt;**<br/>保存最近一次转换前的状态值" }
  class n7 node_resource
  n8@{ shape: cyl, label: "**NextState#lt;PlayState#gt;**<br/>保存待处理的状态切换请求" }
  class n8 node_resource
  n9@{ shape: cyl, label: "**State#lt;AppState#gt;**<br/>保存某个状态类型当前生效的值" }
  class n9 node_resource
  n1 e0@-->|"main / StateTransition"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n3 e2@--> n0
  class e2 edge_consume
  n0 e3@--> n4
  class e3 edge_publish
  n5 e4@-->|"参数 / 查询数据"| n0
  class e4 edge_reference
  n0 e5@--> n6
  class e5 edge_write
  n0 e6@--> n7
  class e6 edge_write
  n0 e7@--> n8
  class e7 edge_write
  n9 e8@--> n0
  class e8 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
