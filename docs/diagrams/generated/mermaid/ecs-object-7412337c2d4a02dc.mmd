  n3@{ shape: cyl, label: "**DepthOfFieldGlobalBindGroupLayout**<br/>定义景深共享参数布局与颜色采样器。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**DepthOfFieldGlobalBindGroup**<br/>保存跨视图共享的景深着色器资源绑定。" }
  class n4 node_resource
