---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: prepare_egui_pass · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**prepare_egui_pass**<br/>消费每个 Egui 视图暂缓处理的绘制回调更<br/>新，构造视口、裁剪、像素比例和目标尺寸信<br/>息，并在当前渲染世界调用回调的 update。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · Core3d**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: rounded, label: "**egui_pass**<br/>读取当前 Egui 视图已准备的绘制数据、纹<br/>理绑定及变换缓冲，在目标颜色附件上执行<br/>Egui 绘制命令，并按相机视口设置渲染范<br/>围。" }
  class n2 node_system
  n3@{ shape: notch-rect, label: "**World**<br/>来自Bevy 引擎 ↗：保存实体、组件、资源<br/>及关联元数据" }
  class n3 node_system_param
  class n3 external_node
  n4@{ shape: cyl, label: "**EguiRenderData**<br/>缓存 EguiPipeline 各特化实例的渲染管线<br/>身份" }
  class n4 node_resource
  n1 e0@-->|"RenderApp / Core3d"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_order
  n0 e2@--> n3
  class e2 edge_write
  n0 e3@-->|"正文可变访问"| n4
  class e3 edge_write
  e1@{ curve: basis }
  e3@{ curve: basis }
