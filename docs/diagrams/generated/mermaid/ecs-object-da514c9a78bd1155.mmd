  class n3 external_node
  n4@{ shape: rounded, label: "**sprite​_​picking**<br/>来自crate:bevy​_​sprite ↗：按精灵图像和<br/>拾取配置计算指针命中。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**check​_​point​_​light​_​mesh​_​visibility**<br/>来自crate:bevy​_​light ↗：计算点光与聚<br/>光灯阴影可见的网格。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**on​_​egui​_​context​_​added​_​system**<br/>来自crate:bevy​_​egui ↗：登记新建<br/>Egui 上下文的窗口映射。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**propagate​_​ui​_​target​_​cameras**<br/>来自crate:bevy​_​ui ↗：为 UI 根配置目标<br/>相机和视口信息传播源。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**viewport​_​picking**<br/>来自crate:bevy​_​ui ↗：把外部指针转换并<br/>转发到 UI 内嵌视口。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**ui​_​picking**<br/>来自crate:bevy​_​ui ↗：按 UI 堆叠与相机<br/>视口计算指针命中。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**extract​_​viewport​_​nodes**<br/>来自crate:bevy​_​ui​_​render ↗：把视口节<br/>点所引用相机的输出图像嵌入 UI。" }
