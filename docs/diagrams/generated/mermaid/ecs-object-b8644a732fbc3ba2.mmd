---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: QueueRecomputation · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: lin-rect, label: "**QueueRecomputation**<br/>组织质量属性重算与写回。" }
  class n0 node_system_set
  end
  style layout_card_n0 fill:none,stroke:none
  n1@{ shape: lin-rect, label: "**UpdateColliderMassProperties**<br/>组织质量属性重算与写回。" }
  class n1 node_system_set
  n2@{ shape: lin-rect, label: "**TransformToPosition**<br/>组织实体变换与物理姿态同步。" }
  class n2 node_system_set
  n3@{ shape: lin-rect, label: "**Prepare**<br/>划分物理准备、模拟与回写边界。" }
  class n3 node_system_set
  n4@{ shape: rounded, label: "**avian3d::dynamics::rigid​_​body::mass​_​**<br/>**properties::queue​_​mass​_​**<br/>**recomputation​_​on​_​mass​_​change**<br/>在刚体质量输入变化时请求重算。" }
  class n4 node_system
  n5@{ shape: lin-rect, label: "**UpdateComputedMassProperties**<br/>组织质量属性重算与写回。" }
  class n5 node_system_set
  n6@{ shape: rounded, label: "**avian3d::dynamics::rigid​_​body::mass​_​**<br/>**properties::queue​_​mass​_​**<br/>**recomputation​_​on​_​collider​_​mass​_​**<br/>**change**<br/>在附属碰撞体质量输入变化时请求刚体重算。" }
  class n6 node_system
  n1 e0@-->|"先于"| n0
  class e0 edge_order
  n2 e1@-->|"先于"| n0
  class e1 edge_order
  n3 e2@-->|"集合成员"| n0
  class e2 edge_set_membership
  n0 e3@-->|"集合成员"| n4
  class e3 edge_set_membership
  n0 e4@-->|"先于"| n5
  class e4 edge_order
  n0 e5@-->|"集合成员"| n6
  class e5 edge_set_membership
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
