---
flowchart LR
  accTitle: IndirectParametersBuildJobs · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**IndirectParametersBuildJobs**<br/>按对齐要求存储间接绘制参数构建任务。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**prepare_indirect_parameters_build_**<br/>**jobs**<br/>按视图阶段的批范围登记间接参数构建任务。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**write_indirect_parameters_build_jobs**<br/>上传间接参数构建任务的动态参数缓冲。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare_preprocess_bind_groups**<br/>绑定各视图网格预处理和间接参数构建资源。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**init_gpu_resource#lt;bevy_render::**<br/>**batching::gpu_preprocessing::**<br/>**IndirectParametersBuildJobs#gt;**<br/>通过 FromWorld 构建指定的 GPU 资源，并<br/>将初始化结果插入当前世界。" }
  class n4 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_read
  n4 e3@-->|"正文添加"| n0
  class e3 edge_write
  e0@{ curve: basis }
  e3@{ curve: basis }
