---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: GizmoHandles · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**GizmoHandles**<br/>按配置组记录当前调试图元资产句柄。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**bevy​_​gizmos::update​_​gizmo​_​**<br/>**meshes#lt;bevy​_​gizmos::frustum::**<br/>**FrustumGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**bevy​_​gizmos::update​_​gizmo​_​**<br/>**meshes#lt;bevy​_​gizmos::aabb::**<br/>**AabbGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**bevy​_​gizmos::update​_​gizmo​_​**<br/>**meshes#lt;bevy​_​gizmos::config::**<br/>**DefaultGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**bevy​_​gizmos::update​_​gizmo​_​**<br/>**meshes#lt;bevy​_​light::gizmos::**<br/>**LightGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**bevy​_​gizmos​_​render::extract​_​gizmo​_​**<br/>**data**<br/>来自crate:bevy​_​gizmos​_​render ↗：把启<br/>用的即时 Gizmo 数据提取为渲染实体。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**bevy​_​gizmos::update​_​gizmo​_​**<br/>**meshes#lt;bevy​_​gizmos::skinned​_​mesh​_​**<br/>**bounds::**<br/>**SkinnedMeshBoundsGizmoConfigGroup#gt;**<br/>把配置组即时线条缓冲转交 Gizmo 资产。" }
  class n6 node_system
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n2 e1@-->|"可变访问"| n0
  class e1 edge_write
  n3 e2@-->|"可变访问"| n0
  class e2 edge_write
  n4 e3@-->|"可变访问"| n0
  class e3 edge_write
  n0 e4@--> n5
  class e4 edge_read
  n6 e5@-->|"可变访问"| n0
  class e5 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
