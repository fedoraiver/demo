---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: extract_screenshots · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**extract_screenshots**<br/>在主世界收集尚未捕获的截图请求，规范化窗<br/>口或纹理目标并为本帧去重；记录渲染截图目<br/>标、标记 Capturing，并销毁同一目标的重<br/>复请求实体。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: cyl, label: "**RenderScreenshotTargets**<br/>按截图请求实体保存本帧的规范化渲染目标。" }
  class n2 node_resource
  n3@{ shape: cyl, label: "**MainWorld**<br/>在提取阶段临时提供主模拟世界。" }
  class n3 node_resource
  n4@{ shape: notch-rect, label: "**Option#lt;SystemState#lt;(Commands,**<br/>**Query#lt;Entity, With#lt;PrimaryWindow#gt;#gt;,**<br/>**Query#lt;(Entity, Screenshot),**<br/>**Without#lt;Capturing#gt;#gt;)#gt;#gt;**<br/>缓存主世界截图提取使用的系统参数状态。" }
  class n4 node_local
  n5@{ shape: notch-rect, label: "**HashSet#lt;NormalizedRenderTarget#gt;**<br/>去重本帧指向相同渲染目标的截图请求。" }
  class n5 node_local
  n6@{ shape: rounded, label: "**Capturing**<br/>标记截图请求正在异步捕获。" }
  class n6 node_component
  n1 e0@-->|"RenderApp / ExtractSchedule"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_write
  n0 e4@--> n5
  class e4 edge_write
  n0 e5@-->|"延迟添加"| n6
  class e5 edge_write
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
