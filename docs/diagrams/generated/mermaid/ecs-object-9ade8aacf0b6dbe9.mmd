---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: demo::character::log_configuration · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**demo::character::log​_​configuration**<br/>记录实际玩法配置；显式保留日志分类，兼容<br/>现有过滤设置。" }
  class n0 node_system
  n1@{ shape: cyl, label: "**settings::prototype::PrototypeConfig**<br/>来自settings ↗：原型的运动、平地和持箱<br/>参数。" }
  class n1 node_resource
  class n1 external_node
  n2@{ shape: fr-rect, label: "**character::CharacterPlugin**<br/>注册角色运动与反射元数据，不加载窗口、场<br/>景或其他项目插件。" }
  class n2 node_plugin
  n1 e0@--> n0
  class e0 edge_read
  n2 e1@-->|"调用"| n0
  class e1 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
