---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: queue_shadows · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**queue_shadows**<br/>为提取的 UI 阴影选择匹配目标格式和阴影<br/>采样数的管线，按节点堆叠顺序及阴影层偏移<br/>加入透明 UI 绘制阶段。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · Render**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**RenderSystems::Queue**<br/>把可绘制实体排入对应渲染阶段。" }
  class n2 node_system_set
  n3@{ shape: cyl, label: "**ExtractedBoxShadows**<br/>按主世界节点保存已提取的 UI 阴影。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**BoxShadowPipeline**<br/>提供 UI 方框阴影的视图布局和着色器。" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**SpecializedRenderPipelines#lt;BoxShadow**<br/>**Pipeline#gt;**<br/>按配置键缓存渲染管线变体。" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**ViewSortedRenderPhases#lt;TransparentUi**<br/>**#gt;**<br/>汇集各视图需要排序的绘制指令。" }
  class n6 node_resource
  n7@{ shape: rounded, label: "**UiCameraView**<br/>从主渲染目标视图定位对应的 UI 视图。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**BoxShadowSamples**<br/>配置相机 UI 阴影的采样次数。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**ExtractedView**<br/>描述渲染视图的身份、投影与空间状态。" }
  class n9 node_component
  n10@{ shape: cyl, label: "**PipelineCache**<br/>缓存 GPU 渲染、计算管线与待创建队列。" }
  class n10 node_resource
  n11@{ shape: cyl, label: "**DrawFunctions#lt;TransparentUi#gt;**<br/>注册并查询指定绘制项的绘制函数。" }
  class n11 node_resource
  n1 e0@-->|"RenderApp / Render"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_read
  n0 e4@--> n5
  class e4 edge_write
  n0 e5@--> n6
  class e5 edge_write
  n7 e6@--> n0
  class e6 edge_read
  n8 e7@--> n0
  class e7 edge_read
  n9 e8@-->|"存在 / 变更过滤"| n0
  class e8 edge_reference
  n9 e9@--> n0
  class e9 edge_read
  n10 e10@--> n0
  class e10 edge_read
  n11 e11@--> n0
  class e11 edge_read
