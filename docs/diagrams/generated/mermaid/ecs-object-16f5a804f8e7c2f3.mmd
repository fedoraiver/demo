---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-16f5a804f8e7c2f3-e3{marker-start:url(#object-16f5a804f8e7c2f3_flowchart-v2-pointStart)!important}\n#object-16f5a804f8e7c2f3_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: bevy_core_pipeline::prepass::PreviousViewData · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**PreviousViewData**<br/>保存上一帧的相机视图与投影矩阵。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**prepare​_​previous​_​view​_​uniforms**<br/>来自crate:bevy​_​pbr ↗：重建前帧抖动矩<br/>阵并上传视图历史参数。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**extract​_​camera​_​previous​_​view​_​data**<br/>来自crate:bevy​_​pbr ↗：把活动三维相机<br/>的前帧视图数据提取到渲染侧。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**update​_​previous​_​view​_​data**<br/>来自crate:bevy​_​pbr ↗：记录三维及阴影<br/>视图未抖动的变换矩阵。" }
  class n3 node_system
  class n3 external_node
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"插入"| n0
  class e1 edge_write
  n3 e2@-->|"插入"| n0
  class e2 edge_write
  n2 e3@--- n0
  class e3 edge_read
  n2 e4@-->|"移除"| n0
  class e4 edge_write
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
