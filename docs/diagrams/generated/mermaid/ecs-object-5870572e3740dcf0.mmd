flowchart LR
  accTitle: bevy_inspector_egui::quick::world_inspector_ui · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**bevy​_​inspector​_​egui::quick::world​_​**<br/>**inspector​_​ui**<br/>在主 Egui 上下文展示可编辑的 World 检<br/>视器。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**EguiContext**<br/>来自crate:bevy​_​egui ↗：包装一个<br/>egui::Context" }
  class n1 node_component
  class n1 external_node
  n2@{ shape: rounded, label: "**PrimaryEguiContext**<br/>来自crate:bevy​_​egui ↗：标记运行<br/>主Egui调度的上下文。" }
  class n2 node_component
  class n2 external_node
  n3@{ shape: rounded, label: "**demo::game​_​flow::gameplay​_​running**<br/>来自game​_​flow ↗：独立功能测试没有应用<br/>状态；真实游戏只在 Running 推进玩法。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: cyl, label: "**bevy​_​ecs::entity​_​disabling::**<br/>**DefaultQueryFilters**<br/>来自crate:bevy​_​ecs ↗：保存默认禁用实<br/>体查询过滤规则。" }
  class n4 node_resource
  class n4 external_node
  n1 e0@--> n0
  class e0 edge_read
  n2 e1@-->|"存在性约束"| n0
  class e1 edge_reference
  n3 e2@-->|"运行条件"| n0
  class e2 edge_reference
  n4 e3@--> n0
  class e3 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
