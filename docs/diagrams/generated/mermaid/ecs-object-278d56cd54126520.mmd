---
flowchart LR
  accTitle: SparseBufferUpdateJobs · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**SparseBufferUpdateJobs**<br/>暂存待执行的稀疏缓冲更新任务。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**clear_sparse_buffer_jobs**<br/>清空新帧的稀疏缓冲更新任务。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**write_batched_instance_buffers#lt;bevy_**<br/>**pbr::render::mesh::MeshPipeline#gt;**<br/>上传实例输入、预处理任务并准备稀疏更新。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**write_mesh_culling_data_buffer**<br/>上传网格裁剪数据并准备稀疏填充任务。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**update_sparse_buffers**<br/>用计算通道把变化元素写入稀疏 GPU 缓冲。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**init_gpu_resource#lt;bevy_render::**<br/>**render_resource::sparse_buffer_vec::**<br/>**SparseBufferUpdateJobs#gt;**<br/>通过 FromWorld 构建指定的 GPU 资源，并<br/>将初始化结果插入当前世界。" }
  class n5 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_read
  n5 e4@-->|"正文添加"| n0
  class e4 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
