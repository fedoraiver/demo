  n2@{ shape: stadium, label: "**AddEvent**<br/>来自crate:bevy​_​ecs ↗：通知组件首次加<br/>入实体。" }
  class n2 node_event
  class n2 external_node
  n3@{ shape: cyl, label: "**ContactStatusChangeQueue**<br/>暂存窄相产生的接触状态变化。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**Messages#lt;CollisionEnd#gt;**<br/>来自crate:bevy​_​ecs ↗：保存最近两次轮<br/>换期间产生的指定类型消息" }
  class n4 node_resource
  class n4 external_node
  n5@{ shape: rounded, label: "**CollidingEntities**<br/>记录当前与碰撞体相交的实体。" }
  class n5 node_component
  n6@{ shape: cyl, label: "**ContactGraph**<br/>维护碰撞体接触对及其碰撞数据。" }
  class n6 node_resource
