---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: main · StateTransition · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef node_system_group fill:#F2F5F7,stroke:#607C96,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**main · StateTransition**<br/>保存本应用调度的注册上下文与成员。" }
  class n0 node_engine_flow
  n1@{ shape: rounded, label: "**apply_state_transition#lt;demo::game_**<br/>**flow::AppState#gt;**<br/>取出 NextState 中待提交的新状态及是否<br/>允许同值切换的设置；当前状态存在时交给内<br/>部状态转换逻辑更新状态、保留前态并发布转<br/>换消息。" }
  class n1 node_system
  n2@{ shape: fr-rect, label: "**Pipe(bevy_state::state::**<br/>**transitions::last_transition#lt;demo::**<br/>**game_flow::AppState#gt;, bevy_state::**<br/>**state::transitions::run_exit#lt;demo::**<br/>**game_flow::AppState#gt;)**<br/>按管道顺序执行组合系统。" }
  class n2 node_system_group
  n3@{ shape: rounded, label: "**despawn_entities_on_exit_**<br/>**state#lt;demo::game_flow::AppState#gt;**<br/>读取最新状态转换消息，对<br/>DespawnOnExit 值匹配退出状态的实体排入<br/>销毁；包括禁用实体，未发生有效转换时不遍<br/>历。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**disable_entities_on_exit_**<br/>**state#lt;demo::game_flow::AppState#gt;**<br/>有效状态转换退出指定值时，对匹配<br/>DisableOnExit 的实体及 Children 后代<br/>递归添加 Disabled，停用整条子树。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**enable_entities_on_exit_state#lt;demo::**<br/>**game_flow::AppState#gt;**<br/>有效状态转换退出指定值时，对匹配<br/>EnableOnExit 且已禁用的实体及<br/>Children 后代递归移除 Disabled，重新启<br/>用该子树。" }
  class n5 node_system
  n6@{ shape: fr-rect, label: "**Pipe(bevy_state::state::**<br/>**transitions::last_transition#lt;demo::**<br/>**game_flow::AppState#gt;, bevy_state::**<br/>**state::transitions::run_**<br/>**transition#lt;demo::game_flow::**<br/>**AppState#gt;)**<br/>按管道顺序执行组合系统。" }
  class n6 node_system_group
  n7@{ shape: rounded, label: "**despawn_entities_when_state#lt;demo::**<br/>**game_flow::AppState#gt;**<br/>读取最新有效状态转换，逐个调用<br/>DespawnWhen 保存的转换判定函数；判定命<br/>中时安全销毁实体，包括当前已禁用的实体。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**disable_entities_when_state#lt;demo::**<br/>**game_flow::AppState#gt;**<br/>读取最新有效状态转换，调用<br/>DisableWhen 的转换判定函数；命中时给实<br/>体及 Children 后代递归添加 Disabled。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**enable_entities_when_state#lt;demo::**<br/>**game_flow::AppState#gt;**<br/>读取最新有效状态转换，调用 EnableWhen<br/>的转换判定函数；命中时从当前禁用实体及<br/>Children 后代递归移除 Disabled。" }
  class n9 node_system
  n10@{ shape: fr-rect, label: "**Pipe(bevy_state::state::**<br/>**transitions::last_transition#lt;demo::**<br/>**game_flow::AppState#gt;, bevy_state::**<br/>**state::transitions::run_enter#lt;demo::**<br/>**game_flow::AppState#gt;)**<br/>按管道顺序执行组合系统。" }
  class n10 node_system_group
  n11@{ shape: rounded, label: "**despawn_entities_on_enter_**<br/>**state#lt;demo::game_flow::AppState#gt;**<br/>读取最新状态转换消息，对<br/>DespawnOnEnter 值匹配进入状态的实体排<br/>入销毁；包括禁用实体，未发生有效转换时跳<br/>过。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**disable_entities_on_enter_**<br/>**state#lt;demo::game_flow::AppState#gt;**<br/>有效状态转换进入指定值时，对匹配<br/>DisableOnEnter 的实体及 Children 后代<br/>递归添加 Disabled。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**enable_entities_on_enter_**<br/>**state#lt;demo::game_flow::AppState#gt;**<br/>有效状态转换进入指定值时，对匹配<br/>EnableOnEnter 且已禁用的实体及<br/>Children 后代递归移除 Disabled。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**ApplyDeferred**<br/>在调度建立的同步点应用前序系统暂存的<br/>Commands 等延迟操作，使后续系统可以观察<br/>到结构变化；此卡片是 ApplyDeferred 的<br/>System 实现。" }
  class n14 node_sync
  n15@{ shape: rounded, label: "**ApplyDeferred**<br/>在调度建立的同步点应用前序系统暂存的<br/>Commands 等延迟操作，使后续系统可以观察<br/>到结构变化；此卡片是 ApplyDeferred 的<br/>System 实现。" }
  class n15 node_sync
  n16@{ shape: rounded, label: "**ApplyDeferred**<br/>在调度建立的同步点应用前序系统暂存的<br/>Commands 等延迟操作，使后续系统可以观察<br/>到结构变化；此卡片是 ApplyDeferred 的<br/>System 实现。" }
  class n16 node_sync
  n17@{ shape: lin-rect, label: "**StateTransitionSystems::**<br/>**DependentTransitions**<br/>先计算彼此依赖的状态转换。" }
  class n17 node_system_set
  n18@{ shape: lin-rect, label: "**ApplyStateTransition ·**<br/>**(PhantomData#lt;demo::game_flow::**<br/>**AppState#gt;)**<br/>应用待处理状态及其依赖子状态转换。" }
  class n18 node_system_set
  n19@{ shape: lin-rect, label: "**ExitSchedules**<br/>执行旧状态的退出调度和退出生命周期。" }
  class n19 node_system_set
  n20@{ shape: lin-rect, label: "**ExitSchedules · (PhantomData#lt;demo::**<br/>**game_flow::AppState#gt;)**<br/>执行旧状态的退出调度和退出生命周期。" }
  class n20 node_system_set
  n21@{ shape: lin-rect, label: "**TransitionSchedules**<br/>执行特定状态对的转换和谓词生命周期。" }
  class n21 node_system_set
  n22@{ shape: lin-rect, label: "**TransitionSchedules ·**<br/>**(PhantomData#lt;demo::game_flow::**<br/>**AppState#gt;)**<br/>执行特定状态对的转换和谓词生命周期。" }
  class n22 node_system_set
  n23@{ shape: lin-rect, label: "**EnterSchedules**<br/>执行新状态的进入调度和进入生命周期。" }
  class n23 node_system_set
  n24@{ shape: lin-rect, label: "**EnterSchedules · (PhantomData#lt;demo::**<br/>**game_flow::AppState#gt;)**<br/>执行新状态的进入调度和进入生命周期。" }
