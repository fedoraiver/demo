---
flowchart LR
  accTitle: button_on_pointer_cancel · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: hex, label: "**button_on_pointer_cancel**<br/>收到取消事件时移除原生Pressed。" }
  class n0 node_observer
  n1@{ shape: stadium, label: "**PointerCancel**<br/>收到取消事件时移除原生Pressed。" }
  class n1 node_event
  n2@{ shape: fr-rect, label: "**ButtonPlugin**<br/>为原生按钮注册六个事件Observer。" }
  class n2 node_plugin
  n3@{ shape: rounded, label: "**Pressed**<br/>标记原生按钮当前被按压。" }
  class n3 node_component
  n4@{ shape: stadium, label: "**RemoveEvent**<br/>正移除 Pressed 且仍具有 MenuButton 的<br/>实体" }
  class n4 node_event
  n5@{ shape: rounded, label: "**Button**<br/>启用原生界面按钮命中处理。" }
  class n5 node_component
  n1 e0@-->|"PointerCancel"| n0
  class e0 edge_observe
  n2 e1@--> n0
  class e1 edge_registration
  n3 e2@---|"移除"| n0
  class e2 edge_write
  n0 e3@-->|"RemoveEvent（Pressed） lifecycle"| n4
  class e3 edge_emit
  n5 e4@-->|"With#lt;Button#gt;"| n0
  class e4 edge_reference
  n3 e5@-->|"Has#lt;Pressed#gt;"| n0
  class e5 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
