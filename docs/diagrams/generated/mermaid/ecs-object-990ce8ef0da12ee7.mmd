---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: TransformEasingSystems::Reset · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**TransformEasingSystems::Reset**<br/>重置上一轮固定步的插值状态。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**resume_interpolation**<br/>来自越界恢复 ↗：撤销落水恢复添加的临时<br/>插值暂停。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**resume_carry_easing**<br/>来自物品交互 ↗：恢复物品释放前未暂停的<br/>插值通道。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: stadium, label: "**main · FixedFirst**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n3 node_engine_flow
  class n3 external_node
  n4@{ shape: rounded, label: "**reset_translation_easing**<br/>清除旧位置平滑的起点和终点。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**reset_rotation_easing**<br/>清除旧旋转平滑的起点和终点。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**reset_scale_easing**<br/>清除旧缩放平滑的起点和终点。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**reset_translation_extrapolation**<br/>在固定步开始前还原真实位置。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**complete_scale_easing**<br/>在新一轮插值前完成上一段缩放。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**reset_rotation_extrapolation**<br/>在固定步开始前还原真实旋转。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n10 node_component
  class n10 external_node
  n11@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存自由运动或共享持<br/>握时的显示姿态。" }
  class n11 node_component
  class n11 external_node
  n12@{ shape: rounded, label: "**TranslationEasingState**<br/>保存固定步平移插值的起止端点。" }
  class n12 node_component
  n13@{ shape: rounded, label: "**TranslationEasingState**<br/>保存固定步平移插值的起止端点。" }
  class n13 node_component
  n14@{ shape: rounded, label: "**RotationEasingState**<br/>保存旋转显示插值的起止端点。" }
  class n14 node_component
  n15@{ shape: rounded, label: "**ScaleEasingState**<br/>保存缩放显示插值的起止端点。" }
  class n15 node_component
  n0 e0@--> n1
  class e0 edge_order
  n0 e1@--> n2
  class e1 edge_order
  n3 e2@-->|"main / FixedFirst"| n0
  class e2 edge_registration
  n0 e3@--> n4
  class e3 edge_set_membership
  n0 e4@--> n5
  class e4 edge_set_membership
  n0 e5@--> n6
  class e5 edge_set_membership
  n7 e6@--> n0
  class e6 edge_order
  n8 e7@--> n0
  class e7 edge_order
  n9 e8@--> n0
  class e8 edge_order
  n10 e9@-->|"查询访问"| n0
  class e9 edge_read
  n11 e10@-->|"查询访问"| n0
  class e10 edge_read
  n0 e11@-->|"可变访问"| n12
  class e11 edge_write
  n0 e12@-->|"可变访问"| n13
  class e12 edge_write
  n0 e13@-->|"可变访问"| n14
  class e13 edge_write
  n0 e14@-->|"可变访问"| n15
  class e14 edge_write
