---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-373c927f1a242629-e1{marker-start:url(#object-373c927f1a242629_flowchart-v2-pointStart)!important}\n#object-373c927f1a242629-e3{marker-start:url(#object-373c927f1a242629_flowchart-v2-pointStart)!important}\n#object-373c927f1a242629-e5{marker-start:url(#object-373c927f1a242629_flowchart-v2-pointStart)!important}\n#object-373c927f1a242629_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: HoldingItems · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**HoldingItems**<br/>索引角色当前持有的物品。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n1 node_entity
  class n1 external_node
  n2@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**handle_interaction**<br/>处理物品拾取、共享持握与主动释放。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**initialize_ready_couriers**<br/>来自角色动画 ↗：绑定主角命名动画并缓存<br/>鞋底补偿节点。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**sync_courier_animation**<br/>来自角色动画 ↗：按角色运动状态连续混合<br/>移动与跳跃动画。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**restore_empty_holder_mass**<br/>归还不再持物角色的原有质量。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**release_orphaned_items**<br/>清理失效持握并恢复物品独立运动。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**align_attachments**<br/>沿安全碰撞路径将物品对齐双手。" }
  class n10 node_system
  n0 e0@-->|"可能挂载于"| n1
  class e0 edge_reference
  n2 e1@---|"查询访问"| n0
  class e1 edge_read
  n2 e2@-->|"可变访问"| n0
  class e2 edge_write
  n3 e3@---|"查询访问"| n0
  class e3 edge_read
  n3 e4@-->|"可变访问"| n0
  class e4 edge_write
  n4 e5@---|"查询访问"| n0
  class e5 edge_read
  n4 e6@-->|"可变访问"| n0
  class e6 edge_write
  n0 e7@-->|"查询访问"| n5
  class e7 edge_read
  n0 e8@-->|"查询访问"| n6
  class e8 edge_read
  n0 e9@-->|"查询访问"| n7
  class e9 edge_read
  n8 e10@-->|"可变访问"| n0
  class e10 edge_write
  n9 e11@-->|"可变访问"| n0
  class e11 edge_write
  n10 e12@-->|"可变访问"| n0
  class e12 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
