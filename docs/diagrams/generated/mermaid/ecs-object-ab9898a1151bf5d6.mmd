---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-ab9898a1151bf5d6-e5{marker-start:url(#object-ab9898a1151bf5d6_flowchart-v2-pointStart)!important}\n#object-ab9898a1151bf5d6-e6{marker-start:url(#object-ab9898a1151bf5d6_flowchart-v2-pointStart)!important}\n#object-ab9898a1151bf5d6_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: NoRotationEasing · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**NoRotationEasing**<br/>显式禁止当前实体的旋转插值和外推" }
  class n0 node_component
  n1@{ shape: rounded, label: "**bevy​_​transform​_​interpolation::**<br/>**interpolation::complete​_​rotation​_​**<br/>**easing**<br/>在新一轮插值前完成上一段旋转。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**demo::bounds​_​recovery::recovery::**<br/>**resume​_​interpolation**<br/>来自bounds​_​recovery ↗：下一固定步从恢<br/>复后的位置重新采样插值，只移除本模块临时<br/>添加的暂停项。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**bevy​_​transform​_​interpolation::ease​_​**<br/>**rotation​_​slerp**<br/>按固定步剩余比例球面插值显示旋转。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**bevy​_​transform​_​interpolation::**<br/>**extrapolation::reset​_​rotation​_​**<br/>**extrapolation**<br/>在固定步开始前还原真实旋转。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**bevy​_​transform​_​interpolation::**<br/>**hermite::ease​_​rotation​_​**<br/>**hermite#lt;avian3d::interpolation::**<br/>**AngVelSource#gt;**<br/>用两端角速度做 Hermite 旋转平滑。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**demo::bounds​_​recovery::recovery::**<br/>**recover​_​from​_​water**<br/>来自bounds​_​recovery ↗：恢复实体自身的<br/>出生姿态；角色落水只释放手中物品，物品落<br/>水时再独立恢复。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**demo::item​_​interaction::**<br/>**interaction::handle​_​interaction**<br/>来自item​_​interaction ↗：拾取建立物理<br/>持握关系；释放只解除控制，保留刚体姿态、<br/>线速度和角速度。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**bevy​_​transform​_​interpolation::**<br/>**interpolation::update​_​rotation​_​**<br/>**interpolation​_​start**<br/>把当前旋转记录为插值起点。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**bevy​_​transform​_​interpolation::**<br/>**extrapolation::update​_​rotation​_​**<br/>**extrapolation​_​states#lt;avian3d::**<br/>**interpolation::AngVelSource#gt;**<br/>依据当前角速度预测下一个旋转端点。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**demo::item​_​interaction::lifecycle::**<br/>**resume​_​carry​_​easing**<br/>来自item​_​interaction ↗：下一固定步在<br/>旧端点清除后恢复自由箱插值，保留原本由其<br/>他模块设置的暂停项。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: rounded, label: "**bevy​_​transform​_​interpolation::**<br/>**interpolation::update​_​rotation​_​**<br/>**interpolation​_​end**<br/>把当前旋转记录为插值终点。" }
  class n11 node_system
  n0 e0@-->|"存在性约束"| n1
  class e0 edge_reference
  n2 e1@-->|"移除"| n0
  class e1 edge_write
  n0 e2@-->|"存在性约束"| n3
  class e2 edge_reference
  n0 e3@-->|"存在性约束"| n4
  class e3 edge_reference
  n0 e4@-->|"存在性约束"| n5
  class e4 edge_reference
  n6 e5@---|"存在性约束"| n0
  class e5 edge_reference
  n7 e6@---|"存在性约束"| n0
  class e6 edge_reference
  n0 e7@-->|"存在性约束"| n8
  class e7 edge_reference
  n0 e8@-->|"存在性约束"| n9
  class e8 edge_reference
  n7 e9@-->|"插入"| n0
  class e9 edge_write
  n10 e10@-->|"移除"| n0
  class e10 edge_write
  n0 e11@-->|"存在性约束"| n11
  class e11 edge_reference
  n6 e12@-->|"插入"| n0
  class e12 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: bumpX }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: basis }
