  class n2 node_system
  n3@{ shape: rounded, label: "**joint_damping#lt;avian3d::dynamics::**<br/>**joints::revolute::RevoluteJoint#gt;**<br/>读取指定关节及 JointDamping，查找两端<br/>刚体的求解器索引并按时间步修正相对速度；<br/>静态端使用占位刚体，同一索引不重复处理。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**joint_damping#lt;avian3d::dynamics::**<br/>**joints::spherical::SphericalJoint#gt;**<br/>读取指定关节及 JointDamping，查找两端<br/>刚体的求解器索引并按时间步修正相对速度；<br/>静态端使用占位刚体，同一索引不重复处理。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**joint_damping#lt;avian3d::dynamics::**<br/>**joints::prismatic::PrismaticJoint#gt;**<br/>读取指定关节及 JointDamping，查找两端<br/>刚体的求解器索引并按时间步修正相对速度；<br/>静态端使用占位刚体，同一索引不重复处理。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**joint_damping#lt;avian3d::dynamics::**<br/>**joints::distance::DistanceJoint#gt;**<br/>读取指定关节及 JointDamping，查找两端<br/>刚体的求解器索引并按时间步修正相对速度；<br/>静态端使用占位刚体，同一索引不重复处理。" }
