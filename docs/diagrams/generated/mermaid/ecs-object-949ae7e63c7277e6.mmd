---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: SolverDiagnostics · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**SolverDiagnostics**<br/>记录物理求解各阶段耗时。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**clear_velocity_increments**<br/>在子步循环后清零速度积分增量。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**writeback_solver_bodies**<br/>将求解后的位姿和速度回写 ECS。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare_contact_constraints**<br/>从有效接触流形生成本轮求解约束。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**pre_process_velocity_increments**<br/>把加速度、重力和轴锁转成子步速度增量。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**solve_restitution**<br/>遍历接触约束，按恢复系数、速度阈值和配置<br/>迭代次数对求解器刚体施加恢复冲量；溢出约<br/>束串行处理，其余按约束颜色并行处理。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**solve_continuous**<br/>对单步位移相对厚度过大的动态刚体执行连续<br/>碰撞扫掠；发现碰撞时缩短累计运动，使刚体<br/>停在首次撞击位置，并保留后续接触处理所需<br/>信息。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**store_contact_impulses**<br/>保存已求得的接触冲量供下一轮热启动。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**reset**<br/>清零当前物理诊断类型的计数及耗时采样，准<br/>备记录下一次物理步。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**apply_local_acceleration**<br/>在子步中把局部加速度作用到世界速度。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**integrate_velocities**<br/>对采用默认速度积分的活跃动态刚体，先应用<br/>线性和角速度阻尼，再累加当前步的速度增<br/>量；运动学刚体跳过该积分，并记录诊断耗<br/>时。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**clamp_velocities**<br/>分别按 MaxLinearSpeed 和<br/>MaxAngularSpeed 限制求解器刚体的速度大<br/>小，超过上限时保持方向缩放；线速度和角速<br/>度查询通过 ParamSet 分开访问。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**integrate_positions**<br/>依据求解器刚体速度与本子步时间累加<br/>delta_position 和 delta_rotation；带<br/>自定义位置积分标志的刚体跳过默认积分。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**warm_start**<br/>按 warm_start_coefficient 把上一帧或<br/>子步保存的接触冲量重新应用到求解器刚体，<br/>作为约束求解初始值；溢出约束串行、其他颜<br/>色并行处理。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**solve_contacts#lt;true#gt;**<br/>迭代接触约束并向碰撞刚体施加冲量；泛型<br/>USE_BIAS 决定是否加入重叠修正，用带偏置<br/>求解和无偏置松弛分别处理穿透与速度过冲。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**solve_contacts#lt;false#gt;**<br/>迭代接触约束并向碰撞刚体施加冲量；泛型<br/>USE_BIAS 决定是否加入重叠修正，用带偏置<br/>求解和无偏置松弛分别处理穿透与速度过冲。" }
  class n15 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_write
  n6 e5@--> n0
  class e5 edge_write
  n7 e6@--> n0
  class e6 edge_write
  n8 e7@--> n0
  class e7 edge_write
  n9 e8@--> n0
  class e8 edge_write
  n10 e9@--> n0
  class e9 edge_write
  n11 e10@--> n0
  class e10 edge_write
  n12 e11@--> n0
  class e11 edge_write
  n13 e12@--> n0
  class e12 edge_write
  n14 e13@--> n0
  class e13 edge_write
  n15 e14@--> n0
  class e14 edge_write
