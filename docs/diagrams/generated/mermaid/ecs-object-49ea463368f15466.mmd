---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: mark_island_ready · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: hex, label: "**mark_island_ready**<br/>标记地图实例以进入碰撞准备。" }
  class n0 node_observer
  n1@{ shape: stadium, label: "**WorldInstanceReady**<br/>来自Bevy 引擎 ↗：通知对应场景资产已完<br/>成实体层级实例化。" }
  class n1 node_event
  class n1 external_node
  n2@{ shape: rounded, label: "**IslandMap**<br/>海岛身份。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**IslandReady**<br/>静态碰撞与布局已准备。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**IslandPending**<br/>标记等待构建碰撞的海岛实例。" }
  class n4 node_component
  n5@{ shape: fr-rect, label: "**SceneAssemblyPlugin**<br/>加载运行资源并装配海岛、碰撞与业务实体。" }
  class n5 node_plugin
  n1 e0@-->|"WorldInstanceReady"| n0
  class e0 edge_observe
  n2 e1@-->|"存在 / 变更过滤"| n0
  class e1 edge_reference
  n3 e2@-->|"存在 / 变更过滤"| n0
  class e2 edge_reference
  n0 e3@-->|"添加"| n4
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
