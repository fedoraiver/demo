  class e6 edge_write
  n6 e7@-->|"转向受阻时移除"| n0
  class e7 edge_write
  n7 e8@-->|"转向受阻时移除"| n0
  class e8 edge_write
  n8 e9@-->|"持续对齐受阻时移除"| n0
  class e9 edge_write
  n9 e10@-->|"落水恢复时移除"| n0
  class e10 edge_write
  n10 e11@---|"反射查看"| n0
  class e11 edge_read
  n10 e12@-->|"反射可选编辑"| n0
  class e12 edge_write
