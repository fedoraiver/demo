---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: main · SpawnScene · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**main · SpawnScene**<br/>保存本应用调度的注册上下文与成员。" }
  class n0 node_engine_flow
  n1@{ shape: rounded, label: "**world_instance_spawner**<br/>根据世界资产根组件排队生成或替换实例。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**world_instance_spawner_system**<br/>清除父实体已失效的待加载实例，消费<br/>WorldAsset 和 DynamicWorld 资产变化，<br/>执行排队的生成、销毁及实例更新，并触发已<br/>经装配完成的实例就绪事件。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**resolve_scene_patches**<br/>解析已完成依赖加载的场景补丁。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**spawn_queued**<br/>消费场景补丁资产加载通知，把已解析的<br/>ScenePatch 或 SceneListPatch 应用到等<br/>待中的实体，并推进排队的场景装配；错误记<br/>录到日志。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**ApplyDeferred**<br/>在调度建立的同步点应用前序系统暂存的<br/>Commands 等延迟操作，使后续系统可以观察<br/>到结构变化；此卡片是 ApplyDeferred 的<br/>System 实现。" }
  class n5 node_sync
  n6@{ shape: lin-rect, label: "**SceneSpawnerSystems::**<br/>**WorldInstanceSpawn**<br/>生成或更新世界资产实例。" }
  class n6 node_system_set
  n7@{ shape: lin-rect, label: "**SceneSpawnerSystems::SceneSpawn**<br/>解析并实例化新一代场景补丁。" }
  class n7 node_system_set
  n0 e0@-->|"main / SpawnScene"| n1
  class e0 edge_registration
  n0 e1@-->|"main / SpawnScene"| n2
  class e1 edge_registration
  n0 e2@-->|"main / SpawnScene"| n3
  class e2 edge_registration
  n0 e3@-->|"main / SpawnScene"| n4
  class e3 edge_registration
  n0 e4@-->|"main / SpawnScene"| n5
  class e4 edge_registration
  n0 e5@-->|"main / SpawnScene"| n6
  class e5 edge_registration
  n0 e6@-->|"main / SpawnScene"| n7
  class e6 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
