---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: AssetServer · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**AssetServer**<br/>加载资产并追踪加载状态。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**queue_oit_resolve_pipeline**<br/>按 OIT 相机设置缓存透明解析管线。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare_depth_of_field_pipelines**<br/>按景深模式和视图格式准备两阶段管线。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**init_mesh_pipeline**<br/>初始化三维网格着色器及设备缓冲策略。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**init_screenshot_to_screen_pipeline**<br/>建立把截图纹理复制到屏幕的管线资源。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**init_skybox_pipeline**<br/>加载天空盒着色器并建立管线资源。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**init_copy_deferred_lighting_id_**<br/>**pipeline**<br/>建立延迟光照标识到深度的复制管线。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**init_blit_pipeline**<br/>建立全屏颜色复制与缩放的 Blit 资源。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**init_tonemapping_pipeline**<br/>建立色调映射的颜色、视图与 LUT 输入布<br/>局。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**init_bloom_downsampling_pipeline**<br/>建立 Bloom 降采样的纹理与参数管线。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**init_bloom_upscaling_pipeline**<br/>建立 Bloom 升采样的纹理和参数布局。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**init_motion_blur_pipeline**<br/>加载运动模糊着色器并构造管线资源。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**init_post_processing_pipeline**<br/>建立色差、暗角和镜头畸变的共用后处理资<br/>源。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**init_fxaa_pipeline**<br/>建立 FXAA 的纹理采样布局和着色器资源。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**init_smaa_pipelines**<br/>建立 SMAA 三个阶段的布局和着色器资源。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**init_taa_pipeline**<br/>建立 TAA 的当前帧、历史帧和预通道输入布<br/>局。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**init_cas_pipeline**<br/>建立 CAS 锐化的纹理、参数布局和管线变体<br/>资源。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**init_mesh_2d_pipeline**<br/>建立二维网格的视图、实例及元数据输入布<br/>局。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**load_mesh2d_bindings**<br/>按运行设备能力加载二维网格绑定着色器。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**initialize_material2d_shaders#lt;bevy_**<br/>**sprite_render::mesh2d::color_**<br/>**material::ColorMaterial#gt;**<br/>解析二维材质的自定义顶点与片元着色器。" }
  class n19 node_system
  n20@{ shape: rounded, label: "**initialize_material2d_shaders#lt;bevy_**<br/>**sprite_render::sprite_mesh::sprite_**<br/>**mesh_material::SpriteMeshMaterial#gt;**<br/>解析二维材质的自定义顶点与片元着色器。" }
  class n20 node_system
  n21@{ shape: rounded, label: "**initialize_material2d_shaders#lt;bevy_**<br/>**sprite_render::tilemap_chunk::**<br/>**tilemap_chunk_material::**<br/>**TilemapChunkMaterial#gt;**<br/>解析二维材质的自定义顶点与片元着色器。" }
  class n21 node_system
  n22@{ shape: rounded, label: "**init_sprite_pipeline**<br/>建立精灵视图和图像材质管线资源。" }
  class n22 node_system
  n23@{ shape: rounded, label: "**init_ui_pipeline**<br/>建立 UI 图形的视图、图像和采样器布局。" }
  class n23 node_system
  n24@{ shape: rounded, label: "**init_ui_texture_slice_pipeline**<br/>建立 UI 图像切片的视图和纹理管线资源。" }
  class n24 node_system
  n25@{ shape: rounded, label: "**init_gradient_pipeline**<br/>建立 UI 渐变的视图布局和着色器资源。" }
  class n25 node_system
  n26@{ shape: rounded, label: "**init_box_shadow_pipeline**<br/>建立 UI 盒阴影的视图布局和着色器资源。" }
  class n26 node_system
  n27@{ shape: rounded, label: "**init_prepass_pipeline**<br/>初始化带运动矢量及普通预通道的资源布局。" }
  class n27 node_system
  n28@{ shape: rounded, label: "**init_volumetric_fog_pipeline**<br/>初始化体积雾管线的视图布局与着色器。" }
  class n28 node_system
  n29@{ shape: rounded, label: "**init_screen_space_reflections_**<br/>**pipeline**<br/>初始化屏幕空间反射的全屏渲染管线资源。" }
  class n29 node_system
  n30@{ shape: rounded, label: "**init_deferred_lighting_layout**<br/>初始化延迟光照的深度标识绑定与着色器。" }
  class n30 node_system
  n31@{ shape: rounded, label: "**init_line_gizmo_pipelines**<br/>建立二维 Gizmo 线段和接头管线。" }
  class n31 node_system
  n32@{ shape: rounded, label: "**init_line_gizmo_pipelines**<br/>建立三维 Gizmo 线条深度管线和接头资源。" }
  class n32 node_system
  n33@{ shape: rounded, label: "**init_sparse_buffer_update_pipelines**<br/>按设备存储绑定能力建立稀疏更新计算资源。" }
  class n33 node_system
  n34@{ shape: rounded, label: "**init_background_motion_vectors_**<br/>**pipeline**<br/>建立背景运动矢量的全屏管线资源。" }
  class n34 node_system
  n35@{ shape: rounded, label: "**initialize_generated_environment_**<br/>**map_resources**<br/>初始化环境图降采样、复制和卷积的 GPU 接<br/>口。" }
  class n35 node_system
  n36@{ shape: rounded, label: "**init_atmosphere_probe_pipeline**<br/>排队创建大气环境贴图生成计算管线。" }
  class n36 node_system
