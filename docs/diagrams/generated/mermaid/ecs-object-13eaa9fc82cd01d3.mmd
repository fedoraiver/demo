  class n4 external_node
  n5@{ shape: rounded, label: "**queue_mass_recomputation_on_mass_**<br/>**change**<br/>来自Avian ↗：在刚体自身的质量、惯量或<br/>质心组件变化时添加<br/>RecomputeMassProperties，安排后续重<br/>算；附属于刚体的碰撞体由另一条更新路径处<br/>理。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**queue_mass_recomputation_on_**<br/>**collider_mass_change**<br/>来自Avian ↗：在附属碰撞体质量输入变化<br/>时请求刚体重算。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**update_mass_properties**<br/>来自Avian ↗：遍历已标记<br/>RecomputeMassProperties 的实体，通过<br/>MassPropertyHelper 重算质量属性，随后<br/>移除本轮重算标记。" }
  class n7 node_system
  class n7 external_node
