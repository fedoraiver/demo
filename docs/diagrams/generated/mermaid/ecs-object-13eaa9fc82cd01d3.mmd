  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**update_collider_mass_**<br/>**properties#lt;avian3d::collision::**<br/>**collider::parry::Collider#gt;**<br/>来自Avian ↗：按变化的形状和密度重算碰<br/>撞体质量。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**transform_to_position**<br/>来自Avian ↗：把用户改变的世界变换同步<br/>到物理位姿。" }
