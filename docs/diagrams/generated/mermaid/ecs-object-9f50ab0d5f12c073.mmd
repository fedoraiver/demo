  n6@{ shape: rounded, label: "**shared_shadow_pass#lt;true#gt;**<br/>绘制跨相机共享的点光或聚光阴影。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**ExtractedView**<br/>描述渲染视图的身份、投影与空间状态。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**ShadowView**<br/>描述阴影绘制的深度附件与通道名称。" }
  class n8 node_component
  n9@{ shape: cyl, label: "**PreprocessPipelines**<br/>汇集网格预处理与间接参数构建管线。" }
  class n9 node_resource
  n10@{ shape: cyl, label: "**BuildIndirectParametersBindGroups**<br/>绑定间接绘制计数重置和参数构建资源。" }
  class n10 node_resource
  n11@{ shape: cyl, label: "**PipelineCache**<br/>缓存 GPU 渲染、计算管线与待创建队列。" }
  class n11 node_resource
  n12@{ shape: cyl, label: "**IndirectParametersBuffers**<br/>保存间接绘制命令与裁剪计数缓冲。" }
  class n12 node_resource
  n13@{ shape: cyl, label: "**BuildIndirectParametersMetadata**<br/>描述间接绘制参数构建的 GPU 调度。" }
  class n13 node_resource
  n14@{ shape: notch-rect, label: "**RenderContext**<br/>向渲染系统提供命令编码器和 GPU 设备。" }
