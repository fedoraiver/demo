---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: ui::volume::VolumeValue · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**VolumeValue**<br/>数字与填充各自保存设置键，草稿更新不需要<br/>重建实体树。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>随音量草稿刷新百分比或静音文字。" }
  class n1 node_entity
  n2@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>随音量草稿刷新百分比或静音文字。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>随音量草稿刷新百分比或静音文字。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**update​_​volume​_​visuals**<br/>草稿由请求系统在 PreUpdate 修改，随后<br/>同帧更新已有数字和轨道填充。" }
  class n4 node_system
  n1 e0@-->|"可能包含"| n0
  class e0 edge_reference
  n2 e1@-->|"可能包含"| n0
  class e1 edge_reference
  n3 e2@-->|"可能包含"| n0
  class e2 edge_reference
  n0 e3@--> n4
  class e3 edge_read
  e0@{ curve: basis }
  e2@{ curve: basis }
