---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: CameraFxaaPipeline · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**CameraFxaaPipeline**<br/>保存相机的 FXAA 管线标识。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**fxaa**<br/>在 FXAA 开启且相机管线就绪时，读取当前<br/>视图颜色并执行全屏抗锯齿，写入下一后处理<br/>目标；复用与源纹理对应的绑定组。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**fxaa**<br/>在 FXAA 开启且相机管线就绪时，读取当前<br/>视图颜色并执行全屏抗锯齿，写入下一后处理<br/>目标；复用与源纹理对应的绑定组。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare_fxaa_pipelines**<br/>按相机边缘阈值与目标格式准备 FXAA 管<br/>线。" }
  class n3 node_system
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_read
  n3 e2@-->|"延迟添加"| n0
  class e2 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
