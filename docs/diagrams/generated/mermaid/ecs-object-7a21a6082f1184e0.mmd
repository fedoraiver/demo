---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: rebuild_page · 创建模板 · 对象关系
  accDescr: 实体创建模板与直接关联的非组件对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>组织随设置视口整体滚动的标题、选项、说明<br/>和状态。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>显示并原位刷新设置保存状态与草稿提示。" }
  class n1 node_entity
  n2@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>标识设置页面或当前设置分类。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>按窗口布局排列设置内容与说明面板。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>在设置总标题下绘制金色强调线。" }
  class n4 node_entity
  n5@{ shape: rounded, label: "**rebuild​_​page · 创建模板**<br/>裁切并滚动设置面板内的正文内容。" }
  class n5 node_entity
  n0 e0@-->|"子实体"| n1
  class e0 edge_relationship
  n0 e1@-->|"子实体"| n2
  class e1 edge_relationship
  n0 e2@-->|"子实体"| n3
  class e2 edge_relationship
  n0 e3@-->|"子实体"| n4
  class e3 edge_relationship
  n5 e4@-->|"子实体"| n0
  class e4 edge_relationship
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
