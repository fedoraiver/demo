---
flowchart LR
  accTitle: AudioOutput · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_non_send fill:#F8F3EF,stroke:#A5633A,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: tag-rect, label: "**AudioOutput**<br/>持有 Kira 音频管理器及实例、通道、轨道<br/>状态" }
  class n0 node_non_send
  n1@{ shape: rounded, label: "**play_dynamic_channels**<br/>执行按名称创建的动态音频通道命令。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**play_audio_channel#lt;bevy_kira_audio::**<br/>**MainTrack#gt;**<br/>执行指定类型音频通道的命令队列。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**play_audio_channel#lt;demo::audio::**<br/>**UiTrack#gt;**<br/>执行指定类型音频通道的命令队列。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**play_audio_channel#lt;demo::audio::**<br/>**SfxTrack#gt;**<br/>执行指定类型音频通道的命令队列。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**cleanup_stopped_instances**<br/>释放已停止播放实例的内部引用。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_instance_states#lt;bevy_kira_**<br/>**audio::MainTrack#gt;**<br/>把实际播放状态回写到类型通道。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**update_instance_states#lt;demo::audio::**<br/>**UiTrack#gt;**<br/>把实际播放状态回写到类型通道。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**update_instance_states#lt;demo::audio::**<br/>**SfxTrack#gt;**<br/>把实际播放状态回写到类型通道。" }
  class n8 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_write
  n0 e5@--> n6
  class e5 edge_read
  n0 e6@--> n7
  class e6 edge_read
  n0 e7@--> n8
  class e7 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e7@{ curve: basis }
