---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-b075ce93f7506bbe-e0{marker-start:url(#object-b075ce93f7506bbe_flowchart-v2-pointStart)!important}\n#object-b075ce93f7506bbe-e1{marker-start:url(#object-b075ce93f7506bbe_flowchart-v2-pointStart)!important}\n#object-b075ce93f7506bbe-e3{marker-start:url(#object-b075ce93f7506bbe_flowchart-v2-pointStart)!important}\n#object-b075ce93f7506bbe-e5{marker-start:url(#object-b075ce93f7506bbe_flowchart-v2-pointStart)!important}\n#object-b075ce93f7506bbe-e8{marker-start:url(#object-b075ce93f7506bbe_flowchart-v2-pointStart)!important}\n#object-b075ce93f7506bbe-e9{marker-start:url(#object-b075ce93f7506bbe_flowchart-v2-pointStart)!important}\n#object-b075ce93f7506bbe_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: list::ActiveDescendant · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ActiveDescendant**<br/>记录列表键盘导航的活动行。" }
  class n0 node_component
  n1@{ shape: hex, label: "**listbox​_​on​_​key​_​input**<br/>处理列表键盘导航与行确认。" }
  class n1 node_observer
  n2@{ shape: hex, label: "**listbox​_​focus​_​gained**<br/>在列表获焦时初始化活动行。" }
  class n2 node_observer
  n3@{ shape: hex, label: "**listbox​_​focus​_​gained**<br/>在列表获焦时初始化活动行。" }
  class n3 node_observer
  n4@{ shape: hex, label: "**listbox​_​on​_​key​_​input**<br/>处理列表键盘导航与行确认。" }
  class n4 node_observer
  n5@{ shape: hex, label: "**listbox​_​focus​_​gained**<br/>在列表获焦时初始化活动行。" }
  class n5 node_observer
  n6@{ shape: hex, label: "**listbox​_​on​_​key​_​input**<br/>处理列表键盘导航与行确认。" }
  class n6 node_observer
  n7@{ shape: hex, label: "**listbox​_​focus​_​lost**<br/>清除失焦列表的键盘活动行。" }
  class n7 node_observer
  n8@{ shape: hex, label: "**listbox​_​focus​_​lost**<br/>清除失焦列表的键盘活动行。" }
  class n8 node_observer
  n9@{ shape: hex, label: "**listbox​_​on​_​row​_​click**<br/>将列表行点击转为选择或重选请求。" }
  class n9 node_observer
  n10@{ shape: hex, label: "**listbox​_​on​_​row​_​click**<br/>将列表行点击转为选择或重选请求。" }
  class n10 node_observer
  n11@{ shape: hex, label: "**listbox​_​focus​_​lost**<br/>清除失焦列表的键盘活动行。" }
  class n11 node_observer
  n12@{ shape: hex, label: "**listbox​_​on​_​row​_​click**<br/>将列表行点击转为选择或重选请求。" }
  class n12 node_observer
  n1 e0@--- n0
  class e0 edge_read
  n2 e1@--- n0
  class e1 edge_read
  n3 e2@-->|"插入"| n0
  class e2 edge_write
  n4 e3@--- n0
