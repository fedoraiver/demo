---
flowchart LR
  accTitle: menu::MenuFocusState · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**MenuFocusState**<br/>保存菜单弹出层的打开、获得焦点和关闭状态" }
  class n0 node_component
  n1@{ shape: rounded, label: "**menu​_​on​_​lose​_​focus**<br/>关闭不再持有内部焦点的菜单。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**menu​_​acquire​_​focus**<br/>在菜单打开时为菜单项取得焦点。" }
  class n2 node_system
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n2 e1@-->|"可变访问"| n0
  class e1 edge_write
  n2 e2@-->|"赋值"| n0
  class e2 edge_write
  n1 e3@-->|"赋值"| n0
  class e3 edge_write
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: basis }
  e3@{ curve: bumpX }
