---
flowchart LR
  accTitle: RenderExtractedShadowMapVisibleEntities · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**RenderExtractedShadowMapVisibleEntit**<br/>**ies**<br/>暂存各阴影子视图经 CPU 判定可见的实体。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**extract_lights**<br/>同步可见点光、聚光、平行光及矩形光的渲染<br/>参数和阴影可见实体，提取变化的阴影贴图设<br/>置；隐藏或失效光源不继续保留有效渲染状<br/>态。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**collect_visible_cpu_culled_entities**<br/>汇总相机与阴影子视图的 CPU 剔除可见实<br/>体。" }
  class n2 node_system
  n1 e0@--> n0
  class e0 edge_write
  n1 e1@-->|"延迟添加"| n0
  class e1 edge_write
  n1 e2@-->|"延迟移除"| n0
  class e2 edge_write
  n2 e3@--> n0
  class e3 edge_write
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: basis }
  e3@{ curve: basis }
