flowchart LR
  accTitle: volumetric_fog::render::ViewVolumetricFogPipelines · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ViewVolumetricFogPipelines**<br/>保存有无密度纹理两种体积雾管线。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**volumetric​_​fog**<br/>结合深度与光照逐个绘制视图中的雾体。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare​_​volumetric​_​fog​_​pipelines**<br/>为体积雾视图准备有密度纹理和无密度纹理两<br/>类管线。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**extract​_​volumetric​_​fog**<br/>从主世界提取体积雾、雾体积及体积光配置。" }
  class n3 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"插入"| n0
  class e1 edge_write
  n3 e2@-->|"移除"| n0
  class e2 edge_write
  e1@{ curve: basis }
  e2@{ curve: basis }
