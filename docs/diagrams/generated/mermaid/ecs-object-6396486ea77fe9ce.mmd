      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-6396486ea77fe9ce-e0{marker-start:url(#object-6396486ea77fe9ce_flowchart-v2-pointStart)!important}\n#object-6396486ea77fe9ce-e4{marker-start:url(#object-6396486ea77fe9ce_flowchart-v2-pointStart)!important}\n#object-6396486ea77fe9ce_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
