---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: extract_text2d_sprite · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**extract_text2d_sprite**<br/>把可见二维文字及装饰提取为精灵切片。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n2 node_system_param
  n3@{ shape: cyl, label: "**ExtractedSprites**<br/>保存本帧提取的精灵绘制实例。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**ExtractedSlices**<br/>保存已提取的精灵与文字图像切片。" }
  class n4 node_resource
  n5@{ shape: rounded, label: "**ViewVisibility**<br/>记录实体是否应被提取用于渲染。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**ComputedTextBlock**<br/>缓存文字块的 Parley 布局、文本实体树和<br/>重绘标记" }
  class n6 node_component
  n7@{ shape: rounded, label: "**TextLayoutInfo**<br/>保存文字块完成排版后的缩放、字形位置、文<br/>字运行几何及尺寸" }
  class n7 node_component
  n8@{ shape: rounded, label: "**TextBounds**<br/>保存文字逻辑像素宽高上限" }
  class n8 node_component
  n9@{ shape: rounded, label: "**Anchor**<br/>保存二维可渲染实体相对自身尺寸的归一化锚<br/>点偏移" }
  class n9 node_component
  n10@{ shape: rounded, label: "**Text2dShadow**<br/>为二维文字保存阴影的偏移与颜色" }
  class n10 node_component
  n11@{ shape: rounded, label: "**GlobalTransform**<br/>保存实体合并祖先变换后的世界空间仿射变换" }
  class n11 node_component
  n12@{ shape: rounded, label: "**TextColor**<br/>保存当前文字段的前景色" }
  class n12 node_component
  n13@{ shape: rounded, label: "**TextBackgroundColor**<br/>保存当前文字段的背景色" }
  class n13 node_component
  n14@{ shape: rounded, label: "**Strikethrough**<br/>标记文字实体需要绘制删除线" }
  class n14 node_component
  n15@{ shape: rounded, label: "**Underline**<br/>标记文字实体需要绘制下划线" }
  class n15 node_component
  n16@{ shape: rounded, label: "**StrikethroughColor**<br/>覆盖文字删除线颜色" }
  class n16 node_component
  n17@{ shape: rounded, label: "**UnderlineColor**<br/>覆盖文字下划线颜色" }
  class n17 node_component
  n18@{ shape: rounded, label: "**TemporaryRenderEntity**<br/>标记需要在渲染结束后销毁的临时实体。" }
  class n18 node_component
