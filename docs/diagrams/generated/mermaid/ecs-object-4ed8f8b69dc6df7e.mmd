---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: main · FixedFirst · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**main · FixedFirst**<br/>保存本应用调度的注册上下文与成员。" }
  class n0 node_engine_flow
  n1@{ shape: rounded, label: "**reset_translation_easing**<br/>来自Avian ↗：清除旧位置平滑的起点和终<br/>点。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**reset_rotation_easing**<br/>来自Avian ↗：清除旧旋转平滑的起点和终<br/>点。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**reset_scale_easing**<br/>来自Avian ↗：清除旧缩放平滑的起点和终<br/>点。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**update_translation_interpolation_**<br/>**start**<br/>来自Avian ↗：把当前位置记录为插值起<br/>点。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**update_rotation_interpolation_start**<br/>来自Avian ↗：把当前旋转记录为插值起<br/>点。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**update_scale_interpolation_start**<br/>来自Avian ↗：把当前缩放记录为插值起<br/>点。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**clear_gizmo_context#lt;bevy_light::**<br/>**gizmos::LightGizmoConfigGroup, bevy_**<br/>**time::fixed::Fixed#gt;**<br/>清空指定 Gizmo 配置组及清理上下文的存<br/>储，丢弃该上下文上一轮保存的线段和颜色数<br/>据。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**clear_gizmo_context#lt;bevy_gizmos::**<br/>**config::DefaultGizmoConfigGroup,**<br/>**bevy_time::fixed::Fixed#gt;**<br/>清空指定 Gizmo 配置组及清理上下文的存<br/>储，丢弃该上下文上一轮保存的线段和颜色数<br/>据。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**clear_gizmo_context#lt;bevy_gizmos::**<br/>**aabb::AabbGizmoConfigGroup, bevy_**<br/>**time::fixed::Fixed#gt;**<br/>清空指定 Gizmo 配置组及清理上下文的存<br/>储，丢弃该上下文上一轮保存的线段和颜色数<br/>据。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**clear_gizmo_context#lt;bevy_gizmos::**<br/>**frustum::FrustumGizmoConfigGroup,**<br/>**bevy_time::fixed::Fixed#gt;**<br/>清空指定 Gizmo 配置组及清理上下文的存<br/>储，丢弃该上下文上一轮保存的线段和颜色数<br/>据。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**clear_gizmo_context#lt;bevy_gizmos::**<br/>**skinned_mesh_bounds::**<br/>**SkinnedMeshBoundsGizmoConfigGroup,**<br/>**bevy_time::fixed::Fixed#gt;**<br/>清空指定 Gizmo 配置组及清理上下文的存<br/>储，丢弃该上下文上一轮保存的线段和颜色数<br/>据。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**complete_translation_easing**<br/>来自Avian ↗：在新一轮插值前完成上一段<br/>平移。" }
  class n12 node_system
  class n12 external_node
  n13@{ shape: rounded, label: "**complete_rotation_easing**<br/>来自Avian ↗：在新一轮插值前完成上一段<br/>旋转。" }
  class n13 node_system
  class n13 external_node
  n14@{ shape: rounded, label: "**complete_scale_easing**<br/>来自Avian ↗：在新一轮插值前完成上一段<br/>缩放。" }
  class n14 node_system
  class n14 external_node
  n15@{ shape: rounded, label: "**reset_translation_extrapolation**<br/>来自Avian ↗：在固定步开始前还原真实位<br/>置。" }
  class n15 node_system
  class n15 external_node
  n16@{ shape: rounded, label: "**reset_rotation_extrapolation**<br/>来自Avian ↗：在固定步开始前还原真实旋<br/>转。" }
  class n16 node_system
  class n16 external_node
  n17@{ shape: rounded, label: "**resume_carry_easing**<br/>来自物品交互 ↗：恢复物品释放前未暂停的<br/>插值通道。" }
  class n17 node_system
  class n17 external_node
  n18@{ shape: rounded, label: "**resume_interpolation**<br/>来自越界恢复 ↗：撤销落水恢复添加的临时<br/>插值暂停。" }
  class n18 node_system
  class n18 external_node
  n19@{ shape: rounded, label: "**ApplyDeferred**<br/>在调度建立的同步点应用前序系统暂存的<br/>Commands 等延迟操作，使后续系统可以观察<br/>到结构变化；此卡片是 ApplyDeferred 的<br/>System 实现。" }
  class n19 node_sync
  n20@{ shape: lin-rect, label: "**TransformEasingSystems::Reset**<br/>来自Avian ↗：重置上一轮固定步的插值状<br/>态。" }
  class n20 node_system_set
  class n20 external_node
  n21@{ shape: lin-rect, label: "**TransformEasingSystems::UpdateStart**<br/>来自Avian ↗：记录当前固定步的插值起<br/>点。" }
  class n21 node_system_set
  class n21 external_node
