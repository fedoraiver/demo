---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-8a0651aaa8d26cb7-e2{marker-start:url(#object-8a0651aaa8d26cb7_flowchart-v2-pointStart)!important}\n#object-8a0651aaa8d26cb7_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: RecomputeMassProperties · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**RecomputeMassProperties**<br/>请求重新计算刚体质量属性。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**queue_mass_recomputation_on_mass_**<br/>**change**<br/>在刚体自身的质量、惯量或质心组件变化时添<br/>加 RecomputeMassProperties，安排后续<br/>重算；附属于刚体的碰撞体由另一条更新路径<br/>处理。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**queue_mass_recomputation_on_**<br/>**collider_mass_change**<br/>在附属碰撞体质量输入变化时请求刚体重算。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update_mass_properties**<br/>遍历已标记 RecomputeMassProperties 的<br/>实体，通过 MassPropertyHelper 重算质<br/>量属性，随后移除本轮重算标记。" }
  class n3 node_system
  n1 e0@-->|"延迟添加"| n0
  class e0 edge_write
  n2 e1@-->|"延迟添加"| n0
  class e1 edge_write
  n3 e2@---|"存在 / 变更过滤"| n0
  class e2 edge_reference
  n3 e3@-->|"延迟移除"| n0
  class e3 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
