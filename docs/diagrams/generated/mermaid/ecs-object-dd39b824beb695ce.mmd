---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: RigidBody · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**RigidBody**<br/>选择动态、静态或运动学刚体行为。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**warn_invalid_mass**<br/>报告动态刚体无效的总质量或总惯量。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**propagate_collider_transforms**<br/>沿实体层级计算碰撞体相对刚体的变换。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**release_orphaned_items**<br/>来自物品交互 ↗：清理失效持握并恢复物品<br/>独立运动。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**align_attachments**<br/>来自物品交互 ↗：沿安全碰撞路径将物品对<br/>齐双手。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**update_child_collider_position**<br/>由所属刚体位姿更新附属碰撞体的世界位姿。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**prepare_solver_bodies**<br/>把 ECS 刚体状态准备成子步求解数据。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**pre_process_velocity_increments**<br/>把加速度、重力和轴锁转成子步速度增量。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n11 node_system
  class n11 external_node
  n12@{ shape: rounded, label: "**prepare_island**<br/>来自场景装配 ↗：从海岛模型构建静态碰<br/>撞、坡道与人物碰撞。" }
  class n12 node_system
  class n12 external_node
  n13@{ shape: rounded, label: "**spawn_actors**<br/>来自场景装配 ↗：装配玩家、可搬物、控制<br/>者与相机。" }
  class n13 node_system
  class n13 external_node
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@-->|"存在 / 变更过滤"| n2
  class e1 edge_reference
  n3 e2@-->|"延迟添加"| n0
  class e2 edge_write
  n4 e3@-->|"延迟添加"| n0
  class e3 edge_write
  n5 e4@-->|"延迟添加"| n0
  class e4 edge_write
  n5 e5@-->|"延迟移除"| n0
  class e5 edge_write
  n6 e6@-->|"延迟添加"| n0
  class e6 edge_write
  n7 e7@-->|"延迟添加"| n0
  class e7 edge_write
  n0 e8@-->|"存在 / 变更过滤"| n8
  class e8 edge_reference
  n0 e9@--> n9
  class e9 edge_read
  n0 e10@--> n10
  class e10 edge_read
  n11 e11@-->|"延迟添加"| n0
  class e11 edge_write
  n12 e12@-->|"延迟添加"| n0
  class e12 edge_write
  n13 e13@-->|"延迟添加"| n0
  class e13 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: basis }
  e13@{ curve: basis }
