---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Activate · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**Activate**<br/>原生按钮激活事件；GameUiPlugin不消费，<br/>避免与Enhanced Input重复。" }
  class n0 node_event
  n1@{ shape: hex, label: "**button_on_pointer_down**<br/>按压时插入原生Pressed；可<br/>选ActivateOnPress会发Activate。" }
  class n1 node_observer
  n2@{ shape: hex, label: "**button_on_pointer_click**<br/>满足条件时派发原生Activate。" }
  class n2 node_observer
  n3@{ shape: hex, label: "**button_on_key_event**<br/>焦点键盘Enter或Space首次按下时派<br/>发Activate。" }
  class n3 node_observer
  n1 e0@-->|"Activate（有条件）"| n0
  class e0 edge_emit
  n2 e1@-->|"Activate（有条件）"| n0
  class e1 edge_emit
  n3 e2@-->|"Activate（有条件）"| n0
  class e2 edge_emit
  e0@{ curve: basis }
  e2@{ curve: basis }
