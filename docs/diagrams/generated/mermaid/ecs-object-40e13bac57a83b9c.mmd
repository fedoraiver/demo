---
flowchart LR
  accTitle: apply_contact_status_changes · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**apply_contact_status_changes**<br/>把接触增删同步到约束图和物理岛。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PhysicsSchedule**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**PhysicsStepSystems::First**<br/>在物理调度开头处理状态与关系变化。" }
  class n2 node_system_set
  n3@{ shape: cyl, label: "**ContactStatusChangeQueue**<br/>暂存窄相产生的接触状态变化。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**ContactGraph**<br/>保存物理解算后的真实接触结果。" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**ConstraintGraph**<br/>为并行接触求解维护约束着色图。" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**PhysicsIslands**<br/>管理模拟岛及接触和关节连接。" }
  class n6 node_resource
  n7@{ shape: rounded, label: "**BodyIslandNode**<br/>记录刚体在物理岛中的连接位置。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**Disabled**<br/>来自Bevy 引擎 ↗：标记被禁用的实体" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: notch-rect, label: "**Commands**<br/>来自Bevy 引擎 ↗：保存延迟执行的<br/>World 操作队列" }
  class n9 node_system_param
  class n9 external_node
  n1 e0@-->|"main / PhysicsSchedule"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_read
  n0 e4@--> n5
  class e4 edge_write
  n0 e5@--> n6
  class e5 edge_write
  n0 e6@--> n7
  class e6 edge_write
  n8 e7@-->|"存在 / 变更过滤"| n0
  class e7 edge_reference
  n9 e8@-->|"参数 / 查询数据"| n0
  class e8 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
