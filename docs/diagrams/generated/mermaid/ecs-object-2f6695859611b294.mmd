---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: publish_asset_server_diagnostics · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**publish_asset_server_diagnostics**<br/>发布资产加载任务的启动计数。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PreUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**handle_internal_asset_events**<br/>消费资产服务器内部的加载、依赖就绪和失败<br/>通知，完成资产状态更新、唤醒等待任务并发<br/>布对应消息；启用热重载时继续处理依赖和文<br/>件变化。" }
  class n2 node_system
  n3@{ shape: cyl, label: "**AssetServer**<br/>加载并查询递归依赖。" }
  class n3 node_resource
  n4@{ shape: notch-rect, label: "**Diagnostics**<br/>提供诊断测量值的记录入口" }
  class n4 node_system_param
  n5@{ shape: cyl, label: "**DiagnosticsStore**<br/>按 DiagnosticPath 保存诊断项、测量历史<br/>和统计结果" }
  class n5 node_resource
  n6@{ shape: notch-rect, label: "**Deferred#lt;DiagnosticsBuffer#gt;**<br/>保存稍后在 ApplyDeferred 中应用的系统<br/>缓冲" }
  class n6 node_system_param
  n1 e0@-->|"main / PreUpdate"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_order
  n3 e2@--> n0
  class e2 edge_read
  n4 e3@-->|"参数 / 查询数据"| n0
  class e3 edge_reference
  n5 e4@--> n0
  class e4 edge_read
  n6 e5@-->|"参数 / 查询数据"| n0
  class e5 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
