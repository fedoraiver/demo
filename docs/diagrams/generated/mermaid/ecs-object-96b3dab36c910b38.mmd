---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: LightEntity · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**LightEntity**<br/>标识阴影视图对应的光源面或级联。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**allocate_uniforms**<br/>遍历当前视图及其阴影级联的各批次集合，<br/>在 GPU 上执行局部扫描、全局扫描和分配计<br/>算，确定 MeshUniform 的存储位置，避免<br/>CPU 每帧遍历全部可见网格。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**unpack_bins**<br/>针对当前视图及其阴影级联的索引和非索引批<br/>次，在 GPU 上解包已缓存的分桶数据，生成<br/>后续网格预处理所需的任务列表。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**early_gpu_preprocess**<br/>为当前视图及阴影级联执行早期网格转换与裁<br/>剪。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**prepare_lights**<br/>汇总提取后的各类光源，为视图准备光照<br/>GPU 参数、聚簇索引及阴影贴图和阴影视<br/>图，维护对应缓存及阶段记录，并检查设备和<br/>实现支持的数量限制。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**check_views_lights_need_**<br/>**specialization**<br/>检测阴影视图投影类型并标记管线待刷新。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**specialize_shadows**<br/>按阴影视图、网格及材质变化重新选择专用阴<br/>影渲染管线，清理失效缓存，并整理需要补齐<br/>或重新排队的阴影网格任务。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**queue_shadows**<br/>遍历各阴影视图中可见的网格，按专用材质管<br/>线、渲染层及投影资格更新阴影分桶；移除失<br/>效项，将资产或管线尚未就绪的网格留到后续<br/>重试。" }
  class n7 node_system
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n4 e3@-->|"延迟添加"| n0
  class e3 edge_write
  n0 e4@--> n5
  class e4 edge_read
  n0 e5@--> n6
  class e5 edge_read
  n0 e6@--> n7
  class e6 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
