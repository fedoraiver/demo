---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: integrate_velocities · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**integrate_velocities**<br/>对采用默认速度积分的活跃动态刚体，先应用<br/>线性和角速度阻尼，再累加当前步的速度增<br/>量；运动学刚体跳过该积分，并记录诊断耗<br/>时。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · SubstepSchedule**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**IntegrationSystems::Velocity**<br/>把速度增量应用到刚体速度。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**clamp_velocities**<br/>分别按 MaxLinearSpeed 和<br/>MaxAngularSpeed 限制求解器刚体的速度大<br/>小，超过上限时保持方向缩放；线速度和角速<br/>度查询通过 ParamSet 分开访问。" }
  class n3 node_system
  n4@{ shape: lin-rect, label: "**ForceSystems::ApplyLocalAcceleration**<br/>按当前姿态应用局部空间加速度。" }
  class n4 node_system_set
  n5@{ shape: cyl, label: "**SolverBodies**<br/>连续存储活跃刚体的求解状态。" }
  class n5 node_resource
  n6@{ shape: notch-rect, label: "**VelocityIntegrationQuery**<br/>汇集速度积分写入入口。" }
  class n6 node_query_data
  n7@{ shape: rounded, label: "**SolverBodyIndex**<br/>定位实体对应的求解器刚体。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**VelocityIntegrationData**<br/>缓存子步速度增量和阻尼系数。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**ComputedAngularInertia**<br/>保存汇总后的刚体局部角惯量。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**Rotation**<br/>保存刚体或碰撞体的世界旋转。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**CustomVelocityIntegration**<br/>将速度积分交给自定义逻辑。" }
  class n11 node_component
  n12@{ shape: cyl, label: "**SolverDiagnostics**<br/>记录物理求解各阶段耗时。" }
  class n12 node_resource
  n13@{ shape: cyl, label: "**Time**<br/>来自Bevy 引擎 ↗：提供当前运行阶段的通<br/>用时间。" }
  class n13 node_resource
  class n13 external_node
  n1 e0@-->|"main / SubstepSchedule"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_order
  n4 e3@--> n0
  class e3 edge_order
  n0 e4@--> n5
  class e4 edge_write
  n6 e5@-->|"参数 / 查询数据"| n0
  class e5 edge_reference
  n7 e6@--> n0
  class e6 edge_read
  n0 e7@--> n8
  class e7 edge_write
  n9 e8@--> n0
  class e8 edge_read
  n10 e9@--> n0
  class e9 edge_read
  n11 e10@-->|"存在 / 变更过滤"| n0
  class e10 edge_reference
  n0 e11@--> n12
  class e11 edge_write
  n13 e12@--> n0
  class e12 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
