---
flowchart LR
  accTitle: TransformEasingSystems::UpdateEasingTick · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**TransformEasingSystems::**<br/>**UpdateEasingTick**<br/>记录显示变更，区分插值更新与外部瞬移。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**sync_character_visibility**<br/>来自第一人称控制 ↗：隐藏第一人称控制角<br/>色的自身模型。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: stadium, label: "**main · RunFixedMainLoop**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n2 node_engine_flow
  class n2 external_node
  n3@{ shape: lin-rect, label: "**RunFixedMainLoopSystems::**<br/>**AfterFixedMainLoop**<br/>来自Bevy 引擎 ↗：在固定循环之后执行插<br/>值与呈现。" }
  class n3 node_system_set
  class n3 external_node
  n4@{ shape: rounded, label: "**update_last_easing_tick**<br/>记录平滑系统完成后的变化检测边界。" }
  class n4 node_system
  n5@{ shape: lin-rect, label: "**PresentationSystems::Visibility**<br/>来自应用流程 ↗：在相机更新后隐藏受控角<br/>色自身模型。" }
  class n5 node_system_set
  class n5 external_node
  n6@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存自由运动或共享持<br/>握时的显示姿态。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: cyl, label: "**LastEasingTick**<br/>记录最近显示插值变更以识别外部瞬移。" }
  class n8 node_resource
  n1 e0@--> n0
  class e0 edge_order
  n2 e1@-->|"main / RunFixedMainLoop"| n0
  class e1 edge_registration
  n3 e2@--> n0
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_set_membership
  n5 e4@--> n0
  class e4 edge_order
  n6 e5@-->|"查询访问"| n0
  class e5 edge_read
  n7 e6@-->|"查询访问"| n0
  class e6 edge_read
  n0 e7@-->|"访问声明"| n8
  class e7 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
