  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**TranslationExtrapolation**<br/>启用平移外推" }
  class n0 node_component
  n1@{ shape: rounded, label: "**reset​_​translation​_​extrapolation**<br/>在固定步开始前还原真实位置。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update​_​translation​_​extrapolation​_​**<br/>**states**<br/>依据当前线速度预测下一个位置端点。" }
  class n2 node_system
  n0 e0@-->|"存在性约束"| n1
  class e0 edge_reference
  n0 e1@-->|"存在性约束"| n2
  class e1 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
