---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-eec1d3413dfd066d-e9{marker-start:url(#object-eec1d3413dfd066d_flowchart-v2-pointStart)!important}\n#object-eec1d3413dfd066d_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: RotationEasingState · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**RotationEasingState**<br/>保存固定步旋转插值的起点与终点" }
  class n0 node_component
  n1@{ shape: rounded, label: "**reset_rotation_easing**<br/>清除旧旋转平滑的起点和终点。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update_rotation_interpolation_start**<br/>把当前旋转记录为插值起点。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**complete_rotation_easing**<br/>在新一轮插值前完成上一段旋转。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**reset_rotation_extrapolation**<br/>在固定步开始前还原真实旋转。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update_rotation_interpolation_end**<br/>把当前旋转记录为插值终点。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_rotation_extrapolation_**<br/>**states#lt;avian3d::interpolation::**<br/>**AngVelSource#gt;**<br/>依据当前角速度预测下一个旋转端点。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**ease_rotation_hermite#lt;avian3d::**<br/>**interpolation::AngVelSource#gt;**<br/>用两端角速度做 Hermite 旋转平滑。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**ease_rotation_slerp**<br/>按固定步剩余比例球面插值显示旋转。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**reset_easing_states_on_transform_**<br/>**change**<br/>在外部直接改变变换时取消失效的平滑区间。" }
  class n9 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  n5 e4@--> n0
  class e4 edge_write
  n6 e5@--> n0
  class e5 edge_write
  n0 e6@--> n7
  class e6 edge_read
  n0 e7@--> n8
  class e7 edge_read
  n9 e8@--> n0
  class e8 edge_write
  n9 e9@---|"存在 / 变更过滤"| n0
  class e9 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: bumpX }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
