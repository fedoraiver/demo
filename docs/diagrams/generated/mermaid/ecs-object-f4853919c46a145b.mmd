---
flowchart LR
  accTitle: demo::window_policy::install_native_policy · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_non_send fill:#F8F3EF,stroke:#A5633A,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**demo::window​_​policy::install​_​native​_​**<br/>**policy**<br/>安装并维护原生窗口比例与尺寸策略。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**raw​_​handle::RawHandleWrapper**<br/>来自crate:bevy​_​window ↗：持有原始窗口<br/>及显示服务器句柄" }
  class n1 node_component
  class n1 external_node
  n2@{ shape: tag-rect, label: "**window​_​policy::NativePolicies**<br/>原生句柄守护对象必须与窗口线程绑定，实体<br/>退出时释放对应约束。" }
  class n2 node_non_send
  n3@{ shape: rounded, label: "**window::Window**<br/>来自crate:bevy​_​window ↗：保存窗口的呈<br/>现模式、位置、分辨率、标题、全屏及平台行<br/>为配置" }
  class n3 node_component
  class n3 external_node
  subgraph layout_card_n4[" "]
  n4@{ shape: rounded, label: "**window::PrimaryWindow**<br/>来自crate:bevy​_​window ↗：标识唯一的主<br/>窗口" }
  class n4 node_component
  class n4 external_node
  end
  style layout_card_n4 fill:none,stroke:none
  n5@{ shape: fr-rect, label: "**window​_​policy::WindowPolicyPlugin**<br/>在现有会话日志和原生窗口创建之后安装比例<br/>策略。" }
  class n5 node_plugin
  n1 e0@--> n0
  class e0 edge_read
  n0 e1@-->|"可变访问"| n2
  class e1 edge_write
  n0 e2@-->|"可变访问"| n3
  class e2 edge_write
  n0 e3@-->|"赋值"| n3
  class e3 edge_write
  n4 e4@-->|"存在性约束"| n0
  class e4 edge_reference
  n5 e5@-->|"调用"| n0
  class e5 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: bumpX }
  e3@{ curve: basis }
