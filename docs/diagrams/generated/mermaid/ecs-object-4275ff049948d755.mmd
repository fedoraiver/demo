---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: main · Startup · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**main · Startup**<br/>保存本应用调度的注册上下文与成员。" }
  class n0 node_engine_flow
  n1@{ shape: rounded, label: "**spawn_gizmo_meshes**<br/>创建变换操作器各轴网格、材质和覆盖相机。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**spawn_mouse_pointer**<br/>创建携带 PointerId::Mouse 的默认鼠标指<br/>针实体，让后续输入接收与拾取流程能够关联<br/>鼠标状态。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**log_world_inspector**<br/>来自世界检查器 ↗：记录世界检查器已启用<br/>的初始化日志。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**log_policy**<br/>来自窗口策略 ↗：记录窗口策略支持平台、<br/>比例与最小尺寸。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**log_simulation_timestep**<br/>来自设置与参数 ↗：记录固定模拟频率。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**log_configuration**<br/>来自角色运动 ↗：记录角色运动与持物行为<br/>的初始化配置。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**spawn_lighting**<br/>来自场景装配 ↗：进入游戏会话时创建日光<br/>场景和加载相机，配置默认 UI、主 Egui 上<br/>下文及退出清理；资源就绪后继续复用同一相<br/>机实体。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**spawn_menu_controller**<br/>来自菜单与界面 ↗：创建菜单动作控制者及<br/>键盘、手柄绑定。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**preload_sounds**<br/>来自音频播放 ↗：预加载界面与音效短音并<br/>保存播放策略。" }
  class n9 node_system
  class n9 external_node
  n0 e0@-->|"main / Startup"| n1
  class e0 edge_registration
  n0 e1@-->|"main / Startup"| n2
  class e1 edge_registration
  n0 e2@-->|"main / Startup"| n3
  class e2 edge_registration
  n0 e3@-->|"main / Startup"| n4
  class e3 edge_registration
  n0 e4@-->|"main / Startup"| n5
  class e4 edge_registration
  n0 e5@-->|"main / Startup"| n6
  class e5 edge_registration
  n0 e6@-->|"main / Startup"| n7
  class e6 edge_registration
  n0 e7@-->|"main / Startup"| n8
  class e7 edge_registration
  n0 e8@-->|"main / Startup"| n9
  class e8 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
