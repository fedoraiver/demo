---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-0d4ad6682ea693b6-e5{marker-start:url(#object-0d4ad6682ea693b6_flowchart-v2-pointStart)!important}\n#object-0d4ad6682ea693b6_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: run_fixed_main_schedule · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**run_fixed_main_schedule**<br/>累积虚拟时间并按固定时钟步长重复运行<br/>FixedMain，保存剩余 overstep。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · RunFixedMainLoop**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**RunFixedMainLoopSystems::**<br/>**FixedMainLoop**<br/>根据虚拟时间推进零次或多次固定更新。" }
  class n2 node_system_set
  n3@{ shape: notch-rect, label: "**World**<br/>保存实体、组件、资源及关联元数据" }
  class n3 node_system_param
  n4@{ shape: cyl, label: "**Time#lt;Virtual#gt;**<br/>提供可暂停的游戏时间，作为固定步时间来<br/>源。" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**Time#lt;Fixed#gt;**<br/>提供固定模拟的时间步长。" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**Time**<br/>提供当前运行阶段的通用时间。" }
  class n6 node_resource
  n1 e0@-->|"main / RunFixedMainLoop"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_write
  n4 e3@-->|"正文只读访问"| n0
  class e3 edge_read
  n5 e4@-->|"正文只读访问"| n0
  class e4 edge_read
  n5 e5@---|"正文可变访问"| n0
  class e5 edge_write
  n0 e6@-->|"正文可变访问"| n6
  class e6 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
