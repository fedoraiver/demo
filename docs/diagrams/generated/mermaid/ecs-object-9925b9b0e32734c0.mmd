---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-9925b9b0e32734c0-e1{marker-start:url(#object-9925b9b0e32734c0_flowchart-v2-pointStart)!important}\n#object-9925b9b0e32734c0-e2{marker-start:url(#object-9925b9b0e32734c0_flowchart-v2-pointStart)!important}\n#object-9925b9b0e32734c0-e5{marker-start:url(#object-9925b9b0e32734c0_flowchart-v2-pointStart)!important}\n#object-9925b9b0e32734c0-e7{marker-start:url(#object-9925b9b0e32734c0_flowchart-v2-pointStart)!important}\n#object-9925b9b0e32734c0-e9{marker-start:url(#object-9925b9b0e32734c0_flowchart-v2-pointStart)!important}\n#object-9925b9b0e32734c0-e11{marker-start:url(#object-9925b9b0e32734c0_flowchart-v2-pointStart)!important}\n#object-9925b9b0e32734c0_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: HeldTarget · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**HeldTarget**<br/>保存本帧握持姿态的检查目标。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**handle_interaction**<br/>处理物品拾取、共享持握与主动释放。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**release_orphaned_items**<br/>清理失效持握并恢复物品独立运动。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**align_attachments**<br/>沿安全碰撞路径将物品对齐双手。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n6 node_system
  class n6 external_node
  n1 e0@-->|"延迟移除"| n0
  class e0 edge_write
  n1 e1@---|"延迟只读访问"| n0
  class e1 edge_read
  n2 e2@---|"延迟只读访问"| n0
  class e2 edge_read
  n2 e3@-->|"延迟移除"| n0
  class e3 edge_write
  n3 e4@-->|"延迟添加"| n0
  class e4 edge_write
  n3 e5@---|"延迟只读访问"| n0
  class e5 edge_read
  n3 e6@-->|"延迟移除"| n0
  class e6 edge_write
  n4 e7@---|"延迟只读访问"| n0
  class e7 edge_read
  n4 e8@-->|"延迟移除"| n0
  class e8 edge_write
  n5 e9@---|"延迟只读访问"| n0
  class e9 edge_read
  n5 e10@-->|"延迟移除"| n0
  class e10 edge_write
  n6 e11@---|"延迟只读访问"| n0
  class e11 edge_read
  n6 e12@-->|"延迟移除"| n0
  class e12 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
