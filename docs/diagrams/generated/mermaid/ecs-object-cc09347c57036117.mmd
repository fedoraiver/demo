---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: ui_picking · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ui_picking**<br/>把各指针位置映射到匹配相机的视口坐标，<br/>按 UiStack 的绘制顺序检查 UI 节点及拾<br/>取规则，输出 PointerHits 供悬停与交互<br/>阶段汇总。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PreUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**PickingSystems::Backend**<br/>通过拾取后端生成指针命中。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**PointerId**<br/>以鼠标、触摸编号或自定义 UUID 提供稳定<br/>指针身份" }
  class n3 node_component
  n4@{ shape: rounded, label: "**PointerLocation**<br/>保存指针当前目标及该目标上的位置" }
  class n4 node_component
  n5@{ shape: rounded, label: "**Camera**<br/>配置相机视口、输出目标和渲染顺序。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**RenderTarget**<br/>指定相机输出的窗口、图像或纹理。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**UiPickingCamera**<br/>标记允许参与 UI 拾取的相机。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**PrimaryWindow**<br/>标识唯一的主窗口" }
  class n8 node_component
  n9@{ shape: cyl, label: "**UiPickingSettings**<br/>配置 UI 拾取的显式标记要求。" }
  class n9 node_resource
  n10@{ shape: cyl, label: "**UiStack**<br/>保存按相机分区的 UI 绘制顺序。" }
  class n10 node_resource
  n11@{ shape: notch-rect, label: "**NodeQuery**<br/>汇集 UI 拾取的节点命中数据。" }
  class n11 node_query_data
  n12@{ shape: notch-rect, label: "**Entity**<br/>以实体索引和代际组成实体身份" }
  class n12 node_system_param
  n13@{ shape: rounded, label: "**ComputedNode**<br/>保存 UI 布局计算后的物理尺寸。" }
  class n13 node_component
  n14@{ shape: rounded, label: "**UiGlobalTransform**<br/>保存 UI 节点的绝对二维变换。" }
  class n14 node_component
  n15@{ shape: rounded, label: "**Pickable**<br/>配置实体是否可被拾取及是否阻挡深度更低的<br/>命中目标" }
