  n16@{ shape: rounded, label: "**InheritedVisibility**<br/>保存从实体层级计算出的可见性。" }
  class n16 node_component
  n17@{ shape: rounded, label: "**ComputedUiTargetCamera**<br/>缓存 UI 节点实际采用的相机。" }
  class n17 node_component
  n18@{ shape: rounded, label: "**TextLayoutInfo**<br/>保存文字块完成排版后的缩放、字形位置、文<br/>字运行几何及尺寸" }
  class n18 node_component
  n19@{ shape: rounded, label: "**ComputedTextBlock**<br/>缓存文字块的 Parley 布局、文本实体树和<br/>重绘标记" }
  class n19 node_component
  n20@{ shape: rounded, label: "**CalculatedClip**<br/>缓存节点从祖先继承的裁剪结果。" }
  class n20 node_component
  n21@{ shape: cyl, label: "**Messages#lt;PointerHits#gt;**<br/>保存 PointerHits 消息。" }
