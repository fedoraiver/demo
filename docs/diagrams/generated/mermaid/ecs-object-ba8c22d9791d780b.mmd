---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: EguiCameraView · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**EguiCameraView**<br/>在主渲染目标视图上保存对应的 Egui 渲染<br/>视图实体" }
  class n0 node_component
  n1@{ shape: rounded, label: "**prepare_egui_transforms_system**<br/>上传 Egui 屏幕变换缓冲。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**egui_pass**<br/>读取当前 Egui 视图已准备的绘制数据、纹<br/>理绑定及变换缓冲，在目标颜色附件上执行<br/>Egui 绘制命令，并按相机视口设置渲染范<br/>围。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**egui_pass**<br/>读取当前 Egui 视图已准备的绘制数据、纹<br/>理绑定及变换缓冲，在目标颜色附件上执行<br/>Egui 绘制命令，并按相机视口设置渲染范<br/>围。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**extract_egui_camera_view_system**<br/>为活动相机提取独立 Egui 渲染视图。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**prepare_egui_transforms_system**<br/>上传 Egui 屏幕变换缓冲。" }
  class n5 node_system
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n4 e3@-->|"延迟移除"| n0
  class e3 edge_write
  n4 e4@-->|"延迟添加"| n0
  class e4 edge_write
  n0 e5@--> n5
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
