---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: spawn_gizmo_meshes · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**spawn_gizmo_meshes**<br/>创建变换操作器各轴网格、材质和覆盖相机。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · Startup**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n2 node_system_param
  n3@{ shape: cyl, label: "**Assets#lt;Mesh#gt;**<br/>保存模型网格并提供碰撞构建所需的顶点。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**Assets#lt;StandardMaterial#gt;**<br/>保存导入模型使用的材质资产。" }
  class n4 node_resource
  n5@{ shape: rounded, label: "**TransformGizmoRoot**<br/>标记变换操纵器网格层级的根实体。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Transform**<br/>保存实体相对父实体的平移、旋转和缩放" }
  class n6 node_component
  n7@{ shape: rounded, label: "**Visibility**<br/>声明实体可见意图及层级继承方式。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**Mesh3d**<br/>为三维可绘制实体指定网格资产。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**MeshMaterial3d#lt;StandardMaterial#gt;**<br/>为三维网格指定材质资产。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**TransformGizmoMeshMarker**<br/>记录操纵器网格部件的轴和操作模式。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**RenderLayers**<br/>限定相机与实体可相交的渲染层。" }
  class n11 node_component
  n12@{ shape: rounded, label: "**ChildOf**<br/>保存当前实体的父实体身份" }
  class n12 node_component
  n13@{ shape: rounded, label: "**Camera3d**<br/>启用三维相机主渲染流程。" }
  class n13 node_component
  n14@{ shape: rounded, label: "**Camera**<br/>配置相机视口、输出目标和渲染顺序。" }
  class n14 node_component
  n15@{ shape: rounded, label: "**GizmoOverlayCamera**<br/>标记绘制变换操纵器的内部叠加相机。" }
  class n15 node_component
  n16@{ shape: cyl, label: "**TransformGizmoMaterials**<br/>保存操纵器各轴的普通、高亮和停用颜色。" }
  class n16 node_resource
