---
flowchart LR
  accTitle: collision::diagnostics::CollisionDiagnostics · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**CollisionDiagnostics**<br/>汇总碰撞检测耗时与接触数量。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**update​_​narrow​_​phase**<br/>更新窄相接触并输出碰撞变化消息。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**reset**<br/>重置物理诊断测量。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**collect​_​collision​_​pairs**<br/>为移动碰撞代理收集广相候选接触。" }
  class n3 node_system
  n1 e0@-->|"赋值"| n0
  class e0 edge_write
  n1 e1@-->|"可变访问"| n0
  class e1 edge_write
  n2 e2@-->|"赋值"| n0
  class e2 edge_write
  n2 e3@-->|"可变访问"| n0
  class e3 edge_write
  n3 e4@-->|"可变访问"| n0
  class e4 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
