---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-f5c6ed30c0cc48ab-e6{marker-start:url(#object-f5c6ed30c0cc48ab_flowchart-v2-pointStart)!important}\n#object-f5c6ed30c0cc48ab_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: frame_count::FrameCount · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**FrameCount**<br/>记录应用启动以来的帧计数" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**prepare​_​view​_​uniforms**<br/>来自crate:bevy​_​render ↗：生成视图投<br/>影、抖动、裁剪及 LOD 的 GPU 参数。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**prepare​_​prepass​_​textures**<br/>来自crate:bevy​_​core​_​pipeline ↗：按三<br/>维预通道配置分配各类输出纹理。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**update​_​frame​_​count**<br/>递增应用帧计数。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**extract​_​frame​_​count**<br/>来自crate:bevy​_​render ↗：将主世界帧计<br/>数同步到渲染世界。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**prepare​_​taa​_​history​_​textures**<br/>来自crate:bevy​_​anti​_​alias ↗：按帧奇<br/>偶为 TAA 轮换读写历史纹理。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**prepare​_​globals​_​buffer**<br/>来自crate:bevy​_​render ↗：更新并上传着<br/>色器全局时间与帧号。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**collect​_​meshes​_​for​_​gpu​_​building**<br/>来自crate:bevy​_​pbr ↗：把线程提取队列<br/>整理为 GPU 网格实例和输入缓冲。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**prepare​_​taa​_​jitter**<br/>来自crate:bevy​_​anti​_​alias ↗：为 TAA<br/>相机逐帧设置 Halton 投影抖动。" }
  class n8 node_system
  class n8 external_node
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_read
  n3 e2@-->|"赋值"| n0
  class e2 edge_write
  n3 e3@-->|"可变访问"| n0
  class e3 edge_write
  n4 e4@-->|"插入"| n0
  class e4 edge_write
  n0 e5@--> n5
  class e5 edge_read
  n4 e6@--- n0
  class e6 edge_read
  n0 e7@--> n6
  class e7 edge_read
  n0 e8@--> n7
  class e8 edge_read
  n0 e9@--> n8
  class e9 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: bumpX }
  e4@{ curve: bumpX }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
