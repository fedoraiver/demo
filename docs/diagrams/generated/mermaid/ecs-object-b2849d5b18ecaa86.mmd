---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: AccumulatedMouseMotion · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**AccumulatedMouseMotion**<br/>汇总本帧鼠标位移供观察动作使用。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**accumulate_mouse_motion_system**<br/>累计本帧鼠标位移。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update_pending**<br/>来自Enhanced Input ↗：调用<br/>InputReader 的待处理输入更新逻辑，消费<br/>上一阶段排队的绑定与重置操作，使本轮上下<br/>文评估使用更新后的输入读取状态。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**Enhanced Input update**<br/>来自Enhanced Input ↗：按上下文优先级<br/>评估输入绑定、修饰器和条件，计算动作值及<br/>触发状态；此卡片的名称由系统参数元组生<br/>成。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: lin-rect, label: "**InputSystems**<br/>汇总键盘与鼠标输入状态。" }
  class n4 node_system_set
  n5@{ shape: lin-rect, label: "**EnhancedInputSystems::Prepare**<br/>来自Enhanced Input ↗：准备动作评估并<br/>清理待释放的输入。" }
  class n5 node_system_set
  class n5 external_node
  n6@{ shape: lin-rect, label: "**EnhancedInputSystems::Update**<br/>来自Enhanced Input ↗：评估绑定输入并<br/>更新动作值与触发状态。" }
  class n6 node_system_set
  class n6 external_node
  n1 e0@--> n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n4 e3@-->|"访问声明"| n0
  class e3 edge_write
  n0 e4@-->|"访问声明"| n5
  class e4 edge_read
  n0 e5@-->|"访问声明"| n6
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
