  class e4 edge_publish
  n6 e5@-->|"存在 / 变更过滤"| n0
  class e5 edge_reference
  n7 e6@-->|"存在 / 变更过滤"| n0
  class e6 edge_reference
  n8 e7@-->|"访问声明"| n0
  class e7 edge_read
  n9 e8@-->|"访问声明"| n0
  class e8 edge_read
  n10 e9@-->|"访问声明"| n0
  class e9 edge_read
  n9 e10@---|"访问声明"| n0
  class e10 edge_write
  n11 e11@--> n0
  class e11 edge_registration
