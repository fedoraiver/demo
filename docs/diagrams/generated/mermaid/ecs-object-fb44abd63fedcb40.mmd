  class n20 node_system
  n21@{ shape: rounded, label: "**batch_and_prepare_binned_render_**<br/>**phase#lt;bevy_core_pipeline::core_2d::**<br/>**Opaque2d, bevy_sprite_render::**<br/>**mesh2d::mesh::Mesh2dPipeline#gt;**<br/>在不使用 GPU 数据预处理的路径上逐个读取<br/>分桶实体的批次数据，写入实例缓冲并生成绘<br/>制区间；动态 Uniform 偏移变化时拆分批<br/>次，不可合批项单独记录索引。" }
  class n21 node_system
  n22@{ shape: rounded, label: "**batch_and_prepare_binned_render_**<br/>**phase#lt;bevy_core_pipeline::core_2d::**<br/>**AlphaMask2d, bevy_sprite_render::**<br/>**mesh2d::mesh::Mesh2dPipeline#gt;**<br/>在不使用 GPU 数据预处理的路径上逐个读取<br/>分桶实体的批次数据，写入实例缓冲并生成绘<br/>制区间；动态 Uniform 偏移变化时拆分批<br/>次，不可合批项单独记录索引。" }
  class n22 node_system
  n23@{ shape: rounded, label: "**batch_and_prepare_sorted_render_**<br/>**phase#lt;bevy_core_pipeline::core_2d::**<br/>**Transparent2d, bevy_sprite_render::**<br/>**mesh2d::mesh::Mesh2dPipeline#gt;**<br/>为有序渲染阶段在 CPU 上构建实例数据，按<br/>绘制元数据合并兼容项，并给阶段项记录实例<br/>区间及可选的动态 Uniform 偏移。" }
  class n23 node_system
  n24@{ shape: rounded, label: "**prepare_skins**<br/>交换本帧与上一帧的骨骼 GPU 缓冲，按暂存<br/>关节矩阵数量扩容并上传数据；新建上一帧缓<br/>冲时使用当前姿势填充。" }
  class n24 node_system
  n25@{ shape: rounded, label: "**prepare_previous_view_uniforms**<br/>重建前帧抖动矩阵并上传视图历史参数。" }
  class n25 node_system
  n26@{ shape: rounded, label: "**prepare_fog**<br/>把各提取视图的 DistanceFog 转换为线<br/>性、指数、平方指数或大气模式的 GPU 参<br/>数，写入雾 Uniform 缓冲，并记录视图所用<br/>偏移。" }
  class n26 node_system
  n27@{ shape: rounded, label: "**upload_light_probes**<br/>上传各视图的环境图、反射与辐照探针参数。" }
  class n27 node_system
  n28@{ shape: rounded, label: "**prepare_ssr_settings**<br/>上传各视图反射参数并记录动态缓冲偏移。" }
  class n28 node_system
