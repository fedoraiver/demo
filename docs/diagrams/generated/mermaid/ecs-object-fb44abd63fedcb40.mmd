  class n29 node_system
  n30@{ shape: rounded, label: "**upload_decals**<br/>把本帧渲染贴花列表写入 GPU 缓冲；没有贴<br/>花时仍写入一个默认项，保证后续存在可绑定<br/>的缓冲。" }
  class n30 node_system
