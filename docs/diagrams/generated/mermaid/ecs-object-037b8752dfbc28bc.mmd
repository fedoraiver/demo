---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-037b8752dfbc28bc-e7{marker-start:url(#object-037b8752dfbc28bc_flowchart-v2-pointStart)!important}\n#object-037b8752dfbc28bc_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: RotationEasingState · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**RotationEasingState**<br/>保存固定步旋转插值的起点与终点" }
  class n0 node_component
  n1@{ shape: rounded, label: "**ease​_​rotation​_​hermite**<br/>用两端角速度做 Hermite 旋转平滑。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update​_​rotation​_​extrapolation​_​states**<br/>依据当前角速度预测下一个旋转端点。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**ease​_​rotation​_​slerp**<br/>按固定步剩余比例球面插值显示旋转。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**reset​_​rotation​_​extrapolation**<br/>在固定步开始前还原真实旋转。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update​_​rotation​_​interpolation​_​end**<br/>把当前旋转记录为插值终点。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**reset​_​easing​_​states​_​on​_​transform​_​**<br/>**change**<br/>在外部直接改变变换时取消失效的平滑区间。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**reset​_​rotation​_​easing**<br/>清除旧旋转平滑的起点和终点。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**complete​_​rotation​_​easing**<br/>在新一轮插值前完成上一段旋转。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**update​_​rotation​_​interpolation​_​start**<br/>把当前旋转记录为插值起点。" }
  class n9 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"赋值"| n0
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  n5 e4@-->|"赋值"| n0
  class e4 edge_write
  n6 e5@-->|"可变访问"| n0
  class e5 edge_write
  n7 e6@-->|"可变访问"| n0
  class e6 edge_write
  n6 e7@---|"存在性约束"| n0
  class e7 edge_reference
  n7 e8@-->|"赋值"| n0
  class e8 edge_write
  n0 e9@--> n8
  class e9 edge_read
  n9 e10@-->|"赋值"| n0
  class e10 edge_write
  n9 e11@-->|"可变访问"| n0
  class e11 edge_write
  n5 e12@-->|"可变访问"| n0
  class e12 edge_write
  n6 e13@-->|"赋值"| n0
  class e13 edge_write
  n2 e14@-->|"可变访问"| n0
  class e14 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: bumpX }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: basis }
  e13@{ curve: basis }
  e14@{ curve: basis }
