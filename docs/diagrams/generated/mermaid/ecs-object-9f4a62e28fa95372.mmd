---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: Trigger · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**Trigger**<br/>组织动作求值、值应用与事件触发。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**Apply**<br/>组织动作求值、值应用与事件触发。" }
  class n1 node_system_set
  n2@{ shape: rounded, label: "**(bevy​_​ecs::system::commands::**<br/>**Commands#lt;'​_​, '​_​#gt;, bevy​_​ecs::change​_​**<br/>**detection::params::Res#lt;'​_​, bevy​_​**<br/>**enhanced​_​input::context::instance::**<br/>**ContextInstances#lt;bevy​_​app::main​_​**<br/>**schedule::PreUpdate#gt;#gt;, bevy​_​ecs::**<br/>**system::query::Query#lt;'​_​, '​_​, bevy​_​**<br/>**ecs::world::entity​_​access::**<br/>**filtered::FilteredEntityRef#lt;'​_​, '​_​**<br/>**#gt;, bevy​_​ecs::query::filter::**<br/>**Without#lt;bevy​_​enhanced​_​input::**<br/>**action::fns::ActionFns#gt;#gt;, bevy​_​ecs::**<br/>**system::query::Query#lt;'​_​, '​_​, bevy​_​**<br/>**ecs::world::entity​_​access::entity​_​**<br/>**ref::EntityRef#lt;'​_​#gt;, (bevy​_​ecs::**<br/>**query::filter::With#lt;bevy​_​enhanced​_​**<br/>**input::action::fns::ActionFns#gt;,**<br/>**bevy​_​ecs::query::filter::**<br/>**Without#lt;bevy​_​enhanced​_​input::**<br/>**context::instance::**<br/>**ContextInstances#lt;bevy​_​app::main​_​**<br/>**schedule::PreUpdate#gt;#gt;)#gt;)**<br/>根据求值结果触发输入动作通知。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**demo::ui::requests::handle​_​requests**<br/>来自ui ↗：每帧只消费一项语义请求，避免<br/>鼠标与确认键同时激活，或旧页面动作穿过页<br/>面切换。" }
  class n3 node_system
  class n3 external_node
  n1 e0@-->|"先于"| n0
  class e0 edge_order
  n0 e1@-->|"集合成员"| n2
  class e1 edge_set_membership
  n0 e2@-->|"先于"| n3
  class e2 edge_order
  e1@{ curve: basis }
  e2@{ curve: basis }
