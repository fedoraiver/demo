---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: UiSystems::Content · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**UiSystems::Content**<br/>在 UI 布局前测量文字和内容需求。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**main · PostUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: rounded, label: "**update_inline_image_boxes**<br/>把内联图像尺寸同步到文本排版盒。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**measure_text_system**<br/>在文本变化后更新内容测量并安排文字重排。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**update_editable_text_content_size**<br/>按可见字符宽度和行数设置输入框固有尺寸。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update_editable_text_styles**<br/>把字体和排版配置同步到可编辑文本引擎。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**sync_font_size_to_em_size**<br/>把文本字号解析为节点的 EmSize。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**update_image_content_size_system**<br/>按图像或图集区域更新 UI 的固有尺寸测<br/>量。" }
  class n7 node_system
  n8@{ shape: lin-rect, label: "**UiSystems::Propagate**<br/>沿 UI 层级传播布局所需的组件值。" }
  class n8 node_system_set
  n9@{ shape: rounded, label: "**mark_images_as_changed_if_their_**<br/>**assets_changed**<br/>使图像或图集资产变化触发 UI 图像更新。" }
  class n9 node_system
  n10@{ shape: lin-rect, label: "**UiSystems::Layout**<br/>计算界面内容与视口的本帧布局。" }
  class n10 node_system_set
  n1 e0@-->|"main / PostUpdate"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_set_membership
  n0 e4@--> n5
  class e4 edge_set_membership
  n0 e5@--> n6
  class e5 edge_set_membership
  n0 e6@--> n7
  class e6 edge_set_membership
  n8 e7@--> n0
  class e7 edge_order
  n0 e8@--> n9
  class e8 edge_order
  n0 e9@--> n10
  class e9 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
