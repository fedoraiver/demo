---
flowchart LR
  accTitle: mesh2d::mesh::Mesh2dPipeline · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Mesh2dPipeline**<br/>提供二维网格的视图与实例资源布局。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**specialize​_​material2d​_​meshes**<br/>为可见二维网格重建失效的材质专用化。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare​_​mesh2d​_​view​_​bind​_​groups**<br/>为二维相机绑定视图、全局参数与色调<br/>LUT。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare​_​mesh2d​_​bind​_​group**<br/>按网格元数据分配块建立二维网格绑定组。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**init​_​mesh​_​2d​_​pipeline**<br/>建立二维网格的视图、实例及元数据输入布<br/>局。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**init​_​line​_​gizmo​_​pipelines**<br/>来自crate:bevy​_​gizmos​_​render ↗：建立<br/>二维 Gizmo 线段和接头管线。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**init​_​material​_​2d​_​pipeline**<br/>以二维网格基础管线建立材质管线资源。" }
  class n6 node_system
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n4 e3@-->|"插入"| n0
  class e3 edge_write
  n0 e4@--> n5
  class e4 edge_read
  n0 e5@--> n6
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
