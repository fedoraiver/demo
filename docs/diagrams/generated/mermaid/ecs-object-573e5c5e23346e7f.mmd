---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Assets<AudioInstance> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Assets#lt;AudioInstance#gt;**<br/>保存正在播放或刚就绪的声音实例。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**asset_events**<br/>来自Bevy 引擎 ↗：将 Assets 暂存的<br/>Added、Modified、Removed 等变化批量写<br/>入对应 AssetEvent 消息；存在<br/>AssetChanges 时同步记录当前系统 tick，<br/>随后清空待发队列。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**play_dynamic_channels**<br/>执行按名称创建的动态音频通道命令。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**play_audio_channel#lt;bevy_kira_audio::**<br/>**MainTrack#gt;**<br/>执行指定类型音频通道的命令队列。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**play_audio_channel#lt;demo::audio::**<br/>**UiTrack#gt;**<br/>执行指定类型音频通道的命令队列。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**play_audio_channel#lt;demo::audio::**<br/>**SfxTrack#gt;**<br/>执行指定类型音频通道的命令队列。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**track_assets**<br/>来自Bevy 引擎 ↗：持有 AssetServer 资<br/>产信息锁处理句柄释放通知，确认没有新强句<br/>柄后移除已释放资产，使 Assets 集合与资<br/>产服务器的引用状态保持一致。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**cleanup_stopped_instances**<br/>释放已停止播放实例的内部引用。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**update_instance_states#lt;bevy_kira_**<br/>**audio::MainTrack#gt;**<br/>把实际播放状态回写到类型通道。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**update_instance_states#lt;demo::audio::**<br/>**UiTrack#gt;**<br/>把实际播放状态回写到类型通道。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**update_instance_states#lt;demo::audio::**<br/>**SfxTrack#gt;**<br/>把实际播放状态回写到类型通道。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**sync_voice_volumes**<br/>来自音频播放 ↗：将有效混音与素材音量同<br/>步到播放实例。" }
  class n11 node_system
  class n11 external_node
  n12@{ shape: rounded, label: "**sync_voice_volumes**<br/>来自音频播放 ↗：为新就绪的播放实例补同<br/>步有效音量。" }
  class n12 node_system
  class n12 external_node
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_write
  n6 e5@--> n0
  class e5 edge_write
  n7 e6@--> n0
  class e6 edge_write
  n0 e7@--> n8
  class e7 edge_read
  n0 e8@--> n9
  class e8 edge_read
  n0 e9@--> n10
  class e9 edge_read
  n11 e10@-->|"访问声明"| n0
  class e10 edge_write
  n12 e11@-->|"访问声明"| n0
  class e11 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
