---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: UpdateEasingTick · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**UpdateEasingTick**<br/>组织变换缓动端点与帧间应用。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**Facing**<br/>来自game​_​flow ↗：固定循环后的呈现阶<br/>段，零固定步的帧也执行同一顺序。" }
  class n1 node_system_set
  class n1 external_node
  n2@{ shape: lin-rect, label: "**AfterFixedMainLoop**<br/>来自crate:bevy​_​app ↗：划分固定更新循<br/>环的前后边界。" }
  class n2 node_system_set
  class n2 external_node
  n3@{ shape: lin-rect, label: "**Visibility**<br/>来自game​_​flow ↗：固定循环后的呈现阶<br/>段，零固定步的帧也执行同一顺序。" }
  class n3 node_system_set
  class n3 external_node
  n4@{ shape: lin-rect, label: "**HeldPresentation**<br/>来自game​_​flow ↗：固定循环后的呈现阶<br/>段，零固定步的帧也执行同一顺序。" }
  class n4 node_system_set
  class n4 external_node
  n5@{ shape: lin-rect, label: "**HeldPhysics**<br/>来自game​_​flow ↗：固定循环后的呈现阶<br/>段，零固定步的帧也执行同一顺序。" }
  class n5 node_system_set
  class n5 external_node
  n6@{ shape: rounded, label: "**bevy​_​transform​_​interpolation::**<br/>**update​_​last​_​easing​_​tick**<br/>记录平滑系统完成后的变化检测边界。" }
  class n6 node_system
  n7@{ shape: lin-rect, label: "**Ease**<br/>组织变换缓动端点与帧间应用。" }
  class n7 node_system_set
  n8@{ shape: lin-rect, label: "**Camera**<br/>来自game​_​flow ↗：固定循环后的呈现阶<br/>段，零固定步的帧也执行同一顺序。" }
  class n8 node_system_set
  class n8 external_node
  n1 e0@-->|"先于"| n0
  class e0 edge_order
  n2 e1@-->|"集合成员"| n0
  class e1 edge_set_membership
  n3 e2@-->|"先于"| n0
  class e2 edge_order
  n4 e3@-->|"先于"| n0
  class e3 edge_order
  n5 e4@-->|"先于"| n0
  class e4 edge_order
  n0 e5@-->|"集合成员"| n6
  class e5 edge_set_membership
  n7 e6@-->|"先于"| n0
  class e6 edge_order
  n8 e7@-->|"先于"| n0
  class e7 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
