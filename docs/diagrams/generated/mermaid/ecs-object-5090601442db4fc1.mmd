---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-5090601442db4fc1-e4{marker-start:url(#object-5090601442db4fc1_flowchart-v2-pointStart)!important}\n#object-5090601442db4fc1_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: ViewVisibility · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ViewVisibility**<br/>记录实体是否应被提取用于渲染。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**check_visibility_cpu_culling**<br/>按层、距离和视锥收集各相机可见实体。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**check_visibility_gpu_culling**<br/>同步退出 CPU 裁剪对象的层级可见状态。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**reset_view_visibility**<br/>为本帧可见性检查保留上帧状态。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**mark_newly_hidden_entities_invisible**<br/>提交本帧已不再可见的对象状态。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**check_dir_light_mesh_visibility**<br/>计算方向光各相机级联可见的投影网格。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**check_point_light_mesh_visibility**<br/>计算点光与聚光灯阴影可见的网格。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**assign_objects_to_clusters**<br/>将灯光、探针及贴花分配到视图分簇。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**update_directional_light_frusta**<br/>从方向光级联投影更新阴影视锥。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**update_point_light_frusta**<br/>更新可见点光的六面阴影视锥。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**update_spot_light_frusta**<br/>更新可见聚光灯的阴影视锥。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**draw_aabbs**<br/>为带 ShowAabbGizmo 且可见的实体，使用<br/>Aabb 和 GlobalTransform 绘制三维包围<br/>盒；颜色来自组件、配置默认值或实体派生<br/>色。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**draw_all_aabbs**<br/>绘制未单独标记实体的可见 AABB 调试线<br/>框。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**sprite_picking**<br/>将可见、变换有效的精灵按深度排序，结合指<br/>针射线、相机、精灵图像和拾取配置计算命<br/>中，并向拾取后端发布 PointerHits。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**extract_meshes_for_gpu_building**<br/>增量提取变化或需重试网格到线程队列。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**extract_mesh_materials#lt;bevy_pbr::**<br/>**pbr_material::StandardMaterial#gt;**<br/>根据可见性和材质变化更新渲染实例映射。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**extract_mesh_materials#lt;bevy_pbr::**<br/>**extended_material::**<br/>**ExtendedMaterial#lt;bevy_pbr::pbr_**<br/>**material::StandardMaterial, bevy_**<br/>**pbr::decal::forward::**<br/>**ForwardDecalMaterialExt#gt;#gt;**<br/>根据可见性和材质变化更新渲染实例映射。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**extract_2d_meshes**<br/>增量同步二维网格变换和渲染实例信息。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**extract_mesh_materials_2d#lt;bevy_**<br/>**sprite_render::mesh2d::color_**<br/>**material::ColorMaterial#gt;**<br/>同步可见二维网格使用的材质资产身份。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**extract_mesh_materials_2d#lt;bevy_**<br/>**sprite_render::sprite_mesh::sprite_**<br/>**mesh_material::SpriteMeshMaterial#gt;**<br/>同步可见二维网格使用的材质资产身份。" }
  class n19 node_system
  n20@{ shape: rounded, label: "**extract_mesh_materials_2d#lt;bevy_**<br/>**sprite_render::tilemap_chunk::**<br/>**tilemap_chunk_material::**<br/>**TilemapChunkMaterial#gt;**<br/>同步可见二维网格使用的材质资产身份。" }
  class n20 node_system
  n21@{ shape: rounded, label: "**extract_text2d_sprite**<br/>把可见二维文字及装饰提取为精灵切片。" }
  class n21 node_system
  n22@{ shape: rounded, label: "**extract_skins**<br/>按蒙皮可见性和资产变化分配或回收骨骼缓冲<br/>区域，提取关节全局变换与逆绑定姿势到暂存<br/>数据，并清理移除的蒙皮记录。" }
  class n22 node_system
  n23@{ shape: rounded, label: "**extract_morphs**<br/>提取可见网格的形变权重，重建本帧权重缓冲<br/>及实体索引，同时保留上一帧权重位置以计算<br/>运动矢量；按 GPU 缓冲能力选择对齐和存储<br/>方式。" }
  class n23 node_system
  n24@{ shape: rounded, label: "**extract_lightmaps**<br/>为可见的新增光照贴图分配渲染槽位，记录<br/>UV 和采样设置，释放移除项，并在 GPU 图<br/>像就绪后完成待处理槽位的纹理更新。" }
  class n24 node_system
  n25@{ shape: rounded, label: "**extract_decals**<br/>从主世界提取可见聚簇贴花及点光、聚光和平<br/>行光的光照纹理，重建渲染贴花缓冲，并记录<br/>真正参与聚簇计算的贴花数量。" }
  class n25 node_system
  n26@{ shape: rounded, label: "**extract_lights**<br/>同步可见点光、聚光、平行光及矩形光的渲染<br/>参数和阴影可见实体，提取变化的阴影贴图设<br/>置；隐藏或失效光源不继续保留有效渲染状<br/>态。" }
  class n26 node_system
