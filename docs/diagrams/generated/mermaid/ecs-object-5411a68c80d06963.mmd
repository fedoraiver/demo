---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: ViewUniformOffset · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**ViewUniformOffset**<br/>定位当前视图在共享 Uniform 缓冲中的参<br/>数。" }
  class n0 node_component
  end
  style layout_card_n0 fill:none,stroke:none
  subgraph layout_card_n1[" "]
  n1@{ shape: rounded, label: "**tonemapping**<br/>为启用色调映射的 HDR 视图绑定颜色源、视<br/>图参数和 LUT，执行全屏色调映射并写入后<br/>处理目标；模式关闭或管线尚未就绪时跳过。" }
  class n1 node_system
  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: rounded, label: "**cluster_on_gpu**<br/>执行深度切片、计数、分配和填充的 GPU 聚<br/>簇。" }
  class n2 node_system
  end
  style layout_card_n2 fill:none,stroke:none
  subgraph layout_card_n3[" "]
  n3@{ shape: rounded, label: "**main_opaque_pass_3d**<br/>绘制三维不透明、AlphaMask 与天空盒。" }
  class n3 node_system
  end
  style layout_card_n3 fill:none,stroke:none
  subgraph layout_card_n4[" "]
  n4@{ shape: rounded, label: "**oit_resolve**<br/>在透明主通道之后解析顺序无关透明数据并合<br/>成到视图颜色，同时重置 OIT 原子计数与链<br/>表头，避免下一次透明通道使用损坏的数据。" }
  class n4 node_system
  end
  style layout_card_n4 fill:none,stroke:none
  subgraph layout_card_n5[" "]
  n5@{ shape: rounded, label: "**tonemapping**<br/>为启用色调映射的 HDR 视图绑定颜色源、视<br/>图参数和 LUT，执行全屏色调映射并写入后<br/>处理目标；模式关闭或管线尚未就绪时跳过。" }
  class n5 node_system
  end
  style layout_card_n5 fill:none,stroke:none
  subgraph layout_card_n6[" "]
  n6@{ shape: rounded, label: "**depth_of_field**<br/>以两阶段全屏通道执行景深模糊。" }
  class n6 node_system
  end
  style layout_card_n6 fill:none,stroke:none
  subgraph layout_card_n7[" "]
  n7@{ shape: rounded, label: "**ssao**<br/>依据视口尺寸依次调度深度预处理、屏幕空间<br/>环境光遮蔽及空间去噪计算通道，为当前视图<br/>生成 SSAO 结果；所需管线未完成编译时跳<br/>过。" }
  class n7 node_system
  end
  style layout_card_n7 fill:none,stroke:none
  subgraph layout_card_n8[" "]
  n8@{ shape: rounded, label: "**early_gpu_preprocess**<br/>为当前视图及阴影级联执行早期网格转换与裁<br/>剪。" }
  class n8 node_system
  end
  style layout_card_n8 fill:none,stroke:none
  subgraph layout_card_n9[" "]
  n9@{ shape: rounded, label: "**late_gpu_preprocess**<br/>对后期遮挡工作项执行间接网格预处理。" }
  class n9 node_system
  end
  style layout_card_n9 fill:none,stroke:none
  subgraph layout_card_n10[" "]
  n10@{ shape: rounded, label: "**atmosphere_luts**<br/>根据当前大气、视图和光照参数调度计算管<br/>线，生成透射、多重散射、天空视图及空气透<br/>视查找表，供天空和大气渲染使用。" }
  class n10 node_system
  end
  style layout_card_n10 fill:none,stroke:none
  subgraph layout_card_n11[" "]
  n11@{ shape: rounded, label: "**atmosphere_environment**<br/>使用当前视图的大气和光照参数，为每个大气<br/>环境贴图的六个立方体面调度计算着色器，更<br/>新环境光源纹理。" }
  class n11 node_system
  end
  style layout_card_n11 fill:none,stroke:none
  subgraph layout_card_n12[" "]
  n12@{ shape: rounded, label: "**render_sky**<br/>绑定大气查找表及视图、光照参数，按相机视<br/>口和可选分辨率覆盖设置绘制全屏天空，将结<br/>果写入视图颜色附件。" }
  class n12 node_system
  end
  style layout_card_n12 fill:none,stroke:none
  subgraph layout_card_n13[" "]
  n13@{ shape: rounded, label: "**extract_cameras**<br/>把主世界活动相机的目标、视口、变换、可见<br/>实体和渲染设置提取到渲染实体，并维护视图<br/>所需格式；对停用或目标尺寸无效的相机移除<br/>失效提取状态。" }
  class n13 node_system
  end
  style layout_card_n13 fill:none,stroke:none
  subgraph layout_card_n14[" "]
  n14@{ shape: rounded, label: "**prepare_view_uniforms**<br/>生成视图投影、抖动、裁剪及 LOD 的 GPU<br/>参数。" }
  class n14 node_system
  end
  style layout_card_n14 fill:none,stroke:none
  subgraph layout_card_n15[" "]
  n15@{ shape: rounded, label: "**prepare_mesh_view_bind_groups**<br/>为视图绑定光照、阴影及各可选渲染效果资<br/>源。" }
  class n15 node_system
  end
  style layout_card_n15 fill:none,stroke:none
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  n0 e4@--> n5
  class e4 edge_read
  n0 e5@--> n6
  class e5 edge_read
  n0 e6@--> n7
  class e6 edge_read
  n0 e7@--> n8
  class e7 edge_read
  n0 e8@--> n9
  class e8 edge_read
  n0 e9@--> n10
  class e9 edge_read
  n0 e10@--> n11
  class e10 edge_read
  n0 e11@--> n12
  class e11 edge_read
  n13 e12@-->|"延迟移除"| n0
  class e12 edge_write
  n14 e13@-->|"延迟添加"| n0
  class e13 edge_write
  n0 e14@--> n15
  class e14 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
