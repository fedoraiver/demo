---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-b97ae6159f998c49-e2{marker-start:url(#object-b97ae6159f998c49_flowchart-v2-pointStart)!important}\n#object-b97ae6159f998c49-e4{marker-start:url(#object-b97ae6159f998c49_flowchart-v2-pointStart)!important}\n#object-b97ae6159f998c49_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: batching::NoAutomaticBatching · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**NoAutomaticBatching**<br/>禁止网格实体参与自动合批。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**extract​_​meshes​_​for​_​gpu​_​building**<br/>来自crate:bevy​_​pbr ↗：增量提取变化或<br/>需重试网格到线程队列。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**no​_​automatic​_​skin​_​batching**<br/>来自crate:bevy​_​pbr ↗：在 Uniform 限<br/>制路径上禁止蒙皮网格自动合批。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**extract​_​2d​_​meshes**<br/>来自crate:bevy​_​sprite​_​render ↗：增量<br/>同步二维网格变换和渲染实例信息。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**no​_​automatic​_​morph​_​batching**<br/>来自crate:bevy​_​pbr ↗：在 Uniform 限<br/>制路径上禁止形变网格自动合批。" }
  class n4 node_system
  class n4 external_node
  n0 e0@-->|"存在性约束"| n1
  class e0 edge_reference
  n2 e1@-->|"插入"| n0
  class e1 edge_write
  n2 e2@---|"存在性约束"| n0
  class e2 edge_reference
  n0 e3@-->|"存在性约束"| n3
  class e3 edge_reference
  n4 e4@---|"存在性约束"| n0
  class e4 edge_reference
  n4 e5@-->|"插入"| n0
  class e5 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: bumpX }
  e3@{ curve: basis }
  e4@{ curve: bumpX }
  e5@{ curve: basis }
