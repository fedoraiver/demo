---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: IntegrationSystems::Velocity · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**IntegrationSystems::Velocity**<br/>把速度增量应用到刚体速度。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**main · SubstepSchedule**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n1 node_engine_flow
  class n1 external_node
  n2@{ shape: lin-rect, label: "**ForceSystems::ApplyLocalAcceleration**<br/>按当前姿态应用局部空间加速度。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**integrate_velocities**<br/>对采用默认速度积分的活跃动态刚体，先应用<br/>线性和角速度阻尼，再累加当前步的速度增<br/>量；运动学刚体跳过该积分，并记录诊断耗<br/>时。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**clamp_velocities**<br/>分别按 MaxLinearSpeed 和<br/>MaxAngularSpeed 限制求解器刚体的速度大<br/>小，超过上限时保持方向缩放；线速度和角速<br/>度查询通过 ParamSet 分开访问。" }
  class n4 node_system
  n5@{ shape: lin-rect, label: "**SubstepSolverSystems::WarmStart**<br/>以历史接触冲量热启动求解器。" }
  class n5 node_system_set
  n1 e0@-->|"main / SubstepSchedule"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_set_membership
  n0 e4@--> n5
  class e4 edge_order
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
