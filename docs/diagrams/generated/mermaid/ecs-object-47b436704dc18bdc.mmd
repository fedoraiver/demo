---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: UiRootNodes · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: notch-rect, label: "**UiRootNodes**<br/>枚举 UI 布局的根节点。" }
  class n0 node_system_param
  n1@{ shape: rounded, label: "**propagate_ui_target_cameras**<br/>为 UI 根配置目标相机和视口信息传播源。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**ui_layout_system**<br/>求解 UI 布局并回写节点尺寸和二维变换。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update_clipping_system**<br/>从 UI 根递归更新继承裁剪范围。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**ui_stack_system**<br/>重建稳定的 UI 绘制和命中顺序。" }
  class n4 node_system
  n0 e0@-->|"参数 / 查询数据"| n1
  class e0 edge_reference
  n0 e1@-->|"参数 / 查询数据"| n2
  class e1 edge_reference
  n0 e2@-->|"参数 / 查询数据"| n3
  class e2 edge_reference
  n0 e3@-->|"参数 / 查询数据"| n4
  class e3 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
