---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-75bd3790038bcd76-e4{marker-start:url(#object-75bd3790038bcd76_flowchart-v2-pointStart)!important}\n#object-75bd3790038bcd76-e12{marker-start:url(#object-75bd3790038bcd76_flowchart-v2-pointStart)!important}\n#object-75bd3790038bcd76_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: scroll_focused_button · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**scroll_focused_button**<br/>将当前聚焦设置按钮滚入可视范围。" }
  class n0 node_system
  n1@{ shape: lin-rect, label: "**UiSystems::Style**<br/>组织菜单显示、数值与说明的原位更新。" }
  class n1 node_system_set
  n2@{ shape: stadium, label: "**main · Update**<br/>来自Bevy 引擎 ↗：保存本应用调度的注册<br/>上下文与成员。" }
  class n2 node_engine_flow
  class n2 external_node
  n3@{ shape: rounded, label: "**MenuButton**<br/>保存菜单动作及按钮的导航序号。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**ChildOf**<br/>来自Bevy 引擎 ↗：关联父实体并跟随父级<br/>生命周期。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**ScrollPosition**<br/>来自Bevy 引擎 ↗：保存内容视口的滚动偏<br/>移。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: rounded, label: "**ComputedNode**<br/>来自Bevy 引擎 ↗：布局计算结果，用于滚<br/>动范围与坐标转换。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**UiGlobalTransform**<br/>来自Bevy 引擎 ↗：保存滚动视口在界面中<br/>的全局变换。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**ComputedNode**<br/>来自Bevy 引擎 ↗：原生布局后的按钮几<br/>何，用于焦点滚入。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**UiGlobalTransform**<br/>来自Bevy 引擎 ↗：保存按钮在界面中的全<br/>局变换。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: cyl, label: "**MenuFocus**<br/>保存当前可操作按钮的导航序号。" }
  class n10 node_resource
  n11@{ shape: notch-rect, label: "**Local · previous focused Entity**<br/>保存最近提交的滚动焦点按钮。" }
  class n11 node_local
  n12@{ shape: fr-rect, label: "**GameUiPlugin**<br/>管理菜单、设置编辑、导航与主菜单展示场<br/>景。" }
  class n12 node_plugin
