  class n7 node_system
  n8@{ shape: rounded, label: "**Hovered**<br/>记录实体当前是否被任一指针悬停。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**Hovered**<br/>标记滑块当前被指针悬停。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**ChildOf**<br/>关联父实体并跟随父级生命周期。" }
