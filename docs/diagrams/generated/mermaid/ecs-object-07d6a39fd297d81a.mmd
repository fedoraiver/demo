---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 48,
      "rankSpacing": 80,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-07d6a39fd297d81a-e0{marker-start:url(#object-07d6a39fd297d81a_flowchart-v2-pointStart)!important}\n#object-07d6a39fd297d81a_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: ssao::ScreenSpaceAmbientOcclusion · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**ScreenSpaceAmbientOcclusion**<br/>配置三维相机的屏幕空间环境光遮蔽。" }
  class n0 node_component
  end
  style layout_card_n0 fill:none,stroke:none
  subgraph layout_card_n1[" "]
  n1@{ shape: rounded, label: "**extract​_​ssao​_​settings**<br/>向渲染相机提取屏幕空间环境光遮蔽配置。" }
  class n1 node_system
  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: rounded, label: "**check​_​views​_​need​_​specialization**<br/>汇总视图渲染特性并检测管线配置变化。" }
  class n2 node_system
  end
  style layout_card_n2 fill:none,stroke:none
  subgraph layout_card_n3[" "]
  n3@{ shape: rounded, label: "**prepare​_​ssao​_​textures**<br/>为环境光遮蔽分配中间纹理及参数缓冲。" }
  class n3 node_system
  end
  style layout_card_n3 fill:none,stroke:none
  subgraph layout_card_n4[" "]
  n4@{ shape: rounded, label: "**prepare​_​ssao​_​pipelines**<br/>按遮蔽质量和时间抖动配置选择计算管线。" }
  class n4 node_system
  end
  style layout_card_n4 fill:none,stroke:none
  n1 e0@--- n0
  class e0 edge_read
  n0 e1@-->|"存在性约束"| n2
  class e1 edge_reference
  n1 e2@-->|"移除"| n0
  class e2 edge_write
  n1 e3@-->|"插入"| n0
  class e3 edge_write
  n0 e4@--> n3
  class e4 edge_read
  n0 e5@--> n4
  class e5 edge_read
  n2 layout_output_0@~~~ n3
  n3 layout_output_1@~~~ n4
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: bumpX }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
