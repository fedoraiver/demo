---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: text_system · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**text_system**<br/>文本节点尺寸、字形提示或重排标志变化时，<br/>通过 TextPipeline 重算排版并写入<br/>TextLayoutInfo；同时更新字体图集，等待<br/>测量函数的文本暂不排版。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**main · PostUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**UiSystems::PostLayout**<br/>根据完成的布局生成裁切和文字几何。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**load_font_assets_into_font_**<br/>**collection**<br/>把字体资产注册到排版字体数据库。" }
  class n3 node_system
  n4@{ shape: lin-rect, label: "**AssetEventSystems**<br/>发布资产容器积累的变更消息。" }
  class n4 node_system_set
  n5@{ shape: cyl, label: "**Assets#lt;Image#gt;**<br/>按资产身份存储对象并暂存变化消息。" }
  class n5 node_resource
  n6@{ shape: cyl, label: "**FontAtlasSet**<br/>保存字体光栅化结果所在的 FontAtlas 集<br/>合" }
  class n6 node_resource
  n7@{ shape: cyl, label: "**TextPipeline**<br/>执行文字块布局与渲染数据生成" }
  class n7 node_resource
  n8@{ shape: rounded, label: "**ComputedNode**<br/>保存 UI 布局计算后的物理尺寸。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**TextLayout**<br/>保存文字块的内部对齐与换行策略" }
  class n9 node_component
  n10@{ shape: rounded, label: "**TextLayoutInfo**<br/>保存文字块完成排版后的缩放、字形位置、文<br/>字运行几何及尺寸" }
  class n10 node_component
  n11@{ shape: rounded, label: "**TextNodeFlags**<br/>追踪 UI 文本测量与重排状态。" }
  class n11 node_component
  n12@{ shape: rounded, label: "**ComputedTextBlock**<br/>缓存文字块的 Parley 布局、文本实体树和<br/>重绘标记" }
  class n12 node_component
  n13@{ shape: rounded, label: "**FontHinting**<br/>选择字形光栅化时是否启用字体 hinting" }
  class n13 node_component
  n14@{ shape: cyl, label: "**ScaleCx**<br/>持有字形缩放上下文" }
  class n14 node_resource
  n1 e0@-->|"main / PostUpdate"| n0
  class e0 edge_registration
