---
flowchart LR
  accTitle: bevy_gizmos::gizmos::GizmoStorage#lt;gizmos::LightGizmoConfigGroup, bevy_time::fixed::Fixed#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**GizmoStorage#lt;LightGizmoConfigGroup,**<br/>**Fixed#gt;**<br/>按配置组和清理上下文存储调试图元。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**clear​_​gizmo​_​context**<br/>清空指定 Gizmo 配置组及清理上下文的存<br/>储，丢弃该上下文上一轮保存的线段和颜色数<br/>据。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**propagate​_​gizmos**<br/>汇入指定上下文保留的 Gizmo 图元。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**collect​_​requested​_​gizmos**<br/>把即时 Gizmo 请求转存到指定清理上下文。" }
  class n3 node_system
  n1 e0@-->|"可变访问"| n0
  class e0 edge_write
  n0 e1@--> n2
  class e1 edge_read
  n3 e2@-->|"可变访问"| n0
  class e2 edge_write
  e0@{ curve: basis }
  e2@{ curve: basis }
