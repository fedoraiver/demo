---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: EnterSchedules · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**EnterSchedules**<br/>执行新状态的进入调度和进入生命周期。" }
  class n0 node_system_set
  n1@{ shape: stadium, label: "**main · StateTransition**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**EnterSchedules · (PhantomData#lt;demo::**<br/>**game_flow::AppState#gt;)**<br/>执行新状态的进入调度和进入生命周期。" }
  class n2 node_system_set
  n3@{ shape: lin-rect, label: "**EnterSchedules · (PhantomData#lt;demo::**<br/>**game_flow::PlayState#gt;)**<br/>执行新状态的进入调度和进入生命周期。" }
  class n3 node_system_set
  n4@{ shape: rounded, label: "**despawn_entities_on_enter_**<br/>**state#lt;demo::game_flow::AppState#gt;**<br/>读取最新状态转换消息，对<br/>DespawnOnEnter 值匹配进入状态的实体排<br/>入销毁；包括禁用实体，未发生有效转换时跳<br/>过。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**disable_entities_on_enter_**<br/>**state#lt;demo::game_flow::AppState#gt;**<br/>有效状态转换进入指定值时，对匹配<br/>DisableOnEnter 的实体及 Children 后代<br/>递归添加 Disabled。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**enable_entities_on_enter_**<br/>**state#lt;demo::game_flow::AppState#gt;**<br/>有效状态转换进入指定值时，对匹配<br/>EnableOnEnter 且已禁用的实体及<br/>Children 后代递归移除 Disabled。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**despawn_entities_on_enter_**<br/>**state#lt;demo::game_flow::PlayState#gt;**<br/>读取最新状态转换消息，对<br/>DespawnOnEnter 值匹配进入状态的实体排<br/>入销毁；包括禁用实体，未发生有效转换时跳<br/>过。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**disable_entities_on_enter_**<br/>**state#lt;demo::game_flow::PlayState#gt;**<br/>有效状态转换进入指定值时，对匹配<br/>DisableOnEnter 的实体及 Children 后代<br/>递归添加 Disabled。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**enable_entities_on_enter_**<br/>**state#lt;demo::game_flow::PlayState#gt;**<br/>有效状态转换进入指定值时，对匹配<br/>EnableOnEnter 且已禁用的实体及<br/>Children 后代递归移除 Disabled。" }
  class n9 node_system
  n10@{ shape: lin-rect, label: "**TransitionSchedules**<br/>执行特定状态对的转换和谓词生命周期。" }
  class n10 node_system_set
  n1 e0@-->|"main / StateTransition"| n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_set_membership
  n0 e2@--> n3
  class e2 edge_set_membership
  n0 e3@--> n4
  class e3 edge_set_membership
  n0 e4@--> n5
  class e4 edge_set_membership
  n0 e5@--> n6
  class e5 edge_set_membership
  n0 e6@--> n7
  class e6 edge_set_membership
  n0 e7@--> n8
  class e7 edge_set_membership
  n0 e8@--> n9
  class e8 edge_set_membership
  n10 e9@--> n0
  class e9 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
