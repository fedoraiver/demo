---
flowchart LR
  accTitle: bevy::bevy_ecs::message::Messages#lt;bevy::bevy_picking::pointer::PointerInput#gt; · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**Messages#lt;PointerInput#gt;**<br/>保存最近两次轮换期间产生的指定类型消息" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**receive**<br/>来自crate:bevy​_​picking ↗：按输入消息<br/>更新拾取指针状态。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**touch​_​pick​_​events**<br/>来自crate:bevy​_​picking ↗：把触摸阶段<br/>转换为独立拾取指针。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**mouse​_​pick​_​events**<br/>来自crate:bevy​_​picking ↗：把窗口鼠标<br/>事件转换为拾取指针动作。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**viewport​_​picking**<br/>来自crate:bevy​_​ui ↗：把外部指针转换并<br/>转发到 UI 内嵌视口。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**pointer​_​events**<br/>来自crate:bevy​_​picking ↗：根据悬停与<br/>按钮状态派发指针交互事件。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**clear​_​cancelled​_​primary​_​presses**<br/>来自ui ↗：Bevy 先从 HoverMap 排除取消<br/>的指针，随后可能无法为它发出<br/>PointerCancel。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**generate​_​hovermap**<br/>来自crate:bevy​_​picking ↗：汇总拾取命<br/>中并应用指针捕获。" }
  class n7 node_system
  class n7 external_node
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"赋值"| n0
  class e1 edge_write
  n3 e2@-->|"可变访问"| n0
  class e2 edge_write
  n0 e3@--> n4
  class e3 edge_read
  n2 e4@-->|"可变访问"| n0
  class e4 edge_write
  n0 e5@--> n5
  class e5 edge_read
  n0 e6@--> n6
  class e6 edge_read
  n0 e7@--> n7
  class e7 edge_read
  n3 e8@-->|"赋值"| n0
  class e8 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: bumpX }
  e3@{ curve: basis }
  e4@{ curve: bumpX }
