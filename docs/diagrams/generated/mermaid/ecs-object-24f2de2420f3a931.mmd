  n5@{ shape: rounded, label: "**MeshViewBindGroup**<br/>保存网格视图的主要及数组资源绑定。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**ViewTarget**<br/>管理视图主颜色纹理及最终输出附件。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**DeferredLightingIdDepthTexture**<br/>保存延迟光照通道使用的标识深度纹理。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**DeferredLightingPipeline**<br/>保存视图选用的延迟光照管线。" }
  class n8 node_component
  n9@{ shape: cyl, label: "**PipelineCache**<br/>缓存 GPU 渲染、计算管线与待创建队列。" }
  class n9 node_resource
  n10@{ shape: cyl, label: "**DeferredLightingLayout**<br/>描述延迟光照绘制的着色与绑定接口。" }
