---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: PickingSystems::Hover · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**PickingSystems::Hover**<br/>更新HoverMap、悬停组件与指针事件。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**PickingSystems::PostHover**<br/>位于Hover之后、Last之前。" }
  class n1 node_system_set
  n2@{ shape: rounded, label: "**pointer_events**<br/>生成指针EntityEvent并同时发布对<br/>应Message。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**update_is_hovered**<br/>按鼠标HoverMap及祖先关系替换已<br/>有Hovered值。" }
  class n3 node_system
  n4@{ shape: stadium, label: "**main · PreUpdate**<br/>保存本应用调度的注册上下文与成员。" }
  class n4 node_engine_flow
  n5@{ shape: rounded, label: "**generate_hovermap**<br/>汇总指针输入与各拾取后端的命中，重建当前<br/>和上一帧悬停映射；处理释放或取消后的捕<br/>获，并把仍有效的指针捕获应用到最终<br/>HoverMap。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_interactions**<br/>依据当前与上一帧 HoverMap 更新指针的深<br/>度排序命中列表，合并多个指针对目标的交互<br/>状态，并更新或插入<br/>PickingInteraction。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**update_is_directly_hovered**<br/>更新鼠标直接悬停的实体标记。" }
  class n7 node_system
  n8@{ shape: lin-rect, label: "**PickingSystems::Backend**<br/>通过拾取后端生成指针命中。" }
  class n8 node_system_set
  n0 e0@-->|"Picking sets chain"| n1
  class e0 edge_order
  n0 e1@-->|"in_set(Hover)"| n2
  class e1 edge_set_membership
  n0 e2@-->|"in_set(Hover)"| n3
  class e2 edge_set_membership
  n4 e3@-->|"main / PreUpdate"| n0
  class e3 edge_registration
  n0 e4@--> n5
  class e4 edge_set_membership
  n0 e5@--> n6
  class e5 edge_set_membership
  n0 e6@--> n3
  class e6 edge_set_membership
  n0 e7@--> n7
  class e7 edge_set_membership
  n0 e8@--> n2
  class e8 edge_set_membership
  n8 e9@--> n0
  class e9 edge_order
  n0 e10@--> n1
  class e10 edge_order
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
