---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-2052da510cfa084b-e0{marker-start:url(#object-2052da510cfa084b_flowchart-v2-pointStart)!important}\n#object-2052da510cfa084b_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}\n.edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: dof::DepthOfField · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**DepthOfField**<br/>配置相机焦点及离焦模糊。" }
  class n0 node_component
  end
  style layout_card_n0 fill:none,stroke:none
  n1@{ shape: rounded, label: "**extract​_​depth​_​of​_​field​_​settings**<br/>把透视相机景深设置转换为 GPU 参数。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare​_​depth​_​of​_​field​_​view​_​bind​_​**<br/>**group​_​layouts**<br/>为景深视图创建单输入与 Bokeh 双输入布<br/>局。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare​_​auxiliary​_​depth​_​of​_​field​_​**<br/>**textures**<br/>为 Bokeh 景深分配第二颜色输出。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**prepare​_​depth​_​of​_​field​_​pipelines**<br/>按景深模式和视图格式准备两阶段管线。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**configure​_​depth​_​of​_​field​_​view​_​**<br/>**targets**<br/>允许景深相机采样自己的深度纹理。" }
  class n5 node_system
  n1 e0@--- n0
  class e0 edge_read
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@--> n3
  class e2 edge_read
  n1 e3@-->|"移除"| n0
  class e3 edge_write
  n0 e4@--> n4
  class e4 edge_read
  n0 e5@-->|"存在性约束"| n5
  class e5 edge_reference
  n1 e6@-->|"插入"| n0
  class e6 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: bumpX }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
