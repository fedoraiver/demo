---
flowchart LR
  accTitle: effect_stack::PostProcessingPipeline · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**effect​_​stack::PostProcessingPipeline**<br/>提供色差、暗角和镜头畸变的共享管线。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**bevy​_​post​_​process::effect​_​stack::**<br/>**prepare​_​post​_​processing​_​pipelines**<br/>按视图颜色格式准备内置后处理管线。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**bevy​_​post​_​process::effect​_​stack::**<br/>**init​_​post​_​processing​_​pipeline**<br/>建立色差、暗角和镜头畸变的共用后处理资<br/>源。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**bevy​_​post​_​process::effect​_​stack::**<br/>**post​_​processing**<br/>组合执行色差、暗角和镜头畸变。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**bevy​_​post​_​process::effect​_​stack::**<br/>**post​_​processing**<br/>组合执行色差、暗角和镜头畸变。" }
  class n4 node_system
  n0 e0@--> n1
  class e0 edge_read
  n2 e1@-->|"插入"| n0
  class e1 edge_write
  n0 e2@--> n3
  class e2 edge_read
  n0 e3@--> n4
  class e3 edge_read
  e0@{ curve: basis }
  e3@{ curve: basis }
