  n1@{ shape: stadium, label: "**RenderApp · Render**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: lin-rect, label: "**RenderSystems::PrepareResources**<br/>初始化绘制绑定需要的缓冲、纹理和<br/>Uniform。" }
  class n2 node_system_set
  n3@{ shape: lin-rect, label: "**RenderSystems::**<br/>**PrepareResourcesBatchPhases**<br/>为各渲染阶段生成绘制批次。" }
  class n3 node_system_set
  n4@{ shape: lin-rect, label: "**RenderSystems::**<br/>**PrepareResourcesWritePhaseBuffers**<br/>把各渲染阶段的批次缓冲写入 GPU。" }
  class n4 node_system_set
  n5@{ shape: lin-rect, label: "**RenderSystems::**<br/>**PrepareResourcesCollectPhaseBuffers**<br/>汇总阶段合批生成的实例和绘制缓冲。" }
  class n5 node_system_set
  n6@{ shape: lin-rect, label: "**RenderSystems::PrepareResourcesFlush**<br/>在资源准备后、绑定创建前上传缓冲。" }
  class n6 node_system_set
  n7@{ shape: lin-rect, label: "**RenderSystems::PrepareBindGroups**<br/>把已准备的渲染资源组成 GPU 绑定组。" }
  class n7 node_system_set
  n8@{ shape: rounded, label: "**prepare_skybox_pipelines**<br/>按目标格式与采样数准备天空盒管线。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**prepare_view_tonemapping_pipelines**<br/>按视图实际颜色分级需求专用化色调映射。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**prepare_view_upscaling_pipelines**<br/>按相机合成方式准备输出缩放管线。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**create_downsample_depth_pipelines**<br/>在支持 GPU 剔除时一次性建立深度降采样管<br/>线。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**prepare_msaa_writeback_pipelines**<br/>为需要保留已有颜色的多采样相机准备回写管<br/>线。" }
  class n12 node_system
  n13@{ shape: rounded, label: "**prepare_downsampling_pipeline**<br/>按预过滤和缩放设置准备 Bloom 降采样变<br/>体。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**prepare_upsampling_pipeline**<br/>为 Bloom 中间合成和最终目标准备升采样管<br/>线。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**prepare_motion_blur_pipelines**<br/>按颜色格式与采样数准备运动模糊管线。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**prepare_depth_of_field_view_bind_**<br/>**group_layouts**<br/>为景深视图创建单输入与 Bokeh 双输入布<br/>局。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**prepare_depth_of_field_pipelines**<br/>按景深模式和视图格式准备两阶段管线。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**prepare_post_processing_pipelines**<br/>按视图颜色格式准备内置后处理管线。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**prepare_post_processing_uniforms**<br/>收集并上传逐视图色差、暗角和畸变参数。" }
  class n19 node_system
  n20@{ shape: rounded, label: "**prepare_fxaa_pipelines**<br/>按相机边缘阈值与目标格式准备 FXAA 管<br/>线。" }
  class n20 node_system
  n21@{ shape: rounded, label: "**prepare_smaa_pipelines**<br/>按质量预设准备视图的三条 SMAA 管线。" }
  class n21 node_system
  n22@{ shape: rounded, label: "**prepare_taa_pipelines**<br/>准备 TAA 当前状态及下一帧恢复用管线。" }
  class n22 node_system
  n23@{ shape: rounded, label: "**prepare_cas_pipelines**<br/>按去噪与目标格式准备视图锐化管线。" }
  class n23 node_system
  n24@{ shape: rounded, label: "**prepare_volumetric_fog_pipelines**<br/>为体积雾视图准备有密度纹理和无密度纹理两<br/>类管线。" }
  class n24 node_system
  n25@{ shape: rounded, label: "**prepare_volumetric_fog_uniforms**<br/>把各视图和雾体积组合转换为体积雾<br/>Uniform。" }
  class n25 node_system
  n26@{ shape: rounded, label: "**prepare_view_depth_textures_for_**<br/>**volumetric_fog**<br/>允许体积雾着色器读取三维相机深度纹理。" }
  class n26 node_system
  n27@{ shape: rounded, label: "**prepare_ssr_pipelines**<br/>为具备反射及深度、延迟预通道的视图选择管<br/>线。" }
  class n27 node_system
  n28@{ shape: rounded, label: "**prepare_deferred_lighting_pipelines**<br/>为有效延迟视图选择与前向一致的光照管线。" }
  class n28 node_system
  n29@{ shape: rounded, label: "**cleanup_background_motion_vectors**<br/>从不再启用运动矢量预通道或已标记<br/>NoBackgroundMotionVectors 的视图移除<br/>背景运动矢量管线及绑定组，清理失效渲染状<br/>态。" }
  class n29 node_system
  n30@{ shape: rounded, label: "**prepare_background_motion_vectors_**<br/>**pipelines**<br/>按采样数和法线预通道准备背景运动管线。" }
  class n30 node_system
  n31@{ shape: rounded, label: "**prepare_ssao_pipelines**<br/>按遮蔽质量和时间抖动配置选择计算管线。" }
  class n31 node_system
  n32@{ shape: rounded, label: "**prepare_preprocess_pipelines**<br/>按设备裁剪能力准备网格预处理管线变体。" }
  class n32 node_system
  n33@{ shape: rounded, label: "**prepare_atmosphere_uniforms**<br/>把提取的大气几何转换为 GPU Uniform 组<br/>件。" }
  class n33 node_system
  n34@{ shape: rounded, label: "**prepare_egui_transforms_system**<br/>来自Egui / Inspector ↗：上传 Egui 屏<br/>幕变换缓冲。" }
  class n34 node_system
  class n34 external_node
  n35@{ shape: rounded, label: "**prepare_egui_render_target_data_**<br/>**system**<br/>来自Egui / Inspector ↗：准备 Egui 顶<br/>点索引和裁剪绘制命令。" }
  class n35 node_system
  class n35 external_node
  n36@{ shape: rounded, label: "**prepare_clustering_pipelines**<br/>为视图取得 GPU 聚簇五阶段的管线标识。" }
  class n36 node_system
  n37@{ shape: rounded, label: "**prepare_cluster_dummy_textures**<br/>为聚簇光栅通道准备视口占位纹理。" }
  class n37 node_system
  n38@{ shape: lin-rect, label: "**RenderSystems::Render**<br/>处理待建管线并执行实际渲染。" }
  class n38 node_system_set
  n39@{ shape: lin-rect, label: "**RenderSystems::PhaseSort**<br/>排序透明渲染阶段及分箱绘制键。" }
  class n39 node_system_set
