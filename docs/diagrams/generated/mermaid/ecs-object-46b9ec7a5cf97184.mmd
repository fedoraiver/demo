---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Transform · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Transform**<br/>保存实体相对父实体的平移、旋转和缩放" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update_translation_interpolation_**<br/>**start**<br/>来自Avian ↗：把当前位置记录为插值起<br/>点。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**update_rotation_interpolation_start**<br/>来自Avian ↗：把当前旋转记录为插值起<br/>点。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**update_scale_interpolation_start**<br/>来自Avian ↗：把当前缩放记录为插值起<br/>点。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**complete_translation_easing**<br/>来自Avian ↗：在新一轮插值前完成上一段<br/>平移。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**complete_rotation_easing**<br/>来自Avian ↗：在新一轮插值前完成上一段<br/>旋转。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**complete_scale_easing**<br/>来自Avian ↗：在新一轮插值前完成上一段<br/>缩放。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**reset_translation_extrapolation**<br/>来自Avian ↗：在固定步开始前还原真实位<br/>置。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**reset_rotation_extrapolation**<br/>来自Avian ↗：在固定步开始前还原真实旋<br/>转。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**update_translation_interpolation_end**<br/>来自Avian ↗：把当前位置记录为插值终<br/>点。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**update_rotation_interpolation_end**<br/>来自Avian ↗：把当前旋转记录为插值终<br/>点。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: rounded, label: "**update_scale_interpolation_end**<br/>来自Avian ↗：把当前缩放记录为插值终<br/>点。" }
  class n11 node_system
  class n11 external_node
  n12@{ shape: rounded, label: "**update_translation_extrapolation_**<br/>**states#lt;avian3d::interpolation::**<br/>**LinVelSource#gt;**<br/>来自Avian ↗：依据当前线速度预测下一个<br/>位置端点。" }
  class n12 node_system
  class n12 external_node
  n13@{ shape: rounded, label: "**update_rotation_extrapolation_**<br/>**states#lt;avian3d::interpolation::**<br/>**AngVelSource#gt;**<br/>来自Avian ↗：依据当前角速度预测下一个<br/>旋转端点。" }
  class n13 node_system
  class n13 external_node
  n14@{ shape: rounded, label: "**propagate_collider_transforms**<br/>来自Avian ↗：沿实体层级计算碰撞体相对<br/>刚体的变换。" }
  class n14 node_system
  class n14 external_node
  n15@{ shape: rounded, label: "**update_collider_scale#lt;avian3d::**<br/>**collision::collider::parry::**<br/>**Collider#gt;**<br/>来自Avian ↗：把根节点和附属碰撞体的缩<br/>放传给形状。" }
  class n15 node_system
  class n15 external_node
  n16@{ shape: rounded, label: "**mark_dirty_trees**<br/>沿祖先链标记需要重算变换的子树。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**propagate_parent_transforms**<br/>沿父子层级并行合成世界变换。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**sync_simple_transforms**<br/>同步没有父子层级的独立实体世界变换。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n19 node_system
  class n19 external_node
  n20@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n20 node_system
  class n20 external_node
  n21@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n21 node_system
  class n21 external_node
  n22@{ shape: rounded, label: "**release_orphaned_items**<br/>来自物品交互 ↗：清理失效持握并恢复物品<br/>独立运动。" }
  class n22 node_system
  class n22 external_node
  n23@{ shape: rounded, label: "**finish_attachments**<br/>来自物品交互 ↗：为持物装配共享碰撞代理<br/>并累计质量。" }
