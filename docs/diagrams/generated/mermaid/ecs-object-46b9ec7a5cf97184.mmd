  class n28 node_system
  n29@{ shape: rounded, label: "**propagate_transforms_for#lt;bevy_ecs::**<br/>**query::filter::Or#lt;(bevy_ecs::query::**<br/>**filter::With#lt;bevy_gizmos::transform_**<br/>**gizmo::TransformGizmoRoot#gt;, bevy_**<br/>**ecs::query::filter::With#lt;bevy_**<br/>**gizmos_render::transform_gizmo_**<br/>**render::GizmoOverlayCamera#gt;, bevy_**<br/>**ecs::query::filter::With#lt;bevy_**<br/>**gizmos::transform_gizmo::**<br/>**TransformGizmoMeshMarker#gt;)#gt;#gt;**<br/>按指定查询过滤器即时计算世界变换。" }
  class n29 node_system
  n30@{ shape: rounded, label: "**mark_dirty_trees**<br/>沿祖先链标记需要重算变换的子树。" }
  class n30 node_system
  n31@{ shape: rounded, label: "**propagate_parent_transforms**<br/>沿父子层级并行合成世界变换。" }
  class n31 node_system
  n32@{ shape: rounded, label: "**sync_simple_transforms**<br/>同步没有父子层级的独立实体世界变换。" }
  class n32 node_system
  n33@{ shape: rounded, label: "**ease_translation_hermite#lt;avian3d::**<br/>**interpolation::LinVelSource#gt;**<br/>来自Avian ↗：用两端线速度做 Hermite<br/>位置平滑。" }
  class n33 node_system
  class n33 external_node
  n34@{ shape: rounded, label: "**ease_rotation_hermite#lt;avian3d::**<br/>**interpolation::AngVelSource#gt;**<br/>来自Avian ↗：用两端角速度做 Hermite<br/>旋转平滑。" }
  class n34 node_system
  class n34 external_node
  n35@{ shape: rounded, label: "**ease_translation_lerp**<br/>来自Avian ↗：按固定步剩余比例线性插值<br/>显示位置。" }
  class n35 node_system
  class n35 external_node
  n36@{ shape: rounded, label: "**ease_rotation_slerp**<br/>来自Avian ↗：按固定步剩余比例球面插值<br/>显示旋转。" }
  class n36 node_system
  class n36 external_node
  n37@{ shape: rounded, label: "**ease_scale_lerp**<br/>来自Avian ↗：按固定步剩余比例线性插值<br/>显示缩放。" }
  class n37 node_system
  class n37 external_node
  n38@{ shape: rounded, label: "**reset_easing_states_on_transform_**<br/>**change**<br/>来自Avian ↗：在外部直接改变变换时取消<br/>失效的平滑区间。" }
  class n38 node_system
  class n38 external_node
  n39@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n39 node_system
  class n39 external_node
  n40@{ shape: rounded, label: "**spawn_gizmo_meshes**<br/>创建变换操作器各轴网格、材质和覆盖相机。" }
  class n40 node_system
  n41@{ shape: rounded, label: "**prepare_island**<br/>来自场景装配 ↗：从海岛模型构建静态碰<br/>撞、坡道与人物碰撞。" }
