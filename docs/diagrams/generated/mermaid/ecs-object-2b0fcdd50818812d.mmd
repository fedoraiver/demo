---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: ConstraintGraph · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**ConstraintGraph**<br/>为并行接触求解维护约束着色图。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**apply_contact_status_changes**<br/>把接触增删同步到约束图和物理岛。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare_contact_constraints**<br/>从有效接触流形生成本轮求解约束。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**solve_restitution**<br/>遍历接触约束，按恢复系数、速度阈值和配置<br/>迭代次数对求解器刚体施加恢复冲量；溢出约<br/>束串行处理，其余按约束颜色并行处理。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**store_contact_impulses**<br/>保存已求得的接触冲量供下一轮热启动。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**apply_contact_status_changes**<br/>把接触增删同步到约束图和物理岛。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**warm_start**<br/>按 warm_start_coefficient 把上一帧或<br/>子步保存的接触冲量重新应用到求解器刚体，<br/>作为约束求解初始值；溢出约束串行、其他颜<br/>色并行处理。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**solve_contacts#lt;true#gt;**<br/>迭代接触约束并向碰撞刚体施加冲量；泛型<br/>USE_BIAS 决定是否加入重叠修正，用带偏置<br/>求解和无偏置松弛分别处理穿透与速度过冲。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**solve_contacts#lt;false#gt;**<br/>迭代接触约束并向碰撞刚体施加冲量；泛型<br/>USE_BIAS 决定是否加入重叠修正，用带偏置<br/>求解和无偏置松弛分别处理穿透与速度过冲。" }
  class n8 node_system
  n1 e0@--> n0
  class e0 edge_write
  n2 e1@--> n0
  class e1 edge_write
  n3 e2@--> n0
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_write
  n5 e4@--> n0
  class e4 edge_write
  n6 e5@--> n0
  class e5 edge_write
  n7 e6@--> n0
  class e6 edge_write
  n8 e7@--> n0
  class e7 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
