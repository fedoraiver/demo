---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: StepSimulation · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**StepSimulation**<br/>划分物理准备、模拟与回写边界。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**Prepare**<br/>划分物理准备、模拟与回写边界。" }
  class n1 node_system_set
  n2@{ shape: rounded, label: "**run​_​physics​_​schedule**<br/>使用物理时钟推进 PhysicsSchedule 并恢<br/>复原时钟。" }
  class n2 node_system
  n3@{ shape: lin-rect, label: "**Propagate**<br/>来自crate:bevy​_​transform ↗：组织实体<br/>层级变换传播。" }
  class n3 node_system_set
  class n3 external_node
  n4@{ shape: rounded, label: "**log​_​collisions**<br/>来自physics ↗：接触开始和结束属于离散<br/>变化，通过现有文件日志设施记录碰撞双方。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**emit​_​item​_​land**<br/>来自item​_​interaction ↗：检测自由物品<br/>支撑撞击并锁存一次落地音效。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: lin-rect, label: "**Writeback**<br/>划分物理准备、模拟与回写边界。" }
  class n6 node_system_set
  n1 e0@-->|"先于"| n0
  class e0 edge_order
  n0 e1@-->|"集合成员"| n2
  class e1 edge_set_membership
  n0 e2@-->|"先于"| n3
  class e2 edge_order
  n0 e3@-->|"先于"| n4
  class e3 edge_order
  n0 e4@-->|"先于"| n5
  class e4 edge_order
  n0 e5@-->|"先于"| n6
  class e5 edge_order
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
