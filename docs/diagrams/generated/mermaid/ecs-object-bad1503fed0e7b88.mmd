---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 64,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-bad1503fed0e7b88-e0{marker-start:url(#object-bad1503fed0e7b88_flowchart-v2-pointStart)!important}\n#object-bad1503fed0e7b88_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: VolumetricFog · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**VolumetricFog**<br/>为三维相机启用体积雾和光束渲染。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**extract_volumetric_fog**<br/>从主世界提取体积雾、雾体积及体积光配置。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**prepare_volumetric_fog_pipelines**<br/>为体积雾视图准备有密度纹理和无密度纹理两<br/>类管线。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**prepare_volumetric_fog_uniforms**<br/>把各视图和雾体积组合转换为体积雾<br/>Uniform。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**prepare_view_depth_textures_for_**<br/>**volumetric_fog**<br/>允许体积雾着色器读取三维相机深度纹理。" }
  class n4 node_system
  n1 e0@--- n0
  class e0 edge_read
  n1 e1@-->|"延迟移除"| n0
  class e1 edge_write
  n1 e2@-->|"延迟添加"| n0
  class e2 edge_write
  n0 e3@-->|"存在 / 变更过滤"| n2
  class e3 edge_reference
  n0 e4@--> n3
  class e4 edge_read
  n0 e5@--> n4
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
