---
flowchart LR
  accTitle: bevy_render::send_time · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**bevy​_​render::send​_​time**<br/>通过渲染到主应用的时间通道发送当前时刻，<br/>无论本帧是否实际绘制；通道断开时忽略，通<br/>道意外仍满时报告执行顺序错误。" }
  class n0 node_system
  n1@{ shape: fr-rect, label: "**bevy​_​render::RenderPlugin**<br/>建立渲染子应用与 GPU 后端。" }
  class n1 node_plugin
  n2@{ shape: cyl, label: "**TimeSender**<br/>来自crate:bevy​_​time ↗：从渲染世界向主<br/>世界发送帧时刻" }
  class n2 node_resource
  class n2 external_node
  n3@{ shape: rounded, label: "**bevy​_​render::run​_​render​_​schedule**<br/>按 RenderScheduleOrder 中维护的阶段标<br/>签顺序，依次尝试运行渲染子应用的各个调<br/>度。" }
  class n3 node_system
  n1 e0@-->|"调用"| n0
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_read
  n3 e2@-->|"先于"| n0
  class e2 edge_order
  e0@{ curve: basis }
  e2@{ curve: basis }
