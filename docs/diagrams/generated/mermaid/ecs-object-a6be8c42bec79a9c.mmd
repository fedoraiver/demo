---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: character_animation::CourierVisual · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**CourierVisual**<br/>挂在 Character 直属视觉根上的 glTF 引<br/>用；只有标记的快递员接入玩法动画。" }
  class n0 node_component
  n1@{ shape: hex, label: "**mark​_​courier​_​animation​_​ready**<br/>标记主角视觉根以进入动画绑定。" }
  class n1 node_observer
  n2@{ shape: rounded, label: "**initialize​_​ready​_​couriers**<br/>场景就绪后只遍历该视觉根的子树，避免把<br/>NPC 或其他模型的播放器接到主角上。" }
  class n2 node_system
  n3@{ shape: hex, label: "**mark​_​courier​_​animation​_​ready**<br/>标记主角视觉根以进入动画绑定。" }
  class n3 node_observer
  n4@{ shape: rounded, label: "**spawn​_​actors · 创建模板**<br/>来自scene​_​assembly ↗：挂接初始隐藏的<br/>快递员美术与动画来源。" }
  class n4 node_entity
  class n4 external_node
  n5@{ shape: hex, label: "**mark​_​courier​_​animation​_​ready**<br/>标记主角视觉根以进入动画绑定。" }
  class n5 node_observer
  n0 e0@-->|"存在性约束"| n1
  class e0 edge_reference
  n0 e1@--> n2
  class e1 edge_read
  n0 e2@-->|"存在性约束"| n3
  class e2 edge_reference
  n4 e3@-->|"可能包含"| n0
  class e3 edge_reference
  n0 e4@-->|"存在性约束"| n5
  class e4 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
