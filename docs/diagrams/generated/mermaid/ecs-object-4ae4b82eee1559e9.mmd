---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: RecoverableBody · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: notch-rect, label: "**RecoverableBody**<br/>声明落水恢复需要查询的组件与存在条件。" }
  class n0 node_query_data
  n1@{ shape: rounded, label: "**recover_from_water**<br/>将落水实体恢复到各自出生姿态。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**SpawnPoint**<br/>每个业务根独立保存出生姿态。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**SpawnPoint**<br/>每个业务根独立保存出生姿态。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**Position**<br/>来自Avian ↗：保存物理模拟中的真实位<br/>置。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**Position**<br/>来自Avian ↗：保存物理模拟中的真实位<br/>置。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: rounded, label: "**Rotation**<br/>来自Avian ↗：保存物理模拟中的真实旋<br/>转。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**Rotation**<br/>来自Avian ↗：保存物理模拟中的真实旋<br/>转。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存自由运动或共享持<br/>握时的显示姿态。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: rounded, label: "**LinearVelocity**<br/>来自Avian ↗：实际线速度，由冲量、外<br/>力、重力与接触求解改变。" }
  class n10 node_component
  class n10 external_node
  n11@{ shape: rounded, label: "**LinearVelocity**<br/>来自Avian ↗：实际线速度，由冲量、外<br/>力、重力与接触求解改变。" }
  class n11 node_component
  class n11 external_node
  n12@{ shape: rounded, label: "**AngularVelocity**<br/>来自Avian ↗：保存物理模拟中的角速度。" }
  class n12 node_component
  class n12 external_node
  n13@{ shape: rounded, label: "**AngularVelocity**<br/>来自Avian ↗：保存物理模拟中的角速度。" }
  class n13 node_component
  class n13 external_node
  n14@{ shape: rounded, label: "**CharacterIntent**<br/>来自角色运动 ↗：保存持续移动方向与单次<br/>跳跃、交互请求。" }
  class n14 node_component
  class n14 external_node
  n15@{ shape: rounded, label: "**CharacterMotion**<br/>来自角色运动 ↗：保存角色接地等运动观察<br/>结果。" }
  class n15 node_component
  class n15 external_node
  n16@{ shape: rounded, label: "**Character**<br/>来自角色运动 ↗：标识具有角色运动能力的<br/>实体。" }
  class n16 node_component
  class n16 external_node
  n17@{ shape: rounded, label: "**NoTranslationEasing**<br/>来自Avian ↗：暂停独立平移插值。" }
  class n17 node_component
  class n17 external_node
  n18@{ shape: rounded, label: "**NoTranslationEasing**<br/>来自Avian ↗：暂停独立平移插值。" }
  class n18 node_component
  class n18 external_node
  n19@{ shape: rounded, label: "**NoRotationEasing**<br/>来自Avian ↗：暂停独立旋转插值。" }
  class n19 node_component
  class n19 external_node
  n20@{ shape: rounded, label: "**NoRotationEasing**<br/>来自Avian ↗：暂停独立旋转插值。" }
  class n20 node_component
  class n20 external_node
