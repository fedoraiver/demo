---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: format!(#quot;Menu button: {title}#quot;) · 对象关系
  accDescr: 实体创建模板与直接关联的非组件对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**format!(#quot;Menu button: {title}#quot;)**<br/>承载主菜单或暂停页导航动作。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**Menu button icon container**<br/>为菜单按钮图标分配独立空间。" }
  class n1 node_entity
  n2@{ shape: rounded, label: "**Menu heading**<br/>显示菜单按钮的图标与导航文字。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**Main menu buttons**<br/>排列主菜单与暂停页的内容分组。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**Menu label**<br/>显示菜单按钮的图标与导航文字。" }
  class n4 node_entity
  n0 e0@-->|"子实体"| n1
  class e0 edge_relationship
  n0 e1@-->|"子实体"| n2
  class e1 edge_relationship
  n3 e2@-->|"子实体"| n0
  class e2 edge_relationship
  n0 e3@-->|"子实体"| n4
  class e3 edge_relationship
  e0@{ curve: basis }
  e3@{ curve: basis }
