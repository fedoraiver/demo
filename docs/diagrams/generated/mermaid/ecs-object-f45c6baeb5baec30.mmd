---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-f45c6baeb5baec30-e3{marker-start:url(#object-f45c6baeb5baec30_flowchart-v2-pointStart)!important}\n#object-f45c6baeb5baec30-e12{marker-start:url(#object-f45c6baeb5baec30_flowchart-v2-pointStart)!important}\n#object-f45c6baeb5baec30-e14{marker-start:url(#object-f45c6baeb5baec30_flowchart-v2-pointStart)!important}\n#object-f45c6baeb5baec30_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Collider · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Collider**<br/>保存 Parry 碰撞后端的几何形状。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update_collider_mass_**<br/>**properties#lt;avian3d::collision::**<br/>**collider::parry::Collider#gt;**<br/>按变化的形状和密度重算碰撞体质量。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update_collider_scale#lt;avian3d::**<br/>**collision::collider::parry::**<br/>**Collider#gt;**<br/>把根节点和附属碰撞体的缩放传给形状。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**finish_attachments**<br/>来自物品交互 ↗：为持物装配共享碰撞代理<br/>并累计质量。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**update_moved_collider_**<br/>**aabbs#lt;avian3d::collision::collider::**<br/>**parry::Collider#gt;**<br/>重算物理步后被手动改变的碰撞边界。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**solve_continuous**<br/>对单步位移相对厚度过大的动态刚体执行连续<br/>碰撞扫掠；发现碰撞时缩短累计运动，使刚体<br/>停在首次撞击位置，并保留后续接触处理所需<br/>信息。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_solver_body_aabbs#lt;avian3d::**<br/>**collision::collider::parry::**<br/>**Collider#gt;**<br/>按物理结果更新活跃刚体的碰撞边界。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**update_body_size_metrics#lt;avian3d::**<br/>**collision::collider::parry::**<br/>**Collider#gt;**<br/>重算刚体的 CCD 厚度和最大扫掠半径。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**prepare_island**<br/>来自场景装配 ↗：从海岛模型构建静态碰<br/>撞、坡道与人物碰撞。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**spawn_actors**<br/>来自场景装配 ↗：装配玩家、可搬物、控制<br/>者与相机。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**init_collider_constructors**<br/>把就绪的碰撞构造配置变成实际形状。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**init_collider_constructor_**<br/>**hierarchies**<br/>按 ColliderConstructorHierarchy 的默<br/>认及逐名称配置为后代生成碰撞体，写入碰撞<br/>层和密度；需要场景实例时等待就绪，需要网<br/>格时等待资产可用。完成该层级处理后移除构<br/>造配置并发出<br/>ColliderConstructorHierarchyReady。" }
  class n11 node_system
  n0 e0@--> n1
  class e0 edge_read
  n0 e1@-->|"存在 / 变更过滤"| n1
  class e1 edge_reference
  n2 e2@--> n0
  class e2 edge_write
  n2 e3@---|"存在 / 变更过滤"| n0
  class e3 edge_reference
  n3 e4@-->|"延迟添加"| n0
  class e4 edge_write
  n0 e5@--> n4
  class e5 edge_read
  n0 e6@--> n5
  class e6 edge_read
  n0 e7@--> n6
  class e7 edge_read
  n0 e8@--> n7
  class e8 edge_read
  n0 e9@-->|"存在 / 变更过滤"| n7
  class e9 edge_reference
  n8 e10@-->|"延迟添加"| n0
  class e10 edge_write
  n9 e11@-->|"延迟添加"| n0
  class e11 edge_write
  n10 e12@--- n0
  class e12 edge_read
  n10 e13@-->|"延迟添加"| n0
  class e13 edge_write
  n11 e14@--- n0
  class e14 edge_read
  n11 e15@-->|"延迟添加"| n0
  class e15 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: bumpX }
  e12@{ curve: basis }
  e13@{ curve: basis }
  e14@{ curve: basis }
  e15@{ curve: basis }
