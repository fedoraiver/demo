---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-f3535a611321d1f8-e7{marker-start:url(#object-f3535a611321d1f8_flowchart-v2-pointStart)!important}\n#object-f3535a611321d1f8-e10{marker-start:url(#object-f3535a611321d1f8_flowchart-v2-pointStart)!important}\n#object-f3535a611321d1f8-e11{marker-start:url(#object-f3535a611321d1f8_flowchart-v2-pointStart)!important}\n#object-f3535a611321d1f8-e12{marker-start:url(#object-f3535a611321d1f8_flowchart-v2-pointStart)!important}\n#object-f3535a611321d1f8-e13{marker-start:url(#object-f3535a611321d1f8_flowchart-v2-pointStart)!important}\n#object-f3535a611321d1f8-e14{marker-start:url(#object-f3535a611321d1f8_flowchart-v2-pointStart)!important}\n#object-f3535a611321d1f8_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: extract_volumetric_fog · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_param fill:#EFF5F6,stroke:#3B8790,stroke-width:1.6px,color:#1F3340
  classDef node_query_data fill:#F1F4F1,stroke:#567A51,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**extract_volumetric_fog**<br/>从主世界提取体积雾、雾体积及体积光配置。" }
  class n0 node_system
  n1@{ shape: stadium, label: "**RenderApp · ExtractSchedule**<br/>保存本应用调度的注册上下文与成员。" }
  class n1 node_engine_flow
  n2@{ shape: notch-rect, label: "**Commands**<br/>保存延迟执行的 World 操作队列" }
  class n2 node_system_param
  n3@{ shape: notch-rect, label: "**RenderEntity**<br/>记录主实体对应的渲染世界实体。" }
  class n3 node_query_data
  n4@{ shape: rounded, label: "**VolumetricFog**<br/>为三维相机启用体积雾和光束渲染。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**FogVolume**<br/>定义可变换的体积雾区域及介质参数。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**GlobalTransform**<br/>保存实体合并祖先变换后的世界空间仿射变换" }
  class n6 node_component
  n7@{ shape: rounded, label: "**VolumetricLight**<br/>让带阴影的方向光参与体积雾照明。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**ViewVolumetricFogPipelines**<br/>保存有无密度纹理两种体积雾管线。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**ViewVolumetricFog**<br/>定位视图在体积雾 Uniform 缓冲中的参数。" }
  class n9 node_component
  n1 e0@-->|"RenderApp / ExtractSchedule"| n0
  class e0 edge_registration
  n2 e1@-->|"参数 / 查询数据"| n0
  class e1 edge_reference
  n3 e2@-->|"参数 / 查询数据"| n0
  class e2 edge_reference
  n4 e3@--> n0
  class e3 edge_read
  n5 e4@--> n0
  class e4 edge_read
  n6 e5@--> n0
  class e5 edge_read
  n7 e6@--> n0
  class e6 edge_read
  n4 e7@---|"延迟移除"| n0
  class e7 edge_write
  n0 e8@-->|"延迟移除"| n8
  class e8 edge_write
  n0 e9@-->|"延迟移除"| n9
  class e9 edge_write
  n5 e10@---|"延迟移除"| n0
  class e10 edge_write
  n4 e11@---|"延迟添加"| n0
  class e11 edge_write
  n5 e12@---|"延迟添加"| n0
  class e12 edge_write
  n6 e13@---|"延迟添加"| n0
  class e13 edge_write
  n7 e14@---|"延迟添加"| n0
  class e14 edge_write
