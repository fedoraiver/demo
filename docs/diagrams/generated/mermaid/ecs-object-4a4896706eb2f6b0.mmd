---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": ".edgeLabel rect { opacity:1!important; fill:#F6F8FB!important; }"
  }
}
---
flowchart LR
  accTitle: PostProcess · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**PostProcess**<br/>划分二维相机绘制与后处理阶段。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**bloom**<br/>来自crate:bevy​_​post​_​process ↗：通过<br/>降采样和上采样合成 HDR 光晕。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**tonemapping**<br/>为启用的 HDR 视图执行色调映射。" }
  class n2 node_system
  n3@{ shape: lin-rect, label: "**EarlyPostProcess**<br/>划分二维相机绘制与后处理阶段。" }
  class n3 node_system_set
  n4@{ shape: rounded, label: "**upscaling**<br/>将主颜色纹理缩放写入最终输出附件。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**smaa**<br/>来自crate:bevy​_​anti​_​alias ↗：通过三<br/>个阶段完成 SMAA 抗锯齿。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**cas**<br/>来自crate:bevy​_​anti​_​alias ↗：对视图<br/>颜色执行 CAS 锐化后处理。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**ui​_​pass**<br/>来自crate:bevy​_​ui​_​render ↗：把透明<br/>UI 绘制项渲染到关联视图。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**fxaa**<br/>来自crate:bevy​_​anti​_​alias ↗：对启用<br/>的相机视图执行 FXAA 抗锯齿。" }
  class n8 node_system
  class n8 external_node
  n0 e0@-->|"集合成员"| n1
  class e0 edge_set_membership
  n0 e1@-->|"集合成员"| n2
  class e1 edge_set_membership
  n3 e2@-->|"先于"| n0
  class e2 edge_order
  n0 e3@-->|"先于"| n4
  class e3 edge_order
  n0 e4@-->|"集合成员"| n5
  class e4 edge_set_membership
  n0 e5@-->|"集合成员"| n6
  class e5 edge_set_membership
  n0 e6@-->|"先于"| n7
  class e6 edge_order
  n0 e7@-->|"集合成员"| n8
  class e7 edge_set_membership
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
