  class n2 external_node
  n3@{ shape: rounded, label: "**ContextPriority#lt;GameplayContext#gt;**<br/>控制输入上下文的求值优先级。" }
  class n3 node_component
  n4@{ shape: stadium, label: "**InsertEvent**<br/>来自crate:bevy​_​ecs ↗：通知组件值插入<br/>实体。" }
