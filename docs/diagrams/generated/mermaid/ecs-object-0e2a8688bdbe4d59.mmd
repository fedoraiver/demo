---
flowchart LR
  accTitle: events::PointerDragStart · 对象关系
  accDescr: 当前对象及全部直接关联对象。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lean-r, label: "**PointerDragStart**<br/>通知按下后移动开始拖拽目标。" }
  class n0 node_message
  n1@{ shape: rounded, label: "**pointer​_​events**<br/>根据悬停与按钮状态派发指针交互事件。" }
  class n1 node_system
  n1 e0@-->|"可变访问"| n0
  class e0 edge_publish
  n1 e1@-->|"触发事件"| n0
  class e1 edge_emit
  n1 e2@-->|"消息"| n0
  class e2 edge_publish
  e0@{ curve: basis }
  e2@{ curve: basis }
