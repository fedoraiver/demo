  n14@{ shape: rounded, label: "**asset​_​events​_​condition**<br/>判断是否有待发布的资产变化。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**update​_​editable​_​text​_​layout**<br/>来自crate:bevy​_​ui ↗：刷新可编辑文本的<br/>字形布局和编辑反馈。" }
  class n15 node_system
  class n15 external_node
  n16@{ shape: rounded, label: "**update​_​cursors**<br/>来自crate:bevy​_​winit ↗：准备原生或自<br/>定义光标并保留资产重试。" }
  class n16 node_system
  class n16 external_node
  n17@{ shape: rounded, label: "**update​_​text2d​_​layout**<br/>来自crate:bevy​_​sprite ↗：重新排版变化<br/>的二维文字并准备字形。" }
  class n17 node_system
  class n17 external_node
  n18@{ shape: rounded, label: "**asset​_​events**<br/>发布累计的资产变化消息。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**extract​_​render​_​asset**<br/>来自crate:bevy​_​render ↗：按资产变化和<br/>设备恢复请求提取渲染资产。" }
  class n19 node_system
  class n19 external_node
  n20@{ shape: rounded, label: "**generate​_​environment​_​map​_​light**<br/>来自crate:bevy​_​pbr ↗：为环境光生成分<br/>配漫反射和镜面目标图像。" }
  class n20 node_system
