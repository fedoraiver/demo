---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-deb67ddecd8f6b89-e0{marker-start:url(#object-deb67ddecd8f6b89_flowchart-v2-pointStart)!important}\n#object-deb67ddecd8f6b89_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: ReadbackOnce · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**ReadbackOnce**<br/>将 GPU 回读请求限定为一次。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**cleanup_readback_once**<br/>从带 ReadbackOnce 的请求实体移除<br/>Readback 和 ReadbackOnce，结束一次性<br/>GPU 回读请求；实体自身继续保留。" }
  class n1 node_system
  n1 e0@---|"存在 / 变更过滤"| n0
  class e0 edge_reference
  n1 e1@-->|"延迟移除"| n0
  class e1 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
