---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-c0a1da2eb55a017c-e0{marker-start:url(#object-c0a1da2eb55a017c_flowchart-v2-pointStart)!important}\n#object-c0a1da2eb55a017c-e1{marker-start:url(#object-c0a1da2eb55a017c_flowchart-v2-pointStart)!important}\n#object-c0a1da2eb55a017c-e5{marker-start:url(#object-c0a1da2eb55a017c_flowchart-v2-pointStart)!important}\n#object-c0a1da2eb55a017c-e6{marker-start:url(#object-c0a1da2eb55a017c_flowchart-v2-pointStart)!important}\n#object-c0a1da2eb55a017c_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Inherited<ComputedUiRenderTargetInfo> · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Inherited#lt;ComputedUiRenderTargetInfo**<br/>**#gt;**<br/>保存层级传播算法继承到当前节点的中间组件<br/>值" }
  class n0 node_component
  n1@{ shape: rounded, label: "**update_source#lt;bevy_ui::ui_node::**<br/>**ComputedUiRenderTargetInfo, (),**<br/>**bevy_ecs::hierarchy::ChildOf#gt;**<br/>为直接带 Propagate#lt;C#gt; 的实体同步<br/>Inherited#lt;C#gt;；传播源被移除时沿关系查找<br/>可继承值，必要时移除失效的继承状态。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**update_removed_limit#lt;bevy_ui::ui_**<br/>**node::ComputedUiRenderTargetInfo,**<br/>**(), bevy_ecs::hierarchy::ChildOf#gt;**<br/>读取 PropagateOver 或 PropagateStop<br/>的移除记录，将对应实体的 Inherited 标<br/>记为已变化，促使原先受阻或覆盖的继承链重<br/>新传播。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**propagate_inherited#lt;bevy_ui::ui_**<br/>**node::ComputedUiRenderTargetInfo,**<br/>**(), bevy_ecs::hierarchy::ChildOf#gt;**<br/>当 Inherited#lt;C#gt; 改变或关系结构变化时，<br/>沿指定关系向后代传播继承值，并遵守传播覆<br/>盖及停止标记；具体组件、过滤器和关系由泛<br/>型实参决定。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**propagate_output#lt;bevy_ui::ui_node::**<br/>**ComputedUiRenderTargetInfo, ()#gt;**<br/>把变化的 Inherited#lt;C#gt; 写入实体实际的<br/>C 组件；继承状态消失且没有重新添加传播<br/>来源时，移除失去来源的输出组件。" }
  class n4 node_system
  n1 e0@---|"存在 / 变更过滤"| n0
  class e0 edge_reference
  n1 e1@--- n0
  class e1 edge_read
  n1 e2@-->|"延迟添加"| n0
  class e2 edge_write
  n1 e3@-->|"延迟移除"| n0
  class e3 edge_write
  n2 e4@--> n0
  class e4 edge_write
  n3 e5@--- n0
  class e5 edge_read
  n3 e6@---|"存在 / 变更过滤"| n0
  class e6 edge_reference
  n3 e7@-->|"延迟添加"| n0
  class e7 edge_write
  n3 e8@-->|"延迟移除"| n0
  class e8 edge_write
  n0 e9@--> n4
  class e9 edge_read
  n0 e10@-->|"存在 / 变更过滤"| n4
  class e10 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: bumpX }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
