---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-d5dc05949712aa2e-e4{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e6{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e8{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e9{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e11{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e14{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e15{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e17{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e19{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e20{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e21{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e23{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e-e25{marker-start:url(#component-d5dc05949712aa2e_flowchart-v2-pointStart)!important}\n#component-d5dc05949712aa2e_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: Position · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_contract fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n0 node_entity
  class n0 external_node
  end
  style layout_card_n0 fill:none,stroke:none
  subgraph layout_card_n1[" "]
  n1@{ shape: rounded, label: "**可搬物品业务根实体**<br/>来自场景装配 ↗：承载可拾取物品身份及自<br/>由运动、共享持握状态。" }
  class n1 node_entity
  class n1 external_node
  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: rounded, label: "**海岛静态碰撞实体**<br/>来自场景装配 ↗：为海岛结构、入口坡道与<br/>展示人物提供静态碰撞。" }
  class n2 node_entity
  class n2 external_node
  end
  style layout_card_n2 fill:none,stroke:none
  subgraph layout_card_n3[" "]
  n3@{ shape: rounded, label: "**持物无视觉碰撞代理**<br/>来自物品交互 ↗：为持物共享人物刚体提供<br/>无视觉碰撞形状。" }
  class n3 node_entity
  class n3 external_node
  end
  style layout_card_n3 fill:none,stroke:none
  subgraph layout_card_n4[" "]
  n4@{ shape: rounded, label: "**Position**<br/>保存物理模拟中的真实位置。" }
  class n4 node_component
  end
  style layout_card_n4 fill:none,stroke:none
  subgraph layout_card_n5[" "]
  n5@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n5 node_system
  class n5 external_node
  end
  style layout_card_n5 fill:none,stroke:none
  subgraph layout_card_n6[" "]
  n6@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n6 node_system
  class n6 external_node
  end
  style layout_card_n6 fill:none,stroke:none
  subgraph layout_card_n7[" "]
  n7@{ shape: rounded, label: "**update_grounded**<br/>来自角色运动 ↗：探测角色脚下支撑面并更<br/>新接地状态。" }
  class n7 node_system
  class n7 external_node
  end
  style layout_card_n7 fill:none,stroke:none
  subgraph layout_card_n8[" "]
  n8@{ shape: rounded, label: "**release_orphaned_items**<br/>来自物品交互 ↗：清理失效持握并恢复物品<br/>独立运动。" }
  class n8 node_system
  class n8 external_node
  end
  style layout_card_n8 fill:none,stroke:none
  subgraph layout_card_n9[" "]
  n9@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n9 node_system
  class n9 external_node
  end
  style layout_card_n9 fill:none,stroke:none
  subgraph layout_card_n10[" "]
  n10@{ shape: rounded, label: "**warn_hold_strain**<br/>来自物品交互 ↗：检查持续持握偏差并发出<br/>失稳提示音。" }
  class n10 node_system
  class n10 external_node
  end
  style layout_card_n10 fill:none,stroke:none
  subgraph layout_card_n11[" "]
  n11@{ shape: rounded, label: "**align_attachments**<br/>来自物品交互 ↗：沿安全碰撞路径将物品对<br/>齐双手。" }
  class n11 node_system
  class n11 external_node
  end
  style layout_card_n11 fill:none,stroke:none
  subgraph layout_card_n12[" "]
  n12@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：按人物物理姿态同步持物<br/>位置与碰撞代理。" }
  class n12 node_system
  class n12 external_node
  end
  style layout_card_n12 fill:none,stroke:none
  subgraph layout_card_n13[" "]
  n13@{ shape: rounded, label: "**wake_changed_bodies**<br/>来自物理基础 ↗：使休眠身体的外部受力和<br/>位姿修改在本固定步生效。" }
  class n13 node_system
  class n13 external_node
  end
  style layout_card_n13 fill:none,stroke:none
  subgraph layout_card_n14[" "]
  n14@{ shape: rounded, label: "**move_characters**<br/>来自角色运动 ↗：按移动意图和速度为角色<br/>施加水平运动力。" }
  class n14 node_system
  class n14 external_node
  end
  style layout_card_n14 fill:none,stroke:none
  subgraph layout_card_n15[" "]
  n15@{ shape: rounded, label: "**jump_characters**<br/>来自角色运动 ↗：执行角色跳跃并消费单次<br/>请求。" }
  class n15 node_system
  class n15 external_node
  end
  style layout_card_n15 fill:none,stroke:none
  subgraph layout_card_n16[" "]
  n16@{ shape: lin-rect, label: "**PhysicsSystems::Prepare**<br/>准备物理步所需的位姿、质量与碰撞查询数<br/>据。" }
  class n16 node_contract
  end
  style layout_card_n16 fill:none,stroke:none
  subgraph layout_card_n17[" "]
  n17@{ shape: lin-rect, label: "**PhysicsSystems::StepSimulation /**<br/>**PhysicsSchedule**<br/>执行碰撞求解、重力积分与刚体运动。" }
  class n17 node_contract
  end
  style layout_card_n17 fill:none,stroke:none
  subgraph layout_card_n18[" "]
  n18@{ shape: lin-rect, label: "**PhysicsSystems::Writeback**<br/>将求解后的物理位姿写回显示变换。" }
  class n18 node_contract
  end
  style layout_card_n18 fill:none,stroke:none
