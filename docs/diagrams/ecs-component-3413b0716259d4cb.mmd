---
flowchart RL
  accTitle: Character · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**Character**<br/>标识具有角色运动能力的实体。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**WorldInspectorPlugin / world_**<br/>**inspector_ui**<br/>来自Egui / Inspector ↗：展示并编辑开<br/>放反射的实体、资源与资产。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**sync_mouse_capture**<br/>来自第一人称控制 ↗：管理光标捕获及玩法<br/>输入启停。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: hex, label: "**record_movement**<br/>来自第一人称控制 ↗：保存控制角色的持续<br/>移动方向。" }
  class n4 node_observer
  class n4 external_node
  n5@{ shape: hex, label: "**clear_completed_movement**<br/>来自第一人称控制 ↗：清除已结束动作的角<br/>色移动方向。" }
  class n5 node_observer
  class n5 external_node
  n6@{ shape: hex, label: "**clear_cancelled_movement**<br/>来自第一人称控制 ↗：清除已取消动作的角<br/>色移动方向。" }
  class n6 node_observer
  class n6 external_node
  n7@{ shape: hex, label: "**request_jump**<br/>来自第一人称控制 ↗：记录目标角色的单次<br/>跳跃请求。" }
  class n7 node_observer
  class n7 external_node
  n8@{ shape: hex, label: "**request_interaction**<br/>来自第一人称控制 ↗：记录目标角色的单次<br/>交互请求。" }
  class n8 node_observer
  class n8 external_node
  n9@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**move_characters**<br/>按移动意图和速度为角色施加水平运动力。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**jump_characters**<br/>执行角色跳跃并消费单次请求。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n12 node_system
  class n12 external_node
  n13@{ shape: rounded, label: "**sync_held_presentation**<br/>来自物品交互 ↗：按人物呈现姿态同步持物<br/>模型与握持目标。" }
  class n13 node_system
  class n13 external_node
  n14@{ shape: rounded, label: "**follow_first_person_camera**<br/>来自第一人称控制 ↗：按人物本帧位置与观<br/>察角度更新第一人称镜头。" }
  class n14 node_system
  class n14 external_node
  n15@{ shape: rounded, label: "**sync_character_visibility**<br/>来自第一人称控制 ↗：隐藏第一人称控制角<br/>色的自身模型。" }
  class n15 node_system
  class n15 external_node
  n16@{ shape: rounded, label: "**update_grounded**<br/>探测角色脚下支撑面并更新接地状态。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**release_orphaned_items**<br/>来自物品交互 ↗：清理失效持握并恢复物品<br/>独立运动。" }
  class n17 node_system
  class n17 external_node
  n18@{ shape: rounded, label: "**log_character_velocity**<br/>定期记录角色实际速度与接地状态。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**spawn_actors**<br/>来自场景装配 ↗：装配玩家、可搬物、控制<br/>者与相机。" }
  class n19 node_system
  class n19 external_node
  n20@{ shape: rounded, label: "**initialize_ready_couriers**<br/>来自角色动画 ↗：绑定主角命名动画并缓存<br/>鞋底补偿节点。" }
  class n20 node_system
  class n20 external_node
  n21@{ shape: rounded, label: "**sync_courier_animation**<br/>来自角色动画 ↗：按角色运动状态连续混合<br/>移动与跳跃动画。" }
  class n21 node_system
  class n21 external_node
  n22@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n22 node_system
  class n22 external_node
  n23@{ shape: rounded, label: "**warn_hold_strain**<br/>来自物品交互 ↗：检查持续持握偏差并发出<br/>失稳提示音。" }
  class n23 node_system
  class n23 external_node
  n24@{ shape: rounded, label: "**restore_empty_holder_mass**<br/>来自物品交互 ↗：归还不再持物角色的原有<br/>质量。" }
  class n24 node_system
  class n24 external_node
  n25@{ shape: rounded, label: "**finish_attachments**<br/>来自物品交互 ↗：为持物装配共享碰撞代理<br/>并累计质量。" }
  class n25 node_system
  class n25 external_node
  n26@{ shape: rounded, label: "**align_attachments**<br/>来自物品交互 ↗：沿安全碰撞路径将物品对<br/>齐双手。" }
  class n26 node_system
  class n26 external_node
  n27@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：按人物物理姿态同步持物<br/>位置与碰撞代理。" }
  class n27 node_system
  class n27 external_node
