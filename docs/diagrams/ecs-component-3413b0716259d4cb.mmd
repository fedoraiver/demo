---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-3413b0716259d4cb-e1{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e2{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e3{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e4{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e5{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e6{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e7{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e8{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e9{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e10{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e11{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e12{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e13{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e14{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e15{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e16{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e17{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e19{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e20{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e21{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e22{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e23{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e24{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e25{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb-e26{marker-start:url(#component-3413b0716259d4cb_flowchart-v2-pointStart)!important}\n#component-3413b0716259d4cb_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
