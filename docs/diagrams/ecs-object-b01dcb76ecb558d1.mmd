---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-b01dcb76ecb558d1-e3{marker-start:url(#object-b01dcb76ecb558d1_flowchart-v2-pointStart)!important}\n#object-b01dcb76ecb558d1_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: sync_voice_volumes · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**sync_voice_volumes**<br/>为新就绪的播放实例补同步有效音量。" }
  class n0 node_system
  n1@{ shape: lin-rect, label: "**AudioSystemSet::PlayTypedChannels**<br/>来自Kira ↗：将排队声音句柄转为已就绪播<br/>放实例。" }
  class n1 node_system_set
  class n1 external_node
  n2@{ shape: cyl, label: "**AudioMix**<br/>保存界面与音效通道当前采用的有效音量。" }
  class n2 node_resource
  n3@{ shape: cyl, label: "**SoundBank**<br/>保存短音资源、播放策略与实例生命周期。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**Assets#lt;AudioInstance#gt;**<br/>来自Kira ↗：保存正在播放或刚就绪的声音<br/>实例。" }
  class n4 node_resource
  class n4 external_node
  n5@{ shape: fr-rect, label: "**GameAudioPlugin**<br/>管理短音预加载、混音、播放与设备输出。" }
  class n5 node_plugin
  n1 e0@--> n0
  class e0 edge_order
  n2 e1@-->|"访问声明"| n0
  class e1 edge_read
  n3 e2@-->|"访问声明"| n0
  class e2 edge_read
  n3 e3@---|"访问声明"| n0
  class e3 edge_write
  n0 e4@-->|"访问声明"| n4
  class e4 edge_write
  n5 e5@--> n0
  class e5 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e5@{ curve: basis }
