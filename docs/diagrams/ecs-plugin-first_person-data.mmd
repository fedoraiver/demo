---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 第一人称控制 · 数据与实体
  accDescr: 第一人称控制的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_note fill:#F7F7F5,stroke:#9A9B88,stroke-width:1.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n3@{ shape: rounded, label: "**键盘控制者**<br/>保存玩家身份、输入上下文与受控角色及相<br/>机。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**第一人称相机实体**<br/>提供跟随角色的第一人称视角与观察输入状<br/>态。" }
  class n4 node_entity
  n6@{ shape: rounded, label: "**动作实体**<br/>保存玩法或调试动作的评估结果与触发状态。" }
  class n6 node_entity
  n7@{ shape: rounded, label: "**绑定实体**<br/>将键盘或鼠标输入映射到玩法动作。" }
  class n7 node_entity
  n8@{ shape: hex, label: "**on_camera_look**<br/>将观察输入转为第一人称水平角与俯仰角。" }
  class n8 node_observer
  n9@{ shape: rounded, label: "**sync_character_facing**<br/>同步人物朝向并处理持物转向受阻。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n10 node_entity
  class n10 external_node
  n8 e0@-->|"观察角度"| n4
  class e0 edge_write
  n4 e1@-->|"角度"| n9
  class e1 edge_read
  n3 e2@-->|"ControlsCharacter"| n10
  class e2 edge_reference
  n3 e3@-->|"ControlsCamera"| n4
  class e3 edge_reference
  n4 e4@-->|"FirstPersonCamera.target"| n10
  class e4 edge_reference
  n6 e5@-->|"ActionOf#lt;GameplayContext#gt;"| n3
  class e5 edge_relationship
  n7 e6@-->|"BindingOf"| n6
  class e6 edge_relationship
  end
  style relation_0 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: notch-rect, label: "**Local#lt;f64#gt;（next_log_at）**<br/>保存连续观察角度日志的下次采样时间。" }
  class n0 node_local
  n1@{ shape: doc, label: "**第一人称模型生命周期**<br/>保持受控角色自身模型隐藏并恢复失效关联。" }
  class n1 node_note
  n2@{ shape: doc, label: "**捕获与输入上下文**<br/>保存光标捕获与玩法输入启用状态。" }
  class n2 node_note
  n5@{ shape: rounded, label: "**业务直属 GLB 视觉根实体**<br/>承载业务实体的模型、骨骼与动画子树。" }
  class n5 node_entity
  n0 layout_0@~~~ n1
  n1 layout_1@~~~ n2
  n2 layout_2@~~~ n5
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
