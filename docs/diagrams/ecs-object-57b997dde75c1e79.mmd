---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: GameAudioPlugin · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_app fill:#EFF4F5,stroke:#3A7B87,stroke-width:2.2px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: fr-rect, label: "**GameAudioPlugin**<br/>管理短音预加载、混音、播放与设备输出。" }
  class n0 node_plugin
  n1@{ shape: fr-rect, label: "**KiraAudioPlugin**<br/>来自Kira ↗：提供短音资产加载、通道播放<br/>与混音基础设施。" }
  class n1 node_plugin
  class n1 external_node
  n2@{ shape: fr-rect, label: "**main / App**<br/>来自Bevy 引擎 ↗：装配应用、设置与插件<br/>并管理主循环和退出。" }
  class n2 node_app
  class n2 external_node
  n3@{ shape: rounded, label: "**preload_sounds**<br/>预加载界面与音效短音并保存播放策略。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**log_load_failures**<br/>记录声音资源加载失败的路径与错误。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**play_requests**<br/>按有效音量与播放策略处理短音请求。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**stop_on_exit**<br/>停止音频通道并记录退出。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**sync_audio_mix**<br/>合成设置预览或正式配置的有效音量。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**sync_voice_volumes**<br/>将有效混音与素材音量同步到播放实例。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**sync_voice_volumes**<br/>为新就绪的播放实例补同步有效音量。" }
  class n9 node_system
  n0 e0@-->|"Kira"| n1
  class e0 edge_registration
  n2 e1@--> n0
  class e1 edge_registration
  n0 e2@--> n3
  class e2 edge_registration
  n0 e3@--> n4
  class e3 edge_registration
  n0 e4@--> n5
  class e4 edge_registration
  n0 e5@--> n6
  class e5 edge_registration
  n0 e6@--> n7
  class e6 edge_registration
  n0 e7@--> n8
  class e7 edge_registration
  n0 e8@--> n9
  class e8 edge_registration
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
