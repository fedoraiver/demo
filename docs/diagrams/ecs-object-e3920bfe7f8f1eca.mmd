  class e6 edge_write
  n0 e7@-->|"可变访问"| n8
  class e7 edge_write
  n0 e8@-->|"可变访问"| n9
  class e8 edge_write
  n0 e9@-->|"可变访问"| n10
  class e9 edge_write
  n11 e10@-->|"访问声明"| n0
  class e10 edge_read
