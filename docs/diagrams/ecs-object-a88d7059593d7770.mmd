---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: suspend_controls · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**suspend_controls**<br/>停用玩法输入并释放光标。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**MouseLookState**<br/>保存光标捕获与观察输入初始化状态。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**CursorOptions**<br/>来自Bevy 引擎 ↗：配置光标可见性与抓取<br/>模式。" }
  class n2 node_component
  class n2 external_node
  n3@{ shape: rounded, label: "**ContextActivity#lt;GameplayContext#gt;**<br/>来自Enhanced Input ↗：保存动作上下文<br/>的启用状态。" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: fr-rect, label: "**FirstPersonPlugin**<br/>管理玩法动作、光标捕获、朝向与第一人称镜<br/>头。" }
  class n4 node_plugin
  n0 e0@-->|"可变访问"| n1
  class e0 edge_write
  n0 e1@-->|"可变访问"| n2
  class e1 edge_write
  n0 e2@-->|"添加"| n3
  class e2 edge_write
  n4 e3@--> n0
  class e3 edge_registration
  e0@{ curve: basis }
  e2@{ curve: basis }
