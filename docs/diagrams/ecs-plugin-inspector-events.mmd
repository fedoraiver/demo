---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: 世界检查器 · 事件与协作
  accDescr: 世界检查器的事件与协作；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  n0@{ shape: fr-rect, label: "**InspectorPlugin**<br/>安装可读写世界数据的检查器界面。" }
  class n0 node_plugin
  n1@{ shape: fr-rect, label: "**EguiPlugin**<br/>来自Egui / Inspector ↗：准备 Egui 上<br/>下文和界面绘制。" }
  class n1 node_plugin
  class n1 external_node
  n2@{ shape: fr-rect, label: "**WorldInspectorPlugin**<br/>来自Egui / Inspector ↗：展示并编辑开<br/>放反射的世界数据。" }
  class n2 node_plugin
  class n2 external_node
  n0 e0@-->|"Egui"| n1
  class e0 edge_registration
  n0 e1@-->|"Inspector"| n2
  class e1 edge_registration
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
