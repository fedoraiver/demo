---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: CharacterAnimationPlugin · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_app fill:#EFF4F5,stroke:#3A7B87,stroke-width:2.2px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: fr-rect, label: "**CharacterAnimationPlugin**<br/>绑定并混合角色动画，补偿视觉接地。" }
  class n0 node_plugin
  n1@{ shape: fr-rect, label: "**main / App**<br/>来自Bevy 引擎 ↗：装配应用、设置与插件<br/>并管理主循环和退出。" }
  class n1 node_app
  class n1 external_node
  n2@{ shape: hex, label: "**mark_courier_animation_ready**<br/>标记主角视觉根以进入动画绑定。" }
  class n2 node_observer
  n3@{ shape: rounded, label: "**initialize_ready_couriers**<br/>绑定主角命名动画并缓存鞋底补偿节点。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**sync_courier_animation**<br/>按角色运动状态连续混合移动与跳跃动画。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**compensate_courier_sole_penetration**<br/>补偿鞋底穿地并平滑恢复视觉高度。" }
  class n5 node_system
  n1 e0@--> n0
  class e0 edge_registration
  n0 e1@--> n2
  class e1 edge_registration
  n0 e2@--> n3
  class e2 edge_registration
  n0 e3@--> n4
  class e3 edge_registration
  n0 e4@--> n5
  class e4 edge_registration
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
