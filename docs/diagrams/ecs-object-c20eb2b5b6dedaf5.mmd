---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: InspectorPlugin · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_app fill:#EFF4F5,stroke:#3A7B87,stroke-width:2.2px,color:#1F3340
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: fr-rect, label: "**InspectorPlugin**<br/>安装可读写世界数据的检查器界面。" }
  class n0 node_plugin
  n1@{ shape: fr-rect, label: "**EguiPlugin**<br/>来自Egui / Inspector ↗：准备 Egui 上<br/>下文和界面绘制。" }
  class n1 node_plugin
  class n1 external_node
  n2@{ shape: fr-rect, label: "**WorldInspectorPlugin**<br/>来自Egui / Inspector ↗：展示并编辑开<br/>放反射的世界数据。" }
  class n2 node_plugin
  class n2 external_node
  n3@{ shape: fr-rect, label: "**main / App**<br/>来自Bevy 引擎 ↗：装配应用、设置与插件<br/>并管理主循环和退出。" }
  class n3 node_app
  class n3 external_node
  n4@{ shape: rounded, label: "**log_world_inspector**<br/>记录世界检查器已启用的初始化日志。" }
  class n4 node_system
  n0 e0@-->|"Egui"| n1
  class e0 edge_registration
  n0 e1@-->|"Inspector"| n2
  class e1 edge_registration
  n3 e2@--> n0
  class e2 edge_registration
  n0 e3@--> n4
  class e3 edge_registration
  e0@{ curve: basis }
  e3@{ curve: basis }
