---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: Kira · 数据与实体
  accDescr: Kira的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef external_node stroke-dasharray:6 4
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: cyl, label: "**Assets#lt;AudioSource#gt;**<br/>保存已加载的短音资产。" }
  class n0 node_resource
  n1@{ shape: cyl, label: "**Messages#lt;AssetLoadFailedEvent#lt;AudioS**<br/>**ource#gt;#gt;**<br/>缓冲声音资源加载失败的路径与错误。" }
  class n1 node_message_buffer
  n2@{ shape: cyl, label: "**Assets#lt;AudioInstance#gt;**<br/>保存正在播放或刚就绪的声音实例。" }
  class n2 node_resource
  n0 layout_0@~~~ n1
  n1 layout_1@~~~ n2
  end
  style column_0 fill:none,stroke:none
  end
