---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Bevy 引擎 · 事件与协作
  accDescr: Bevy 引擎的事件与协作；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_external_io fill:#F1F3F4,stroke:#526A78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  n0@{ shape: cyl, label: "**Messages#lt;KeyboardInput#gt;**<br/>缓冲底层键盘输入消息。" }
  class n0 node_message_buffer
  n1@{ shape: cyl, label: "**Messages#lt;KeyboardFocusLost#gt;**<br/>通知输入系统清理失焦后残留的按键。" }
  class n1 node_message_buffer
  n2@{ shape: cyl, label: "**Messages#lt;MouseButtonInput#gt;**<br/>缓冲底层鼠标按钮输入消息。" }
  class n2 node_message_buffer
  n3@{ shape: cyl, label: "**Messages#lt;WindowFocused#gt;**<br/>缓冲窗口焦点变化消息。" }
  class n3 node_message_buffer
  n4@{ shape: cyl, label: "**Messages#lt;MouseMotion#gt;**<br/>缓冲底层鼠标位移消息。" }
  class n4 node_message_buffer
  n5@{ shape: cyl, label: "**Messages#lt;UntypedAssetLoadFailedEvent**<br/>**#gt;**<br/>缓冲菜单模型与界面资源的加载失败。" }
  class n5 node_message_buffer
  n6@{ shape: cyl, label: "**Messages#lt;AppExit#gt;**<br/>通知音频停止并进入应用退出流程。" }
  class n6 node_message_buffer
  n7@{ shape: fr-rect, label: "**DefaultPlugins**<br/>提供窗口、时间、资产、动画与渲染基础设<br/>施。" }
  class n7 node_plugin
  n8@{ shape: fr-rect, label: "**LogPlugin**<br/>安装统一日志订阅与输出基础设施。" }
  class n8 node_plugin
  n9@{ shape: lean-r, label: "**WindowFocused / MouseButtonInput**<br/>缓冲窗口焦点与鼠标按钮变化。" }
  class n9 node_message
  n10@{ shape: stadium, label: "**WorldInstanceReady**<br/>通知对应场景资产已完成实体层级实例化。" }
  class n10 node_event
  n11@{ shape: stadium, label: "**Pointer#lt;Scroll#gt;**<br/>通知设置内容视口处理滚轮输入。" }
  class n11 node_event
  n12@{ shape: stadium, label: "**WorldInstanceReady**<br/>通知展示快递员进入命名动画绑定准备。" }
  class n12 node_event
  n13@{ shape: stadium, label: "**Pointer#lt;Scroll#gt;**<br/>通知内容视口处理滚动条上的滚轮输入。" }
  class n13 node_event
  n14@{ shape: stadium, label: "**Pointer#lt;Press#gt;**<br/>通知滚动条接管鼠标输入来源。" }
  class n14 node_event
  n15@{ shape: hex, label: "**ScrollbarPlugin · pointer observers**<br/>处理滚动条的轨道分页与滑块拖动。" }
  class n15 node_observer
  n16@{ shape: stadium, label: "**Despawn#lt;Character#gt;**<br/>通知人物销毁前执行持物生命周期清理。" }
  class n16 node_event
  n17@{ shape: rounded, label: "**WorldInstanceSpawner /**<br/>**WorldInstanceSpawn**<br/>展开场景资产层级并通知实例就绪。" }
  class n17 node_system
  n18@{ shape: rect, label: "**Window**<br/>保存主窗口的尺寸与显示配置。" }
  class n18 node_component
  n19@{ shape: fr-rect, label: "**main / App**<br/>装配应用、设置与插件并管理主循环和退出。" }
  class n19 node_plugin
  n20@{ shape: rounded, label: "**sync_mouse_capture**<br/>来自第一人称控制 ↗：管理光标捕获及玩法<br/>输入启停。" }
  class n20 node_system
  class n20 external_node
  n21@{ shape: rounded, label: "**sync_settings_scrollbars**<br/>来自菜单与界面 ↗：同步滚动条显隐、拾取<br/>范围与高亮。" }
  class n21 node_system
  class n21 external_node
  n22@{ shape: lean-l, label: "**原生窗口约束**<br/>来自窗口策略 ↗：在平台应用尺寸前约束主<br/>窗口比例与范围。" }
  class n22 node_external_io
  class n22 external_node
  n23@{ shape: hex, label: "**mark_island_ready**<br/>来自场景装配 ↗：标记地图实例以进入碰撞<br/>准备。" }
  class n23 node_observer
  class n23 external_node
  n24@{ shape: hex, label: "**mark_courier_animation_ready**<br/>来自角色动画 ↗：标记主角视觉根以进入动<br/>画绑定。" }
  class n24 node_observer
  class n24 external_node
  n25@{ shape: hex, label: "**scroll_menu**<br/>来自菜单与界面 ↗：滚动设置内容并限制在<br/>有效范围内。" }
  class n25 node_observer
  class n25 external_node
  n26@{ shape: hex, label: "**mark_courier_animation_ready**<br/>来自菜单与界面 ↗：标记展示快递员以等待<br/>动画绑定。" }
  class n26 node_observer
  class n26 external_node
  n27@{ shape: hex, label: "**scroll_over_settings_scrollbar**<br/>来自菜单与界面 ↗：通过滚动条上的滚轮操<br/>作滚动内容视口。" }
  class n27 node_observer
  class n27 external_node
  n28@{ shape: hex, label: "**scrollbar_pointer_source**<br/>来自菜单与界面 ↗：将滚动条按下操作标为<br/>鼠标输入。" }
  class n28 node_observer
  class n28 external_node
  n29@{ shape: hex, label: "**prepare_holder_despawn**<br/>来自物品交互 ↗：在持有者销毁前停用并卸<br/>载持物代理。" }
  class n29 node_observer
  class n29 external_node
  n30@{ shape: fr-rect, label: "**SessionLogPlugin**<br/>来自会话日志 ↗：安装统一会话日志并管理<br/>后台输出与退出刷新。" }
  class n30 node_plugin
  class n30 external_node
  n31@{ shape: lean-l, label: "**File worker**<br/>来自会话日志 ↗：在独立线程写入、刷新并<br/>反馈文件输出错误。" }
  class n31 node_external_io
  class n31 external_node
  n9 e0@--> n20
  class e0 edge_consume
  n17 e1@--> n10
  class e1 edge_emit
  n15 e2@-->|"控件数据"| n21
  class e2 edge_reference
  n22 e3@-->|"应用尺寸"| n18
  class e3 edge_write
  n10 e4@-->|"WorldInstanceReady"| n23
  class e4 edge_observe
  n10 e5@-->|"WorldInstanceReady"| n24
  class e5 edge_observe
  n11 e6@-->|"Pointer#lt;Scroll#gt;"| n25
  class e6 edge_observe
  n12 e7@-->|"WorldInstanceReady"| n26
  class e7 edge_observe
  n13 e8@-->|"Pointer#lt;Scroll#gt;"| n27
  class e8 edge_observe
  n14 e9@-->|"Pointer#lt;Press#gt;"| n28
  class e9 edge_observe
  n16 e10@-->|"Despawn#lt;Character#gt;"| n29
  class e10 edge_observe
  n30 e11@-->|"LogPlugin"| n8
  class e11 edge_registration
  n19 e12@-->|"record_exit / 退出刷新"| n31
  class e12 edge_write
  end
  e4@{ curve: basis }
  e5@{ curve: basis }
