---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: spawn_backdrop · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**spawn_backdrop**<br/>装配主菜单海岛展示舞台、相机与日光。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**MenuBackdrop**<br/>舞台根标记。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**DespawnOnExit**<br/>来自Bevy 引擎 ↗：标记退出所属应用状态<br/>时销毁此实体。" }
  class n2 node_component
  class n2 external_node
  n3@{ shape: rounded, label: "**Visibility**<br/>来自Bevy 引擎 ↗：通过父子树传播展示可<br/>见性。" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: rounded, label: "**Children**<br/>来自Bevy 引擎 ↗：索引当前实体的直接子<br/>实体。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**WorldAssetRoot**<br/>来自Bevy 引擎 ↗：指定需要展开的场景资<br/>产实例。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: rounded, label: "**CourierAnimation**<br/>保存展示快递员的模型来源以绑定命名动画。" }
  class n6 node_component
  n7@{ shape: rounded, label: "**Camera3d**<br/>来自Bevy 引擎 ↗：标记三维场景相机。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**IsDefaultUiCamera**<br/>来自Bevy 引擎 ↗：指定菜单界面的默认绘<br/>制相机。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**PrimaryEguiContext**<br/>来自Egui / Inspector ↗：指定主检查器<br/>界面的相机上下文。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：提供展示舞台父子变换<br/>的根姿态。" }
  class n10 node_component
  class n10 external_node
  n11@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存菜单界面与展示模<br/>型的相机构图。" }
  class n11 node_component
  class n11 external_node
  n12@{ shape: rounded, label: "**ChildOf**<br/>来自Bevy 引擎 ↗：舞台根的直接子实体，<br/>根销毁时连带清理。" }
  class n12 node_component
  class n12 external_node
  n13@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存模型及展示包裹的<br/>局部姿态。" }
  class n13 node_component
  class n13 external_node
  n14@{ shape: cyl, label: "**AssetServer**<br/>来自Bevy 引擎 ↗：加载并查询递归依赖。" }
  class n14 node_resource
  class n14 external_node
  n15@{ shape: cyl, label: "**State#lt;AppState#gt; /**<br/>**NextState#lt;AppState#gt;**<br/>来自应用流程 ↗：保存应用主状态及待处理<br/>的会话切换。" }
  class n15 node_resource
  class n15 external_node
  n16@{ shape: fr-rect, label: "**GameUiPlugin**<br/>管理菜单、设置编辑、导航与主菜单展示场<br/>景。" }
  class n16 node_plugin
