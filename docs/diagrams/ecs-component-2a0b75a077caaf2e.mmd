---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-2a0b75a077caaf2e-e1{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e3{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e5{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e7{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e8{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e9{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e11{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e13{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e14{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e15{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e16{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e-e18{marker-start:url(#component-2a0b75a077caaf2e_flowchart-v2-pointStart)!important}\n#component-2a0b75a077caaf2e_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: HeldBy · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**可搬物品业务根实体**<br/>来自场景装配 ↗：承载可拾取物品身份及自<br/>由运动、共享持握状态。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**HeldBy**<br/>关联当前物品的持有者。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**handle_interaction**<br/>处理物品拾取、共享持握与主动释放。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**sync_held_presentation**<br/>按人物呈现姿态同步持物模型与握持目标。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update_grounded**<br/>来自角色运动 ↗：探测角色脚下支撑面并更<br/>新接地状态。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**release_orphaned_items**<br/>清理失效持握并恢复物品独立运动。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**warn_hold_strain**<br/>检查持续持握偏差并发出失稳提示音。" }
  class n8 node_system
  n9@{ shape: rounded, label: "**emit_parcel_land**<br/>识别自由物品落地并发出声音请求。" }
  class n9 node_system
  n10@{ shape: rounded, label: "**finish_attachments**<br/>为持物装配共享碰撞代理并累计质量。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**align_attachments**<br/>沿安全碰撞路径将物品对齐双手。" }
  class n11 node_system
  n12@{ shape: rounded, label: "**sync_held_physics**<br/>按人物物理姿态同步持物位置与碰撞代理。" }
  class n12 node_system
