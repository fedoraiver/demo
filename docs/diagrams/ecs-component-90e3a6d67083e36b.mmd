---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-90e3a6d67083e36b-e1{marker-start:url(#component-90e3a6d67083e36b_flowchart-v2-pointStart)!important}\n#component-90e3a6d67083e36b-e3{marker-start:url(#component-90e3a6d67083e36b_flowchart-v2-pointStart)!important}\n#component-90e3a6d67083e36b-e5{marker-start:url(#component-90e3a6d67083e36b_flowchart-v2-pointStart)!important}\n#component-90e3a6d67083e36b-e7{marker-start:url(#component-90e3a6d67083e36b_flowchart-v2-pointStart)!important}\n#component-90e3a6d67083e36b-e8{marker-start:url(#component-90e3a6d67083e36b_flowchart-v2-pointStart)!important}\n#component-90e3a6d67083e36b-e10{marker-start:url(#component-90e3a6d67083e36b_flowchart-v2-pointStart)!important}\n#component-90e3a6d67083e36b-e11{marker-start:url(#component-90e3a6d67083e36b_flowchart-v2-pointStart)!important}\n#component-90e3a6d67083e36b_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: CharacterMotion · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**CharacterMotion**<br/>保存角色接地等运动观察结果。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**world_inspector_ui**<br/>来自Egui / Inspector ↗：展示并编辑开<br/>放反射的实体、资源与资产。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**move_characters**<br/>按移动意图和速度为角色施加水平运动力。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**jump_characters**<br/>执行角色跳跃并消费单次请求。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**update_grounded**<br/>探测角色脚下支撑面并更新接地状态。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**log_character_velocity**<br/>定期记录角色实际速度与接地状态。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**spawn_actors**<br/>来自场景装配 ↗：装配玩家、可搬物、控制<br/>者与相机。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**initialize_ready_couriers**<br/>来自角色动画 ↗：绑定主角命名动画并缓存<br/>鞋底补偿节点。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**sync_courier_animation**<br/>来自角色动画 ↗：按角色运动状态连续混合<br/>移动与跳跃动画。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n10 node_system
  class n10 external_node
