  n47@{ shape: hex, label: "**back**<br/>发出返回、暂停或恢复请求。" }
  class n47 node_observer
  n49@{ shape: hex, label: "**scrollbar_pointer_source**<br/>将滚动条按下操作标为鼠标输入。" }
