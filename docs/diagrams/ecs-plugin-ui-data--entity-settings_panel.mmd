  n4@{ shape: cyl, label: "**Messages#lt;UiRequest#gt;**<br/>缓冲鼠标与动作输入共用的菜单请求。" }
  class n4 node_message_buffer
  n42@{ shape: hex, label: "**previous**<br/>循环选择上一个可操作菜单按钮。" }
  class n42 node_observer
  n43@{ shape: hex, label: "**next**<br/>循环选择下一个可操作菜单按钮。" }
  class n43 node_observer
  n44@{ shape: hex, label: "**left**<br/>向左调整当前聚焦的真实设置字段。" }
  class n44 node_observer
  n45@{ shape: hex, label: "**right**<br/>向右调整当前聚焦的真实设置字段。" }
  class n45 node_observer
  n46@{ shape: hex, label: "**confirm**<br/>执行当前聚焦按钮的菜单动作。" }
