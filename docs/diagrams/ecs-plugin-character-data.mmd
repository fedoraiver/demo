---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 角色运动 · 数据与实体
  accDescr: 角色运动的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n1@{ shape: rounded, label: "**角色业务根实体**<br/>承载角色身份、运动意图与动态物理身体。" }
  class n1 node_entity
  n2@{ shape: hex, label: "**record_movement**<br/>来自第一人称控制 ↗：保存控制角色的持续<br/>移动方向。" }
  class n2 node_observer
  class n2 external_node
  n3@{ shape: rounded, label: "**move_characters**<br/>按移动意图和速度为角色施加水平运动力。" }
  class n3 node_system
  n4@{ shape: hex, label: "**clear_completed_movement**<br/>来自第一人称控制 ↗：清除已结束动作的角<br/>色移动方向。" }
  class n4 node_observer
  class n4 external_node
  n5@{ shape: hex, label: "**clear_cancelled_movement**<br/>来自第一人称控制 ↗：清除已取消动作的角<br/>色移动方向。" }
  class n5 node_observer
  class n5 external_node
  n6@{ shape: hex, label: "**request_jump**<br/>来自第一人称控制 ↗：记录目标角色的单次<br/>跳跃请求。" }
  class n6 node_observer
  class n6 external_node
  n7@{ shape: hex, label: "**request_interaction**<br/>来自第一人称控制 ↗：记录目标角色的单次<br/>交互请求。" }
  class n7 node_observer
  class n7 external_node
  n8@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n8 node_system
  class n8 external_node
  n2 layout_0@~~~ n4
  n4 layout_1@~~~ n5
  n5 layout_2@~~~ n6
  n6 layout_3@~~~ n7
  n2 e0@-->|"意图"| n1
  class e0 edge_write
  n1 e1@-->|"意图"| n3
  class e1 edge_read
  n4 e2@--> n1
  class e2 edge_write
  n5 e3@--> n1
  class e3 edge_write
  n6 e4@--> n1
  class e4 edge_write
  n7 e5@--> n1
  class e5 edge_write
  n1 e6@-->|"交互请求"| n8
  class e6 edge_read
  end
  style relation_0 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: notch-rect, label: "**Local#lt;f64#gt;（next_log_time）**<br/>保存角色速度日志的下次采样时间。" }
  class n0 node_local
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
