---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-71abcd0957441075-e2{marker-start:url(#component-71abcd0957441075_flowchart-v2-pointStart)!important}\n#component-71abcd0957441075-e4{marker-start:url(#component-71abcd0957441075_flowchart-v2-pointStart)!important}\n#component-71abcd0957441075_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: NoTranslationEasing · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n0 node_entity
  class n0 external_node
  end
  style layout_card_n0 fill:none,stroke:none
  subgraph layout_card_n1[" "]
  n1@{ shape: rounded, label: "**可搬物品业务根实体**<br/>来自场景装配 ↗：承载可拾取物品身份及自<br/>由运动、共享持握状态。" }
  class n1 node_entity
  class n1 external_node
  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: rounded, label: "**NoTranslationEasing**<br/>暂停独立平移插值。" }
  class n2 node_component
  end
  style layout_card_n2 fill:none,stroke:none
  subgraph layout_card_n3[" "]
  n3@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n3 node_system
  class n3 external_node
  end
  style layout_card_n3 fill:none,stroke:none
  subgraph layout_card_n4[" "]
  n4@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n4 node_system
  class n4 external_node
  end
  style layout_card_n4 fill:none,stroke:none
  subgraph layout_card_n5[" "]
  n5@{ shape: rounded, label: "**resume_interpolation**<br/>来自越界恢复 ↗：撤销落水恢复添加的临时<br/>插值暂停。" }
  class n5 node_system
  class n5 external_node
  end
  style layout_card_n5 fill:none,stroke:none
  subgraph layout_card_n6[" "]
  n6@{ shape: rounded, label: "**resume_carry_easing**<br/>来自物品交互 ↗：恢复物品释放前未暂停的<br/>插值通道。" }
  class n6 node_system
  class n6 external_node
  end
  style layout_card_n6 fill:none,stroke:none
  n2 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n2
  n4 layout_3@~~~ n2
  n5 layout_4@~~~ n2
  n6 layout_5@~~~ n2
  n3 e3@-->|"添加"| n2
  class e3 edge_write
  n4 e5@-->|"添加"| n2
  class e5 edge_write
  n5 e6@-->|"移除"| n2
  class e6 edge_write
  n6 e7@-->|"移除"| n2
  class e7 edge_write
  n2 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n2 e1@-->|"可能挂载于"| n1
  class e1 edge_reference
  n3 e2@---|"存在 / 变更过滤"| n2
  class e2 edge_reference
  n4 e4@---|"存在 / 变更过滤"| n2
  class e4 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
