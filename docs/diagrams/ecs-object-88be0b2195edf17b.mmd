---
flowchart LR
  accTitle: RemoveEvent · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**RemoveEvent**<br/>正移除 Pressed 且仍具有 MenuButton 的<br/>实体" }
  class n0 node_event
  n1@{ shape: hex, label: "**clear_primary_press**<br/>来自菜单与界面 ↗：原生 Pressed 移除时<br/>清理菜单主键来源。" }
  class n1 node_observer
  class n1 external_node
  n2@{ shape: hex, label: "**button_on_pointer_up**<br/>释放时移除原生Pressed。" }
  class n2 node_observer
  n3@{ shape: hex, label: "**button_on_pointer_drag_end**<br/>拖动结束时移除原生Pressed。" }
  class n3 node_observer
  n4@{ shape: hex, label: "**button_on_pointer_cancel**<br/>收到取消事件时移除原生Pressed。" }
  class n4 node_observer
  n0 e0@-->|"RemoveEvent"| n1
  class e0 edge_observe
  n2 e1@-->|"RemoveEvent（Pressed） lifecycle"| n0
  class e1 edge_emit
  n3 e2@-->|"RemoveEvent（Pressed） lifecycle"| n0
  class e2 edge_emit
  n4 e3@-->|"RemoveEvent（Pressed） lifecycle"| n0
  class e3 edge_emit
  e1@{ curve: basis }
  e3@{ curve: basis }
