---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 音频播放 · 数据与实体
  accDescr: 音频播放的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_contract fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_publish stroke:#247B91,stroke-width:1.8px,stroke-dasharray:10 4 2 4
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n0@{ shape: cyl, label: "**Messages#lt;SoundRequest#gt;**<br/>缓冲菜单交互与物品反馈的短音请求。" }
  class n0 node_message_buffer
  n1@{ shape: cyl, label: "**SoundBank**<br/>保存短音资源、播放策略与实例生命周期。" }
  class n1 node_resource
  n6@{ shape: cyl, label: "**AudioMix**<br/>保存界面与音效通道当前采用的有效音量。" }
  class n6 node_resource
  n8@{ shape: lin-rect, label: "**已接入的反馈生产者**<br/>来自物品交互 ↗：汇总菜单交互与物品运动<br/>产生的声音反馈。" }
  class n8 node_contract
  class n8 external_node
  n9@{ shape: lin-rect, label: "**Update / Kira 播放输出**<br/>将声音请求按有效混音与播放策略提交音频实<br/>例。" }
  class n9 node_contract
  n10@{ shape: rounded, label: "**pointer_interaction**<br/>来自菜单与界面 ↗：将真实鼠标交互转换为<br/>共享菜单请求。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: hex, label: "**previous**<br/>来自菜单与界面 ↗：循环选择上一个可操作<br/>菜单按钮。" }
  class n11 node_observer
  class n11 external_node
  n12@{ shape: hex, label: "**next**<br/>来自菜单与界面 ↗：循环选择下一个可操作<br/>菜单按钮。" }
  class n12 node_observer
  class n12 external_node
  n13@{ shape: rounded, label: "**warn_hold_strain**<br/>来自物品交互 ↗：检查持续持握偏差并发出<br/>失稳提示音。" }
  class n13 node_system
  class n13 external_node
  n14@{ shape: rounded, label: "**emit_parcel_land**<br/>来自物品交互 ↗：识别自由物品落地并发出<br/>声音请求。" }
  class n14 node_system
  class n14 external_node
  n15@{ shape: rounded, label: "**play_requests**<br/>按有效音量与播放策略处理短音请求。" }
  class n15 node_system
  n18@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n18 node_system
  class n18 external_node
  n11 layout_0@~~~ n12
  n8 e0@--> n0
  class e0 edge_publish
  n0 e1@-->|"请求"| n9
  class e1 edge_consume
  n1 e2@--> n9
  class e2 edge_read
  n9 e3@--> n1
  class e3 edge_write
  n10 e4@-->|"MenuHover"| n0
  class e4 edge_publish
  n6 e5@-->|"有效音量"| n9
  class e5 edge_read
  n11 e6@--> n0
  class e6 edge_publish
  n12 e7@--> n0
  class e7 edge_publish
  n13 e8@--> n0
  class e8 edge_publish
  n14 e9@--> n0
  class e9 edge_publish
  n0 e10@--> n15
  class e10 edge_consume
  n1 e11@-->|"策略"| n15
  class e11 edge_read
  n15 e12@-->|"实例"| n1
  class e12 edge_write
  n18 e15@-->|"成功拿起 / 释放"| n0
  class e15 edge_publish
  end
  style relation_0 fill:none,stroke:none
  subgraph relation_1[" "]
  direction TB
  n7@{ shape: cyl, label: "**AudioPreview**<br/>向音频功能提供设置界面的临时音量。" }
  class n7 node_resource
  n16@{ shape: rounded, label: "**publish_audio_preview**<br/>来自菜单与界面 ↗：向音频功能发布或清除<br/>临时音量预览。" }
  class n16 node_system
  class n16 external_node
  n17@{ shape: rounded, label: "**sync_audio_mix**<br/>合成设置预览或正式配置的有效音量。" }
  class n17 node_system
  n16 e13@-->|"预览音量"| n7
  class e13 edge_write
  n7 e14@-->|"临时音量契约"| n17
  class e14 edge_read
  end
  style relation_1 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n2@{ shape: cyl, label: "**AudioChannel#lt;UiTrack#gt;**<br/>承载界面短音的播放命令。" }
  class n2 node_resource
  n3@{ shape: cyl, label: "**AudioChannel#lt;SfxTrack#gt;**<br/>承载物品等音效短音的播放命令。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**UiTrack**<br/>标识界面短音通道的类型。" }
  class n4 node_resource
  n5@{ shape: cyl, label: "**SfxTrack**<br/>标识音效短音通道的类型。" }
  class n5 node_resource
  n2 layout_1@~~~ n3
  n3 layout_2@~~~ n4
  n4 layout_3@~~~ n5
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: basis }
  e15@{ curve: basis }
