---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-f99990d689e3b094-e3{marker-start:url(#component-f99990d689e3b094_flowchart-v2-pointStart)!important}\n#component-f99990d689e3b094-e4{marker-start:url(#component-f99990d689e3b094_flowchart-v2-pointStart)!important}\n#component-f99990d689e3b094-e5{marker-start:url(#component-f99990d689e3b094_flowchart-v2-pointStart)!important}\n#component-f99990d689e3b094-e6{marker-start:url(#component-f99990d689e3b094_flowchart-v2-pointStart)!important}\n#component-f99990d689e3b094-e8{marker-start:url(#component-f99990d689e3b094_flowchart-v2-pointStart)!important}\n#component-f99990d689e3b094_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: ColliderAabb · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_contract fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n0 node_entity
  class n0 external_node
  end
  style layout_card_n0 fill:none,stroke:none
  subgraph layout_card_n1[" "]
  n1@{ shape: rounded, label: "**可搬物品业务根实体**<br/>来自场景装配 ↗：承载可拾取物品身份及自<br/>由运动、共享持握状态。" }
  class n1 node_entity
  class n1 external_node
  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: rounded, label: "**海岛静态碰撞实体**<br/>来自场景装配 ↗：为海岛结构、入口坡道与<br/>展示人物提供静态碰撞。" }
  class n2 node_entity
  class n2 external_node
  end
  style layout_card_n2 fill:none,stroke:none
  subgraph layout_card_n3[" "]
  n3@{ shape: rounded, label: "**ColliderAabb**<br/>保存碰撞查询使用的轴对齐包围盒。" }
  class n3 node_component
  end
  style layout_card_n3 fill:none,stroke:none
  subgraph layout_card_n4[" "]
  n4@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n4 node_system
  class n4 external_node
  end
  style layout_card_n4 fill:none,stroke:none
  subgraph layout_card_n5[" "]
  n5@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n5 node_system
  class n5 external_node
  end
  style layout_card_n5 fill:none,stroke:none
  subgraph layout_card_n6[" "]
  n6@{ shape: rounded, label: "**update_grounded**<br/>来自角色运动 ↗：探测角色脚下支撑面并更<br/>新接地状态。" }
  class n6 node_system
  class n6 external_node
  end
  style layout_card_n6 fill:none,stroke:none
  subgraph layout_card_n7[" "]
  n7@{ shape: lin-rect, label: "**PhysicsSystems::StepSimulation /**<br/>**PhysicsSchedule**<br/>执行碰撞求解、重力积分与刚体运动。" }
  class n7 node_contract
  end
  style layout_card_n7 fill:none,stroke:none
  subgraph layout_card_n8[" "]
  n8@{ shape: rounded, label: "**align_attachments**<br/>来自物品交互 ↗：沿安全碰撞路径将物品对<br/>齐双手。" }
  class n8 node_system
  class n8 external_node
  end
  style layout_card_n8 fill:none,stroke:none
  n3 layout_0@~~~ n0
  n3 layout_1@~~~ n1
  n3 layout_2@~~~ n2
  n4 layout_3@~~~ n3
  n5 layout_4@~~~ n3
  n6 layout_5@~~~ n3
  n7 layout_6@~~~ n3
  n8 layout_7@~~~ n3
  n7 e7@-->|"/ 结构变更（待核实）"| n3
  class e7 edge_write
  n3 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n3 e1@-->|"可能挂载于"| n1
  class e1 edge_reference
  n3 e2@-->|"可能挂载于"| n2
  class e2 edge_reference
  n4 e3@---|"查询访问"| n3
  class e3 edge_read
  n5 e4@---|"查询访问"| n3
  class e4 edge_read
  n6 e5@----|"查询访问"| n3
  class e5 edge_read
  n7 e6@---|"查询访问"| n3
  class e6 edge_read
  n8 e8@---|"查询访问"| n3
  class e8 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
