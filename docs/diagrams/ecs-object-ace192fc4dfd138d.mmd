---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: AudioSystems · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_scheduling_constraint fill:#F5F3F8,stroke:#7C6AA6,stroke-width:1.6px,color:#1F3340
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_constraint stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:10 4 2 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**AudioSystems**<br/>公开音量混合与播放的调度阶段。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**UI Style → Audio Mix → Playback**<br/>来自应用流程 ↗：约束界面显示更新先于音<br/>量混合与播放。" }
  class n1 node_scheduling_constraint
  class n1 external_node
  n2@{ shape: rounded, label: "**log_load_failures**<br/>记录声音资源加载失败的路径与错误。" }
  class n2 node_system
  n3@{ shape: rounded, label: "**play_requests**<br/>按有效音量与播放策略处理短音请求。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**stop_on_exit**<br/>停止音频通道并记录退出。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**sync_audio_mix**<br/>合成设置预览或正式配置的有效音量。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**sync_voice_volumes**<br/>将有效混音与素材音量同步到播放实例。" }
  class n6 node_system
  n1 e0@-->|"Audio Mix / Playback"| n0
  class e0 edge_constraint
  n0 e1@-->|"AudioSystems::Mix"| n2
  class e1 edge_set_membership
  n0 e2@-->|"AudioSystems::Playback"| n3
  class e2 edge_set_membership
  n0 e3@-->|"AudioSystems::Playback"| n4
  class e3 edge_set_membership
  n0 e4@-->|"AudioSystems::Mix"| n5
  class e4 edge_set_membership
  n0 e5@-->|"AudioSystems::Mix"| n6
  class e5 edge_set_membership
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
