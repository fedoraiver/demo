---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 设置与参数 · 系统与调度
  accDescr: 设置与参数的系统与调度；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_contract fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_schedule stroke:#334155,stroke-width:3px
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  subgraph sg0["Startup"]
  direction TB
  n0@{ shape: rounded, label: "**log_simulation_timestep**<br/>记录固定模拟频率。" }
  class n0 node_system
  end
  subgraph sg1["First"]
  direction TB
  n1@{ shape: rounded, label: "**limit_frame_rate**<br/>补足帧间等待以控制显示帧率。" }
  class n1 node_system
  n2@{ shape: lin-rect, label: "**TimeSystems / time_system**<br/>来自Bevy 引擎 ↗：推进真实时间与游戏时<br/>间。" }
  class n2 node_contract
  class n2 external_node
  n1 layout_0@~~~ n2
  end
  sg0 sc0@--> sg1
  class sc0 edge_schedule
  n1 e0@--> n2
  class e0 edge_order
  end
  e0@{ curve: basis }
