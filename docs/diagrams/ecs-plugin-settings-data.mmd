---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 设置与参数 · 数据与实体
  accDescr: 设置与参数的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n0@{ shape: cyl, label: "**GameSettings**<br/>保存已应用的玩家设置与音量配置。" }
  class n0 node_resource
  n3@{ shape: cyl, label: "**SettingsDraft**<br/>保存待应用的设置草稿与临时音量编辑。" }
  class n3 node_resource
  n5@{ shape: rounded, label: "**limit_frame_rate**<br/>补足帧间等待以控制显示帧率。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**handle_requests**<br/>来自菜单与界面 ↗：处理菜单导航、设置应<br/>用与音量编辑请求。" }
  class n6 node_system
  class n6 external_node
  n10@{ shape: hex, label: "**on_camera_look**<br/>来自第一人称控制 ↗：将观察输入转为第一<br/>人称水平角与俯仰角。" }
  class n10 node_observer
  class n10 external_node
  n11@{ shape: rounded, label: "**update_settings_text**<br/>来自菜单与界面 ↗：原位更新设置草稿数值<br/>与保存提示。" }
  class n11 node_system
  class n11 external_node
  n12@{ shape: rounded, label: "**sync_audio_mix**<br/>来自音频播放 ↗：合成设置预览或正式配置<br/>的有效音量。" }
  class n12 node_system
  class n12 external_node
  n0 e0@-->|"设置"| n5
  class e0 edge_read
  n6 e1@-->|"草稿"| n3
  class e1 edge_write
  n0 e5@-->|"已应用观察设置"| n10
  class e5 edge_read
  n3 e6@-->|"草稿显示"| n11
  class e6 edge_read
  n6 e7@-->|"保存成功后应用"| n0
  class e7 edge_write
  n0 e8@-->|"正式音量配置"| n12
  class e8 edge_read
  end
  style relation_0 fill:none,stroke:none
  subgraph relation_1[" "]
  direction TB
  n1@{ shape: cyl, label: "**PrototypeConfig**<br/>保存运动、重力、拾取与握持的共享参数。" }
  class n1 node_resource
  n7@{ shape: rounded, label: "**move_characters**<br/>来自角色运动 ↗：按移动意图和速度为角色<br/>施加水平运动力。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**sync_gravity**<br/>来自物理基础 ↗：将共享重力配置同步到物<br/>理世界。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n9 node_system
  class n9 external_node
  n1 e2@-->|"移动参数"| n7
  class e2 edge_read
  n1 e3@-->|"共享重力参数"| n8
  class e3 edge_read
  n1 e4@-->|"拾取参数"| n9
  class e4 edge_read
  end
  style relation_1 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n2@{ shape: notch-rect, label: "**Local#lt;FramePacing#gt;**<br/>保存帧间等待计时与重复日志抑制状态。" }
  class n2 node_local
  n4@{ shape: cyl, label: "**SettingsFile**<br/>保存玩家设置文件的存储路径。" }
  class n4 node_resource
  n2 layout_0@~~~ n4
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e4@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
