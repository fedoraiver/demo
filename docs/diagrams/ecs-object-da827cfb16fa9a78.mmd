---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: GameUiPlugin · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_app fill:#EFF4F5,stroke:#3A7B87,stroke-width:2.2px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: fr-rect, label: "**GameUiPlugin**<br/>管理菜单、设置编辑、导航与主菜单展示场<br/>景。" }
  class n0 node_plugin
  n1@{ shape: fr-rect, label: "**main / App**<br/>来自Bevy 引擎 ↗：装配应用、设置与插件<br/>并管理主循环和退出。" }
  class n1 node_app
  class n1 external_node
  n2@{ shape: rounded, label: "**菜单输入控制者**<br/>提供跨页面与玩法会话保留的菜单动作输入。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**BSN 菜单页面根**<br/>承载当前菜单页面及其声明式控件层级。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**可操作菜单按钮**<br/>承载可操作菜单动作、设置调整与连续导航。" }
  class n4 node_entity
  n5@{ shape: rounded, label: "**设置面板内容视口**<br/>为设置标题、字段、说明与提示提供滚动视<br/>口。" }
  class n5 node_entity
  n6@{ shape: rounded, label: "**主菜单展示舞台根**<br/>承载主菜单的独立海岛展示场景。" }
  class n6 node_entity
  n7@{ shape: rounded, label: "**主菜单展示相机**<br/>为主菜单展示场景与界面提供相机。" }
  class n7 node_entity
  n8@{ shape: rounded, label: "**菜单 GLB 模型与动画子树**<br/>承载主菜单的海岛模型与快递员展示动画。" }
  class n8 node_entity
  n9@{ shape: rounded, label: "**菜单文字叶节点**<br/>显示菜单标题、按钮、按键提示与正文。" }
  class n9 node_entity
  n10@{ shape: rounded, label: "**音量轨道填充**<br/>显示当前音量对应的轨道填充。" }
  class n10 node_entity
  n11@{ shape: rounded, label: "**设置右侧纸色面板**<br/>限定设置内容的显示与裁切范围。" }
  class n11 node_entity
  n12@{ shape: rounded, label: "**设置滚动条轨道**<br/>为设置内容视口提供可交互滚动轨道。" }
  class n12 node_entity
  n13@{ shape: rounded, label: "**设置滚动条滑块**<br/>显示设置内容的可视比例并支持拖动。" }
  class n13 node_entity
  n14@{ shape: rounded, label: "**show_main_menu**<br/>打开主菜单并重置页面、返回来源与焦点。" }
  class n14 node_system
  n15@{ shape: rounded, label: "**show_pause_menu**<br/>打开暂停菜单并重置焦点。" }
  class n15 node_system
  n16@{ shape: rounded, label: "**hide_menu**<br/>隐藏菜单并清除提示。" }
  class n16 node_system
  n17@{ shape: rounded, label: "**spawn_menu_controller**<br/>创建菜单动作控制者及键盘、手柄绑定。" }
  class n17 node_system
  n18@{ shape: rounded, label: "**sync_context**<br/>跟随窗口焦点启停菜单输入。" }
  class n18 node_system
  n19@{ shape: rounded, label: "**handle_requests**<br/>处理菜单导航、设置应用与音量编辑请求。" }
  class n19 node_system
  n20@{ shape: rounded, label: "**pointer_interaction**<br/>将真实鼠标交互转换为共享菜单请求。" }
  class n20 node_system
  n21@{ shape: rounded, label: "**rebuild_page**<br/>按页面结构变化重建菜单界面。" }
  class n21 node_system
  n22@{ shape: rounded, label: "**style_buttons**<br/>按当前输入来源更新按钮背景与焦点边框。" }
  class n22 node_system
  n23@{ shape: rounded, label: "**update_description**<br/>更新当前聚焦设置的说明标题与正文。" }
  class n23 node_system
  n24@{ shape: rounded, label: "**scroll_focused_button**<br/>将当前聚焦设置按钮滚入可视范围。" }
  class n24 node_system
  n25@{ shape: rounded, label: "**spawn_backdrop**<br/>装配主菜单海岛展示舞台、相机与日光。" }
  class n25 node_system
  n26@{ shape: rounded, label: "**log_asset_failures**<br/>记录菜单模型与界面资源加载失败。" }
  class n26 node_system
  n27@{ shape: hex, label: "**previous**<br/>循环选择上一个可操作菜单按钮。" }
  class n27 node_observer
  n28@{ shape: hex, label: "**next**<br/>循环选择下一个可操作菜单按钮。" }
  class n28 node_observer
  n29@{ shape: hex, label: "**left**<br/>向左调整当前聚焦的真实设置字段。" }
  class n29 node_observer
  n30@{ shape: hex, label: "**right**<br/>向右调整当前聚焦的真实设置字段。" }
  class n30 node_observer
  n31@{ shape: hex, label: "**confirm**<br/>执行当前聚焦按钮的菜单动作。" }
  class n31 node_observer
  n32@{ shape: hex, label: "**back**<br/>发出返回、暂停或恢复请求。" }
  class n32 node_observer
  n33@{ shape: hex, label: "**scroll_menu**<br/>滚动设置内容并限制在有效范围内。" }
  class n33 node_observer
  n34@{ shape: hex, label: "**mark_courier_animation_ready**<br/>标记展示快递员以等待动画绑定。" }
  class n34 node_observer
  n35@{ shape: rounded, label: "**play_courier_animation**<br/>绑定并循环播放展示快递员的持物待机动画。" }
  class n35 node_system
  n36@{ shape: rounded, label: "**sample_slider_pointer**<br/>从光标位置生成音量采样与释放请求。" }
  class n36 node_system
  n37@{ shape: rounded, label: "**update_volume_visuals**<br/>原位更新音量百分比文字与轨道填充。" }
  class n37 node_system
  n38@{ shape: rounded, label: "**update_settings_text**<br/>原位更新设置草稿数值与保存提示。" }
  class n38 node_system
  n39@{ shape: rounded, label: "**bind_settings_scrollbars**<br/>将设置滚动条绑定到对应内容视口。" }
  class n39 node_system
  n40@{ shape: rounded, label: "**sync_settings_scrollbars**<br/>同步滚动条显隐、拾取范围与高亮。" }
  class n40 node_system
  n41@{ shape: hex, label: "**scroll_over_settings_scrollbar**<br/>通过滚动条上的滚轮操作滚动内容视口。" }
  class n41 node_observer
  n42@{ shape: hex, label: "**scrollbar_pointer_source**<br/>将滚动条按下操作标为鼠标输入。" }
  class n42 node_observer
  n43@{ shape: rounded, label: "**publish_audio_preview**<br/>向音频功能发布或清除临时音量预览。" }
  class n43 node_system
  n44@{ shape: hex, label: "**primary_press**<br/>记录菜单按钮主键按压的指针身份。" }
  class n44 node_observer
  n45@{ shape: hex, label: "**clear_primary_press**<br/>原生 Pressed 移除时清理菜单主键来源。" }
  class n45 node_observer
  n46@{ shape: rounded, label: "**clear_cancelled_primary_presses**<br/>清理被取消、失焦或离窗的菜单主键按压。" }
  class n46 node_system
