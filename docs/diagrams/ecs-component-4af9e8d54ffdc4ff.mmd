---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-4af9e8d54ffdc4ff-e1{marker-start:url(#component-4af9e8d54ffdc4ff_flowchart-v2-pointStart)!important}\n#component-4af9e8d54ffdc4ff-e2{marker-start:url(#component-4af9e8d54ffdc4ff_flowchart-v2-pointStart)!important}\n#component-4af9e8d54ffdc4ff-e4{marker-start:url(#component-4af9e8d54ffdc4ff_flowchart-v2-pointStart)!important}\n#component-4af9e8d54ffdc4ff-e5{marker-start:url(#component-4af9e8d54ffdc4ff_flowchart-v2-pointStart)!important}\n#component-4af9e8d54ffdc4ff_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: HeldCollider · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**持物无视觉碰撞代理**<br/>为持物共享人物刚体提供无视觉碰撞形状。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**HeldCollider**<br/>关联代理所对应的真实物品。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**update_grounded**<br/>来自角色运动 ↗：探测角色脚下支撑面并更<br/>新接地状态。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**cleanup_orphaned_colliders**<br/>清理物品销毁后残留的碰撞代理。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**finish_attachments**<br/>为持物装配共享碰撞代理并累计质量。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**sync_held_physics**<br/>按人物物理姿态同步持物位置与碰撞代理。" }
  class n5 node_system
  n6@{ shape: hex, label: "**prepare_holder_despawn**<br/>在持有者销毁前停用并卸载持物代理。" }
  class n6 node_observer
  n1 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n1
  n4 layout_3@~~~ n1
  n5 layout_4@~~~ n1
  n6 layout_5@~~~ n1
  n4 e3@-->|"添加"| n1
  class e3 edge_write
  n1 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n2 e1@---|"存在 / 变更过滤"| n1
  class e1 edge_reference
  n3 e2@---|"查询访问"| n1
  class e2 edge_read
  n5 e4@---|"存在 / 变更过滤"| n1
  class e4 edge_reference
  n6 e5@---|"存在 / 变更过滤"| n1
  class e5 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
