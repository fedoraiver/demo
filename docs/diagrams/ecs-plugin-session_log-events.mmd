---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: 会话日志 · 事件与协作
  accDescr: 会话日志的事件与协作；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_app fill:#EFF4F5,stroke:#3A7B87,stroke-width:2.2px,color:#1F3340
  classDef node_external_io fill:#F1F3F4,stroke:#526A78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  n0@{ shape: fr-rect, label: "**SessionLogPlugin**<br/>安装统一会话日志并管理后台输出与退出刷<br/>新。" }
  class n0 node_plugin
  n1@{ shape: lean-l, label: "**会话日志文件**<br/>保存本次运行中各模块的统一会话日志。" }
  class n1 node_external_io
  n2@{ shape: lean-l, label: "**tracing producer**<br/>格式化日志并交给独立文件与控制台队列。" }
  class n2 node_external_io
  n3@{ shape: lean-l, label: "**File worker**<br/>在独立线程写入、刷新并反馈文件输出错误。" }
  class n3 node_external_io
  n4@{ shape: lean-l, label: "**Console worker**<br/>在独立线程输出控制台日志。" }
  class n4 node_external_io
  n5@{ shape: fr-rect, label: "**LogPlugin**<br/>来自Bevy 引擎 ↗：安装统一日志订阅与输<br/>出基础设施。" }
  class n5 node_plugin
  class n5 external_node
  n6@{ shape: rounded, label: "**log_collisions**<br/>来自物理基础 ↗：将碰撞开始与结束写入统<br/>一日志。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: fr-rect, label: "**main / App**<br/>来自Bevy 引擎 ↗：装配应用、设置与插件<br/>并管理主循环和退出。" }
  class n7 node_app
  class n7 external_node
  n8@{ shape: rounded, label: "**wake_changed_bodies**<br/>来自物理基础 ↗：使休眠身体的外部受力和<br/>位姿修改在本固定步生效。" }
  class n8 node_system
  class n8 external_node
  n3 e0@-->|"write_all / flush"| n1
  class e0 edge_write
  n2 e1@-->|"入队"| n3
  class e1 edge_write
  n2 e2@-->|"入队"| n4
  class e2 edge_write
  n0 e3@-->|"LogPlugin"| n5
  class e3 edge_registration
  n0 e4@-->|"格式层与后台输出"| n2
  class e4 edge_registration
  n6 e5@-->|"tracing 碰撞日志"| n2
  class e5 edge_write
  n7 e6@-->|"record_exit / 退出刷新"| n3
  class e6 edge_write
  n8 e7@-->|"tracing 唤醒日志"| n2
  class e7 edge_write
  end
  e1@{ curve: basis }
  e2@{ curve: bumpX }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: bumpX }
  e6@{ curve: basis }
  e7@{ curve: basis }
