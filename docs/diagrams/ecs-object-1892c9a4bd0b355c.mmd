---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-1892c9a4bd0b355c-e3{marker-start:url(#object-1892c9a4bd0b355c_flowchart-v2-pointStart)!important}\n#object-1892c9a4bd0b355c-e4{marker-start:url(#object-1892c9a4bd0b355c_flowchart-v2-pointStart)!important}\n#object-1892c9a4bd0b355c_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: TimeSystems · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**TimeSystems**<br/>推进真实时间与游戏时间。" }
  class n0 node_system_set
  n1@{ shape: cyl, label: "**Time#lt;Fixed#gt;**<br/>提供固定模拟的时间步长。" }
  class n1 node_resource
  n2@{ shape: cyl, label: "**Time#lt;Real#gt;**<br/>提供不随游戏暂停的真实时间。" }
  class n2 node_resource
  n3@{ shape: cyl, label: "**Time#lt;Virtual#gt;**<br/>提供可暂停的游戏时间，作为固定步时间来<br/>源。" }
  class n3 node_resource
  n4@{ shape: cyl, label: "**Time**<br/>提供当前运行阶段的通用时间。" }
  class n4 node_resource
  n1 e0@-->|"访问声明"| n0
  class e0 edge_read
  n2 e1@-->|"访问声明"| n0
  class e1 edge_read
  n3 e2@-->|"访问声明"| n0
  class e2 edge_read
  n2 e3@---|"访问声明"| n0
  class e3 edge_write
  n3 e4@---|"访问声明"| n0
  class e4 edge_write
  n0 e5@-->|"访问声明"| n4
  class e5 edge_write
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: bumpX }
  e3@{ curve: basis }
  e4@{ curve: basis }
