---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-53f36eacd5c759e1-e4{marker-start:url(#object-53f36eacd5c759e1_flowchart-v2-pointStart)!important}\n#object-53f36eacd5c759e1-e8{marker-start:url(#object-53f36eacd5c759e1_flowchart-v2-pointStart)!important}\n#object-53f36eacd5c759e1-e11{marker-start:url(#object-53f36eacd5c759e1_flowchart-v2-pointStart)!important}\n#object-53f36eacd5c759e1-e13{marker-start:url(#object-53f36eacd5c759e1_flowchart-v2-pointStart)!important}\n#object-53f36eacd5c759e1-e16{marker-start:url(#object-53f36eacd5c759e1_flowchart-v2-pointStart)!important}\n#object-53f36eacd5c759e1-e18{marker-start:url(#object-53f36eacd5c759e1_flowchart-v2-pointStart)!important}\n#object-53f36eacd5c759e1_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: sync_settings_scrollbars · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_observer_group fill:#F7F3F6,stroke:#9A648D,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**sync_settings_scrollbars**<br/>同步滚动条显隐、拾取范围与高亮。" }
  class n0 node_system
  n1@{ shape: rounded, label: "**update_scrollbar_thumb**<br/>来自Bevy 引擎 ↗：按内容与视口比例更新<br/>滚动条滑块几何。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: lin-rect, label: "**VisibilitySystems::**<br/>**VisibilityPropagate**<br/>来自Bevy 引擎 ↗：在项目显隐同步后传播<br/>可见性。" }
  class n2 node_system_set
  class n2 external_node
  n3@{ shape: hex, label: "**ScrollbarPlugin · pointer observers**<br/>来自Bevy 引擎 ↗：处理滚动条的轨道分页<br/>与滑块拖动。" }
  class n3 node_observer_group
  class n3 external_node
  n4@{ shape: rounded, label: "**ComputedNode**<br/>来自Bevy 引擎 ↗：布局计算结果，用于滚<br/>动范围与坐标转换。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**ScrollPosition**<br/>来自Bevy 引擎 ↗：保存内容视口的滚动偏<br/>移。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: rounded, label: "**Scrollbar**<br/>来自Bevy 引擎 ↗：关联滚动条控制的内容<br/>视口。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**Children**<br/>来自Bevy 引擎 ↗：索引轨道拥有的原生滑<br/>块子实体。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: rounded, label: "**Visibility**<br/>来自Bevy 引擎 ↗：控制实体及视觉子树的<br/>显示状态。" }
  class n8 node_component
  class n8 external_node
  n9@{ shape: rounded, label: "**Hovered**<br/>来自Bevy 引擎 ↗：标记滑块当前被指针悬<br/>停。" }
  class n9 node_component
  class n9 external_node
  n10@{ shape: rounded, label: "**ScrollbarDragState**<br/>来自Bevy 引擎 ↗：保存原生滑块的拖动状<br/>态。" }
  class n10 node_component
  class n10 external_node
  n11@{ shape: rounded, label: "**BackgroundColor**<br/>来自Bevy 引擎 ↗：保存滑块的背景颜色。" }
  class n11 node_component
  class n11 external_node
  n12@{ shape: rounded, label: "**Pickable**<br/>来自Bevy 引擎 ↗：控制滚动条是否接受指<br/>针拾取。" }
  class n12 node_component
  class n12 external_node
  n13@{ shape: rounded, label: "**Pickable**<br/>来自Bevy 引擎 ↗：控制滑块是否接受指针<br/>拾取。" }
  class n13 node_component
  class n13 external_node
  n14@{ shape: cyl, label: "**MenuState**<br/>保存菜单页面、设置分类、返回来源与提示。" }
  class n14 node_resource
  n15@{ shape: cyl, label: "**MenuInputSource**<br/>保存当前可见焦点使用的输入来源。" }
  class n15 node_resource
  n16@{ shape: fr-rect, label: "**GameUiPlugin**<br/>管理菜单、设置编辑、导航与主菜单展示场<br/>景。" }
  class n16 node_plugin
