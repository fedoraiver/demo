---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: primary_press · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: hex, label: "**primary_press**<br/>记录菜单按钮主键按压的指针身份。" }
  class n0 node_observer
  n1@{ shape: stadium, label: "**PointerPress**<br/>来自Bevy 引擎 ↗：事件 entity 上具有<br/>MenuButton，且为 Primary 指针键" }
  class n1 node_event
  class n1 external_node
  n2@{ shape: rounded, label: "**PrimaryPress**<br/>区分菜单主键按压与其他按钮来源。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**MenuButton**<br/>保存菜单动作及按钮的导航序号。" }
  class n3 node_component
  n4@{ shape: fr-rect, label: "**GameUiPlugin**<br/>管理菜单、设置编辑、导航与主菜单展示场<br/>景。" }
  class n4 node_plugin
  n1 e0@-->|"PointerPress"| n0
  class e0 edge_observe
  n0 e1@-->|"添加"| n2
  class e1 edge_write
  n3 e2@-->|"存在 / 变更过滤"| n0
  class e2 edge_reference
  n4 e3@--> n0
  class e3 edge_registration
  e0@{ curve: basis }
  e3@{ curve: basis }
