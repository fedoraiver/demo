---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: AssetServer · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**AssetServer**<br/>加载并查询递归依赖。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**poll_art_assets**<br/>来自场景装配 ↗：检查资源及其依赖的加载<br/>结果。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**spawn_backdrop**<br/>来自菜单与界面 ↗：装配主菜单海岛展示舞<br/>台、相机与日光。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**preload_sounds**<br/>来自音频播放 ↗：预加载界面与音效短音并<br/>保存播放策略。" }
  class n3 node_system
  class n3 external_node
  n0 e0@-->|"访问声明"| n1
  class e0 edge_read
  n0 e1@-->|"访问声明"| n2
  class e1 edge_read
  n0 e2@-->|"访问声明"| n3
  class e2 edge_read
  e0@{ curve: basis }
  e2@{ curve: basis }
