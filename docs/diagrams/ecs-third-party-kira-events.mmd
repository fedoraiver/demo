---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Kira · 事件与协作
  accDescr: Kira的事件与协作；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  n0@{ shape: cyl, label: "**Messages#lt;AssetLoadFailedEvent#lt;AudioS**<br/>**ource#gt;#gt;**<br/>缓冲声音资源加载失败的路径与错误。" }
  class n0 node_message_buffer
  n1@{ shape: fr-rect, label: "**KiraAudioPlugin**<br/>提供短音资产加载、通道播放与混音基础设<br/>施。" }
  class n1 node_plugin
  n2@{ shape: stadium, label: "**Kira UI / SFX 输出流程**<br/>接收播放与停止命令并输出界面和物品短音。" }
  class n2 node_engine_flow
  n3@{ shape: rounded, label: "**play_requests**<br/>来自音频播放 ↗：按有效音量与播放策略处<br/>理短音请求。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: fr-rect, label: "**GameAudioPlugin**<br/>来自音频播放 ↗：管理短音预加载、混音、<br/>播放与设备输出。" }
  class n4 node_plugin
  class n4 external_node
  n3 e0@-->|"排队播放"| n2
  class e0 edge_write
  n4 e1@-->|"Kira"| n1
  class e1 edge_registration
  end
