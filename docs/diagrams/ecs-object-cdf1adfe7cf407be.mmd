---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-cdf1adfe7cf407be-e3{marker-start:url(#object-cdf1adfe7cf407be_flowchart-v2-pointStart)!important}\n#object-cdf1adfe7cf407be-e10{marker-start:url(#object-cdf1adfe7cf407be_flowchart-v2-pointStart)!important}\n#object-cdf1adfe7cf407be-e12{marker-start:url(#object-cdf1adfe7cf407be_flowchart-v2-pointStart)!important}\n#object-cdf1adfe7cf407be-e14{marker-start:url(#object-cdf1adfe7cf407be_flowchart-v2-pointStart)!important}\n#object-cdf1adfe7cf407be-e16{marker-start:url(#object-cdf1adfe7cf407be_flowchart-v2-pointStart)!important}\n#object-cdf1adfe7cf407be-e18{marker-start:url(#object-cdf1adfe7cf407be_flowchart-v2-pointStart)!important}\n#object-cdf1adfe7cf407be-e21{marker-start:url(#object-cdf1adfe7cf407be_flowchart-v2-pointStart)!important}\n#object-cdf1adfe7cf407be-e24{marker-start:url(#object-cdf1adfe7cf407be_flowchart-v2-pointStart)!important}\n#object-cdf1adfe7cf407be-e37{marker-start:url(#object-cdf1adfe7cf407be_flowchart-v2-pointStart)!important}\n#object-cdf1adfe7cf407be_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: EnhancedInputSystems::Update · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**EnhancedInputSystems::Update**<br/>评估绑定输入并更新动作值与触发状态。" }
  class n0 node_system_set
  n1@{ shape: lin-rect, label: "**EnhancedInputSystems::Prepare**<br/>准备动作评估并清理待释放的输入。" }
  class n1 node_system_set
  n2@{ shape: lin-rect, label: "**EnhancedInputSystems::Apply**<br/>把评估结果写回强类型动作值。" }
  class n2 node_system_set
  n3@{ shape: rounded, label: "**Actions#lt;GameplayContext#gt;**<br/>索引控制上下文拥有的动作实体。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**ContextActivity#lt;GameplayContext#gt;**<br/>保存动作上下文的启用状态。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**GamepadDevice**<br/>配置玩法上下文的手柄输入来源。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Name**<br/>来自Bevy 引擎 ↗：Action#lt;A#gt; 要求的动作<br/>名称，用于插件诊断。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**ActionSettings**<br/>保存动作的输入消费与重新激活策略。" }
  class n7 node_component
  n8@{ shape: rounded, label: "**Bindings**<br/>索引动作拥有的输入绑定。" }
  class n8 node_component
  n9@{ shape: rounded, label: "**ActionMock**<br/>保存测试使用的模拟动作输入。" }
  class n9 node_component
  n10@{ shape: rounded, label: "**ActionValue**<br/>保存动作评估产生的通用输入值。" }
  class n10 node_component
  n11@{ shape: rounded, label: "**TriggerState**<br/>保存本次动作评估的触发状态。" }
  class n11 node_component
  n12@{ shape: rounded, label: "**ActionEvents**<br/>保存本次待派发的动作事件。" }
  class n12 node_component
  n13@{ shape: rounded, label: "**ActionTime**<br/>动作持续与触发计时，由插件评估更新。" }
  class n13 node_component
  n14@{ shape: rounded, label: "**ConditionFns**<br/>保存动作触发条件的执行适配。" }
  class n14 node_component
  n15@{ shape: rounded, label: "**Press**<br/>将按钮按下转换为一次触发。" }
  class n15 node_component
  n16@{ shape: rounded, label: "**Binding**<br/>保存设备输入到动作的映射。" }
  class n16 node_component
  n17@{ shape: rounded, label: "**FirstActivation**<br/>记录绑定重新启用时的首次激活状态。" }
  class n17 node_component
  n18@{ shape: rounded, label: "**ModifierFns**<br/>保存输入修饰器的执行适配。" }
  class n18 node_component
  n19@{ shape: rounded, label: "**Negate**<br/>反转绑定输入的方向符号。" }
  class n19 node_component
  n20@{ shape: rounded, label: "**SwizzleAxis**<br/>将输入标量映射到指定坐标轴。" }
  class n20 node_component
  n21@{ shape: cyl, label: "**Time**<br/>来自Bevy 引擎 ↗：提供当前运行阶段的通<br/>用时间。" }
  class n21 node_resource
  class n21 external_node
  n22@{ shape: cyl, label: "**Time#lt;Real#gt;**<br/>来自Bevy 引擎 ↗：提供不随游戏暂停的真<br/>实时间。" }
  class n22 node_resource
  class n22 external_node
  n23@{ shape: cyl, label: "**ContextInstances#lt;PreUpdate#gt;**<br/>索引输入框架当前运行的动作上下文。" }
  class n23 node_resource
  n24@{ shape: cyl, label: "**ButtonInput#lt;KeyCode#gt;**<br/>来自Bevy 引擎 ↗：保存键盘按键的当前状<br/>态与变化。" }
  class n24 node_resource
  class n24 external_node
  n25@{ shape: cyl, label: "**ButtonInput#lt;MouseButton#gt;**<br/>来自Bevy 引擎 ↗：保存鼠标按钮的当前状<br/>态与变化。" }
  class n25 node_resource
  class n25 external_node
  n26@{ shape: cyl, label: "**AccumulatedMouseMotion**<br/>来自Bevy 引擎 ↗：汇总本帧鼠标位移供观<br/>察动作使用。" }
  class n26 node_resource
  class n26 external_node
  n27@{ shape: cyl, label: "**ActionSources**<br/>配置输入框架允许使用的输入来源。" }
  class n27 node_resource
  n28@{ shape: cyl, label: "**ConsumedInputs**<br/>记录本轮动作评估已经消费的输入。" }
  class n28 node_resource
  n29@{ shape: cyl, label: "**PendingBindings**<br/>保存上下文停用后仍需重置的输入绑定。" }
  class n29 node_resource
