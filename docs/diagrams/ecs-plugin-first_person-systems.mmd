  n29 e19@-->|"Cancel#lt;MoveAction#gt;"| n4
  class e19 edge_observe
  n28 e20@-->|"Fire#lt;JumpAction#gt;"| n5
  class e20 edge_observe
  n28 e21@-->|"Fire#lt;InteractAction#gt;"| n6
