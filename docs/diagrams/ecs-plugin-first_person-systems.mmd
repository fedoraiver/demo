---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 第一人称控制 · 系统与调度
  accDescr: 第一人称控制的系统与调度；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_sync fill:#F6F3F0,stroke:#8B6A42,stroke-width:1.6px,color:#1F3340
  classDef edge_schedule stroke:#334155,stroke-width:3px
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_set_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  subgraph sg0["Startup"]
  direction TB
  n0@{ shape: rounded, label: "**log_pose_synchronization**<br/>记录物理模拟与显示同步的阶段安排。" }
  class n0 node_system
  end
  subgraph sg1["PreUpdate"]
  direction TB
  n21@{ shape: lin-rect, label: "**EguiPreUpdateSet::ProcessInput**<br/>来自Egui / Inspector ↗：将窗口和设备<br/>输入转换为检查器界面输入。" }
  class n21 node_system_set
  class n21 external_node
  n12@{ shape: rounded, label: "**filter_captured_egui_input**<br/>隔离游戏操作与检查器界面输入。" }
  class n12 node_system
  n22@{ shape: lin-rect, label: "**EguiPreUpdateSet::BeginPass**<br/>来自Egui / Inspector ↗：界定检查器界<br/>面开始计算前的输入准备阶段。" }
  class n22 node_system_set
  class n22 external_node
  n1@{ shape: rounded, label: "**sync_mouse_capture**<br/>管理光标捕获及玩法输入启停。" }
  class n1 node_system
  n23@{ shape: rounded, label: "**ApplyDeferred（捕获 → 动作准备）**<br/>来自Bevy 引擎 ↗：使本帧玩法输入启停变<br/>更对动作评估可见。" }
  class n23 node_sync
  class n23 external_node
  n28@{ shape: lin-rect, label: "**EnhancedInputSystems::Trigger**<br/>来自Enhanced Input ↗：按上下文顺序排<br/>入动作事件命令。" }
  class n28 node_system_set
  class n28 external_node
  n2@{ shape: hex, label: "**record_movement**<br/>保存控制角色的持续移动方向。" }
  class n2 node_observer
  n3@{ shape: hex, label: "**clear_completed_movement**<br/>清除已结束动作的角色移动方向。" }
  class n3 node_observer
  n4@{ shape: hex, label: "**clear_cancelled_movement**<br/>清除已取消动作的角色移动方向。" }
  class n4 node_observer
  n5@{ shape: hex, label: "**request_jump**<br/>记录目标角色的单次跳跃请求。" }
  class n5 node_observer
  n6@{ shape: hex, label: "**request_interaction**<br/>记录目标角色的单次交互请求。" }
  class n6 node_observer
  n7@{ shape: hex, label: "**on_camera_look**<br/>将观察输入转为第一人称水平角与俯仰角。" }
  class n7 node_observer
  n15@{ shape: hex, label: "**release_pointer_for_inspector**<br/>释放光标以允许操作世界检查器。" }
  class n15 node_observer
  n29@{ shape: hex, label: "**reset_action#lt;GameplayContext#gt;**<br/>来自Enhanced Input ↗：动作移除时清零<br/>并派发条件性的结束事件。" }
  class n29 node_observer
  class n29 external_node
  n21 layout_0@~~~ n12
  n12 layout_1@~~~ n22
  n22 layout_2@~~~ n1
  n1 layout_3@~~~ n23
  n23 layout_4@~~~ n28
  n2 layout_5@~~~ n3
  n3 layout_6@~~~ n4
  n4 layout_7@~~~ n5
  n5 layout_8@~~~ n6
  n6 layout_9@~~~ n7
  n7 layout_10@~~~ n15
  end
  subgraph sg2["OnEnter"]
  direction TB
  n13@{ shape: rounded, label: "**suspend_controls**<br/>停用玩法输入并释放光标。" }
  class n13 node_system
  n14@{ shape: rounded, label: "**suspend_controls**<br/>停用玩法输入并释放光标。" }
  class n14 node_system
  n16@{ shape: rounded, label: "**resume_capture**<br/>重置光标捕获并丢弃自由光标阶段位移。" }
  class n16 node_system
  n13 layout_11@~~~ n14
  n14 layout_12@~~~ n16
  end
  subgraph sg3["FixedUpdate"]
  direction TB
  n24@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n24 node_system
  class n24 external_node
  n8@{ shape: rounded, label: "**sync_character_facing**<br/>同步人物朝向并处理持物转向受阻。" }
  class n8 node_system
  n25@{ shape: rounded, label: "**update_grounded**<br/>来自角色运动 ↗：准备运动前更新接地状<br/>态。" }
  class n25 node_system
  class n25 external_node
  n26@{ shape: lin-rect, label: "**FixedGameplaySystems**<br/>来自应用流程 ↗：协调恢复、朝向、运动、<br/>交互与持握的固定步顺序。" }
  class n26 node_system_set
  class n26 external_node
  n24 layout_13@~~~ n8
  n8 layout_14@~~~ n25
  n25 layout_15@~~~ n26
  end
  subgraph sg4["RunFixedMainLoop ·<br/>AfterFixedMainLoop"]
  direction TB
  n17@{ shape: lin-rect, label: "**TransformEasingSystems::Ease**<br/>来自Avian ↗：混合固定步端点以生成平滑<br/>显示姿态。" }
  class n17 node_system_set
  class n17 external_node
  n9@{ shape: rounded, label: "**sync_character_facing**<br/>同步人物朝向并处理持物转向受阻。" }
  class n9 node_system
  n18@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：同步本帧持物碰撞朝向与<br/>显示朝向。" }
  class n18 node_system
  class n18 external_node
  n19@{ shape: rounded, label: "**sync_held_presentation**<br/>来自物品交互 ↗：按人物呈现姿态同步持物<br/>模型与握持目标。" }
  class n19 node_system
  class n19 external_node
  n10@{ shape: rounded, label: "**follow_first_person_camera**<br/>按人物本帧位置与观察角度更新第一人称镜<br/>头。" }
  class n10 node_system
  n11@{ shape: rounded, label: "**sync_character_visibility**<br/>隐藏第一人称控制角色的自身模型。" }
  class n11 node_system
  n20@{ shape: lin-rect, label: "**TransformEasingSystems::**<br/>**UpdateEasingTick**<br/>来自Avian ↗：记录显示变更，区分插值更<br/>新与外部瞬移。" }
  class n20 node_system_set
  class n20 external_node
  n27@{ shape: lin-rect, label: "**PresentationSystems**<br/>来自应用流程 ↗：协调插值后的持物、镜头<br/>与可见性同步。" }
  class n27 node_system_set
  class n27 external_node
  n17 layout_16@~~~ n9
  n9 layout_17@~~~ n18
  n18 layout_18@~~~ n19
  n19 layout_19@~~~ n10
  n10 layout_20@~~~ n11
  n11 layout_21@~~~ n20
  n20 layout_22@~~~ n27
  end
