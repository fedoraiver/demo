---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-883cbc5d40646a35-e3{marker-start:url(#component-883cbc5d40646a35_flowchart-v2-pointStart)!important}\n#component-883cbc5d40646a35-e5{marker-start:url(#component-883cbc5d40646a35_flowchart-v2-pointStart)!important}\n#component-883cbc5d40646a35-e7{marker-start:url(#component-883cbc5d40646a35_flowchart-v2-pointStart)!important}\n#component-883cbc5d40646a35-e9{marker-start:url(#component-883cbc5d40646a35_flowchart-v2-pointStart)!important}\n#component-883cbc5d40646a35_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: ScrollPosition · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**设置面板内容视口**<br/>来自菜单与界面 ↗：为设置标题、字段、说<br/>明与提示提供滚动视口。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**ScrollPosition**<br/>保存内容视口的滚动偏移。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**rebuild_page**<br/>来自菜单与界面 ↗：按页面结构变化重建菜<br/>单界面。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**scroll_focused_button**<br/>来自菜单与界面 ↗：将当前聚焦设置按钮滚<br/>入可视范围。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: hex, label: "**scroll_menu**<br/>来自菜单与界面 ↗：滚动设置内容并限制在<br/>有效范围内。" }
  class n4 node_observer
  class n4 external_node
  n5@{ shape: rounded, label: "**sync_settings_scrollbars**<br/>来自菜单与界面 ↗：同步滚动条显隐、拾取<br/>范围与高亮。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: hex, label: "**scroll_over_settings_scrollbar**<br/>来自菜单与界面 ↗：通过滚动条上的滚轮操<br/>作滚动内容视口。" }
  class n6 node_observer
  class n6 external_node
  n1 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n1
  n4 layout_3@~~~ n1
  n5 layout_4@~~~ n1
  n6 layout_5@~~~ n1
  n2 e1@-->|"添加"| n1
  class e1 edge_write
  n3 e2@-->|"字段赋值"| n1
  class e2 edge_write
  n4 e4@-->|"字段赋值"| n1
  class e4 edge_write
  n5 e6@-->|"字段赋值"| n1
  class e6 edge_write
  n6 e8@-->|"字段赋值"| n1
  class e8 edge_write
  n1 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n3 e3@---|"查询访问"| n1
  class e3 edge_read
  n4 e5@---|"查询访问"| n1
  class e5 edge_read
  n5 e7@---|"查询访问"| n1
  class e7 edge_read
  n6 e9@---|"查询访问"| n1
  class e9 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e9@{ curve: basis }
