---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: 应用流程 · 事件与协作
  accDescr: 应用流程的事件与协作；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_contract fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_note fill:#F7F7F5,stroke:#9A9B88,stroke-width:1.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef edge_constraint stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:10 4 2 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  n0@{ shape: cyl, label: "**Messages#lt;StateTransitionEvent#lt;AppSta**<br/>**te#gt;#gt;**<br/>缓冲应用主状态转换的日志输入。" }
  class n0 node_message_buffer
  n1@{ shape: cyl, label: "**Messages#lt;StateTransitionEvent#lt;PlaySt**<br/>**ate#gt;#gt;**<br/>缓冲游戏运行与暂停转换的日志输入。" }
  class n1 node_message_buffer
  n2@{ shape: fr-rect, label: "**GameFlowPlugin**<br/>管理应用状态、时钟及跨功能阶段顺序。" }
  class n2 node_plugin
  n3@{ shape: doc, label: "**NextState → StateTransition**<br/>将开始、返回、暂停与恢复请求提交状态切<br/>换。" }
  class n3 node_note
  n4@{ shape: lin-rect, label: "**FixedGameplaySystems**<br/>协调恢复、朝向、运动、交互与持握的固定步<br/>顺序。" }
  class n4 node_contract
  n5@{ shape: lin-rect, label: "**PresentationSystems**<br/>协调插值后的持物、镜头与可见性同步。" }
  class n5 node_contract
  n6@{ shape: lin-rect, label: "**UI Style → Audio Mix → Playback**<br/>约束界面显示更新先于音量混合与播放。" }
  class n6 node_contract
  n7@{ shape: rounded, label: "**handle_requests**<br/>来自菜单与界面 ↗：处理菜单导航、设置应<br/>用与音量编辑请求。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**move_characters**<br/>来自角色运动 ↗：按移动意图和速度为角色<br/>施加水平运动力。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n11 node_system
  class n11 external_node
  n12@{ shape: rounded, label: "**sync_held_presentation**<br/>来自物品交互 ↗：按人物呈现姿态同步持物<br/>模型与握持目标。" }
  class n12 node_system
  class n12 external_node
  n13@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：按人物物理姿态同步持物<br/>位置与碰撞代理。" }
  class n13 node_system
  class n13 external_node
  n14@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n14 node_system
  class n14 external_node
  n15@{ shape: rounded, label: "**sync_held_physics**<br/>来自物品交互 ↗：同步本帧持物碰撞朝向与<br/>显示朝向。" }
  class n15 node_system
  class n15 external_node
  n16@{ shape: rounded, label: "**sync_held_presentation**<br/>来自物品交互 ↗：按人物呈现姿态同步持物<br/>模型与握持目标。" }
  class n16 node_system
  class n16 external_node
  n17@{ shape: rounded, label: "**follow_first_person_camera**<br/>来自第一人称控制 ↗：按人物本帧位置与观<br/>察角度更新第一人称镜头。" }
  class n17 node_system
  class n17 external_node
  n18@{ shape: rounded, label: "**sync_character_visibility**<br/>来自第一人称控制 ↗：隐藏第一人称控制角<br/>色的自身模型。" }
  class n18 node_system
  class n18 external_node
  n19@{ shape: lin-rect, label: "**UiSystems::Style**<br/>来自菜单与界面 ↗：组织菜单显示、数值与<br/>说明的原位更新。" }
  class n19 node_contract
  class n19 external_node
  n20@{ shape: lin-rect, label: "**AudioSystems**<br/>来自音频播放 ↗：公开音量混合与播放的调<br/>度阶段。" }
  class n20 node_contract
  class n20 external_node
  n7 e0@-->|"状态请求"| n3
  class e0 edge_write
  n4 e1@-->|"Recover"| n8
  class e1 edge_membership
  n4 e2@-->|"Facing"| n9
  class e2 edge_membership
  n4 e3@-->|"Motion"| n10
  class e3 edge_membership
  n4 e4@-->|"Interaction"| n11
  class e4 edge_membership
  n4 e5@-->|"Target"| n12
  class e5 edge_membership
  n4 e6@-->|"Attachment"| n13
  class e6 edge_membership
  n5 e7@-->|"Facing"| n14
  class e7 edge_membership
  n5 e8@-->|"HeldPhysics"| n15
  class e8 edge_membership
  n5 e9@-->|"HeldPresentation"| n16
  class e9 edge_membership
  n5 e10@-->|"Camera"| n17
  class e10 edge_membership
  n5 e11@-->|"Visibility"| n18
  class e11 edge_membership
  n6 e12@-->|"UI Style"| n19
  class e12 edge_constraint
  n6 e13@-->|"Audio Mix / Playback"| n20
  class e13 edge_constraint
  end
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
  e8@{ curve: basis }
  e10@{ curve: basis }
  e11@{ curve: basis }
  e12@{ curve: basis }
  e13@{ curve: basis }
