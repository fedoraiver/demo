---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-19fb829e678c883e-e7{marker-start:url(#component-19fb829e678c883e_flowchart-v2-pointStart)!important}\n#component-19fb829e678c883e-e12{marker-start:url(#component-19fb829e678c883e_flowchart-v2-pointStart)!important}\n#component-19fb829e678c883e-e13{marker-start:url(#component-19fb829e678c883e_flowchart-v2-pointStart)!important}\n#component-19fb829e678c883e-e14{marker-start:url(#component-19fb829e678c883e_flowchart-v2-pointStart)!important}\n#component-19fb829e678c883e_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: Visibility · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n0 node_entity
  class n0 external_node
  end
  style layout_card_n0 fill:none,stroke:none
  subgraph layout_card_n1[" "]
  n1@{ shape: rounded, label: "**可搬物品业务根实体**<br/>来自场景装配 ↗：承载可拾取物品身份及自<br/>由运动、共享持握状态。" }
  class n1 node_entity
  class n1 external_node
  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: rounded, label: "**业务直属 GLB 视觉根实体**<br/>来自场景装配 ↗：承载业务实体的模型、骨<br/>骼与动画子树。" }
  class n2 node_entity
  class n2 external_node
  end
  style layout_card_n2 fill:none,stroke:none
  subgraph layout_card_n3[" "]
  n3@{ shape: rounded, label: "**GLB 网格与骨骼节点**<br/>承载导入模型的网格、骨骼与局部动画姿态。" }
  class n3 node_entity
  end
  style layout_card_n3 fill:none,stroke:none
  subgraph layout_card_n4[" "]
  n4@{ shape: rounded, label: "**主菜单展示舞台根**<br/>来自菜单与界面 ↗：承载主菜单的独立海岛<br/>展示场景。" }
  class n4 node_entity
  class n4 external_node
  end
  style layout_card_n4 fill:none,stroke:none
  subgraph layout_card_n5[" "]
  n5@{ shape: rounded, label: "**设置滚动条轨道**<br/>来自菜单与界面 ↗：为设置内容视口提供可<br/>交互滚动轨道。" }
  class n5 node_entity
  class n5 external_node
  end
  style layout_card_n5 fill:none,stroke:none
  subgraph layout_card_n6[" "]
  n6@{ shape: rounded, label: "**Visibility**<br/>控制实体及视觉子树的显示状态。" }
  class n6 node_component
  end
  style layout_card_n6 fill:none,stroke:none
  subgraph layout_card_n7[" "]
  n7@{ shape: rounded, label: "**sync_character_visibility**<br/>来自第一人称控制 ↗：隐藏第一人称控制角<br/>色的自身模型。" }
  class n7 node_system
  class n7 external_node
  end
  style layout_card_n7 fill:none,stroke:none
  subgraph layout_card_n8[" "]
  n8@{ shape: rounded, label: "**spawn_actors**<br/>来自场景装配 ↗：装配玩家、可搬物、控制<br/>者与相机。" }
  class n8 node_system
  class n8 external_node
  end
  style layout_card_n8 fill:none,stroke:none
  subgraph layout_card_n9[" "]
  n9@{ shape: rounded, label: "**rebuild_page**<br/>来自菜单与界面 ↗：按页面结构变化重建菜<br/>单界面。" }
  class n9 node_system
  class n9 external_node
  end
  style layout_card_n9 fill:none,stroke:none
  subgraph layout_card_n10[" "]
  n10@{ shape: rounded, label: "**spawn_backdrop**<br/>来自菜单与界面 ↗：装配主菜单海岛展示舞<br/>台、相机与日光。" }
  class n10 node_system
  class n10 external_node
  end
  style layout_card_n10 fill:none,stroke:none
  subgraph layout_card_n11[" "]
  n11@{ shape: rounded, label: "**sync_settings_scrollbars**<br/>来自菜单与界面 ↗：同步滚动条显隐、拾取<br/>范围与高亮。" }
  class n11 node_system
  class n11 external_node
  end
  style layout_card_n11 fill:none,stroke:none
  subgraph layout_card_n12[" "]
  n12@{ shape: stadium, label: "**RenderApp 渲染流程**<br/>提取场景数据并执行本帧渲染。" }
  class n12 node_engine_flow
  end
  style layout_card_n12 fill:none,stroke:none
  subgraph layout_card_n13[" "]
  n13@{ shape: rounded, label: "**world_inspector_ui**<br/>来自Egui / Inspector ↗：展示并编辑开<br/>放反射的实体、资源与资产。" }
  class n13 node_system
  class n13 external_node
  end
  style layout_card_n13 fill:none,stroke:none
  n6 layout_0@~~~ n0
  n6 layout_1@~~~ n1
  n6 layout_2@~~~ n2
  n6 layout_3@~~~ n3
  n6 layout_4@~~~ n4
  n6 layout_5@~~~ n5
  n7 layout_6@~~~ n6
  n8 layout_7@~~~ n6
  n9 layout_8@~~~ n6
  n10 layout_9@~~~ n6
  n11 layout_10@~~~ n6
  n12 layout_11@~~~ n6
  n13 layout_12@~~~ n6
  n7 e6@-->|"字段赋值"| n6
  class e6 edge_write
  n8 e8@-->|"添加"| n6
  class e8 edge_write
  n9 e9@-->|"添加"| n6
  class e9 edge_write
  n10 e10@-->|"添加"| n6
  class e10 edge_write
  n11 e11@-->|"字段赋值"| n6
  class e11 edge_write
  n13 e15@-->|"结构变更（待核实）"| n6
  class e15 edge_write
  n6 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n6 e1@-->|"可能挂载于"| n1
  class e1 edge_reference
  n6 e2@-->|"可能挂载于"| n2
  class e2 edge_reference
  n6 e3@-->|"可能挂载于"| n3
  class e3 edge_reference
  n6 e4@-->|"可能挂载于"| n4
  class e4 edge_reference
  n6 e5@-->|"可能挂载于"| n5
  class e5 edge_reference
  n7 e7@---|"查询访问"| n6
  class e7 edge_read
  n11 e12@---|"查询访问"| n6
  class e12 edge_read
  n12 e13@---|"查询访问"| n6
  class e13 edge_read
  n13 e14@---|"查询访问"| n6
  class e14 edge_read
