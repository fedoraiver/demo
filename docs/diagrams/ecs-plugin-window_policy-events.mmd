---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: 窗口策略 · 事件与协作
  accDescr: 窗口策略的事件与协作；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_non_send fill:#F8F3EF,stroke:#A5633A,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_external_io fill:#F1F3F4,stroke:#526A78,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  n0@{ shape: fr-rect, label: "**WindowPolicyPlugin**<br/>维护主窗口的原生比例与尺寸策略。" }
  class n0 node_plugin
  n1@{ shape: lean-l, label: "**原生窗口约束**<br/>在平台应用尺寸前约束主窗口比例与范围。" }
  class n1 node_external_io
  n2@{ shape: lean-l, label: "**OS 窗口事件 / API**<br/>接收原生窗口尺寸、缩放与工作区变化。" }
  class n2 node_external_io
  n3@{ shape: tag-rect, label: "**NativePolicies**<br/>持有原生窗口策略的线程专属守卫。" }
  class n3 node_non_send
  n4@{ shape: rounded, label: "**Window**<br/>来自Bevy 引擎 ↗：保存主窗口的尺寸与显<br/>示配置。" }
  class n4 node_component
  class n4 external_node
  n3 e0@-->|"安装 / 刷新 / Drop"| n1
  class e0 edge_reference
  n2 e1@-->|"原生约束"| n1
  class e1 edge_reference
  n1 e2@-->|"应用尺寸"| n4
  class e2 edge_write
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
