---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-aa8f46f96f7e4877-e1{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e2{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e4{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e5{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e6{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e7{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e8{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e9{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e10{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e11{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e12{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e13{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877-e14{marker-start:url(#component-aa8f46f96f7e4877_flowchart-v2-pointStart)!important}\n#component-aa8f46f96f7e4877_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
