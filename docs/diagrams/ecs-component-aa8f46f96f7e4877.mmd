---
flowchart RL
  accTitle: MenuButton · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**可操作菜单按钮**<br/>承载可操作菜单动作、设置调整与连续导航。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**MenuButton**<br/>保存菜单动作及按钮的导航序号。" }
  class n1 node_component
  n2@{ shape: hex, label: "**primary_press**<br/>记录菜单按钮主键按压的指针身份。" }
  class n2 node_observer
  n3@{ shape: rounded, label: "**pointer_interaction**<br/>将真实鼠标交互转换为共享菜单请求。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**rebuild_page**<br/>按页面结构变化重建菜单界面。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**style_buttons**<br/>按当前输入来源更新按钮背景与焦点边框。" }
  class n5 node_system
  n6@{ shape: rounded, label: "**update_description**<br/>更新当前聚焦设置的说明标题与正文。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**scroll_focused_button**<br/>将当前聚焦设置按钮滚入可视范围。" }
  class n7 node_system
  n8@{ shape: hex, label: "**previous**<br/>循环选择上一个可操作菜单按钮。" }
  class n8 node_observer
  n9@{ shape: hex, label: "**next**<br/>循环选择下一个可操作菜单按钮。" }
  class n9 node_observer
  n10@{ shape: hex, label: "**left**<br/>向左调整当前聚焦的真实设置字段。" }
  class n10 node_observer
  n11@{ shape: hex, label: "**right**<br/>向右调整当前聚焦的真实设置字段。" }
  class n11 node_observer
  n12@{ shape: hex, label: "**confirm**<br/>执行当前聚焦按钮的菜单动作。" }
  class n12 node_observer
  n13@{ shape: rounded, label: "**sample_slider_pointer**<br/>从光标位置生成音量采样与释放请求。" }
  class n13 node_system
  n14@{ shape: hex, label: "**clear_primary_press**<br/>原生 Pressed 移除时清理菜单主键来源。" }
  class n14 node_observer
