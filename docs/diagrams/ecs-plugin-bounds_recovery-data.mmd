---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 越界恢复 · 数据与实体
  accDescr: 越界恢复的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef external_node stroke-dasharray:6 4
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>承载角色身份、运动意图与动态物理身体。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**可搬物品业务根实体**<br/>承载可拾取物品身份及自由运动、共享持握状<br/>态。" }
  class n1 node_entity
  n0 layout_0@~~~ n1
  end
  style column_0 fill:none,stroke:none
  end
