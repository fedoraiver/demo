---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 场景装配 · 数据与实体
  accDescr: 场景装配的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n11@{ shape: rect, label: "**角色业务根实体**        ​<br/>承载角色身份、运动意图与动态物        ​<br/>理身体。        ​" }
  class n11 node_entity
  n12@{ shape: rect, label: "**可搬物品业务根实体**        ​<br/>承载可拾取物品身份及自由运动、        ​<br/>共享持握状态。        ​" }
  class n12 node_entity
  n14@{ shape: rect, label: "**业务直属 GLB 视觉根实体**        ​<br/>承载业务实体的模型、骨骼与动画        ​<br/>子树。        ​" }
  class n14 node_entity
  n14 e0@-->|"ChildOf"| n11
  class e0 edge_relationship
  n14 e1@-->|"ChildOf"| n12
  class e1 edge_relationship
  end
  style relation_0 fill:none,stroke:none
  subgraph relation_1[" "]
  direction TB
  n15@{ shape: rect, label: "**海岛静态碰撞实体**        ​<br/>为海岛结构、入口坡道与展示人物        ​<br/>提供静态碰撞。        ​" }
  class n15 node_entity
  n16@{ shape: rect, label: "**海岛实例根**        ​<br/>承载海岛实例并记录碰撞与业务生        ​<br/>成进度。        ​" }
  class n16 node_entity
  n17@{ shape: rect, label: "**地图展示 NPC**        ​<br/>保留地图展示人物及其静态身体碰        ​<br/>撞。        ​" }
  class n17 node_entity
  n18@{ shape: rect, label: "**GLB 网格与骨骼节点**        ​<br/>来自Bevy 引擎 ↗：承载导入模型        ​<br/>的网格、骨骼与局部动画姿态。        ​" }
  class n18 node_entity
  class n18 external_node
  n15 e2@-->|"ChildOf（原地图美术实例）"| n18
  class e2 edge_relationship
  n15 e3@-->|"ChildOf（NPC 身体碰撞）"| n17
  class e3 edge_relationship
  n17 e4@-->|"ChildOf（地图子树）"| n16
  class e4 edge_relationship
  end
  style relation_1 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: cyl, label: "**ArtAssets**<br/>保存运行模型资源并维持其加载寿命。" }
  class n0 node_resource
  n1@{ shape: cyl, label: "**ArtLoadState**<br/>保存运行资源的加载进度与就绪结果。" }
  class n1 node_resource
  subgraph n10[" "]
  direction TB
  eh0@{ shape: text, label: "**键盘控制者**        ​<br/>保存玩家身份、输入上下文与受控        ​<br/>角色及相机。        ​" }
  n19@{ shape: rect, label: "**Name**<br/>来自Bevy 引擎 ↗：用于日志与调试的控制<br/>者名称。" }
  class n19 node_component
  class n19 external_node
  n20@{ shape: rect, label: "**PlayerId**<br/>来自第一人称控制 ↗：独立于运行时<br/>Entity 的业务身份。" }
  class n20 node_component
  class n20 external_node
  n21@{ shape: rect, label: "**GameplayContext**<br/>来自第一人称控制 ↗：标记用于玩法动作的<br/>控制上下文。" }
  class n21 node_component
  class n21 external_node
  n22@{ shape: rect, label: "**GamepadDevice**<br/>来自Enhanced Input ↗：配置玩法上下文<br/>的手柄输入来源。" }
  class n22 node_component
  class n22 external_node
  n23@{ shape: rect, label: "**ControlsCharacter**<br/>来自第一人称控制 ↗：普通实体引用，指向<br/>受控角色。" }
  class n23 node_component
  class n23 external_node
  eh0 layout_0@~~~ n19
  n19 layout_1@~~~ n20
  n20 layout_2@~~~ n21
  n21 layout_3@~~~ n22
  n22 layout_4@~~~ n23
  n24@{ shape: rect, label: "**ControlsCamera**<br/>来自第一人称控制 ↗：普通实体引用，指向<br/>受控相机。" }
  class n24 node_component
  class n24 external_node
  n25@{ shape: rect, label: "**Actions#lt;GameplayContext#gt;**<br/>来自Enhanced Input ↗：索引控制上下文<br/>拥有的动作实体。" }
  class n25 node_component
  class n25 external_node
  n26@{ shape: rect, label: "**ContextPriority#lt;GameplayContext#gt;**<br/>来自Enhanced Input ↗：配置动作上下文<br/>的输入评估优先级。" }
  class n26 node_component
  class n26 external_node
  n27@{ shape: rect, label: "**ContextActivity#lt;GameplayContext#gt;**<br/>来自Enhanced Input ↗：保存动作上下文<br/>的启用状态。" }
  class n27 node_component
  class n27 external_node
  n28@{ shape: rect, label: "**DespawnOnExit**<br/>来自Bevy 引擎 ↗：标记退出游戏会话时清<br/>理控制者。" }
  class n28 node_component
  class n28 external_node
  eh0 layout_5@~~~ n24
  n24 layout_6@~~~ n25
  n25 layout_7@~~~ n26
  n26 layout_8@~~~ n27
  n27 layout_9@~~~ n28
  end
  class n10 node_entity
  style n10 fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  n13@{ shape: rect, label: "**第一人称相机实体**        ​<br/>提供跟随角色的第一人称视角与观        ​<br/>察输入状态。        ​" }
  class n13 node_entity
  n0 layout_10@~~~ n1
  n1 layout_11@~~~ n10
  n10 layout_12@~~~ n13
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
