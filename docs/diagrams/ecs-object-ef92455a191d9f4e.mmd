---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: 组件移除与实体销毁流程 · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_emit stroke:#B66B2D,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: stadium, label: "**组件移除与实体销毁流程**<br/>在实际移除或销毁时发出匹配的生命周期事<br/>件。" }
  class n0 node_engine_flow
  n1@{ shape: stadium, label: "**DespawnEvent**<br/>通知人物销毁前执行持物生命周期清理。" }
  class n1 node_event
  n2@{ shape: stadium, label: "**RemoveEvent**<br/>正移除 Pressed 且仍具有 MenuButton 的<br/>实体" }
  class n2 node_event
  n3@{ shape: stadium, label: "**RemoveEvent**<br/>通知 GameplayContext 的动作关系正在移<br/>除。" }
  class n3 node_event
  n0 e0@-->|"Despawn#lt;Character#gt; 生命周期"| n1
  class e0 edge_emit
  n0 e1@-->|"Remove#lt;Pressed#gt; 生命周期"| n2
  class e1 edge_emit
  n0 e2@-->|"Remove#lt;ActionOf#lt;GameplayContext#gt;#gt; 生<br/>命周期"| n3
  class e2 edge_emit
  e0@{ curve: basis }
  e2@{ curve: basis }
