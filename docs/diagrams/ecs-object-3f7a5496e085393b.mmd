---
flowchart LR
  accTitle: TransformEasingSystems::Ease · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**TransformEasingSystems::Ease**<br/>混合固定步端点以生成平滑显示姿态。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: rounded, label: "**TranslationEasingState**<br/>保存固定步平移插值的起止端点。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**TranslationEasingState**<br/>保存固定步平移插值的起止端点。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**RotationEasingState**<br/>保存旋转显示插值的起止端点。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**ScaleEasingState**<br/>保存缩放显示插值的起止端点。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n6 node_component
  class n6 external_node
  n7@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存自由运动或共享持<br/>握时的显示姿态。" }
  class n7 node_component
  class n7 external_node
  n8@{ shape: cyl, label: "**Time#lt;Fixed#gt;**<br/>来自Bevy 引擎 ↗：提供固定模拟的时间步<br/>长。" }
  class n8 node_resource
  class n8 external_node
  n9@{ shape: cyl, label: "**LastEasingTick**<br/>记录最近显示插值变更以识别外部瞬移。" }
  class n9 node_resource
  n0 e0@--> n1
  class e0 edge_order
  n2 e1@-->|"查询访问"| n0
  class e1 edge_read
  n3 e2@-->|"查询访问"| n0
  class e2 edge_read
  n4 e3@-->|"查询访问"| n0
  class e3 edge_read
  n5 e4@-->|"查询访问"| n0
  class e4 edge_read
  n0 e5@-->|"可变访问"| n6
  class e5 edge_write
  n0 e6@-->|"可变访问"| n7
  class e6 edge_write
  n8 e7@-->|"访问声明"| n0
  class e7 edge_read
  n9 e8@-->|"访问声明"| n0
  class e8 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
