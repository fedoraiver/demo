---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 第一人称控制 · 数据与实体
  accDescr: 第一人称控制的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_local fill:#F8F5F1,stroke:#AA8752,stroke-width:1.6px,color:#1F3340
  classDef node_note fill:#F7F7F5,stroke:#9A9B88,stroke-width:1.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n10@{ shape: rect, label: "**键盘控制者**        ​<br/>保存玩家身份、输入上下文与受控        ​<br/>角色及相机。        ​" }
  class n10 node_entity
  n11@{ shape: rect, label: "**第一人称相机实体**        ​<br/>提供跟随角色的第一人称视角与观        ​<br/>察输入状态。        ​" }
  class n11 node_entity
  n13@{ shape: rect, label: "**动作实体**        ​<br/>保存玩法或调试动作的评估结果与        ​<br/>触发状态。        ​" }
  class n13 node_entity
  n14@{ shape: rect, label: "**绑定实体**        ​<br/>将键盘或鼠标输入映射到玩法动        ​<br/>作。        ​" }
  class n14 node_entity
  n15@{ shape: hex, label: "**on_camera_look**<br/>将观察输入转为第一人称水平角与俯仰角。" }
  class n15 node_observer
  n16@{ shape: rounded, label: "**sync_character_facing**<br/>同步人物朝向并处理持物转向受阻。" }
  class n16 node_system
  n17@{ shape: rect, label: "**角色业务根实体**        ​<br/>来自场景装配 ↗：承载角色身        ​<br/>份、运动意图与动态物理身体。        ​" }
  class n17 node_entity
  class n17 external_node
  n15 e0@-->|"观察角度"| n11
  class e0 edge_write
  n11 e1@-->|"角度"| n16
  class e1 edge_read
  n10 e2@-->|"ControlsCharacter"| n17
  class e2 edge_reference
  n10 e3@-->|"ControlsCamera"| n11
  class e3 edge_reference
  n11 e4@-->|"FirstPersonCamera.target"| n17
  class e4 edge_reference
  n13 e5@-->|"ActionOf#lt;GameplayContext#gt;"| n10
  class e5 edge_relationship
  n14 e6@-->|"BindingOf"| n13
  class e6 edge_relationship
  end
  style relation_0 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: notch-rect, label: "**Local#lt;f64#gt;（next_log_at）**<br/>保存连续观察角度日志的下次采样时间。" }
  class n0 node_local
  subgraph n12[" "]
  direction TB
  eh3@{ shape: text, label: "**业务直属 GLB 视觉根实体**        ​<br/>承载业务实体的模型、骨骼与动画        ​<br/>子树。        ​" }
  n75@{ shape: rect, label: "**Name**<br/>来自Bevy 引擎 ↗：各视觉部分的调试名<br/>称。" }
  class n75 node_component
  class n75 external_node
  n76@{ shape: rect, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存模型相对业务根的<br/>局部显示姿态。" }
  class n76 node_component
  class n76 external_node
  n77@{ shape: rect, label: "**GlobalTransform**<br/>来自Bevy 引擎 ↗：保存层级传播后的世界<br/>姿态。" }
  class n77 node_component
  class n77 external_node
  n78@{ shape: rect, label: "**ChildOf**<br/>来自Bevy 引擎 ↗：关联父实体并跟随父级<br/>生命周期。" }
  class n78 node_component
  class n78 external_node
  n79@{ shape: rect, label: "**Visibility**<br/>来自Bevy 引擎 ↗：控制实体及视觉子树的<br/>显示状态。" }
  class n79 node_component
  class n79 external_node
  n7@{ shape: rect, label: "**CharacterVisual**<br/>标记随第一人称视角隐藏的角色模型。" }
  class n7 node_component
  eh3 layout_0@~~~ n75
  n75 layout_1@~~~ n76
  n76 layout_2@~~~ n77
  n77 layout_3@~~~ n78
  n78 layout_4@~~~ n79
  n79 layout_5@~~~ n7
  n80@{ shape: rect, label: "**CourierVisual**<br/>来自角色动画 ↗：保存主角模型来源并作为<br/>动画绑定入口。" }
  class n80 node_component
  class n80 external_node
  n81@{ shape: rect, label: "**CourierAnimationPending**<br/>来自角色动画 ↗：实例就绪后等待命名动画<br/>绑定。" }
  class n81 node_component
  class n81 external_node
  n82@{ shape: rect, label: "**CourierFootGrounding**<br/>来自角色动画 ↗：保存鞋底高度补偿与骨链<br/>引用。" }
  class n82 node_component
  class n82 external_node
  n83@{ shape: rect, label: "**WorldAssetRoot**<br/>来自Bevy 引擎 ↗：主角和物品模板的实例<br/>化入口。" }
  class n83 node_component
  class n83 external_node
  n84@{ shape: rect, label: "**Children**<br/>来自Bevy 引擎 ↗：索引当前实体的直接子<br/>实体。" }
  class n84 node_component
  class n84 external_node
  eh3 layout_6@~~~ n80
  n80 layout_7@~~~ n81
  n81 layout_8@~~~ n82
  n82 layout_9@~~~ n83
  n83 layout_10@~~~ n84
  end
  class n12 node_entity
  style n12 fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  n8@{ shape: doc, label: "**第一人称模型生命周期**<br/>保持受控角色自身模型隐藏并恢复失效关联。" }
  class n8 node_note
  n9@{ shape: rect, label: "**捕获与输入上下文**<br/>保存光标捕获与玩法输入启用状态。" }
  class n9 node_component
  n0 layout_11@~~~ n12
  n12 layout_12@~~~ n8
  n8 layout_13@~~~ n9
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
