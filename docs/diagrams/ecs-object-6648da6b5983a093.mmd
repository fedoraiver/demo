  class n21 node_component
  class n21 external_node
  n22@{ shape: rounded, label: "**Restitution**<br/>来自Avian ↗：保持原反弹配置。" }
  class n22 node_component
  class n22 external_node
  n23@{ shape: rounded, label: "**RigidBodyColliders**<br/>来自Avian ↗：索引属于同一刚体的全部碰<br/>撞体。" }
  class n23 node_component
