---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: Egui / Inspector · 数据与实体
  accDescr: Egui / Inspector的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef external_node stroke-dasharray:6 4
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: cyl, label: "**EguiGlobalSettings**<br/>配置检查器界面的上下文与输入处理。" }
  class n0 node_resource
  n1@{ shape: cyl, label: "**EnableMultipassForPrimaryContext**<br/>启用主检查器上下文的多轮界面计算。" }
  class n1 node_resource
  n9@{ shape: rect, label: "**第一人称相机实体**        ​<br/>来自场景装配 ↗：提供跟随角色        ​<br/>的第一人称视角与观察输入状态。        ​" }
  class n9 node_entity
  class n9 external_node
  n19@{ shape: rect, label: "**主菜单展示相机**        ​<br/>来自菜单与界面 ↗：为主菜单展        ​<br/>示场景与界面提供相机。        ​" }
  class n19 node_entity
  class n19 external_node
  n0 layout_0@~~~ n1
  n1 layout_1@~~~ n9
  n9 layout_2@~~~ n19
  end
  style column_0 fill:none,stroke:none
  end
