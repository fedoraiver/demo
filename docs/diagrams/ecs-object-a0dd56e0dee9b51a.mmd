---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-a0dd56e0dee9b51a-e1{marker-start:url(#object-a0dd56e0dee9b51a_flowchart-v2-pointStart)!important}\n#object-a0dd56e0dee9b51a_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: 持物无视觉碰撞代理 · 对象关系
  accDescr: 中心实体与直接关联的非组件对象；组件清单在右侧查看，保留原关系方向及身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**持物无视觉碰撞代理**<br/>为持物共享人物刚体提供无视觉碰撞形状。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**可搬物品业务根实体**<br/>来自场景装配 ↗：承载可拾取物品身份及自<br/>由运动、共享持握状态。" }
  class n1 node_entity
  class n1 external_node
  n2@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n2 node_entity
  class n2 external_node
  n3@{ shape: fr-rect, label: "**ItemInteractionPlugin**<br/>管理物品拾取、共享持握、安全释放与反馈。" }
  class n3 node_plugin
  n1 e0@-->|"HeldAttachment.collider"| n0
  class e0 edge_reference
  n1 e1@---|"HeldCollider.0"| n0
  class e1 edge_reference
  n0 e2@-->|"ColliderOf"| n2
  class e2 edge_relationship
  n3 e3@-->|"装配归属"| n0
  class e3 edge_reference
  e0@{ curve: basis }
  e1@{ curve: basis }
  e3@{ curve: basis }
