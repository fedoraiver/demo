---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-f83fb8afe4e216e4-e1{marker-start:url(#component-f83fb8afe4e216e4_flowchart-v2-pointStart)!important}\n#component-f83fb8afe4e216e4-e2{marker-start:url(#component-f83fb8afe4e216e4_flowchart-v2-pointStart)!important}\n#component-f83fb8afe4e216e4_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: Mesh3d · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**GLB 网格与骨骼节点**<br/>承载导入模型的网格、骨骼与局部动画姿态。" }
  class n0 node_entity
  n1@{ shape: rounded, label: "**Mesh3d**<br/>关联实体使用的三维网格资产。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**prepare_island**<br/>来自场景装配 ↗：从海岛模型构建静态碰<br/>撞、坡道与人物碰撞。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: stadium, label: "**RenderApp 渲染流程**<br/>提取场景数据并执行本帧渲染。" }
  class n3 node_engine_flow
  n1 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n1
  n1 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n2 e1@---|"查询访问"| n1
  class e1 edge_read
  n3 e2@---|"查询访问"| n1
  class e2 edge_read
  e0@{ curve: basis }
  e1@{ curve: bumpX }
  e2@{ curve: basis }
