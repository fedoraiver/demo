---
flowchart LR
  accTitle: release_pointer_for_inspector · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: hex, label: "**release_pointer_for_inspector**<br/>释放光标以允许操作世界检查器。" }
  class n0 node_observer
  n1@{ shape: stadium, label: "**Fire#lt;ReleasePointerAction#gt;**<br/>通知控制者释放光标以操作检查器。" }
  class n1 node_event
  n2@{ shape: rounded, label: "**ControlsCamera**<br/>普通实体引用，指向受控相机。" }
  class n2 node_component
  n3@{ shape: rounded, label: "**MouseLookState**<br/>保存光标捕获与观察输入初始化状态。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**Window**<br/>来自Bevy 引擎 ↗：保存主窗口的尺寸与显<br/>示配置。" }
  class n4 node_component
  class n4 external_node
  n5@{ shape: rounded, label: "**CursorOptions**<br/>来自Bevy 引擎 ↗：配置光标可见性与抓取<br/>模式。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: fr-rect, label: "**FirstPersonPlugin**<br/>管理玩法动作、光标捕获、朝向与第一人称镜<br/>头。" }
  class n6 node_plugin
  n1 e0@-->|"Fire#lt;ReleasePointerAction#gt;"| n0
  class e0 edge_observe
  n2 e1@-->|"查询访问"| n0
  class e1 edge_read
  n0 e2@-->|"可变访问"| n3
  class e2 edge_write
  n4 e3@-->|"查询访问"| n0
  class e3 edge_read
  n0 e4@-->|"可变访问"| n5
  class e4 edge_write
  n6 e5@--> n0
  class e5 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
