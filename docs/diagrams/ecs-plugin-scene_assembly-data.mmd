---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 场景装配 · 数据与实体
  accDescr: 场景装配的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n3@{ shape: rounded, label: "**角色业务根实体**<br/>承载角色身份、运动意图与动态物理身体。" }
  class n3 node_entity
  n4@{ shape: rounded, label: "**可搬物品业务根实体**<br/>承载可拾取物品身份及自由运动、共享持握状<br/>态。" }
  class n4 node_entity
  n6@{ shape: rounded, label: "**业务直属 GLB 视觉根实体**<br/>承载业务实体的模型、骨骼与动画子树。" }
  class n6 node_entity
  n6 e0@-->|"ChildOf"| n3
  class e0 edge_relationship
  n6 e1@-->|"ChildOf"| n4
  class e1 edge_relationship
  end
  style relation_0 fill:none,stroke:none
  subgraph relation_1[" "]
  direction TB
  n7@{ shape: rounded, label: "**海岛静态碰撞实体**<br/>为海岛结构、入口坡道与展示人物提供静态碰<br/>撞。" }
  class n7 node_entity
  n8@{ shape: rounded, label: "**海岛实例根**<br/>承载海岛实例并记录碰撞与业务生成进度。" }
  class n8 node_entity
  n9@{ shape: rounded, label: "**地图展示 NPC**<br/>保留地图展示人物及其静态身体碰撞。" }
  class n9 node_entity
  n10@{ shape: rounded, label: "**GLB 网格与骨骼节点**<br/>来自Bevy 引擎 ↗：承载导入模型的网格、<br/>骨骼与局部动画姿态。" }
  class n10 node_entity
  class n10 external_node
  n7 e2@-->|"ChildOf（原地图美术实例）"| n10
  class e2 edge_relationship
  n7 e3@-->|"ChildOf（NPC 身体碰撞）"| n9
  class e3 edge_relationship
  n9 e4@-->|"ChildOf（地图子树）"| n8
  class e4 edge_relationship
  end
  style relation_1 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: cyl, label: "**ArtAssets**<br/>保存运行模型资源并维持其加载寿命。" }
  class n0 node_resource
  n1@{ shape: cyl, label: "**ArtLoadState**<br/>保存运行资源的加载进度与就绪结果。" }
  class n1 node_resource
  n2@{ shape: rounded, label: "**键盘控制者**<br/>保存玩家身份、输入上下文与受控角色及相<br/>机。" }
  class n2 node_entity
  n5@{ shape: rounded, label: "**第一人称相机实体**<br/>提供跟随角色的第一人称视角与观察输入状<br/>态。" }
  class n5 node_entity
  n0 layout_0@~~~ n1
  n1 layout_1@~~~ n2
  n2 layout_2@~~~ n5
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
