---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-06c732d6a7cdce91-e5{marker-start:url(#component-06c732d6a7cdce91_flowchart-v2-pointStart)!important}\n#component-06c732d6a7cdce91_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: Text · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**菜单文字叶节点**<br/>来自菜单与界面 ↗：显示菜单标题、按钮、<br/>按键提示与正文。" }
  class n0 node_entity
  class n0 external_node
  end
  style layout_card_n0 fill:none,stroke:none
  subgraph layout_card_n1[" "]
  n1@{ shape: rounded, label: "**Text**<br/>保存界面实际显示的文字。" }
  class n1 node_component
  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: rounded, label: "**rebuild_page**<br/>来自菜单与界面 ↗：按页面结构变化重建菜<br/>单界面。" }
  class n2 node_system
  class n2 external_node
  end
  style layout_card_n2 fill:none,stroke:none
  subgraph layout_card_n3[" "]
  n3@{ shape: rounded, label: "**update_description**<br/>来自菜单与界面 ↗：更新当前聚焦设置的说<br/>明标题与正文。" }
  class n3 node_system
  class n3 external_node
  end
  style layout_card_n3 fill:none,stroke:none
  subgraph layout_card_n4[" "]
  n4@{ shape: rounded, label: "**update_volume_visuals**<br/>来自菜单与界面 ↗：原位更新音量百分比文<br/>字与轨道填充。" }
  class n4 node_system
  class n4 external_node
  end
  style layout_card_n4 fill:none,stroke:none
  subgraph layout_card_n5[" "]
  n5@{ shape: rounded, label: "**update_settings_text**<br/>来自菜单与界面 ↗：原位更新设置草稿数值<br/>与保存提示。" }
  class n5 node_system
  class n5 external_node
  end
  style layout_card_n5 fill:none,stroke:none
  n1 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n1
  n4 layout_3@~~~ n1
  n5 layout_4@~~~ n1
  n2 e1@-->|"添加"| n1
  class e1 edge_write
  n3 e2@-->|"字段赋值"| n1
  class e2 edge_write
  n4 e3@-->|"字段赋值"| n1
  class e3 edge_write
  n5 e4@-->|"字段赋值"| n1
  class e4 edge_write
  n1 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n5 e5@---|"查询访问"| n1
  class e5 edge_read
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
