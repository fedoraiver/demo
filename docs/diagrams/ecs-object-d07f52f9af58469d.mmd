---
flowchart LR
  accTitle: TransformEasingSystems::UpdateEnd · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: lin-rect, label: "**TransformEasingSystems::UpdateEnd**<br/>记录固定步结束位置供显示插值。" }
  class n0 node_system_set
  n1@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存角色经插值生成的<br/>显示姿态。" }
  class n1 node_component
  class n1 external_node
  n2@{ shape: rounded, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存自由运动或共享持<br/>握时的显示姿态。" }
  class n2 node_component
  class n2 external_node
  n3@{ shape: rounded, label: "**TranslationEasingState**<br/>保存固定步平移插值的起止端点。" }
  class n3 node_component
  n4@{ shape: rounded, label: "**TranslationEasingState**<br/>保存固定步平移插值的起止端点。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**RotationEasingState**<br/>保存旋转显示插值的起止端点。" }
  class n5 node_component
  n6@{ shape: rounded, label: "**ScaleEasingState**<br/>保存缩放显示插值的起止端点。" }
  class n6 node_component
  n1 e0@-->|"查询访问"| n0
  class e0 edge_read
  n2 e1@-->|"查询访问"| n0
  class e1 edge_read
  n0 e2@-->|"可变访问"| n3
  class e2 edge_write
  n0 e3@-->|"可变访问"| n4
  class e3 edge_write
  n0 e4@-->|"可变访问"| n5
  class e4 edge_write
  n0 e5@-->|"可变访问"| n6
  class e5 edge_write
  e0@{ curve: basis }
