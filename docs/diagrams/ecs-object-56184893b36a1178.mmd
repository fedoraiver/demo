---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-56184893b36a1178-e2{marker-start:url(#object-56184893b36a1178_flowchart-v2-pointStart)!important}\n#object-56184893b36a1178-e4{marker-start:url(#object-56184893b36a1178_flowchart-v2-pointStart)!important}\n#object-56184893b36a1178-e8{marker-start:url(#object-56184893b36a1178_flowchart-v2-pointStart)!important}\n#object-56184893b36a1178-e11{marker-start:url(#object-56184893b36a1178_flowchart-v2-pointStart)!important}\n#object-56184893b36a1178-e13{marker-start:url(#object-56184893b36a1178_flowchart-v2-pointStart)!important}\n#object-56184893b36a1178-e16{marker-start:url(#object-56184893b36a1178_flowchart-v2-pointStart)!important}\n#object-56184893b36a1178-e18{marker-start:url(#object-56184893b36a1178_flowchart-v2-pointStart)!important}\n#object-56184893b36a1178_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
