---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-20ba703f6ebfdfd8-e2{marker-start:url(#object-20ba703f6ebfdfd8_flowchart-v2-pointStart)!important}\n#object-20ba703f6ebfdfd8_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: CourierAnimationPending · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**CourierAnimationPending**<br/>实例就绪后等待命名动画绑定。" }
  class n0 node_component
  n1@{ shape: rounded, label: "**业务直属 GLB 视觉根实体**<br/>来自场景装配 ↗：承载业务实体的模型、骨<br/>骼与动画子树。" }
  class n1 node_entity
  class n1 external_node
  n2@{ shape: hex, label: "**mark_courier_animation_ready**<br/>标记主角视觉根以进入动画绑定。" }
  class n2 node_observer
  n3@{ shape: rounded, label: "**initialize_ready_couriers**<br/>绑定主角命名动画并缓存鞋底补偿节点。" }
  class n3 node_system
  n0 e0@-->|"可能挂载于"| n1
  class e0 edge_reference
  n2 e1@-->|"添加"| n0
  class e1 edge_write
  n3 e2@---|"存在 / 变更过滤"| n0
  class e2 edge_reference
  n3 e3@-->|"移除"| n0
  class e3 edge_write
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
