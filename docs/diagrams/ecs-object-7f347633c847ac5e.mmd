---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-7f347633c847ac5e-e3{marker-start:url(#object-7f347633c847ac5e_flowchart-v2-pointStart)!important}\n#object-7f347633c847ac5e_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: prepare_holder_despawn · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_event fill:#F9F3EE,stroke:#B66B2D,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_observe stroke:#B66B2D,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: hex, label: "**prepare_holder_despawn**<br/>在持有者销毁前停用并卸载持物代理。" }
  class n0 node_observer
  n1@{ shape: rounded, label: "**ColliderDisabled**<br/>来自Avian ↗：标记暂时停用的代理碰撞<br/>体。" }
  class n1 node_component
  class n1 external_node
  n2@{ shape: stadium, label: "**DespawnEvent**<br/>来自Bevy 引擎 ↗：通知人物销毁前执行持<br/>物生命周期清理。" }
  class n2 node_event
  class n2 external_node
  n3@{ shape: rounded, label: "**ColliderOf**<br/>来自Avian ↗：关联碰撞体所属的刚体。" }
  class n3 node_component
  class n3 external_node
  n4@{ shape: rounded, label: "**HeldCollider**<br/>关联代理所对应的真实物品。" }
  class n4 node_component
  n5@{ shape: rounded, label: "**RigidBodyColliders**<br/>来自Avian ↗：索引属于同一刚体的全部碰<br/>撞体。" }
  class n5 node_component
  class n5 external_node
  n6@{ shape: fr-rect, label: "**ItemInteractionPlugin**<br/>管理物品拾取、共享持握、安全释放与反馈。" }
  class n6 node_plugin
  n0 e0@-->|"添加"| n1
  class e0 edge_write
  n2 e1@-->|"Despawn#lt;Character#gt;"| n0
  class e1 edge_observe
  n3 e2@-->|"查询访问"| n0
  class e2 edge_read
  n3 e3@---|"移除"| n0
  class e3 edge_write
  n4 e4@-->|"存在 / 变更过滤"| n0
  class e4 edge_reference
  n0 e5@-->|"可变访问"| n5
  class e5 edge_write
  n6 e6@--> n0
  class e6 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
