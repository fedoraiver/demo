  class e6 edge_read
  n0 e7@-->|"查询访问"| n8
  class e7 edge_read
  n0 e8@-->|"查询访问"| n9
  class e8 edge_read
  n10 e9@-->|"可变访问"| n0
  class e9 edge_write
  n10 e10@---|"查询访问"| n0
  class e10 edge_read
  n0 e11@-->|"查询访问"| n11
  class e11 edge_read
  n0 e12@-->|"查询访问"| n12
  class e12 edge_read
  n0 e13@-->|"查询访问"| n13
  class e13 edge_read
