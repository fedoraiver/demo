---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#object-134fe9172a5a5bc1-e10{marker-start:url(#object-134fe9172a5a5bc1_flowchart-v2-pointStart)!important}\n#object-134fe9172a5a5bc1_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart LR
  accTitle: Window · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_observer fill:#F4F1F9,stroke:#7B4DB2,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_platform_api fill:#F6F3F1,stroke:#8A6555,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**Window**<br/>保存主窗口的尺寸与显示配置。" }
  class n0 node_component
  n1@{ shape: lean-l, label: "**原生窗口约束**<br/>来自窗口策略 ↗：在平台应用尺寸前约束主<br/>窗口比例与范围。" }
  class n1 node_platform_api
  class n1 external_node
  n2@{ shape: rounded, label: "**主窗口实体**<br/>承载应用主窗口及原生尺寸策略。" }
  class n2 node_entity
  n3@{ shape: rounded, label: "**sync_mouse_capture**<br/>来自第一人称控制 ↗：管理光标捕获及玩法<br/>输入启停。" }
  class n3 node_system
  class n3 external_node
  n4@{ shape: rounded, label: "**filter_captured_egui_input**<br/>来自第一人称控制 ↗：隔离游戏操作与检查<br/>器界面输入。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**sync_context**<br/>来自菜单与界面 ↗：跟随窗口焦点启停菜单<br/>输入。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**pointer_interaction**<br/>来自菜单与界面 ↗：将真实鼠标交互转换为<br/>共享菜单请求。" }
  class n6 node_system
  class n6 external_node
  n7@{ shape: rounded, label: "**rebuild_page**<br/>来自菜单与界面 ↗：按页面结构变化重建菜<br/>单界面。" }
  class n7 node_system
  class n7 external_node
  n8@{ shape: hex, label: "**release_pointer_for_inspector**<br/>来自第一人称控制 ↗：释放光标以允许操作<br/>世界检查器。" }
  class n8 node_observer
  class n8 external_node
  n9@{ shape: rounded, label: "**sample_slider_pointer**<br/>来自菜单与界面 ↗：从光标位置生成音量采<br/>样与释放请求。" }
  class n9 node_system
  class n9 external_node
  n10@{ shape: rounded, label: "**install_native_policy**<br/>来自窗口策略 ↗：安装并维护原生窗口比例<br/>与尺寸策略。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: rounded, label: "**clear_cancelled_primary_presses**<br/>来自菜单与界面 ↗：清理被取消、失焦或离<br/>窗的菜单主键按压。" }
  class n11 node_system
  class n11 external_node
  n12@{ shape: lin-rect, label: "**EguiPreUpdateSet::ProcessInput**<br/>来自Egui / Inspector ↗：将窗口和设备<br/>输入转换为检查器界面输入。" }
  class n12 node_system_set
  class n12 external_node
  n13@{ shape: rounded, label: "**dispatch_focused_**<br/>**input#lt;KeyboardInput#gt;**<br/>将键盘消息转为焦点实体上的键盘事件。" }
  class n13 node_system
  n1 e0@-->|"应用尺寸"| n0
  class e0 edge_write
  n0 e1@-->|"可能挂载于"| n2
  class e1 edge_reference
