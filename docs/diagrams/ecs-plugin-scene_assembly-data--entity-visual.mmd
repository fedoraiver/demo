---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 8,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 场景装配 · 数据与实体
  accDescr: 场景装配的数据与实体；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef edge_relationship stroke:#7B4DB2,stroke-width:1.8px
  classDef external_node stroke-dasharray:6 4
  subgraph relations["数据流与关系"]
  direction LR
  subgraph relation_0[" "]
  direction TB
  n11@{ shape: rect, label: "**角色业务根实体**        ​<br/>承载角色身份、运动意图与动态物        ​<br/>理身体。        ​" }
  class n11 node_entity
  n12@{ shape: rect, label: "**可搬物品业务根实体**        ​<br/>承载可拾取物品身份及自由运动、        ​<br/>共享持握状态。        ​" }
  class n12 node_entity
  subgraph n14[" "]
  direction TB
  eh4@{ shape: text, label: "**业务直属 GLB 视觉根实体**        ​<br/>承载业务实体的模型、骨骼与动画        ​<br/>子树。        ​" }
  n130@{ shape: rect, label: "**Name**<br/>来自Bevy 引擎 ↗：各视觉部分的调试名<br/>称。" }
  class n130 node_component
  class n130 external_node
  n131@{ shape: rect, label: "**Transform**<br/>来自Bevy 引擎 ↗：保存模型相对业务根的<br/>局部显示姿态。" }
  class n131 node_component
  class n131 external_node
  n132@{ shape: rect, label: "**GlobalTransform**<br/>来自Bevy 引擎 ↗：保存层级传播后的世界<br/>姿态。" }
  class n132 node_component
  class n132 external_node
  n133@{ shape: rect, label: "**ChildOf**<br/>来自Bevy 引擎 ↗：关联父实体并跟随父级<br/>生命周期。" }
  class n133 node_component
  class n133 external_node
  n134@{ shape: rect, label: "**Visibility**<br/>来自Bevy 引擎 ↗：控制实体及视觉子树的<br/>显示状态。" }
  class n134 node_component
  class n134 external_node
  n135@{ shape: rect, label: "**CharacterVisual**<br/>来自第一人称控制 ↗：标记随第一人称视角<br/>隐藏的角色模型。" }
  class n135 node_component
  class n135 external_node
  eh4 layout_0@~~~ n130
  n130 layout_1@~~~ n131
  n131 layout_2@~~~ n132
  n132 layout_3@~~~ n133
  n133 layout_4@~~~ n134
  n134 layout_5@~~~ n135
  n136@{ shape: rect, label: "**CourierVisual**<br/>来自角色动画 ↗：保存主角模型来源并作为<br/>动画绑定入口。" }
  class n136 node_component
  class n136 external_node
  n137@{ shape: rect, label: "**CourierAnimationPending**<br/>来自角色动画 ↗：实例就绪后等待命名动画<br/>绑定。" }
  class n137 node_component
  class n137 external_node
  n138@{ shape: rect, label: "**CourierFootGrounding**<br/>来自角色动画 ↗：保存鞋底高度补偿与骨链<br/>引用。" }
  class n138 node_component
  class n138 external_node
  n139@{ shape: rect, label: "**WorldAssetRoot**<br/>来自Bevy 引擎 ↗：主角和物品模板的实例<br/>化入口。" }
  class n139 node_component
  class n139 external_node
  n140@{ shape: rect, label: "**Children**<br/>来自Bevy 引擎 ↗：索引当前实体的直接子<br/>实体。" }
  class n140 node_component
  class n140 external_node
  eh4 layout_6@~~~ n136
  n136 layout_7@~~~ n137
  n137 layout_8@~~~ n138
  n138 layout_9@~~~ n139
  n139 layout_10@~~~ n140
  end
  class n14 node_entity
  style n14 fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  n14 e0@-->|"ChildOf"| n11
  class e0 edge_relationship
  n14 e1@-->|"ChildOf"| n12
  class e1 edge_relationship
  end
  style relation_0 fill:none,stroke:none
  subgraph relation_1[" "]
  direction TB
  n15@{ shape: rect, label: "**海岛静态碰撞实体**        ​<br/>为海岛结构、入口坡道与展示人物        ​<br/>提供静态碰撞。        ​" }
  class n15 node_entity
  n16@{ shape: rect, label: "**海岛实例根**        ​<br/>承载海岛实例并记录碰撞与业务生        ​<br/>成进度。        ​" }
  class n16 node_entity
  n17@{ shape: rect, label: "**地图展示 NPC**        ​<br/>保留地图展示人物及其静态身体碰        ​<br/>撞。        ​" }
  class n17 node_entity
  n18@{ shape: rect, label: "**GLB 网格与骨骼节点**        ​<br/>来自Bevy 引擎 ↗：承载导入模型        ​<br/>的网格、骨骼与局部动画姿态。        ​" }
  class n18 node_entity
  class n18 external_node
  n15 e2@-->|"ChildOf（原地图美术实例）"| n18
  class e2 edge_relationship
  n15 e3@-->|"ChildOf（NPC 身体碰撞）"| n17
  class e3 edge_relationship
  n17 e4@-->|"ChildOf（地图子树）"| n16
  class e4 edge_relationship
  end
  style relation_1 fill:none,stroke:none
  end
  subgraph catalog["数据与实体"]
  direction LR
  subgraph column_0[" "]
  direction TB
  n0@{ shape: cyl, label: "**ArtAssets**<br/>保存运行模型资源并维持其加载寿命。" }
  class n0 node_resource
  n1@{ shape: cyl, label: "**ArtLoadState**<br/>保存运行资源的加载进度与就绪结果。" }
  class n1 node_resource
  n10@{ shape: rect, label: "**键盘控制者**        ​<br/>保存玩家身份、输入上下文与受控        ​<br/>角色及相机。        ​" }
  class n10 node_entity
  n13@{ shape: rect, label: "**第一人称相机实体**        ​<br/>提供跟随角色的第一人称视角与观        ​<br/>察输入状态。        ​" }
  class n13 node_entity
  n0 layout_11@~~~ n1
  n1 layout_12@~~~ n10
  n10 layout_13@~~~ n13
  end
  style column_0 fill:none,stroke:none
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
