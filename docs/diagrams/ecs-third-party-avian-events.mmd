---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: Avian · 事件与协作
  accDescr: Avian的事件与协作；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_message fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_message_buffer fill:#EDF4F6,stroke:#247B91,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef node_plugin_group fill:#F4F2F6,stroke:#735C93,stroke-width:2.2px,color:#1F3340
  classDef edge_consume stroke:#247B91,stroke-width:1.8px,stroke-dasharray:2 4
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  n0@{ shape: cyl, label: "**Messages#lt;CollisionStart#gt;**<br/>缓冲物理接触开始消息。" }
  class n0 node_message_buffer
  n1@{ shape: cyl, label: "**Messages#lt;CollisionEnd#gt;**<br/>缓冲物理接触结束消息。" }
  class n1 node_message_buffer
  n2@{ shape: fr-rect, label: "**PhysicsPlugins::default()**<br/>提供固定步刚体模拟与碰撞求解。" }
  class n2 node_plugin_group
  n3@{ shape: lean-r, label: "**CollisionStart / CollisionEnd**<br/>缓冲接触开始或结束及碰撞双方身份。" }
  class n3 node_message
  n4@{ shape: rounded, label: "**log_collisions**<br/>来自物理基础 ↗：将碰撞开始与结束写入统<br/>一日志。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: fr-rect, label: "**GamePhysicsPlugin**<br/>来自物理基础 ↗：安装物理引擎并管理重<br/>力、提前唤醒与碰撞日志。" }
  class n5 node_plugin
  class n5 external_node
  n3 e0@--> n4
  class e0 edge_consume
  n5 e1@-->|"Avian"| n2
  class e1 edge_registration
  end
