---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-260709d768b83bb2-e1{marker-start:url(#component-260709d768b83bb2_flowchart-v2-pointStart)!important}\n#component-260709d768b83bb2-e3{marker-start:url(#component-260709d768b83bb2_flowchart-v2-pointStart)!important}\n#component-260709d768b83bb2-e5{marker-start:url(#component-260709d768b83bb2_flowchart-v2-pointStart)!important}\n#component-260709d768b83bb2-e6{marker-start:url(#component-260709d768b83bb2_flowchart-v2-pointStart)!important}\n#component-260709d768b83bb2-e7{marker-start:url(#component-260709d768b83bb2_flowchart-v2-pointStart)!important}\n#component-260709d768b83bb2_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: HoldingItems · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: rounded, label: "**角色业务根实体**<br/>来自场景装配 ↗：承载角色身份、运动意图<br/>与动态物理身体。" }
  class n0 node_entity
  class n0 external_node
  n1@{ shape: rounded, label: "**HoldingItems**<br/>索引角色当前持有的物品。" }
  class n1 node_component
  n2@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n2 node_system
  class n2 external_node
  n3@{ shape: rounded, label: "**handle_interaction**<br/>处理物品拾取、共享持握与主动释放。" }
  class n3 node_system
  n4@{ shape: rounded, label: "**initialize_ready_couriers**<br/>来自角色动画 ↗：绑定主角命名动画并缓存<br/>鞋底补偿节点。" }
  class n4 node_system
  class n4 external_node
  n5@{ shape: rounded, label: "**sync_courier_animation**<br/>来自角色动画 ↗：按角色运动状态连续混合<br/>移动与跳跃动画。" }
  class n5 node_system
  class n5 external_node
  n6@{ shape: rounded, label: "**restore_empty_holder_mass**<br/>归还不再持物角色的原有质量。" }
  class n6 node_system
  n7@{ shape: rounded, label: "**release_orphaned_items**<br/>清理失效持握并恢复物品独立运动。" }
  class n7 node_system
  n8@{ shape: rounded, label: "**recover_from_water**<br/>来自越界恢复 ↗：将落水实体恢复到各自出<br/>生姿态。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**align_attachments**<br/>沿安全碰撞路径将物品对齐双手。" }
  class n9 node_system
  n1 layout_0@~~~ n0
  n2 layout_1@~~~ n1
  n3 layout_2@~~~ n1
  n4 layout_3@~~~ n1
  n5 layout_4@~~~ n1
  n6 layout_5@~~~ n1
  n7 layout_6@~~~ n1
  n8 layout_7@~~~ n1
  n9 layout_8@~~~ n1
  n2 e2@-->|"/ 结构变更（待核实）"| n1
  class e2 edge_write
  n3 e4@-->|"/ 结构变更（待核实）"| n1
  class e4 edge_write
  n7 e8@-->|"/ 结构变更（待核实）"| n1
  class e8 edge_write
  n8 e9@-->|"/ 结构变更（待核实）"| n1
  class e9 edge_write
  n9 e10@-->|"/ 结构变更（待核实）"| n1
  class e10 edge_write
  n1 e0@-->|"可能挂载于"| n0
  class e0 edge_reference
  n2 e1@---|"查询访问"| n1
  class e1 edge_read
  n3 e3@---|"查询访问"| n1
  class e3 edge_read
  n4 e5@---|"查询访问"| n1
  class e5 edge_read
  n5 e6@---|"查询访问"| n1
  class e6 edge_read
  n6 e7@---|"查询访问"| n1
  class e7 edge_read
  e0@{ curve: basis }
