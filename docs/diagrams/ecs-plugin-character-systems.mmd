---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 32,
      "rankSpacing": 56,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart TB
  accTitle: 角色运动 · 系统与调度
  accDescr: 角色运动的系统与调度；外部契约保留摘要，可跳转到所属插件。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_contract fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef edge_schedule stroke:#334155,stroke-width:3px
  classDef edge_order stroke:#334155,stroke-width:2px
  classDef edge_membership stroke:#6A778C,stroke-width:1.4px,stroke-dasharray:2 4
  classDef external_node stroke-dasharray:6 4
  subgraph diagram_main[" "]
  direction LR
  style diagram_main fill:none,stroke:none
  subgraph sg0["Startup"]
  direction TB
  n0@{ shape: rounded, label: "**log_configuration**<br/>记录角色运动与持物行为的初始化配置。" }
  class n0 node_system
  end
  subgraph sg1["OnEnter"]
  direction TB
  n6@{ shape: rounded, label: "**clear_character_intents**<br/>清空持续移动意图与单次动作请求。" }
  class n6 node_system
  end
  subgraph sg2["FixedUpdate"]
  direction TB
  n8@{ shape: rounded, label: "**sync_gravity**<br/>来自物理基础 ↗：将共享重力配置同步到物<br/>理世界。" }
  class n8 node_system
  class n8 external_node
  n9@{ shape: rounded, label: "**sync_character_facing**<br/>来自第一人称控制 ↗：同步人物朝向并处理<br/>持物转向受阻。" }
  class n9 node_system
  class n9 external_node
  n3@{ shape: rounded, label: "**update_grounded**<br/>准备运动前更新接地状态。" }
  class n3 node_system
  n1@{ shape: rounded, label: "**move_characters**<br/>按移动意图和速度为角色施加水平运动力。" }
  class n1 node_system
  n2@{ shape: rounded, label: "**jump_characters**<br/>执行角色跳跃并消费单次请求。" }
  class n2 node_system
  n10@{ shape: rounded, label: "**handle_interaction**<br/>来自物品交互 ↗：处理物品拾取、共享持握<br/>与主动释放。" }
  class n10 node_system
  class n10 external_node
  n11@{ shape: lin-rect, label: "**FixedGameplaySystems**<br/>来自应用流程 ↗：协调恢复、朝向、运动、<br/>交互与持握的固定步顺序。" }
  class n11 node_contract
  class n11 external_node
  n8 layout_0@~~~ n9
  n9 layout_1@~~~ n3
  n3 layout_2@~~~ n1
  n1 layout_3@~~~ n2
  n2 layout_4@~~~ n10
  n10 layout_5@~~~ n11
  end
  subgraph sg3["FixedPostUpdate"]
  direction TB
  n7@{ shape: lin-rect, label: "**PhysicsSystems::Writeback**<br/>来自Avian ↗：将求解后的物理位姿写回显<br/>示变换。" }
  class n7 node_contract
  class n7 external_node
  n4@{ shape: rounded, label: "**update_grounded**<br/>物理回写之后观察实际接地状态。" }
  class n4 node_system
  n5@{ shape: rounded, label: "**log_character_velocity**<br/>定期记录角色实际速度与接地状态。" }
  class n5 node_system
  n7 layout_6@~~~ n4
  n4 layout_7@~~~ n5
  end
  sg0 sc0@--> sg1
  class sc0 edge_schedule
  sg1 sc1@--> sg2
  class sc1 edge_schedule
  sg2 sc2@--> sg3
  class sc2 edge_schedule
  n7 e0@--> n4
  class e0 edge_order
  n4 e1@--> n5
  class e1 edge_order
  n8 e2@--> n3
  class e2 edge_order
  n9 e3@--> n3
  class e3 edge_order
  n3 e4@--> n1
  class e4 edge_order
  n1 e5@--> n2
  class e5 edge_order
  n2 e6@--> n10
  class e6 edge_order
  n11 e7@-->|"Motion"| n1
  class e7 edge_membership
  end
  e0@{ curve: basis }
  e1@{ curve: basis }
  e2@{ curve: basis }
  e3@{ curve: basis }
  e4@{ curve: basis }
  e5@{ curve: basis }
  e6@{ curve: basis }
  e7@{ curve: basis }
