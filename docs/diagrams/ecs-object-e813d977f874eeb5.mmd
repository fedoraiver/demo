---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 48,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    }
  }
}
---
flowchart LR
  accTitle: WinitSettings · 对象关系
  accDescr: 中心对象与所有直接关联对象；完整保留入边、出边及原投影和注册身份，不递归展开间接关系。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_resource fill:#F8F4EE,stroke:#A5792C,stroke-width:1.6px,color:#1F3340
  classDef node_plugin fill:#F1F3F6,stroke:#4A6389,stroke-width:2.2px,color:#1F3340
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_registration stroke:#64748B,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  n0@{ shape: cyl, label: "**WinitSettings**<br/>配置窗口主循环的更新策略。" }
  class n0 node_resource
  n1@{ shape: rounded, label: "**apply_frame_rate_limit**<br/>来自设置与参数 ↗：将帧率设置同步给原生<br/>窗口循环。" }
  class n1 node_system
  class n1 external_node
  n2@{ shape: fr-rect, label: "**SettingsPlugin**<br/>来自设置与参数 ↗：管理设置持久化、共享<br/>原型参数与帧率控制。" }
  class n2 node_plugin
  class n2 external_node
  n1 e0@-->|"focused_mode / unfocused_mode"| n0
  class e0 edge_write
  n2 e1@-->|"init_resource"| n0
  class e1 edge_registration
  e0@{ curve: basis }
  e1@{ curve: basis }
