---
{
  "config": {
    "theme": "base",
    "look": "classic",
    "layout": "dagre",
    "maxTextSize": 200000,
    "htmlLabels": false,
    "fontFamily": "Segoe UI, Microsoft YaHei, sans-serif",
    "themeVariables": {
      "primaryTextColor": "#1F3340",
      "lineColor": "#64748B",
      "clusterBkg": "#F8FAFC",
      "clusterBorder": "#DDE4ED",
      "edgeLabelBackground": "#FFFFFF",
      "fontSize": "14px"
    },
    "flowchart": {
      "htmlLabels": false,
      "nodeSpacing": 16,
      "rankSpacing": 32,
      "padding": 16,
      "wrappingWidth": 280,
      "minNodeWidth": 180,
      "useMaxWidth": false,
      "curve": "linear"
    },
    "themeCSS": "#component-6072155ec355f601-e9{marker-start:url(#component-6072155ec355f601_flowchart-v2-pointStart)!important}\n#component-6072155ec355f601-e11{marker-start:url(#component-6072155ec355f601_flowchart-v2-pointStart)!important}\n#component-6072155ec355f601-e12{marker-start:url(#component-6072155ec355f601_flowchart-v2-pointStart)!important}\n#component-6072155ec355f601-e13{marker-start:url(#component-6072155ec355f601_flowchart-v2-pointStart)!important}\n#component-6072155ec355f601-e14{marker-start:url(#component-6072155ec355f601_flowchart-v2-pointStart)!important}\n#component-6072155ec355f601-e15{marker-start:url(#component-6072155ec355f601_flowchart-v2-pointStart)!important}\n#component-6072155ec355f601-e16{marker-start:url(#component-6072155ec355f601_flowchart-v2-pointStart)!important}\n#component-6072155ec355f601-e18{marker-start:url(#component-6072155ec355f601_flowchart-v2-pointStart)!important}\n#component-6072155ec355f601-e20{marker-start:url(#component-6072155ec355f601_flowchart-v2-pointStart)!important}\n#component-6072155ec355f601-e21{marker-start:url(#component-6072155ec355f601_flowchart-v2-pointStart)!important}\n#component-6072155ec355f601_flowchart-v2-pointStart path{fill:context-stroke!important;stroke:context-stroke!important}"
  }
}
---
flowchart RL
  accTitle: ChildOf · 组件关系
  accDescr: 左侧为包含组件的实体，中间为组件类型，右侧每个系统函数只显示一次；连线表达访问与生命周期操作。
  %% n*/e* 是业务节点/关系，sc* 是阶段关系；layout_* 仅用于排版。
  classDef node_system fill:#EFF3F8,stroke:#3567A6,stroke-width:1.6px,color:#1F3340
  classDef node_entity fill:#F8F1EF,stroke:#A6533B,stroke-width:2.2px,color:#1F3340
  classDef node_component fill:#F1F5F2,stroke:#4B8060,stroke-width:1.6px,color:#1F3340
  classDef node_system_set fill:#F3F4F6,stroke:#6A778C,stroke-width:1.6px,color:#1F3340
  classDef node_engine_flow fill:#F1F5F4,stroke:#557C78,stroke-width:1.6px,color:#1F3340
  classDef edge_read stroke:#3567A6,stroke-width:1.6px,stroke-dasharray:6 4
  classDef edge_write stroke:#2F7161,stroke-width:1.8px
  classDef edge_reference stroke:#7B4DB2,stroke-width:1.5px,stroke-dasharray:6 4
  classDef external_node stroke-dasharray:6 4
  subgraph layout_card_n0[" "]
  n0@{ shape: rounded, label: "**业务直属 GLB 视觉根实体**<br/>来自场景装配 ↗：承载业务实体的模型、骨<br/>骼与动画子树。" }
  class n0 node_entity
  class n0 external_node
  end
  style layout_card_n0 fill:none,stroke:none
  subgraph layout_card_n1[" "]
  n1@{ shape: rounded, label: "**海岛静态碰撞实体**<br/>来自场景装配 ↗：为海岛结构、入口坡道与<br/>展示人物提供静态碰撞。" }
  class n1 node_entity
  class n1 external_node
  end
  style layout_card_n1 fill:none,stroke:none
  subgraph layout_card_n2[" "]
  n2@{ shape: rounded, label: "**地图展示 NPC**<br/>来自场景装配 ↗：保留地图展示人物及其静<br/>态身体碰撞。" }
  class n2 node_entity
  class n2 external_node
  end
  style layout_card_n2 fill:none,stroke:none
  subgraph layout_card_n3[" "]
  n3@{ shape: rounded, label: "**主角 GLB 播放器节点**<br/>承载主角模型的动画播放与混合状态。" }
  class n3 node_entity
  end
  style layout_card_n3 fill:none,stroke:none
  subgraph layout_card_n4[" "]
  n4@{ shape: rounded, label: "**GLB 网格与骨骼节点**<br/>承载导入模型的网格、骨骼与局部动画姿态。" }
  class n4 node_entity
  end
  style layout_card_n4 fill:none,stroke:none
  subgraph layout_card_n5[" "]
  n5@{ shape: rounded, label: "**可操作菜单按钮**<br/>来自菜单与界面 ↗：承载可操作菜单动作、<br/>设置调整与连续导航。" }
  class n5 node_entity
  class n5 external_node
  end
  style layout_card_n5 fill:none,stroke:none
  subgraph layout_card_n6[" "]
  n6@{ shape: rounded, label: "**主菜单展示相机**<br/>来自菜单与界面 ↗：为主菜单展示场景与界<br/>面提供相机。" }
  class n6 node_entity
  class n6 external_node
  end
  style layout_card_n6 fill:none,stroke:none
  subgraph layout_card_n7[" "]
  n7@{ shape: rounded, label: "**设置滚动条轨道**<br/>来自菜单与界面 ↗：为设置内容视口提供可<br/>交互滚动轨道。" }
  class n7 node_entity
  class n7 external_node
  end
  style layout_card_n7 fill:none,stroke:none
  subgraph layout_card_n8[" "]
  n8@{ shape: rounded, label: "**设置滚动条滑块**<br/>来自菜单与界面 ↗：显示设置内容的可视比<br/>例并支持拖动。" }
  class n8 node_entity
  class n8 external_node
  end
  style layout_card_n8 fill:none,stroke:none
  subgraph layout_card_n9[" "]
  n9@{ shape: rounded, label: "**ChildOf**<br/>关联父实体并跟随父级生命周期。" }
  class n9 node_component
  end
  style layout_card_n9 fill:none,stroke:none
  subgraph layout_card_n10[" "]
  n10@{ shape: rounded, label: "**sync_character_visibility**<br/>来自第一人称控制 ↗：隐藏第一人称控制角<br/>色的自身模型。" }
  class n10 node_system
  class n10 external_node
  end
  style layout_card_n10 fill:none,stroke:none
  subgraph layout_card_n11[" "]
  n11@{ shape: rounded, label: "**prepare_island**<br/>来自场景装配 ↗：从海岛模型构建静态碰<br/>撞、坡道与人物碰撞。" }
  class n11 node_system
  class n11 external_node
  end
  style layout_card_n11 fill:none,stroke:none
  subgraph layout_card_n12[" "]
  n12@{ shape: rounded, label: "**initialize_ready_couriers**<br/>来自角色动画 ↗：绑定主角命名动画并缓存<br/>鞋底补偿节点。" }
  class n12 node_system
  class n12 external_node
  end
  style layout_card_n12 fill:none,stroke:none
  subgraph layout_card_n13[" "]
  n13@{ shape: rounded, label: "**pointer_interaction**<br/>来自菜单与界面 ↗：将真实鼠标交互转换为<br/>共享菜单请求。" }
  class n13 node_system
  class n13 external_node
  end
  style layout_card_n13 fill:none,stroke:none
  subgraph layout_card_n14[" "]
  n14@{ shape: rounded, label: "**scroll_focused_button**<br/>来自菜单与界面 ↗：将当前聚焦设置按钮滚<br/>入可视范围。" }
  class n14 node_system
  class n14 external_node
  end
  style layout_card_n14 fill:none,stroke:none
  subgraph layout_card_n15[" "]
  n15@{ shape: rounded, label: "**sample_slider_pointer**<br/>来自菜单与界面 ↗：从光标位置生成音量采<br/>样与释放请求。" }
  class n15 node_system
  class n15 external_node
  end
  style layout_card_n15 fill:none,stroke:none
  subgraph layout_card_n16[" "]
  n16@{ shape: rounded, label: "**bind_settings_scrollbars**<br/>来自菜单与界面 ↗：将设置滚动条绑定到对<br/>应内容视口。" }
  class n16 node_system
  class n16 external_node
  end
  style layout_card_n16 fill:none,stroke:none
  subgraph layout_card_n17[" "]
  n17@{ shape: lin-rect, label: "**TransformSystems::Propagate**<br/>沿实体层级传播世界变换。" }
  class n17 node_system_set
  end
  style layout_card_n17 fill:none,stroke:none
  subgraph layout_card_n18[" "]
  n18@{ shape: stadium, label: "**场景实例生成流程**<br/>展开场景资产层级并通知实例就绪。" }
  class n18 node_engine_flow
  end
  style layout_card_n18 fill:none,stroke:none
  subgraph layout_card_n19[" "]
  n19@{ shape: rounded, label: "**compensate_courier_sole_penetration**<br/>来自角色动画 ↗：补偿鞋底穿地并平滑恢复<br/>视觉高度。" }
  class n19 node_system
  class n19 external_node
  end
  style layout_card_n19 fill:none,stroke:none
  subgraph layout_card_n20[" "]
  n20@{ shape: rounded, label: "**spawn_backdrop**<br/>来自菜单与界面 ↗：装配主菜单海岛展示舞<br/>台、相机与日光。" }
  class n20 node_system
  class n20 external_node
  end
  style layout_card_n20 fill:none,stroke:none
  subgraph layout_card_n21[" "]
  n21@{ shape: rounded, label: "**pointer_events**<br/>生成指针EntityEvent并同时发布对<br/>应Message。" }
  class n21 node_system
  end
  style layout_card_n21 fill:none,stroke:none
  subgraph layout_card_n22[" "]
  n22@{ shape: rounded, label: "**update_is_hovered**<br/>按鼠标HoverMap及祖先关系替换已<br/>有Hovered值。" }
  class n22 node_system
  end
  style layout_card_n22 fill:none,stroke:none
