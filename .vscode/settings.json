{
  "rust-analyzer.check.extraArgs": [
    "--jobs",
    "2"
  ],
  "rust-analyzer.vfs.extraIncludes": [
    "${workspaceFolder}"
  ],
  "rust-analyzer.files.exclude": [
    "tmp",
    "target",
    "logs"
  ],
  "files.watcherExclude": {
    "tmp/**": true,
    "target/**": true,
    "logs/**": true
  },
  "search.exclude": {
    "tmp/**": true,
    "target/**": true,
    "logs/**": true
  },
  "liveServer.settings.ignoreFiles": [
    ".vscode/**",
    "target/**",
    "tmp/**",
    "logs/**"
  ]
}