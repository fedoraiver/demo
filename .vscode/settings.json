{
  "rust-analyzer.vfs.extraIncludes": ["${workspaceFolder}/src"],
  "rust-analyzer.files.exclude": ["tmp"],
  "files.watcherExclude": {
    "tmp/**": true,
    "target/**": true,
    "logs/**": true
  },
  "search.exclude": {
    "tmp/**": true,
    "target/**": true,
    "logs/**": true
  },
  "liveServer.settings.ignoreFiles": [
    ".vscode/**",
    "target/**",
    "tmp/**",
    "logs/**"
  ]
}
