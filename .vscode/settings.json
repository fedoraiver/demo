{
  "rust-analyzer.files.exclude": ["tmp"],
  "files.watcherExclude": {
    "**/tmp/**": true
  },
  "liveServer.settings.ignoreFiles": [
    ".vscode/**",
    "**/*.scss",
    "**/*.sass",
    "**/*.ts",
    "node_modules/**",
    "venv/**",
    ".venv/**",
    "**/target/**",
    "**/tmp/**"
  ]
}
